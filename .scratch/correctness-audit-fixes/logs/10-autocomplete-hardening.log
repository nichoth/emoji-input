{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Sn7A579c2U34r6MqpvdVb","type":"tool_result","content":"1\t/**\n2\t * <emoji-input>\n3\t *\n4\t * Wrap a <textarea> or <input>. When the user types `:` followed by\n5\t * two or more characters, a popover opens at the caret with matching\n6\t * emoji. Arrow keys move, Enter/Tab insert, Escape closes.\n7\t *\n8\t * No shadow DOM. The list is a plain child element with class\n9\t * `emoji-search-list`; import `index.css` alongside the component\n10\t * and use `--emoji-search-*` custom properties for theming.\n11\t *\n12\t *   <emoji-input>\n13\t *     <textarea></textarea>\n14\t *   </emoji-input>\n15\t *\n16\t * Or attach to a field that lives elsewhere:\n17\t *\n18\t *   const el = document.querySelector('emoji-input')\n19\t *   el.attach(document.querySelector('#chat'))\n20\t *\n21\t * Pass your own data (e.g. from `unicode-emoji-json` or `emojibase-data`)\n22\t * via `el.emojis = [{ emoji: '🍕', name: 'pizza', keywords: ['food'] }]`.\n23\t */\n24\t\n25\timport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n26\timport { search } from './search.js'\n27\timport { placePopover } from './placement.js'\n28\texport { EmojiPicker } from './picker.js'\n29\texport { EmojiButton } from './button.js'\n30\texport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n31\texport type EmojiSelectDetail = {\n32\t    emoji:EmojiEntry;\n33\t    query:string;\n34\t}\n35\t\n36\ttype Field = HTMLTextAreaElement|HTMLInputElement\n37\tconst TRIGGER = /:([a-z0-9_+-]*)$/i\n38\t\n39\t// ---------------------------------------------------------------------\n40\t// Caret position (mirror-div technique)\n41\t// ---------------------------------------------------------------------\n42\t\n43\tconst MIRROR_PROPS = [\n44\t    'boxSizing', 'width', 'height',\n45\t    'overflowX', 'overflowY',\n46\t    'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',\n47\t    'borderStyle',\n48\t    'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',\n49\t    'fontStyle', 'fontVariant', 'fontWeight', 'fontStretch', 'fontSize',\n50\t    'fontSizeAdjust', 'lineHeight', 'fontFamily',\n51\t    'textAlign', 'textTransform', 'textIndent', 'textDecoration',\n52\t    'letterSpacing', 'wordSpacing', 'tabSize', 'whiteSpace',\n53\t    'wordWrap', 'wordBreak',\n54\t] as const\n55\t\n56\tinterface CaretRect { top:number; left:number; height:number }\n57\t\n58\tconst Base = typeof HTMLElement !== 'undefined' ?\n59\t    HTMLElement :\n60\t    class {} as unknown as typeof HTMLElement\n61\t\n62\t// ---------------------------------------------------------------------\n63\t// Element\n64\t// ---------------------------------------------------------------------\n65\t\n66\texport class EmojiInput extends Base {\n67\t    static TAG = 'emoji-input'\n68\t\n69\t    static define (tag = EmojiInput.TAG):void {\n70\t        if (typeof window === 'undefined' || !window.customElements) return\n71\t        if (!customElements.get(tag)) {\n72\t            customElements.define(tag, EmojiInput)\n73\t        }\n74\t    }\n75\t\n76\t    static render (uid:string):string {\n77\t        return `<div class=\"emoji-search-list\"\n78\t            popover=\"manual\"\n79\t            role=\"listbox\"\n80\t            aria-label=\"Emoji suggestions\"\n81\t            id=\"${uid}-list\"\n82\t        ></div>`\n83\t    }\n84\t\n85\t    private hydrate ():void {\n86\t        this.list.addEventListener('pointerdown', ev => ev.preventDefault())\n87\t        this.list.addEventListener('click', ev => {\n88\t            const row = (ev.target as HTMLElement)\n89\t                .closest<HTMLElement>('.emoji-search-item')\n90\t            if (!row) return\n91\t            this.index = Number(row.dataset.index)\n92\t            this.commit()\n93\t        })\n94\t        this.list.addEventListener('pointermove', ev => {\n95\t            const row = (ev.target as HTMLElement)\n96\t                .closest<HTMLElement>(\n97\t                    '.emoji-search-item'\n98\t                )\n99\t            if (!row) return\n100\t            const i = Number(row.dataset.index)\n101\t            if (i !== this.index) {\n102\t                this.index = i\n103\t                this.paintSelection()\n104\t            }\n105\t        })\n106\t    }\n107\t\n108\t    /** Emoji dataset. Replace with a full list if you like. */\n109\t    emojis:EmojiEntry[] = DEFAULT_EMOJIS\n110\t    /** Characters after `:` before the popover opens. */\n111\t    minChars = 2\n112\t    /** Max rows to show. */\n113\t    maxResults = 8\n114\t\n115\t    private field:Field|null = null\n116\t    private list!:HTMLElement\n117\t    private results:EmojiEntry[] = []\n118\t    private index = 0\n119\t    private query = ''\n120\t    private range:{ start:number; end:number }|null = null\n121\t    private observer:MutationObserver|null = null\n122\t\n123\t    private uid = `emoji-search-${Math.random().toString(36).slice(2, 8)}`\n124\t\n125\t    connectedCallback ():void {\n126\t        const root = this.getRootNode() as Document|ShadowRoot\n127\t        if (!this.list) {\n128\t            const wrapper = document.createElement('div')\n129\t            wrapper.innerHTML = EmojiInput.render(this.uid)\n130\t            this.list = wrapper.firstElementChild as HTMLElement\n131\t            this.hydrate()\n132\t        }\n133\t        if (!this.list.isConnected) this.append(this.list)\n134\t\n135\t        const forId = this.getAttribute('for')\n136\t        if (forId) {\n137\t            const target = root.getElementById(forId)\n138\t            if (target) this.attach(target as Field)\n139\t        } else {\n140\t            this.attachSlotted()\n141\t            this.observer = new MutationObserver(() => {\n142\t                if (!this.field) this.attachSlotted()\n143\t            })\n144\t            this.observer.observe(this, { childList:true, subtree:true })\n145\t        }\n146\t    }\n147\t\n148\t    disconnectedCallback ():void {\n149\t        this.detach()\n150\t        this.observer?.disconnect()\n151\t    }\n152\t\n153\t    /** Hook up a textarea or text input. */\n154\t    attach (field:Field):void {\n155\t        this.detach()\n156\t        this.field = field\n157\t        field.addEventListener('input', this.onInput);\n158\t        (field as HTMLElement).addEventListener('keydown', this.onKeydown)\n159\t        field.addEventListener('blur', this.close)\n160\t        field.addEventListener('scroll', this.reposition)\n161\t        field.setAttribute('aria-autocomplete', 'list')\n162\t        window.addEventListener('resize', this.reposition)\n163\t        window.addEventListener('scroll', this.reposition, true)\n164\t    }\n165\t\n166\t    detach ():void {\n167\t        if (!this.field) return\n168\t        this.close()\n169\t        const f = this.field\n170\t        f.removeEventListener('input', this.onInput);\n171\t        (f as HTMLElement).removeEventListener('keydown', this.onKeydown)\n172\t        f.removeEventListener('blur', this.close)\n173\t        f.removeEventListener('scroll', this.reposition)\n174\t        window.removeEventListener('resize', this.reposition)\n175\t        window.removeEventListener('scroll', this.reposition, true)\n176\t        this.field = null\n177\t    }\n178\t\n179\t    get isOpen ():boolean {\n180\t        return this.list.matches(':popover-open')\n181\t    }\n182\t\n183\t    close = ():void => {\n184\t        if (this.isOpen) this.list.hidePopover()\n185\t        this.results = []\n186\t        this.range = null\n187\t        this.field?.removeAttribute('aria-activedescendant')\n188\t        this.field?.removeAttribute('aria-controls')\n189\t    }\n190\t\n191\t    // -- private -------------------------------------------------------\n192\t\n193\t    private attachSlotted ():void {\n194\t        const f = this.querySelector<Field>(\n195\t            ':scope > textarea, :scope > input, textarea, input',\n196\t        )\n197\t        if (f) this.attach(f)\n198\t    }\n199\t\n200\t    private onInput = ():void => {\n201\t        const f = this.field\n202\t        if (!f) return\n203\t        const pos = f.selectionStart ?? f.value.length\n204\t        const before = f.value.slice(0, pos)\n205\t        const m = TRIGGER.exec(before)\n206\t\n207\t        if (!m || m[1].length < this.minChars) {\n208\t            this.close()\n209\t            return\n210\t        }\n211\t\n212\t        // don't trigger inside a word like \"http://foo\"\n213\t        const prev = before[m.index - 1]\n214\t        if (prev && /[^\\s([{]/.test(prev)) {\n215\t            this.close()\n216\t            return\n217\t        }\n218\t\n219\t        this.query = m[1]\n220\t        this.range = { start:m.index, end:pos }\n221\t        this.results = search(this.emojis, this.query, this.maxResults)\n222\t        this.index = 0\n223\t        this.render()\n224\t        this.open()\n225\t    }\n226\t\n227\t    private onKeydown = (ev:KeyboardEvent):void => {\n228\t        if (!this.isOpen) return\n229\t        switch (ev.key) {\n230\t            case 'ArrowDown':\n231\t                ev.preventDefault()\n232\t                this.move(1)\n233\t                break\n234\t            case 'ArrowUp':\n235\t                ev.preventDefault()\n236\t                this.move(-1)\n237\t                break\n238\t            case 'Enter':\n239\t            case 'Tab':\n240\t                if (this.results.length) {\n241\t                    ev.preventDefault()\n242\t                    this.commit()\n243\t                }\n244\t                break\n245\t            case 'Escape':\n246\t                ev.preventDefault()\n247\t                this.close()\n248\t                break\n249\t        }\n250\t    }\n251\t\n252\t    private move (delta:number):void {\n253\t        const n = this.results.length\n254\t        if (!n) return\n255\t        this.index = (this.index + delta + n) % n\n256\t        this.paintSelection()\n257\t    }\n258\t\n259\t    private commit ():void {\n260\t        const f = this.field\n261\t        const chosen = this.results[this.index]\n262\t        const r = this.range\n263\t        if (!f || !chosen || !r) return\n264\t\n265\t        const insert = `${chosen.emoji} `\n266\t        f.setRangeText(insert, r.start, r.end, 'end')\n267\t        const query = this.query\n268\t        this.close()\n269\t        f.dispatchEvent(new InputEvent('input', {\n270\t            bubbles:true,\n271\t            inputType:'insertText',\n272\t            data:insert,\n273\t        }))\n274\t        this.dispatchEvent(new CustomEvent<EmojiSelectDetail>('emoji-select', {\n275\t            bubbles:true,\n276\t            composed:true,\n277\t            detail:{ emoji:chosen, query },\n278\t        }))\n279\t    }\n280\t\n281\t    private render ():void {\n282\t        const list = this.list\n283\t        list.replaceChildren()\n284\t        if (!this.results.length) {\n285\t            const empty = document.createElement('div')\n286\t            empty.className = 'emoji-search-empty'\n287\t            empty.textContent = `No emoji matching :${this.query}`\n288\t            list.append(empty)\n289\t            return\n290\t        }\n291\t        const q = this.query.toLowerCase()\n292\t        this.results.forEach((e, i) => {\n293\t            const row = document.createElement('div')\n294\t            row.className = 'emoji-search-item'\n295\t            row.setAttribute('role', 'option')\n296\t            row.id = `${this.uid}-opt-${i}`\n297\t            row.dataset.index = String(i)\n298\t\n299\t            const glyph = document.createElement('span')\n300\t            glyph.className = 'emoji-search-glyph'\n301\t            glyph.textContent = e.emoji\n302\t\n303\t            const name = document.createElement('span')\n304\t            name.className = 'emoji-search-name'\n305\t            const at = e.name.toLowerCase().indexOf(q)\n306\t            if (at >= 0) {\n307\t                name.append(\n308\t                    `:${e.name.slice(0, at)}`,\n309\t                    Object.assign(document.createElement('b'), {\n310\t                        textContent:e.name.slice(at, at + q.length),\n311\t                    }),\n312\t                    `${e.name.slice(at + q.length)}:`,\n313\t                )\n314\t            } else {\n315\t                name.textContent = `:${e.name}:`\n316\t            }\n317\t\n318\t            row.append(glyph, name)\n319\t            list.append(row)\n320\t        })\n321\t        this.paintSelection()\n322\t    }\n323\t\n324\t    private paintSelection ():void {\n325\t        const rows = this.list.querySelectorAll<HTMLElement>('.emoji-search-item')\n326\t        rows.forEach((row, i) => {\n327\t            row.setAttribute('aria-selected', String(i === this.index))\n328\t        })\n329\t        rows[this.index]?.scrollIntoView({ block:'nearest' })\n330\t        this.field?.setAttribute(\n331\t            'aria-activedescendant',\n332\t            `${this.uid}-opt-${this.index}`,\n333\t        )\n334\t    }\n335\t\n336\t    private open ():void {\n337\t        if (!this.isOpen) this.list.showPopover()\n338\t        this.field?.setAttribute('aria-controls', this.list.id)\n339\t        this.reposition()\n340\t    }\n341\t\n342\t    private reposition = ():void => {\n343\t        const f = this.field\n344\t        if (!f || !this.isOpen || !this.range) return\n345\t        const caret = caretRect(f, this.range.start)\n346\t        const box = this.list.getBoundingClientRect()\n347\t        const pos = placePopover(\n348\t            caret,\n349\t            { width:box.width, height:box.height },\n350\t            {\n351\t                width:document.documentElement.clientWidth,\n352\t                height:document.documentElement.clientHeight,\n353\t            },\n354\t            4,\n355\t        )\n356\t        this.list.style.left = `${Math.round(pos.left)}px`\n357\t        this.list.style.top = `${Math.round(pos.top)}px`\n358\t    }\n359\t}\n360\t\n361\tEmojiInput.define()\n362\t\n363\tdeclare global {\n364\t    interface HTMLElementTagNameMap {\n365\t        'emoji-input':EmojiInput;\n366\t    }\n367\t    interface HTMLElementEventMap {\n368\t        'emoji-select':CustomEvent<EmojiSelectDetail>;\n369\t    }\n370\t}\n371\t\n372\tfunction caretRect (field:Field, pos:number):CaretRect {\n373\t    const isTextarea = field instanceof HTMLTextAreaElement\n374\t    const cs = getComputedStyle(field)\n375\t    const mirror = document.createElement('div')\n376\t    const s = mirror.style\n377\t\n378\t    for (const p of MIRROR_PROPS) {\n379\t        s[p] = cs[p]\n380\t    }\n381\t    s.position = 'absolute'\n382\t    s.visibility = 'hidden'\n383\t    s.top = '0'\n384\t    s.left = '-9999px'\n385\t    s.overflow = 'hidden'\n386\t    s.whiteSpace = isTextarea ? 'pre-wrap' : 'pre'\n387\t    if (isTextarea) s.wordWrap = 'break-word'\n388\t\n389\t    const before = field.value.slice(0, pos)\n390\t    mirror.textContent = isTextarea ? before : before.replace(/\\s/g, '\\u00a0')\n391\t\n392\t    const marker = document.createElement('span')\n393\t    marker.textContent = field.value.slice(pos) || '.'\n394\t    mirror.appendChild(marker)\n395\t    document.body.appendChild(mirror)\n396\t\n397\t    const rect = field.getBoundingClientRect()\n398\t    const borderTop = parseFloat(cs.borderTopWidth) || 0\n399\t    const borderLeft = parseFloat(cs.borderLeftWidth) || 0\n400\t    const lineHeight = parseFloat(cs.lineHeight) || marker.offsetHeight\n401\t\n402\t    const out = {\n403\t        top:rect.top + borderTop + marker.offsetTop - field.scrollTop,\n404\t        left:rect.left + borderLeft + marker.offsetLeft - field.scrollLeft,\n405\t        height:lineHeight,\n406\t    }\n407\t    mirror.remove()\n408\t    return out\n409\t}\n410\t"}]},"parent_tool_use_id":null,"session_id":"6d80d6f4-7ee2-4a0c-a7bb-cc79d9229a55","uuid":"49aba6cd-3053-497c-badc-d7616aef099d","timestamp":"2026-09-23T18:46:47.270Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-10-autocomplete-hardening/src/index.ts","content":"/**\n * <emoji-input>\n *\n * Wrap a <textarea> or <input>. When the user types `:` followed by\n * two or more characters, a popover opens at the caret with matching\n * emoji. Arrow keys move, Enter/Tab insert, Escape closes.\n *\n * No shadow DOM. The list is a plain child element with class\n * `emoji-search-list`; import `index.css` alongside the component\n * and use `--emoji-search-*` custom properties for theming.\n *\n *   <emoji-input>\n *     <textarea></textarea>\n *   </emoji-input>\n *\n * Or attach to a field that lives elsewhere:\n *\n *   const el = document.querySelector('emoji-input')\n *   el.attach(document.querySelector('#chat'))\n *\n * Pass your own data (e.g. from `unicode-emoji-json` or `emojibase-data`)\n * via `el.emojis = [{ emoji: '🍕', name: 'pizza', keywords: ['food'] }]`.\n */\n\nimport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nimport { search } from './search.js'\nimport { placePopover } from './placement.js'\nexport { EmojiPicker } from './picker.js'\nexport { EmojiButton } from './button.js'\nexport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nexport type EmojiSelectDetail = {\n    emoji:EmojiEntry;\n    query:string;\n}\n\ntype Field = HTMLTextAreaElement|HTMLInputElement\nconst TRIGGER = /:([a-z0-9_+-]*)$/i\n\n// ---------------------------------------------------------------------\n// Caret position (mirror-div technique)\n// ---------------------------------------------------------------------\n\nconst MIRROR_PROPS = [\n    'boxSizing', 'width', 'height',\n    'overflowX', 'overflowY',\n    'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',\n    'borderStyle',\n    'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',\n    'fontStyle', 'fontVariant', 'fontWeight', 'fontStretch', 'fontSize',\n    'fontSizeAdjust', 'lineHeight', 'fontFamily',\n    'textAlign', 'textTransform', 'textIndent', 'textDecoration',\n    'letterSpacing', 'wordSpacing', 'tabSize', 'whiteSpace',\n    'wordWrap', 'wordBreak',\n] as const\n\ninterface CaretRect { top:number; left:number; height:number }\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\n// ---------------------------------------------------------------------\n// Element\n// ---------------------------------------------------------------------\n\nexport class EmojiInput extends Base {\n    static TAG = 'emoji-input'\n\n    static define (tag = EmojiInput.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n        if (!customElements.get(tag)) {\n            customElements.define(tag, EmojiInput)\n        }\n    }\n\n    static render (uid:string):string {\n        return `<div class=\"emoji-search-list\"\n            popover=\"manual\"\n            role=\"listbox\"\n            aria-label=\"Emoji suggestions\"\n            id=\"${uid}-list\"\n        ></div>`\n    }\n\n    private hydrate ():void {\n        this.list.addEventListener('pointerdown', ev => ev.preventDefault())\n        this.list.addEventListener('click', ev => {\n            const row = (ev.target as HTMLElement)\n                .closest<HTMLElement>('.emoji-search-item')\n            if (!row) return\n            this.index = Number(row.dataset.index)\n            this.commit()\n        })\n        this.list.addEventListener('pointermove', ev => {\n            const row = (ev.target as HTMLElement)\n                .closest<HTMLElement>(\n                    '.emoji-search-item'\n                )\n            if (!row) return\n            const i = Number(row.dataset.index)\n            if (i !== this.index) {\n                this.index = i\n                this.paintSelection()\n            }\n        })\n    }\n\n    /** Emoji dataset. Replace with a full list if you like. */\n    emojis:EmojiEntry[] = DEFAULT_EMOJIS\n    /** Characters after `:` before the popover opens. */\n    minChars = 2\n    /** Max rows to show. */\n    maxResults = 8\n\n    private field:Field|null = null\n    private list!:HTMLElement\n    private results:EmojiEntry[] = []\n    private index = 0\n    private query = ''\n    private range:{ start:number; end:number }|null = null\n    private observer:MutationObserver|null = null\n\n    private uid = `emoji-search-${Math.random().toString(36).slice(2, 8)}`\n\n    connectedCallback ():void {\n        const root = this.getRootNode() as Document|ShadowRoot\n        if (!this.list) {\n            const wrapper = document.createElement('div')\n            wrapper.innerHTML = EmojiInput.render(this.uid)\n            this.list = wrapper.firstElementChild as HTMLElement\n            this.hydrate()\n        }\n        if (!this.list.isConnected) this.append(this.list)\n\n        const forId = this.getAttribute('for')\n        if (forId) {\n            const target = root.getElementById(forId)\n            if (target) this.attach(target as Field)\n        } else {\n            this.attachSlotted()\n            this.observer = new MutationObserver(() => {\n                if (!this.field) this.attachSlotted()\n            })\n            this.observer.observe(this, { childList:true, subtree:true })\n        }\n    }\n\n    disconnectedCallback ():void {\n        this.detach()\n        this.observer?.disconnect()\n    }\n\n    /** Hook up a textarea or text input. */\n    attach (field:Field):void {\n        this.detach()\n        this.field = field\n        field.addEventListener('input', this.onInput);\n        (field as HTMLElement).addEventListener('keydown', this.onKeydown)\n        field.addEventListener('blur', this.close)\n        field.addEventListener('scroll', this.reposition)\n        field.setAttribute('aria-autocomplete', 'list')\n        window.addEventListener('resize', this.reposition)\n        window.addEventListener('scroll', this.reposition, true)\n    }\n\n    detach ():void {\n        if (!this.field) return\n        this.close()\n        const f = this.field\n        f.removeEventListener('input', this.onInput);\n        (f as HTMLElement).removeEventListener('keydown', this.onKeydown)\n        f.removeEventListener('blur', this.close)\n        f.removeEventListener('scroll', this.reposition)\n        window.removeEventListener('resize', this.reposition)\n        window.removeEventListener('scroll', this.reposition, true)\n        this.field = null\n    }\n\n    get isOpen ():boolean {\n        return this.list.matches(':popover-open')\n    }\n\n    close = ():void => {\n        if (this.isOpen) this.list.hidePopover()\n        this.results = []\n        this.range = null\n        this.field?.removeAttribute('aria-activedescendant')\n        this.field?.removeAttribute('aria-controls')\n    }\n\n    // -- private -------------------------------------------------------\n\n    private attachSlotted ():void {\n        const f = this.querySelector<Field>(\n            ':scope > textarea, :scope > input, textarea, input',\n        )\n        if (f) this.attach(f)\n    }\n\n    private onInput = ():void => {\n        const f = this.field\n        if (!f) return\n        const pos = f.selectionStart ?? f.value.length\n        const before = f.value.slice(0, pos)\n        const m = TRIGGER.exec(before)\n\n        if (!m || m[1].length < this.minChars) {\n            this.close()\n            return\n        }\n\n        // don't trigger inside a word like \"http://foo\"\n        const prev = before[m.index - 1]\n        if (prev && /[^\\s([{]/.test(prev)) {\n            this.close()\n            return\n        }\n\n        this.query = m[1]\n        this.range = { start:m.index, end:pos }\n        this.results = search(this.emojis, this.query, this.maxResults)\n        this.index = 0\n        this.render()\n        this.open()\n    }\n\n    private onKeydown = (ev:KeyboardEvent):void => {\n        if (!this.isOpen) return\n        switch (ev.key) {\n            case 'ArrowDown':\n                ev.preventDefault()\n                this.move(1)\n                break\n            case 'ArrowUp':\n                ev.preventDefault()\n                this.move(-1)\n                break\n            case 'Enter':\n            case 'Tab':\n                if (this.results.length) {\n                    ev.preventDefault()\n                    this.commit()\n                }\n                break\n            case 'Escape':\n                ev.preventDefault()\n                this.close()\n                break\n        }\n    }\n\n    private move (delta:number):void {\n        const n = this.results.length\n        if (!n) return\n        this.index = (this.index + delta + n) % n\n        this.paintSelection()\n    }\n\n    private commit ():void {\n        const f = this.field\n        const chosen = this.results[this.index]\n        const r = this.range\n        if (!f || !chosen || !r) return\n\n        const insert = `${chosen.emoji} `\n        f.setRangeText(insert, r.start, r.end, 'end')\n        const query = this.query\n        this.close()\n        f.dispatchEvent(new InputEvent('input', {\n            bubbles:true,\n            inputType:'insertText',\n            data:insert,\n        }))\n        this.dispatchEvent(new CustomEvent<EmojiSelectDetail>('emoji-select', {\n            bubbles:true,\n            composed:true,\n            detail:{ emoji:chosen, query },\n        }))\n    }\n\n    private render ():void {\n        const list = this.list\n        list.replaceChildren()\n        if (!this.results.length) {\n            const empty = document.createElement('div')\n            empty.className = 'emoji-search-empty'\n            empty.textContent = `No emoji matching :${this.query}`\n            list.append(empty)\n            return\n        }\n        const q = this.query.toLowerCase()\n        this.results.forEach((e, i) => {\n            const row = document.createElement('div')\n            row.className = 'emoji-search-item'\n            row.setAttribute('role', 'option')\n            row.id = `${this.uid}-opt-${i}`\n            row.dataset.index = String(i)\n\n            const glyph = document.createElement('span')\n            glyph.className = 'emoji-search-glyph'\n            glyph.textContent = e.emoji\n\n            const name = document.createElement('span')\n            name.className = 'emoji-search-name'\n            const at = e.name.toLowerCase().indexOf(q)\n            if (at >= 0) {\n                name.append(\n                    `:${e.name.slice(0, at)}`,\n                    Object.assign(document.createElement('b'), {\n                        textContent:e.name.slice(at, at + q.length),\n                    }),\n                    `${e.name.slice(at + q.length)}:`,\n                )\n            } else {\n                name.textContent = `:${e.name}:`\n            }\n\n            row.append(glyph, name)\n            list.append(row)\n        })\n        this.paintSelection()\n    }\n\n    private paintSelection ():void {\n        const rows = this.list.querySelectorAll<HTMLElement>('.emoji-search-item')\n        rows.forEach((row, i) => {\n            row.setAttribute('aria-selected', String(i === this.index))\n        })\n        rows[this.index]?.scrollIntoView({ block:'nearest' })\n        this.field?.setAttribute(\n            'aria-activedescendant',\n            `${this.uid}-opt-${this.index}`,\n        )\n    }\n\n    private open ():void {\n        if (!this.isOpen) this.list.showPopover()\n        this.field?.setAttribute('aria-controls', this.list.id)\n        this.reposition()\n    }\n\n    private reposition = ():void => {\n        const f = this.field\n        if (!f || !this.isOpen || !this.range) return\n        const caret = caretRect(f, this.range.start)\n        const box = this.list.getBoundingClientRect()\n        const pos = placePopover(\n            caret,\n            { width:box.width, height:box.height },\n            {\n                width:document.documentElement.clientWidth,\n                height:document.documentElement.clientHeight,\n            },\n            4,\n        )\n        this.list.style.left = `${Math.round(pos.left)}px`\n        this.list.style.top = `${Math.round(pos.top)}px`\n    }\n}\n\nEmojiInput.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-input':EmojiInput;\n    }\n    interface HTMLElementEventMap {\n        'emoji-select':CustomEvent<EmojiSelectDetail>;\n    }\n}\n\nfunction caretRect (field:Field, pos:number):CaretRect {\n    const isTextarea = field instanceof HTMLTextAreaElement\n    const cs = getComputedStyle(field)\n    const mirror = document.createElement('div')\n    const s = mirror.style\n\n    for (const p of MIRROR_PROPS) {\n        s[p] = cs[p]\n    }\n    s.position = 'absolute'\n    s.visibility = 'hidden'\n    s.top = '0'\n    s.left = '-9999px'\n    s.overflow = 'hidden'\n    s.whiteSpace = isTextarea ? 'pre-wrap' : 'pre'\n    if (isTextarea) s.wordWrap = 'break-word'\n\n    const before = field.value.slice(0, pos)\n    mirror.textContent = isTextarea ? before : before.replace(/\\s/g, '\\u00a0')\n\n    const marker = document.createElement('span')\n    marker.textContent = field.value.slice(pos) || '.'\n    mirror.appendChild(marker)\n    document.body.appendChild(mirror)\n\n    const rect = field.getBoundingClientRect()\n    const borderTop = parseFloat(cs.borderTopWidth) || 0\n    const borderLeft = parseFloat(cs.borderLeftWidth) || 0\n    const lineHeight = parseFloat(cs.lineHeight) || marker.offsetHeight\n\n    const out = {\n        top:rect.top + borderTop + marker.offsetTop - field.scrollTop,\n        left:rect.left + borderLeft + marker.offsetLeft - field.scrollLeft,\n        height:lineHeight,\n    }\n    mirror.remove()\n    return out\n}\n","numLines":410,"startLine":1,"totalLines":410}}}
