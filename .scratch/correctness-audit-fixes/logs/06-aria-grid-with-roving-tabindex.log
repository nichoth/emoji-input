 background: var(--emoji-picker-search-bg, #fff);\n64\t    color: var(--emoji-picker-search-fg, #111);\n65\t    font: inherit;\n66\t}\n67\t\n68\t.emoji-picker-tones {\n69\t    display: grid;\n70\t    grid-template-columns: repeat(6, minmax(0, 1fr));\n71\t    gap: 2px;\n72\t    margin-top: 8px;\n73\t}\n74\t\n75\t.emoji-picker-tone {\n76\t    padding: 3px 0;\n77\t    border: 0;\n78\t    background: transparent;\n79\t    color: inherit;\n80\t    cursor: pointer;\n81\t    font: var(--emoji-picker-tone-font, 18px/1.2 sans-serif);\n82\t}\n83\t\n84\t.emoji-picker-tone[aria-checked=\"true\"] {\n85\t    background: var(--emoji-picker-tone-active-bg,\n86\t        var(--emoji-picker-tab-active-bg, transparent));\n87\t}\n88\t\n89\t.emoji-picker-emoji {\n90\t    min-width: 0;\n91\t    padding: 5px 2px;\n92\t    border: 0;\n93\t    background: transparent;\n94\t    color: inherit;\n95\t    cursor: pointer;\n96\t    font: var(--emoji-picker-emoji-font, 24px/1.2 sans-serif);\n97\t}\n98\t\n99\t.emoji-picker-emoji:hover,\n100\t.emoji-picker-emoji:focus-visible {\n101\t    background: var(--emoji-picker-hover-bg, #e8e8e8);\n102\t}\n103\t\n104\t.emoji-picker-empty {\n105\t    grid-column: 1 / -1;\n106\t    padding: 16px 8px;\n107\t    color: var(--emoji-picker-muted, #666);\n108\t    text-align: center;\n109\t}\n110\t\n111\t.emoji-picker-preview {\n112\t    display: flex;\n113\t    align-items: center;\n114\t    gap: 8px;\n115\t    min-height: 32px;\n116\t    margin-top: 8px;\n117\t    border-top: 1px solid var(--emoji-picker-preview-border, transparent);\n118\t    color: var(--emoji-picker-preview-fg, inherit);\n119\t}\n120\t\n121\t.emoji-picker-preview-glyph {\n122\t    font: var(--emoji-picker-preview-glyph-font, 28px/1.2 sans-serif);\n123\t}\n124\t\n125\t.emoji-picker-preview-name {\n126\t    overflow: hidden;\n127\t    text-overflow: ellipsis;\n128\t}\n129\t"}]},"parent_tool_use_id":null,"session_id":"93aea7ef-73f5-4eca-91f2-b7af54f52bc5","uuid":"98083016-40f5-430c-b30c-0461d0c071