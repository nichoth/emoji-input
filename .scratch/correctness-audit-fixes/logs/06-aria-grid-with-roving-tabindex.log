d;\n    grid-template-columns: repeat(6, minmax(0, 1fr));\n    gap: 2px;\n    margin-top: 8px;\n}\n\n.emoji-picker-tone {\n    padding: 3px 0;\n    border: 0;\n    background: transparent;\n    color: inherit;\n    cursor: pointer;\n    font: var(--emoji-picker-tone-font, 18px/1.2 sans-serif);\n}\n\n.emoji-picker-tone[aria-checked=\"true\"] {\n    background: var(--emoji-picker-tone-active-bg,\n        var(--emoji-picker-tab-active-bg, transparent));\n}\n\n.emoji-picker-emoji {\n    min-width: 0;\n    padding: 5px 2px;\n    border: 0;\n    background: transparent;\n    color: inherit;\n    cursor: pointer;\n    font: var(--emoji-picker-emoji-font, 24px/1.2 sans-serif);\n}\n\n.emoji-picker-emoji:hover,\n.emoji-picker-emoji:focus-visible {\n    background: var(--emoji-picker-hover-bg, #e8e8e8);\n}\n\n.emoji-picker-empty {\n    grid-column: 1 / -1;\n    padding: 16px 8px;\n    color: var(--emoji-picker-muted, #666);\n    text-align: center;\n}\n\n.emoji-picker-preview {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 32px;\n    margin-top: 8px;\n    border-top: 1px solid var(--emoji-picker-preview-border, transparent);\n    color: var(--emoji-picker-preview-fg, inherit);\n}\n\n.emoji-picker-preview-glyph {\n    font: var(--emoji-picker-preview-glyph-font, 28px/1.2 sans-serif);\n}\n\n.emoji-picker-preview-name {\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
