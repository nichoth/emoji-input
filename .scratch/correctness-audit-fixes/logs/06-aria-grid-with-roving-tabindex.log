{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Subh3c8DFW1CQ4BGZw5Z4r","type":"tool_result","content":"1\timport { test } from '@substrate-system/tapzero'\n2\timport { sleep } from '@substrate-system/dom'\n3\timport {\n4\t    EmojiInput,\n5\t    EmojiButton as MainEmojiButton,\n6\t    EmojiPicker as MainEmojiPicker,\n7\t    DEFAULT_EMOJIS,\n8\t    type EmojiEntry,\n9\t    type EmojiSelectDetail,\n10\t} from '../src/index.js'\n11\timport { EmojiPicker } from '../src/picker.js'\n12\timport { EmojiButton } from '../src/button.js'\n13\timport { search } from '../src/search.js'\n14\timport packageJson from '../package.json'\n15\timport buttonCss from '../src/button.css'\n16\timport pickerCss from '../src/picker.css'\n17\t\n18\tconst _style = document.createElement('style')\n19\t_style.textContent = [buttonCss, pickerCss].join('\\n')\n20\tdocument.head.appendChild(_style)\n21\t\n22\t// -- Helpers ---------------------------------------------------\n23\t\n24\tconst SMALL_SET:EmojiEntry[] = [\n25\t    {\n26\t        emoji:'😀',\n27\t        name:'grinning',\n28\t        keywords:['smile', 'happy'],\n29\t    },\n30\t    {\n31\t        emoji:'😃',\n32\t        name:'smiley',\n33\t        keywords:['smile', 'happy'],\n34\t    },\n35\t    {\n36\t        emoji:'😄',\n37\t        name:'smile',\n38\t        keywords:['happy', 'laugh'],\n39\t    },\n40\t    {\n41\t        emoji:'🍕',\n42\t        name:'pizza',\n43\t        keywords:['food'],\n44\t    },\n45\t    {\n46\t        emoji:'🍔',\n47\t        name:'hamburger',\n48\t        keywords:['burger', 'food'],\n49\t    },\n50\t    {\n51\t        emoji:'🔥',\n52\t        name:'fire',\n53\t        keywords:['lit', 'hot'],\n54\t    },\n55\t    {\n56\t        emoji:'🐱',\n57\t        name:'cat',\n58\t        keywords:['kitty'],\n59\t    },\n60\t    {\n61\t        emoji:'🐶',\n62\t        name:'dog',\n63\t        keywords:['puppy'],\n64\t    },\n65\t]\n66\t\n67\t// -- Static render (Node-compatible) ---------------------------\n68\t\n69\ttest('static render returns an HTML string', t => {\n70\t    const html = EmojiInput.render('test-uid')\n71\t    t.equal(typeof html, 'string', 'returns a string')\n72\t    t.ok(\n73\t        html.includes('emoji-search-list'),\n74\t        'contains the list class'\n75\t    )\n76\t    t.ok(\n77\t        html.includes('role=\"listbox\"'),\n78\t        'has listbox role'\n79\t    )\n80\t    t.ok(\n81\t        html.includes('aria-label=\"Emoji suggestions\"'),\n82\t        'listbox has an accessible label'\n83\t    )\n84\t    t.ok(\n85\t        html.includes('id=\"test-uid-list\"'),\n86\t        'uses the uid for the element id'\n87\t    )\n88\t    t.ok(\n89\t        html.includes('popover=\"manual\"'),\n90\t        'has popover attribute'\n91\t    )\n92\t})\n93\t\n94\t// -- Data structure --------------------------------------------\n95\t\n96\ttest('DEFAULT_EMOJIS has expected structure', t => {\n97\t    t.ok(\n98\t        DEFAULT_EMOJIS.length >= 1800,\n99\t        'contains the complete emoji-mart set'\n100\t    )\n101\t\n102\t    const first = DEFAULT_EMOJIS[0]\n103\t    t.equal(\n104\t        typeof first.emoji, 'string',\n105\t        'emoji field is a string'\n106\t    )\n107\t    t.equal(\n108\t        typeof first.name, 'string',\n109\t        'name field is a string'\n110\t    )\n111\t    t.ok(\n112\t        Array.isArray(first.keywords),\n113\t        'keywords is an array'\n114\t    )\n115\t})\n116\t\n117\ttest('DEFAULT_EMOJIS includes category and skin data', t => {\n118\t    const butter = DEFAULT_EMOJIS.find(\n119\t        emoji => emoji.name === 'butter'\n120\t    )\n121\t\n122\t    t.ok(butter, 'includes butter')\n123\t    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n124\t    t.ok(butter?.category, 'includes a category')\n125\t    t.ok(Array.isArray(butter?.categories), 'includes categories')\n126\t\n127\t    const wave = DEFAULT_EMOJIS.find(\n128\t        emoji => emoji.name === 'wave'\n129\t    )\n130\t    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n131\t    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n132\t})\n133\t\n134\ttest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n135\t    const invalid = DEFAULT_EMOJIS.filter(\n136\t        e => !e.emoji || !e.name\n137\t    )\n138\t    t.equal(\n139\t        invalid.length, 0,\n140\t        'no entries missing emoji or name'\n141\t    )\n142\t})\n143\t\n144\ttest('shared search ranks name prefixes before substrings', t => {\n145\t    const emojis:EmojiEntry[] = [\n146\t        { emoji:'1', name:'pineapple', keywords:[] },\n147\t        { emoji:'2', name:'apple', keywords:[] },\n148\t        { emoji:'3', name:'grape', keywords:[] },\n149\t    ]\n150\t\n151\t    const results = search(emojis, 'app', 8)\n152\t    t.equal(\n153\t        JSON.stringify(results.map(emoji => emoji.name)),\n154\t        JSON.stringify(['apple', 'pineapple']),\n155\t        'prefix matches rank before substring matches'\n156\t    )\n157\t})\n158\t\n159\ttest('shared search ranks keyword prefixes after name matches', t => {\n160\t    const emojis:EmojiEntry[] = [\n161\t        { emoji:'1', name:'grape', keywords:['apple'] },\n162\t        { emoji:'2', name:'pineapple', keywords:[] },\n163\t        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n164\t    ]\n165\t\n166\t    const results = search(emojis, 'app', 8)\n167\t    t.equal(\n168\t        JSON.stringify(results.map(emoji => emoji.name)),\n169\t        JSON.stringify(['pineapple', 'grape', 'fruit']),\n170\t        'keyword prefix matches rank after name matches'\n171\t    )\n172\t})\n173\t\n174\t// -- Registration and setup ------------------------------------\n175\t\n176\ttest('custom element is registered', t => {\n177\t    const ctor = customElements.get('emoji-input')\n178\t    t.ok(ctor, 'emoji-input tag is defined')\n179\t    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n180\t})\n181\t\n182\ttest('emoji-picker custom element is registered', t => {\n183\t    const ctor = customElements.get('emoji-picker')\n184\t    t.ok(ctor, 'emoji-picker tag is defined')\n185\t    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n186\t\n187\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n188\t    document.body.appendChild(picker)\n189\t    t.ok(picker.emojis.length > 0, 'has default emoji data')\n190\t    t.ok(!picker.isOpen, 'starts closed')\n191\t    picker.remove()\n192\t})\n193\t\n194\ttest('emoji-button custom element renders an accessible smiley button', t => {\n195\t    const ctor = customElements.get('emoji-button')\n196\t    t.ok(ctor, 'emoji-button tag is defined')\n197\t    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n198\t\n199\t    const button = document.createElement('emoji-button')\n200\t    document.body.appendChild(button)\n201\t    const inner = button.querySelector('button')\n202\t    t.ok(inner, 'renders a native button')\n203\t    t.equal(inner?.type, 'button', 'button does not submit forms')\n204\t    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n205\t    t.ok(\n206\t        inner?.querySelector('.visually-hidden'),\n207\t        'has a visually-hidden label'\n208\t    )\n209\t    button.remove()\n210\t})\n211\t\n212\ttest('emoji-button uses currentColor', t => {\n213\t    const button = document.createElement('emoji-button')\n214\t    document.body.appendChild(button)\n215\t\n216\t    const svg = button.querySelector('svg')\n217\t    t.equal(\n218\t        svg?.getAttribute('fill'),\n219\t        'currentColor',\n220\t        'the SVG inherits its fill from currentColor'\n221\t    )\n222\t    button.remove()\n223\t})\n224\t\n225\ttest('emoji-button opens the picker named by for', t => {\n226\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n227\t    picker.id = 'button-picker-target'\n228\t    let opens = 0\n229\t    picker.open = () => { opens++ }\n230\t\n231\t    const button = document.createElement('emoji-button')\n232\t    button.setAttribute('for', picker.id)\n233\t    document.body.append(picker, button)\n234\t    button.querySelector('button')?.click()\n235\t\n236\t    t.equal(opens, 1, 'click calls the referenced picker open method')\n237\t    button.remove()\n238\t    picker.remove()\n239\t})\n240\t\n241\ttest('emoji-button positions the picker below itself', t => {\n242\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n243\t    picker.id = 'position-test-picker'\n244\t    picker.setAttribute('for', 'position-target')\n245\t\n246\t    const wrapper = document.createElement('div')\n247\t    wrapper.style.position = 'relative'\n248\t    wrapper.style.marginTop = '120px'\n249\t    wrapper.style.marginLeft = '200px'\n250\t\n251\t    const button = document.createElement('emoji-button') as EmojiButton\n252\t    button.setAttribute('for', picker.id)\n253\t\n254\t    wrapper.append(button, picker)\n255\t    document.body.append(wrapper)\n256\t\n257\t    button.querySelector('button')?.click()\n258\t    t.ok(picker.isOpen, 'picker opens')\n259\t\n260\t    picker.querySelector<HTMLElement>(\n261\t        '[role=\"tab\"][aria-label=\"People\"]'\n262\t    )?.click()\n263\t    const panel = picker.querySelector(\n264\t        '.emoji-picker-panel'\n265\t    ) as HTMLElement\n266\t    const btnRect = button.getBoundingClientRect()\n267\t    const panelRect = panel.getBoundingClientRect()\n268\t\n269\t    t.ok(\n270\t        panelRect.top >= btnRect.bottom - 1,\n271\t        'picker top is at or below the button bottom'\n272\t    )\n273\t    t.ok(\n274\t        Math.abs(panelRect.left - btnRect.left) < 2,\n275\t        'picker left aligns with the button left'\n276\t    )\n277\t\n278\t    picker.close()\n279\t    picker.remove()\n280\t    wrapper.remove()\n281\t})\n282\t\n283\ttest('button subpath exports only EmojiButton', t => {\n284\t    const buttonExports = packageJson.exports['./button'] as {\n285\t        import:string;\n286\t        require:string;\n287\t    }|undefined\n288\t    t.ok(buttonExports, 'button subpath is declared')\n289\t    t.equal(\n290\t        buttonExports?.import,\n291\t        './dist/button.js',\n292\t        'button import subpath points to the ESM build'\n293\t    )\n294\t    t.equal(\n295\t        buttonExports?.require,\n296\t        './dist/button.cjs',\n297\t        'button require subpath points to the CommonJS build'\n298\t    )\n299\t})\n300\t\n301\ttest('main entrypoint exports all component classes', t => {\n302\t    t.equal(\n303\t        MainEmojiPicker,\n304\t        EmojiPicker,\n305\t        'main entrypoint exports EmojiPicker'\n306\t    )\n307\t    t.equal(\n308\t        MainEmojiButton,\n309\t        EmojiButton,\n310\t        'main entrypoint exports EmojiButton'\n311\t    )\n312\t    t.equal(\n313\t        EmojiInput,\n314\t        customElements.get('emoji-input'),\n315\t        'main entrypoint exports EmojiInput'\n316\t    )\n317\t})\n318\t\n319\ttest('emoji-picker defaults to the recently used tab', t => {\n320\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n321\t    document.body.appendChild(picker)\n322\t\n323\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n324\t    const recentsTab = tabs[0]\n325\t    t.equal(\n326\t        recentsTab?.getAttribute('aria-selected'),\n327\t        'true',\n328\t        'recently used tab is selected by default'\n329\t    )\n330\t    const peopleTab = tabs[1]\n331\t    t.equal(\n332\t        peopleTab?.getAttribute('aria-selected'),\n333\t        'false',\n334\t        'people tab is not selected by default'\n335\t    )\n336\t    picker.remove()\n337\t})\n338\t\n339\ttest('emoji-picker renders category tabs and an eight-column grid', t => {\n340\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n341\t    document.body.appendChild(picker)\n342\t    picker.open()\n343\t\n344\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n345\t    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n346\t    t.equal(\n347\t        tabs[0]?.getAttribute('aria-label'),\n348\t        'Recently used',\n349\t        'recents is the first tab'\n350\t    )\n351\t    t.equal(\n352\t        tabs[1]?.getAttribute('aria-label'),\n353\t        'People',\n354\t        'people is the first emoji category'\n355\t    )\n356\t\n357\t    const grid = picker.querySelector('[role=\"grid\"]')\n358\t    t.ok(grid, 'renders an emoji grid')\n359\t\n360\t    const natureTab = picker.querySelector<HTMLElement>(\n361\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n362\t    )\n363\t    natureTab?.click()\n364\t    t.ok(\n365\t        grid?.textContent?.includes('🐒'),\n366\t        'category tab filters the grid'\n367\t    )\n368\t    picker.remove()\n369\t})\n370\t\n371\ttest('emoji-picker stays open when switching categories', t => {\n372\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n373\t    document.body.appendChild(picker)\n374\t    picker.open()\n375\t    t.ok(picker.isOpen, 'picker is open before tab click')\n376\t\n377\t    const natureTab = picker.querySelector<HTMLElement>(\n378\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n379\t    )\n380\t    natureTab?.click()\n381\t    t.ok(\n382\t        picker.isOpen,\n383\t        'picker stays open after clicking a category tab'\n384\t    )\n385\t    picker.close()\n386\t    picker.remove()\n387\t})\n388\t\n389\ttest('emoji-picker grid exists when open', t => {\n390\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n391\t    document.body.appendChild(picker)\n392\t    picker.open()\n393\t\n394\t    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n395\t    t.ok(grid, 'grid exists')\n396\t    picker.close()\n397\t    picker.remove()\n398\t})\n399\t\n400\ttest('emoji-picker grid has an accessible label', t => {\n401\t    const picker = document.createElement(\n402\t        'emoji-picker'\n403\t    ) as EmojiPicker\n404\t    document.body.appendChild(picker)\n405\t    const grid = picker.querySelector('[role=\"grid\"]')\n406\t    t.equal(\n407\t        grid?.getAttribute('aria-label'),\n408\t        'Emoji',\n409\t        'grid has aria-label'\n410\t    )\n411\t    picker.remove()\n412\t})\n413\t\n414\ttest('emoji-picker search controls the grid', t => {\n415\t    const picker = document.createElement(\n416\t        'emoji-picker'\n417\t    ) as EmojiPicker\n418\t    document.body.appendChild(picker)\n419\t    const search = picker.querySelector(\n420\t        'input[type=\"search\"]'\n421\t    )\n422\t    const grid = picker.querySelector('[role=\"grid\"]')\n423\t    t.ok(\n424\t        search?.getAttribute('aria-controls'),\n425\t        'search has aria-controls'\n426\t    )\n427\t    t.equal(\n428\t        search?.getAttribute('aria-controls'),\n429\t        grid?.id,\n430\t        'search aria-controls references the grid'\n431\t    )\n432\t    picker.remove()\n433\t})\n434\t\n435\ttest('emoji-picker moves focus to search on open', t => {\n436\t    const picker = document.createElement(\n437\t        'emoji-picker'\n438\t    ) as EmojiPicker\n439\t    document.body.appendChild(picker)\n440\t    picker.open()\n441\t    const search = picker.querySelector(\n442\t        'input[type=\"search\"]'\n443\t    )\n444\t    t.equal(\n445\t        document.activeElement,\n446\t        search,\n447\t        'search input is focused after open'\n448\t    )\n449\t    picker.close()\n450\t    picker.remove()\n451\t})\n452\t\n453\ttest('emoji-picker returns focus to trigger on close', t => {\n454\t    const trigger = document.createElement('button')\n455\t    trigger.textContent = 'trigger'\n456\t    document.body.appendChild(trigger)\n457\t    trigger.focus()\n458\t\n459\t    const picker = document.createElement(\n460\t        'emoji-picker'\n461\t    ) as EmojiPicker\n462\t    document.body.appendChild(picker)\n463\t    picker.open(trigger)\n464\t    picker.close()\n465\t    t.equal(\n466\t        document.activeElement,\n467\t        trigger,\n468\t        'focus returns to the trigger element'\n469\t    )\n470\t    picker.remove()\n471\t    trigger.remove()\n472\t})\n473\t\n474\ttest('emoji-picker tabs use roving tabindex', t => {\n475\t    const picker = document.createElement(\n476\t        'emoji-picker'\n477\t    ) as EmojiPicker\n478\t    document.body.appendChild(picker)\n479\t\n480\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n481\t    const selected = tabs[0]\n482\t    const notSelected = tabs[1]\n483\t    t.equal(\n484\t        selected?.getAttribute('tabindex'),\n485\t        '0',\n486\t        'selected tab has tabindex 0'\n487\t    )\n488\t    t.equal(\n489\t        notSelected?.getAttribute('tabindex'),\n490\t        '-1',\n491\t        'non-selected tab has tabindex -1'\n492\t    )\n493\t    picker.remove()\n494\t})\n495\t\n496\ttest('emoji-picker tabs navigate with arrow keys', t => {\n497\t    const picker = document.createElement(\n498\t        'emoji-picker'\n499\t    ) as EmojiPicker\n500\t    document.body.appendChild(picker)\n501\t    picker.open()\n502\t\n503\t    const firstTab = picker.querySelector<HTMLElement>(\n504\t        '[role=\"tab\"]'\n505\t    )\n506\t    firstTab?.focus()\n507\t    keydown(firstTab!, 'ArrowRight')\n508\t\n509\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n510\t    t.equal(\n511\t        tabs[1]?.getAttribute('aria-selected'),\n512\t        'true',\n513\t        'ArrowRight activates the next tab'\n514\t    )\n515\t    t.equal(\n516\t        document.activeElement,\n517\t        tabs[1],\n518\t        'ArrowRight moves focus to the next tab'\n519\t    )\n520\t    picker.close()\n521\t    picker.remove()\n522\t})\n523\t\n524\ttest('emoji-picker search filters visible emoji', t => {\n525\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n526\t    document.body.appendChild(picker)\n527\t    picker.open()\n528\t\n529\t    const input = picker.querySelector<HTMLInputElement>(\n530\t        'input[type=\"search\"]'\n531\t    )\n532\t    t.ok(input, 'renders a search input')\n533\t    if (input) {\n534\t        input.value = 'butter'\n535\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n536\t    }\n537\t\n538\t    const grid = picker.querySelector('[role=\"grid\"]')\n539\t    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n540\t    t.ok(\n541\t        !grid?.textContent?.includes('😀'),\n542\t        'hides emoji that do not match the query'\n543\t    )\n544\t    picker.remove()\n545\t})\n546\t\n547\ttest('emoji-picker emits emoji-select and closes after selection', t => {\n548\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n549\t    document.body.appendChild(picker)\n550\t    picker.open()\n551\t\n552\t    const input = picker.querySelector<HTMLInputElement>(\n553\t        'input[type=\"search\"]'\n554\t    )\n555\t    if (input) {\n556\t        input.value = 'butter'\n557\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n558\t    }\n559\t\n560\t    const details:Array<EmojiSelectDetail> = []\n561\t    picker.addEventListener('emoji-select', (event) => {\n562\t        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n563\t    })\n564\t    const emoji = Array.from(\n565\t        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n566\t    ).find(button => button.textContent === '🧈')\n567\t    emoji?.click()\n568\t\n569\t    const detail = details[0]\n570\t    t.ok(detail, 'emits selection detail')\n571\t    if (detail) {\n572\t        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n573\t        t.equal(detail.query, 'butter', 'emits the current search query')\n574\t    }\n575\t    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n576\t    picker.remove()\n577\t})\n578\t\n579\ttest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n580\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n581\t    document.body.appendChild(picker)\n582\t    picker.open()\n583\t\n584\t    picker.querySelector<HTMLElement>(\n585\t        '[role=\"tab\"][aria-label=\"People\"]'\n586\t    )?.click()\n587\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n588\t        '[role=\"gridcell\"]'\n589\t    )\n590\t    const first = buttons[0]\n591\t    first?.focus()\n592\t    if (first) keydown(first, 'ArrowRight')\n593\t    t.equal(\n594\t        document.activeElement,\n595\t        buttons[1],\n596\t        'ArrowRight moves to the next emoji'\n597\t    )\n598\t    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n599\t    t.equal(\n600\t        document.activeElement,\n601\t        buttons[9],\n602\t        'ArrowDown moves by one grid row'\n603\t    )\n604\t\n605\t    let selected = false\n606\t    picker.addEventListener('emoji-select', () => { selected = true })\n607\t    if (buttons[9]) keydown(buttons[9], 'Enter')\n608\t    t.ok(selected, 'Enter selects the focused emoji')\n609\t    t.ok(!picker.isOpen, 'Enter closes the picker')\n610\t\n611\t    picker.open()\n612\t    keydown(picker, 'Escape')\n613\t    t.ok(!picker.isOpen, 'Escape closes the picker')\n614\t    picker.remove()\n615\t})\n616\t\n617\ttest('Enter on a category tab activates it without emoji-select', t => {\n618\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n619\t    document.body.appendChild(picker)\n620\t    picker.open()\n621\t\n622\t    let selected = false\n623\t    picker.addEventListener('emoji-select', () => { selected = true })\n624\t\n625\t    const peopleTab = picker.querySelector<HTMLElement>(\n626\t        '[role=\"tab\"][aria-label=\"People\"]'\n627\t    )\n628\t    peopleTab?.focus()\n629\t    t.equal(\n630\t        document.activeElement,\n631\t        peopleTab,\n632\t        'focus is on the People tab'\n633\t    )\n634\t    if (peopleTab) {\n635\t        keydown(peopleTab, 'Enter')\n636\t        peopleTab.click()\n637\t    }\n638\t\n639\t    t.ok(!selected, 'Enter on tab does not emit emoji-select')\n640\t    const updatedPeopleTab = picker.querySelector<HTMLElement>(\n641\t        '[role=\"tab\"][aria-label=\"People\"]'\n642\t    )\n643\t    t.equal(\n644\t        updatedPeopleTab?.getAttribute('aria-selected'),\n645\t        'true',\n646\t        'People tab is now selected'\n647\t    )\n648\t    t.ok(picker.isOpen, 'picker stays open')\n649\t    picker.close()\n650\t    picker.remove()\n651\t})\n652\t\n653\ttest('Enter on a skin tone radio checks it without emoji-select', t => {\n654\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n655\t    document.body.appendChild(picker)\n656\t    picker.open()\n657\t\n658\t    let selected = false\n659\t    picker.addEventListener('emoji-select', () => { selected = true })\n660\t\n661\t    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n662\t    t.ok(radios.length >= 2, 'has skin tone radios')\n663\t    const second = radios[1]\n664\t    second?.focus()\n665\t    if (second) {\n666\t        keydown(second, 'Enter')\n667\t        second.click()\n668\t    }\n669\t\n670\t    t.ok(!selected, 'Enter on radio does not emit emoji-select')\n671\t    const updatedRadios = picker.querySelectorAll<HTMLElement>(\n672\t        '[role=\"radio\"]'\n673\t    )\n674\t    t.equal(\n675\t        updatedRadios[1]?.getAttribute('aria-checked'),\n676\t        'true',\n677\t        'radio is now checked'\n678\t    )\n679\t    t.ok(picker.isOpen, 'picker stays open')\n680\t    picker.close()\n681\t    picker.remove()\n682\t})\n683\t\n684\ttest('ArrowLeft in search box stays in search box', t => {\n685\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n686\t    document.body.appendChild(picker)\n687\t    picker.open()\n688\t\n689\t    const search = picker.querySelector<HTMLElement>(\n690\t        'input[type=\"search\"]'\n691\t    )\n692\t    t.equal(\n693\t        document.activeElement,\n694\t        search,\n695\t        'search is focused after open'\n696\t    )\n697\t    if (search) keydown(search, 'ArrowLeft')\n698\t    t.equal(\n699\t        document.activeElement,\n700\t        search,\n701\t        'focus stays in search after ArrowLeft'\n702\t    )\n703\t    if (search) keydown(search, 'ArrowRight')\n704\t    t.equal(\n705\t        document.activeElement,\n706\t        search,\n707\t        'focus stays in search after ArrowRight'\n708\t    )\n709\t    if (search) keydown(search, 'ArrowUp')\n710\t    t.equal(\n711\t        document.activeElement,\n712\t        search,\n713\t        'focus stays in search after ArrowUp'\n714\t    )\n715\t    picker.close()\n716\t    picker.remove()\n717\t})\n718\t\n719\ttest('ArrowDown in search box moves focus into grid', t => {\n720\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n721\t    document.body.appendChild(picker)\n722\t    picker.open()\n723\t\n724\t    picker.querySelector<HTMLElement>(\n725\t        '[role=\"tab\"][aria-label=\"People\"]'\n726\t    )?.click()\n727\t\n728\t    const search = picker.querySelector<HTMLElement>(\n729\t        'input[type=\"search\"]'\n730\t    )\n731\t    search?.focus()\n732\t    if (search) keydown(search, 'ArrowDown')\n733\t\n734\t    const firstCell = picker.querySelector<HTMLElement>(\n735\t        '[role=\"gridcell\"]'\n736\t    )\n737\t    t.equal(\n738\t        document.activeElement,\n739\t        firstCell,\n740\t        'focus moves to the first gridcell'\n741\t    )\n742\t    picker.close()\n743\t    picker.remove()\n744\t})\n745\t\n746\ttest('Enter in search with query selects first visible emoji', t => {\n747\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n748\t    document.body.appendChild(picker)\n749\t    picker.open()\n750\t\n751\t    const input = picker.querySelector<HTMLInputElement>(\n752\t        'input[type=\"search\"]'\n753\t    )\n754\t    if (input) {\n755\t        input.value = 'butter'\n756\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n757\t    }\n758\t\n759\t    const details:Array<EmojiSelectDetail> = []\n760\t    picker.addEventListener('emoji-select', (event) => {\n761\t        details.push(\n762\t            (event as CustomEvent<EmojiSelectDetail>).detail\n763\t        )\n764\t    })\n765\t\n766\t    if (input) keydown(input, 'Enter')\n767\t\n768\t    t.equal(details.length, 1, 'emits emoji-select')\n769\t    t.ok(\n770\t        details[0]?.emoji.name.startsWith('butter'),\n771\t        'selects the first visible emoji matching the query'\n772\t    )\n773\t    picker.close()\n774\t    picker.remove()\n775\t})\n776\t\n777\ttest('ArrowRight on tone radio moves and checks next radio', t => {\n778\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n779\t    document.body.appendChild(picker)\n780\t    picker.open()\n781\t\n782\t    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n783\t    t.ok(radios.length >= 3, 'has at least 3 radios')\n784\t    radios[0]?.focus()\n785\t    t.equal(\n786\t        document.activeElement,\n787\t        radios[0],\n788\t        'first radio is focused'\n789\t    )\n790\t\n791\t    if (radios[0]) keydown(radios[0], 'ArrowRight')\n792\t\n793\t    const updated = picker.querySelectorAll<HTMLElement>(\n794\t        '[role=\"radio\"]'\n795\t    )\n796\t    t.equal(\n797\t        document.activeElement,\n798\t        updated[1],\n799\t        'focus moved to second radio'\n800\t    )\n801\t    t.equal(\n802\t        updated[1]?.getAttribute('aria-checked'),\n803\t        'true',\n804\t        'second radio is now checked'\n805\t    )\n806\t    t.equal(\n807\t        updated[0]?.getAttribute('aria-checked'),\n808\t        'false',\n809\t        'first radio is unchecked'\n810\t    )\n811\t    picker.close()\n812\t    picker.remove()\n813\t})\n814\t\n815\ttest('emoji-picker closes when a popover click lands outside', t => {\n816\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n817\t    document.body.appendChild(picker)\n818\t    picker.open()\n819\t    t.ok(picker.isOpen, 'opens through the public open method')\n820\t\n821\t    document.body.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n822\t    t.ok(!picker.isOpen, 'outside click closes the popover')\n823\t    picker.remove()\n824\t})\n825\t\n826\ttest('emoji-picker inline mode stays in document flow', t => {\n827\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n828\t    picker.setAttribute('inline', '')\n829\t    document.body.appendChild(picker)\n830\t\n831\t    const grid = picker.querySelector('[role=\"grid\"]')\n832\t    const panel = grid?.parentElement\n833\t    t.ok(grid, 'inline mode still renders the picker grid')\n834\t    t.ok(panel && !panel.hasAttribute('popover'),\n835\t        'inline mode removes popover behavior')\n836\t    t.equal(\n837\t        getComputedStyle(panel as Element).position,\n838\t        'static',\n839\t        'inline mode uses in-flow positioning'\n840\t    )\n841\t    picker.remove()\n842\t})\n843\t\n844\ttest('emoji-picker stores and restores capped recently used emoji', t => {\n845\t    const key = 'emoji-picker-test-recents'\n846\t    localStorage.removeItem(key)\n847\t    const emojis:Array<EmojiEntry> = Array.from(\n848\t        { length:25 },\n849\t        (_, index) => ({\n850\t            emoji:String.fromCodePoint(0x1f600 + index),\n851\t            name:`test-${index}`,\n852\t            keywords:[],\n853\t            category:'people',\n854\t        })\n855\t    )\n856\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n857\t    picker.setAttribute('recent-key', key)\n858\t    picker.emojis = emojis\n859\t    document.body.appendChild(picker)\n860\t\n861\t    for (const emoji of emojis) {\n862\t        picker.open()\n863\t        picker.querySelector<HTMLElement>(\n864\t            '[role=\"tab\"][aria-label=\"People\"]'\n865\t        )?.click()\n866\t        const button = Array.from(\n867\t            picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n868\t        ).find(item => item.textContent === emoji.emoji)\n869\t        button?.click()\n870\t    }\n871\t\n872\t    picker.open()\n873\t    picker.querySelector<HTMLElement>(\n874\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n875\t    )?.click()\n876\t    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n877\t    t.equal(recents.length, 24, 'caps recents at 24 entries')\n878\t    t.equal(\n879\t        recents[0]?.textContent,\n880\t        emojis[24]?.emoji,\n881\t        'most recently selected emoji is first'\n882\t    )\n883\t\n884\t    const duplicate = emojis[10]\n885\t    picker.open()\n886\t    picker.querySelector<HTMLElement>(\n887\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n888\t    )?.click()\n889\t    Array.from(\n890\t        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n891\t    ).find(item => item.textContent === duplicate?.emoji)?.click()\n892\t\n893\t    picker.open()\n894\t    picker.querySelector<HTMLElement>(\n895\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n896\t    )?.click()\n897\t    t.equal(\n898\t        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n899\t        duplicate?.emoji,\n900\t        'duplicate selection moves the emoji to the front'\n901\t    )\n902\t    picker.remove()\n903\t\n904\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n905\t    restored.setAttribute('recent-key', key)\n906\t    restored.emojis = emojis\n907\t    document.body.appendChild(restored)\n908\t    restored.open()\n909\t    restored.querySelector<HTMLElement>(\n910\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n911\t    )?.click()\n912\t    t.equal(\n913\t        restored.querySelectorAll('[role=\"gridcell\"]').length,\n914\t        24,\n915\t        'restores recents from localStorage'\n916\t    )\n917\t    restored.remove()\n918\t    localStorage.removeItem(key)\n919\t})\n920\t\n921\ttest('emoji-picker applies and restores a selected skin tone', t => {\n922\t    const key = 'emoji-picker-test-skin-tone'\n923\t    localStorage.removeItem(key)\n924\t    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n925\t    t.ok(wave, 'has an emoji with skin tone variants')\n926\t    if (!wave) return\n927\t\n928\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n929\t    picker.setAttribute('skin-tone-key', key)\n930\t    picker.emojis = [wave]\n931\t    document.body.appendChild(picker)\n932\t\n933\t    picker.querySelector<HTMLElement>(\n934\t        '[role=\"tab\"][aria-label=\"People\"]'\n935\t    )?.click()\n936\t    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n937\t    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n938\t    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n939\t    const waveButton = picker.querySelector<HTMLButtonElement>(\n940\t        '[role=\"gridcell\"]'\n941\t    )\n942\t    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n943\t\n944\t    let selected = ''\n945\t    picker.addEventListener('emoji-select', (event) => {\n946\t        selected = (event as CustomEvent<EmojiSelectDetail>)\n947\t            .detail.emoji.emoji\n948\t    })\n949\t    waveButton?.click()\n950\t    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n951\t    picker.remove()\n952\t\n953\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n954\t    restored.setAttribute('skin-tone-key', key)\n955\t    restored.emojis = [wave]\n956\t    document.body.appendChild(restored)\n957\t    restored.querySelector<HTMLElement>(\n958\t        '[role=\"tab\"][aria-label=\"People\"]'\n959\t    )?.click()\n960\t    t.equal(\n961\t        restored.querySelector('[role=\"gridcell\"]')?.textContent,\n962\t        '👋🏿',\n963\t        'restores the skin tone from localStorage'\n964\t    )\n965\t    restored.remove()\n966\t    localStorage.removeItem(key)\n967\t})\n968\t\n969\ttest('emoji-picker updates its preview when an emoji is hovered', t => {\n970\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n971\t    picker.emojis = [{\n972\t        emoji:'🧈',\n973\t        name:'butter',\n974\t        keywords:['food'],\n975\t        category:'people',\n976\t    }]\n977\t    document.body.appendChild(picker)\n978\t\n979\t    const button = picker.querySelector<HTMLButtonElement>(\n980\t        '[role=\"gridcell\"]'\n981\t    )\n982\t    const preview = picker.querySelector('[role=\"status\"]')\n983\t    t.ok(preview, 'renders a preview region')\n984\t    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n985\t    t.ok(\n986\t        preview?.textContent?.includes('🧈'),\n987\t        'preview shows the hovered emoji'\n988\t    )\n989\t    t.ok(\n990\t        preview?.textContent?.includes('butter'),\n991\t        'preview shows the hovered emoji name'\n992\t    )\n993\t    picker.remove()\n994\t})\n995\t\n996\ttest('emoji-picker inserts into the field named by for', t => {\n997\t    const field = document.createElement('textarea')\n998\t    field.id = 'emoji-picker-target'\n999\t    field.value = 'hello world'\n1000\t    field.setSelectionRange(6, 6)\n1001\t    document.body.appendChild(field)\n1002\t\n1003\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1004\t    picker.setAttribute('for', field.id)\n1005\t    picker.emojis = [{\n1006\t        emoji:'🧈',\n1007\t        name:'butter',\n1008\t        keywords:['food'],\n1009\t        category:'people',\n1010\t    }]\n1011\t    document.body.appendChild(picker)\n1012\t    picker.open()\n1013\t    picker.querySelector<HTMLButtonElement>('[role=\"gridcell\"]')?.click()\n1014\t\n1015\t    t.equal(\n1016\t        field.value,\n1017\t        'hello 🧈world',\n1018\t        'inserts the selected emoji at the field caret'\n1019\t    )\n1020\t    picker.remove()\n1021\t    field.remove()\n1022\t})\n1023\t\n1024\ttest('element has correct defaults', t => {\n1025\t    const { el } = setup()\n1026\t    t.equal(el.minChars, 2, 'minChars defaults to 2')\n1027\t    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n1028\t    t.ok(el.emojis.length > 0, 'has default emoji data')\n1029\t    el.remove()\n1030\t})\n1031\t\n1032\ttest('auto-attaches to child textarea', t => {\n1033\t    const { el, textarea } = setup()\n1034\t    t.equal(\n1035\t        textarea.getAttribute('aria-autocomplete'),\n1036\t        'list',\n1037\t        'textarea gets aria-autocomplete=list'\n1038\t    )\n1039\t    el.remove()\n1040\t})\n1041\t\n1042\ttest('attaches to child added after connect', async t => {\n1043\t    t.plan(1)\n1044\t    const el = document.createElement(\n1045\t        'emoji-input'\n1046\t    ) as EmojiInput\n1047\t    document.body.appendChild(el)\n1048\t    const textarea = document.createElement('textarea')\n1049\t    el.appendChild(textarea)\n1050\t    await sleep(50)\n1051\t    t.equal(\n1052\t        textarea.getAttribute('aria-autocomplete'),\n1053\t        'list',\n1054\t        'MutationObserver picks up late child'\n1055\t    )\n1056\t    el.remove()\n1057\t})\n1058\t\n1059\ttest('attaches via for attribute', t => {\n1060\t    const textarea = document.createElement('textarea')\n1061\t    textarea.id = 'test-external-field'\n1062\t    document.body.appendChild(textarea)\n1063\t\n1064\t    const el = document.createElement(\n1065\t        'emoji-input'\n1066\t    ) as EmojiInput\n1067\t    el.setAttribute('for', 'test-external-field')\n1068\t    el.emojis = SMALL_SET\n1069\t    document.body.appendChild(el)\n1070\t\n1071\t    t.equal(\n1072\t        textarea.getAttribute('aria-autocomplete'),\n1073\t        'list',\n1074\t        'external field gets aria-autocomplete'\n1075\t    )\n1076\t\n1077\t    simulateInput(textarea, ':pizza')\n1078\t    t.ok(el.isOpen, 'popover opens for external field')\n1079\t\n1080\t    el.remove()\n1081\t    textarea.remove()\n1082\t})\n1083\t\n1084\ttest('works with input element', t => {\n1085\t    const el = document.createElement(\n1086\t        'emoji-input'\n1087\t    ) as EmojiInput\n1088\t    const input = document.createElement('input')\n1089\t    input.type = 'text'\n1090\t    el.appendChild(input)\n1091\t    document.body.appendChild(el)\n1092\t    el.emojis = SMALL_SET\n1093\t\n1094\t    simulateInput(input, ':pizza')\n1095\t    t.ok(el.isOpen, 'popover opens for input element')\n1096\t\n1097\t    keydown(input, 'Enter')\n1098\t    t.ok(\n1099\t        input.value.includes('🍕'),\n1100\t        'emoji inserted into input'\n1101\t    )\n1102\t\n1103\t    el.remove()\n1104\t})\n1105\t\n1106\t// -- Trigger behavior ------------------------------------------\n1107\t\n1108\ttest('popover opens on valid trigger', t => {\n1109\t    const { el, textarea } = setup(SMALL_SET)\n1110\t    simulateInput(textarea, 'hello :sm')\n1111\t    t.ok(el.isOpen, 'opens for :sm after space')\n1112\t    el.remove()\n1113\t})\n1114\t\n1115\ttest('popover opens at start of input', t => {\n1116\t    const { el, textarea } = setup(SMALL_SET)\n1117\t    simulateInput(textarea, ':sm')\n1118\t    t.ok(el.isOpen, 'opens when colon at position 0')\n1119\t    el.remove()\n1120\t})\n1121\t\n1122\ttest('does not open for short query', t => {\n1123\t    const { el, textarea } = setup(SMALL_SET)\n1124\t    simulateInput(textarea, ':s')\n1125\t    t.ok(\n1126\t        !el.isOpen,\n1127\t        'stays closed with 1 char (minChars=2)'\n1128\t    )\n1129\t    el.remove()\n1130\t})\n1131\t\n1132\ttest('does not trigger after word character', t => {\n1133\t    const { el, textarea } = setup(SMALL_SET)\n1134\t    simulateInput(textarea, 'word:sm')\n1135\t    t.ok(\n1136\t        !el.isOpen,\n1137\t        'no trigger when colon follows letter'\n1138\t    )\n1139\t    el.remove()\n1140\t})\n1141\t\n1142\ttest('triggers after opening paren', t => {\n1143\t    const { el, textarea } = setup(SMALL_SET)\n1144\t    simulateInput(textarea, '(:sm')\n1145\t    t.ok(el.isOpen, 'triggers after (')\n1146\t    el.remove()\n1147\t})\n1148\t\n1149\ttest('closes when trigger disappears', t => {\n1150\t    const { el, textarea } = setup(SMALL_SET)\n1151\t    simulateInput(textarea, ':sm')\n1152\t    t.ok(el.isOpen, 'opens first')\n1153\t    simulateInput(textarea, 'no trigger here')\n1154\t    t.ok(!el.isOpen, 'closes when no trigger')\n1155\t    el.remove()\n1156\t})\n1157\t\n1158\ttest('search is case-insensitive', t => {\n1159\t    const { el, textarea } = setup(SMALL_SET)\n1160\t    simulateInput(textarea, ':SM')\n1161\t    t.ok(el.isOpen, 'opens for uppercase query')\n1162\t    const items = listItems(el)\n1163\t    t.ok(items.length >= 1, 'finds results')\n1164\t    el.remove()\n1165\t})\n1166\t\n1167\t// -- Search results --------------------------------------------\n1168\t\n1169\ttest('finds results by name prefix', t => {\n1170\t    const { el, textarea } = setup(SMALL_SET)\n1171\t    simulateInput(textarea, ':sm')\n1172\t    const items = listItems(el)\n1173\t    t.ok(items.length >= 2, 'matches name prefixes')\n1174\t    el.remove()\n1175\t})\n1176\t\n1177\ttest('finds results by name substring', t => {\n1178\t    const { el, textarea } = setup(SMALL_SET)\n1179\t    simulateInput(textarea, ':burger')\n1180\t    const items = listItems(el)\n1181\t    t.ok(items.length >= 1, 'matches name substrings')\n1182\t    el.remove()\n1183\t})\n1184\t\n1185\ttest('finds results by keyword', t => {\n1186\t    const { el, textarea } = setup(SMALL_SET)\n1187\t    simulateInput(textarea, ':lit')\n1188\t    const items = listItems(el)\n1189\t    t.ok(items.length >= 1, 'matches keywords')\n1190\t    el.remove()\n1191\t})\n1192\t\n1193\ttest('respects maxResults', t => {\n1194\t    const { el, textarea } = setup(SMALL_SET)\n1195\t    el.maxResults = 2\n1196\t    simulateInput(textarea, ':sm')\n1197\t    const items = listItems(el)\n1198\t    t.ok(items.length <= 2, 'results capped at maxResults')\n1199\t    el.remove()\n1200\t})\n1201\t\n1202\ttest('shows empty state for no matches', t => {\n1203\t    const { el, textarea } = setup(SMALL_SET)\n1204\t    simulateInput(textarea, ':zzzzzz')\n1205\t    t.ok(\n1206\t        el.isOpen,\n1207\t        'popover opens even with no matches'\n1208\t    )\n1209\t    const items = listItems(el)\n1210\t    t.equal(items.length, 0, 'no result items')\n1211\t    const empty = el.querySelector(\n1212\t        '.emoji-search-empty'\n1213\t    )\n1214\t    t.ok(empty, 'empty state element shown')\n1215\t    el.remove()\n1216\t})\n1217\t\n1218\t// -- Keyboard navigation --------------------------------------\n1219\t\n1220\ttest('first item selected by default', t => {\n1221\t    const { el, textarea } = setup(SMALL_SET)\n1222\t    simulateInput(textarea, ':sm')\n1223\t    const items = listItems(el)\n1224\t    t.equal(\n1225\t        items[0]?.getAttribute('aria-selected'),\n1226\t        'true',\n1227\t        'first item is selected'\n1228\t    )\n1229\t    el.remove()\n1230\t})\n1231\t\n1232\ttest('ArrowDown moves selection forward', t => {\n1233\t    const { el, textarea } = setup(SMALL_SET)\n1234\t    simulateInput(textarea, ':sm')\n1235\t    keydown(textarea, 'ArrowDown')\n1236\t    const items = listItems(el)\n1237\t    t.equal(\n1238\t        items[0]?.getAttribute('aria-selected'),\n1239\t        'false',\n1240\t        'first item deselected'\n1241\t    )\n1242\t    t.equal(\n1243\t        items[1]?.getAttribute('aria-selected'),\n1244\t        'true',\n1245\t        'second item selected'\n1246\t    )\n1247\t    el.remove()\n1248\t})\n1249\t\n1250\ttest('ArrowUp wraps from first to last', t => {\n1251\t    const { el, textarea } = setup(SMALL_SET)\n1252\t    simulateInput(textarea, ':sm')\n1253\t    const items = listItems(el)\n1254\t    const lastIdx = items.length - 1\n1255\t    keydown(textarea, 'ArrowUp')\n1256\t    t.equal(\n1257\t        items[lastIdx]?.getAttribute('aria-selected'),\n1258\t        'true',\n1259\t        'last item selected after wrap'\n1260\t    )\n1261\t    el.remove()\n1262\t})\n1263\t\n1264\ttest('ArrowDown wraps from last to first', t => {\n1265\t    const { el, textarea } = setup(SMALL_SET)\n1266\t    simulateInput(textarea, ':sm')\n1267\t    const items = listItems(el)\n1268\t    const count = items.length\n1269\t    for (let i = 0; i < count; i++) {\n1270\t        keydown(textarea, 'ArrowDown')\n1271\t    }\n1272\t    t.equal(\n1273\t        items[0]?.getAttribute('aria-selected'),\n1274\t        'true',\n1275\t        'wraps back to first'\n1276\t    )\n1277\t    el.remove()\n1278\t})\n1279\t\n1280\ttest('aria-activedescendant tracks selection', t => {\n1281\t    const { el, textarea } = setup(SMALL_SET)\n1282\t    simulateInput(textarea, ':sm')\n1283\t    const first = textarea.getAttribute(\n1284\t        'aria-activedescendant'\n1285\t    )\n1286\t    t.ok(first, 'set when popover opens')\n1287\t    keydown(textarea, 'ArrowDown')\n1288\t    const second = textarea.getAttribute(\n1289\t        'aria-activedescendant'\n1290\t    )\n1291\t    t.notEqual(\n1292\t        first, second,\n1293\t        'changes on navigation'\n1294\t    )\n1295\t    el.remove()\n1296\t})\n1297\t\n1298\t// -- Commit behavior -------------------------------------------\n1299\t\n1300\ttest('Enter commits the selected emoji', t => {\n1301\t    const { el, textarea } = setup(SMALL_SET)\n1302\t    simulateInput(textarea, ':pizza')\n1303\t    keydown(textarea, 'Enter')\n1304\t    t.ok(!el.isOpen, 'popover closes')\n1305\t    t.ok(\n1306\t        textarea.value.includes('🍕'),\n1307\t        'emoji inserted'\n1308\t    )\n1309\t    t.ok(\n1310\t        !textarea.value.includes(':pizza'),\n1311\t        'trigger text replaced'\n1312\t    )\n1313\t    el.remove()\n1314\t})\n1315\t\n1316\ttest('Tab commits the selected emoji', t => {\n1317\t    const { el, textarea } = setup(SMALL_SET)\n1318\t    simulateInput(textarea, ':pizza')\n1319\t    keydown(textarea, 'Tab')\n1320\t    t.ok(!el.isOpen, 'popover closes')\n1321\t    t.ok(\n1322\t        textarea.value.includes('🍕'),\n1323\t        'emoji inserted via Tab'\n1324\t    )\n1325\t    el.remove()\n1326\t})\n1327\t\n1328\ttest('Escape closes without inserting', t => {\n1329\t    const { el, textarea } = setup(SMALL_SET)\n1330\t    simulateInput(textarea, ':pizza')\n1331\t    t.ok(el.isOpen, 'popover open')\n1332\t    keydown(textarea, 'Escape')\n1333\t    t.ok(!el.isOpen, 'popover closes')\n1334\t    t.ok(\n1335\t        textarea.value.includes(':pizza'),\n1336\t        'original text preserved'\n1337\t    )\n1338\t    el.remove()\n1339\t})\n1340\t\n1341\ttest('committed emoji has trailing space', t => {\n1342\t    const { el, textarea } = setup(SMALL_SET)\n1343\t    simulateInput(textarea, ':pizza')\n1344\t    keydown(textarea, 'Enter')\n1345\t    t.ok(\n1346\t        textarea.value.endsWith(' '),\n1347\t        'space after emoji'\n1348\t    )\n1349\t    el.remove()\n1350\t})\n1351\t\n1352\ttest('preserves text before trigger', t => {\n1353\t    const { el, textarea } = setup(SMALL_SET)\n1354\t    simulateInput(textarea, 'hello :pizza')\n1355\t    keydown(textarea, 'Enter')\n1356\t    t.ok(\n1357\t        textarea.value.startsWith('hello '),\n1358\t        'preceding text kept'\n1359\t    )\n1360\t    t.ok(\n1361\t        textarea.value.includes('🍕'),\n1362\t        'emoji inserted after prefix'\n1363\t    )\n1364\t    el.remove()\n1365\t})\n1366\t\n1367\ttest('navigated commit inserts correct emoji', t => {\n1368\t    const { el, textarea } = setup(SMALL_SET)\n1369\t    simulateInput(textarea, ':sm')\n1370\t    keydown(textarea, 'ArrowDown')\n1371\t    keydown(textarea, 'Enter')\n1372\t    t.ok(\n1373\t        textarea.value.includes('😄'),\n1374\t        'second result emoji inserted'\n1375\t    )\n1376\t    el.remove()\n1377\t})\n1378\t\n1379\ttest('click on item commits emoji', t => {\n1380\t    const { el, textarea } = setup(SMALL_SET)\n1381\t    simulateInput(textarea, ':pizza')\n1382\t    const items = listItems(el)\n1383\t    t.ok(items.length > 0, 'has items to click')\n1384\t    items[0]?.click()\n1385\t    t.ok(!el.isOpen, 'closes after click')\n1386\t    t.ok(\n1387\t        textarea.value.includes('🍕'),\n1388\t        'emoji inserted on click'\n1389\t    )\n1390\t    el.remove()\n1391\t})\n1392\t\n1393\t// -- Events ----------------------------------------------------\n1394\t\n1395\ttest('emoji-select event fires on commit', async t => {\n1396\t    t.plan(3)\n1397\t    const { el, textarea } = setup(SMALL_SET)\n1398\t\n1399\t    el.addEventListener('emoji-select', ((\n1400\t        ev:CustomEvent<EmojiSelectDetail>\n1401\t    ) => {\n1402\t        t.ok(ev.detail.emoji, 'has emoji detail')\n1403\t        t.equal(\n1404\t            ev.detail.emoji.name, 'pizza',\n1405\t            'correct emoji name'\n1406\t        )\n1407\t        t.equal(\n1408\t            ev.detail.query, 'pizza',\n1409\t            'correct query string'\n1410\t        )\n1411\t    }) as EventListener)\n1412\t\n1413\t    simulateInput(textarea, ':pizza')\n1414\t    keydown(textarea, 'Enter')\n1415\t    el.remove()\n1416\t})\n1417\t\n1418\ttest('emoji-select event bubbles', async t => {\n1419\t    t.plan(1)\n1420\t    const { el, textarea } = setup(SMALL_SET)\n1421\t\n1422\t    document.body.addEventListener(\n1423\t        'emoji-select',\n1424\t        function handler () {\n1425\t            t.ok(true, 'event bubbles to body')\n1426\t            document.body.removeEventListener(\n1427\t                'emoji-select', handler\n1428\t            )\n1429\t        }\n1430\t    )\n1431\t\n1432\t    simulateInput(textarea, ':pizza')\n1433\t    keydown(textarea, 'Enter')\n1434\t    el.remove()\n1435\t})\n1436\t\n1437\t// -- Configuration ---------------------------------------------\n1438\t\n1439\ttest('minChars can be lowered', t => {\n1440\t    const { el, textarea } = setup(SMALL_SET)\n1441\t    el.minChars = 1\n1442\t    simulateInput(textarea, ':s')\n1443\t    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n1444\t    el.remove()\n1445\t})\n1446\t\n1447\ttest('custom emoji data', t => {\n1448\t    const custom:EmojiEntry[] = [\n1449\t        {\n1450\t            emoji:'🧪',\n1451\t            name:'test_tube',\n1452\t            keywords:['science'],\n1453\t        },\n1454\t    ]\n1455\t    const { el, textarea } = setup(custom)\n1456\t    simulateInput(textarea, ':test')\n1457\t    const items = listItems(el)\n1458\t    t.equal(items.length, 1, 'finds custom emoji')\n1459\t    keydown(textarea, 'Enter')\n1460\t    t.ok(\n1461\t        textarea.value.includes('🧪'),\n1462\t        'custom emoji inserted'\n1463\t    )\n1464\t    el.remove()\n1465\t})\n1466\t\n1467\t// -- Lifecycle -------------------------------------------------\n1468\t\n1469\ttest('detach prevents further triggers', t => {\n1470\t    const { el, textarea } = setup(SMALL_SET)\n1471\t    el.detach()\n1472\t    simulateInput(textarea, ':pizza')\n1473\t    t.ok(!el.isOpen, 'no popover after detach')\n1474\t    el.remove()\n1475\t})\n1476\t\n1477\ttest('re-attach after detach', t => {\n1478\t    const { el, textarea } = setup(SMALL_SET)\n1479\t    el.detach()\n1480\t    el.attach(textarea)\n1481\t    simulateInput(textarea, ':pizza')\n1482\t    t.ok(el.isOpen, 'works after re-attach')\n1483\t    el.remove()\n1484\t})\n1485\t\n1486\ttest('popover re-opens after close', t => {\n1487\t    const { el, textarea } = setup(SMALL_SET)\n1488\t    simulateInput(textarea, ':pizza')\n1489\t    t.ok(el.isOpen, 'opens first time')\n1490\t    keydown(textarea, 'Escape')\n1491\t    t.ok(!el.isOpen, 'closes on Escape')\n1492\t    simulateInput(textarea, ':cat')\n1493\t    t.ok(el.isOpen, 'opens again with new query')\n1494\t    el.remove()\n1495\t})\n1496\t\n1497\ttest('aria-controls set and cleared', t => {\n1498\t    const { el, textarea } = setup(SMALL_SET)\n1499\t    simulateInput(textarea, ':sm')\n1500\t    t.ok(\n1501\t        textarea.hasAttribute('aria-controls'),\n1502\t        'set when open'\n1503\t    )\n1504\t    keydown(textarea, 'Escape')\n1505\t    t.ok(\n1506\t        !textarea.hasAttribute('aria-controls'),\n1507\t        'removed on close'\n1508\t    )\n1509\t    el.remove()\n1510\t})\n1511\t\n1512\ttest('disconnectedCallback cleans up', t => {\n1513\t    const { el, textarea } = setup(SMALL_SET)\n1514\t    simulateInput(textarea, ':pizza')\n1515\t    t.ok(el.isOpen, 'opens while connected')\n1516\t    el.remove()\n1517\t    simulateInput(textarea, ':cat')\n1518\t    t.ok(!el.isOpen, 'no trigger after disconnect')\n1519\t})\n1520\t\n1521\tfunction setup (emojis?:EmojiEntry[]):{\n1522\t    el:EmojiInput;\n1523\t    textarea:HTMLTextAreaElement;\n1524\t} {\n1525\t    const el = document.createElement('emoji-input') as EmojiInput\n1526\t    const textarea = document.createElement('textarea')\n1527\t    el.appendChild(textarea)\n1528\t    document.body.appendChild(el)\n1529\t    if (emojis) el.emojis = emojis\n1530\t    return { el, textarea }\n1531\t}\n1532\t\n1533\tfunction simulateInput (\n1534\t    field:HTMLTextAreaElement|HTMLInputElement,\n1535\t    value:string,\n1536\t):void {\n1537\t    field.value = value\n1538\t    field.selectionStart = value.length\n1539\t    field.selectionEnd = value.length\n1540\t    field.dispatchEvent(\n1541\t        new InputEvent('input', { bubbles:true })\n1542\t    )\n1543\t}\n1544\t\n1545\tfunction keydown (field:HTMLElement, key:string):void {\n1546\t    field.dispatchEvent(new KeyboardEvent('keydown', {\n1547\t        key,\n1548\t        bubbles:true,\n1549\t        cancelable:true,\n1550\t    }))\n1551\t}\n1552\t\n1553\tfunction listItems (\n1554\t    el:EmojiInput,\n1555\t):NodeListOf<HTMLElement> {\n1556\t    return el.querySelectorAll(\n1557\t        '.emoji-search-item'\n1558\t    )\n1559\t}\n1560\t"}]},"parent_tool_use_id":null,"session_id":"93aea7ef-73f5-4eca-91f2-b7af54f52bc5","uuid":"c4391af0-bc66-442d-9821-57e51402a330","timestamp":"2026-09-23T18:46:52.239Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-06-aria-grid-with-roving-tabindex/test/index.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { sleep } from '@substrate-system/dom'\nimport {\n    EmojiInput,\n    EmojiButton as MainEmojiButton,\n    EmojiPicker as MainEmojiPicker,\n    DEFAULT_EMOJIS,\n    type EmojiEntry,\n    type EmojiSelectDetail,\n} from '../src/index.js'\nimport { EmojiPicker } from '../src/picker.js'\nimport { EmojiButton } from '../src/button.js'\nimport { search } from '../src/search.js'\nimport packageJson from '../package.json'\nimport buttonCss from '../src/button.css'\nimport pickerCss from '../src/picker.css'\n\nconst _style = document.createElement('style')\n_style.textContent = [buttonCss, pickerCss].join('\\n')\ndocument.head.appendChild(_style)\n\n// -- Helpers ---------------------------------------------------\n\nconst SMALL_SET:EmojiEntry[] = [\n    {\n        emoji:'😀',\n        name:'grinning',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😃',\n        name:'smiley',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😄',\n        name:'smile',\n        keywords:['happy', 'laugh'],\n    },\n    {\n        emoji:'🍕',\n        name:'pizza',\n        keywords:['food'],\n    },\n    {\n        emoji:'🍔',\n        name:'hamburger',\n        keywords:['burger', 'food'],\n    },\n    {\n        emoji:'🔥',\n        name:'fire',\n        keywords:['lit', 'hot'],\n    },\n    {\n        emoji:'🐱',\n        name:'cat',\n        keywords:['kitty'],\n    },\n    {\n        emoji:'🐶',\n        name:'dog',\n        keywords:['puppy'],\n    },\n]\n\n// -- Static render (Node-compatible) ---------------------------\n\ntest('static render returns an HTML string', t => {\n    const html = EmojiInput.render('test-uid')\n    t.equal(typeof html, 'string', 'returns a string')\n    t.ok(\n        html.includes('emoji-search-list'),\n        'contains the list class'\n    )\n    t.ok(\n        html.includes('role=\"listbox\"'),\n        'has listbox role'\n    )\n    t.ok(\n        html.includes('aria-label=\"Emoji suggestions\"'),\n        'listbox has an accessible label'\n    )\n    t.ok(\n        html.includes('id=\"test-uid-list\"'),\n        'uses the uid for the element id'\n    )\n    t.ok(\n        html.includes('popover=\"manual\"'),\n        'has popover attribute'\n    )\n})\n\n// -- Data structure --------------------------------------------\n\ntest('DEFAULT_EMOJIS has expected structure', t => {\n    t.ok(\n        DEFAULT_EMOJIS.length >= 1800,\n        'contains the complete emoji-mart set'\n    )\n\n    const first = DEFAULT_EMOJIS[0]\n    t.equal(\n        typeof first.emoji, 'string',\n        'emoji field is a string'\n    )\n    t.equal(\n        typeof first.name, 'string',\n        'name field is a string'\n    )\n    t.ok(\n        Array.isArray(first.keywords),\n        'keywords is an array'\n    )\n})\n\ntest('DEFAULT_EMOJIS includes category and skin data', t => {\n    const butter = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'butter'\n    )\n\n    t.ok(butter, 'includes butter')\n    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n    t.ok(butter?.category, 'includes a category')\n    t.ok(Array.isArray(butter?.categories), 'includes categories')\n\n    const wave = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'wave'\n    )\n    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n})\n\ntest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n    const invalid = DEFAULT_EMOJIS.filter(\n        e => !e.emoji || !e.name\n    )\n    t.equal(\n        invalid.length, 0,\n        'no entries missing emoji or name'\n    )\n})\n\ntest('shared search ranks name prefixes before substrings', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'pineapple', keywords:[] },\n        { emoji:'2', name:'apple', keywords:[] },\n        { emoji:'3', name:'grape', keywords:[] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['apple', 'pineapple']),\n        'prefix matches rank before substring matches'\n    )\n})\n\ntest('shared search ranks keyword prefixes after name matches', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'grape', keywords:['apple'] },\n        { emoji:'2', name:'pineapple', keywords:[] },\n        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['pineapple', 'grape', 'fruit']),\n        'keyword prefix matches rank after name matches'\n    )\n})\n\n// -- Registration and setup ------------------------------------\n\ntest('custom element is registered', t => {\n    const ctor = customElements.get('emoji-input')\n    t.ok(ctor, 'emoji-input tag is defined')\n    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n})\n\ntest('emoji-picker custom element is registered', t => {\n    const ctor = customElements.get('emoji-picker')\n    t.ok(ctor, 'emoji-picker tag is defined')\n    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    t.ok(picker.emojis.length > 0, 'has default emoji data')\n    t.ok(!picker.isOpen, 'starts closed')\n    picker.remove()\n})\n\ntest('emoji-button custom element renders an accessible smiley button', t => {\n    const ctor = customElements.get('emoji-button')\n    t.ok(ctor, 'emoji-button tag is defined')\n    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n    const inner = button.querySelector('button')\n    t.ok(inner, 'renders a native button')\n    t.equal(inner?.type, 'button', 'button does not submit forms')\n    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n    t.ok(\n        inner?.querySelector('.visually-hidden'),\n        'has a visually-hidden label'\n    )\n    button.remove()\n})\n\ntest('emoji-button uses currentColor', t => {\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n\n    const svg = button.querySelector('svg')\n    t.equal(\n        svg?.getAttribute('fill'),\n        'currentColor',\n        'the SVG inherits its fill from currentColor'\n    )\n    button.remove()\n})\n\ntest('emoji-button opens the picker named by for', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'button-picker-target'\n    let opens = 0\n    picker.open = () => { opens++ }\n\n    const button = document.createElement('emoji-button')\n    button.setAttribute('for', picker.id)\n    document.body.append(picker, button)\n    button.querySelector('button')?.click()\n\n    t.equal(opens, 1, 'click calls the referenced picker open method')\n    button.remove()\n    picker.remove()\n})\n\ntest('emoji-button positions the picker below itself', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'position-test-picker'\n    picker.setAttribute('for', 'position-target')\n\n    const wrapper = document.createElement('div')\n    wrapper.style.position = 'relative'\n    wrapper.style.marginTop = '120px'\n    wrapper.style.marginLeft = '200px'\n\n    const button = document.createElement('emoji-button') as EmojiButton\n    button.setAttribute('for', picker.id)\n\n    wrapper.append(button, picker)\n    document.body.append(wrapper)\n\n    button.querySelector('button')?.click()\n    t.ok(picker.isOpen, 'picker opens')\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const panel = picker.querySelector(\n        '.emoji-picker-panel'\n    ) as HTMLElement\n    const btnRect = button.getBoundingClientRect()\n    const panelRect = panel.getBoundingClientRect()\n\n    t.ok(\n        panelRect.top >= btnRect.bottom - 1,\n        'picker top is at or below the button bottom'\n    )\n    t.ok(\n        Math.abs(panelRect.left - btnRect.left) < 2,\n        'picker left aligns with the button left'\n    )\n\n    picker.close()\n    picker.remove()\n    wrapper.remove()\n})\n\ntest('button subpath exports only EmojiButton', t => {\n    const buttonExports = packageJson.exports['./button'] as {\n        import:string;\n        require:string;\n    }|undefined\n    t.ok(buttonExports, 'button subpath is declared')\n    t.equal(\n        buttonExports?.import,\n        './dist/button.js',\n        'button import subpath points to the ESM build'\n    )\n    t.equal(\n        buttonExports?.require,\n        './dist/button.cjs',\n        'button require subpath points to the CommonJS build'\n    )\n})\n\ntest('main entrypoint exports all component classes', t => {\n    t.equal(\n        MainEmojiPicker,\n        EmojiPicker,\n        'main entrypoint exports EmojiPicker'\n    )\n    t.equal(\n        MainEmojiButton,\n        EmojiButton,\n        'main entrypoint exports EmojiButton'\n    )\n    t.equal(\n        EmojiInput,\n        customElements.get('emoji-input'),\n        'main entrypoint exports EmojiInput'\n    )\n})\n\ntest('emoji-picker defaults to the recently used tab', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const recentsTab = tabs[0]\n    t.equal(\n        recentsTab?.getAttribute('aria-selected'),\n        'true',\n        'recently used tab is selected by default'\n    )\n    const peopleTab = tabs[1]\n    t.equal(\n        peopleTab?.getAttribute('aria-selected'),\n        'false',\n        'people tab is not selected by default'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker renders category tabs and an eight-column grid', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n    t.equal(\n        tabs[0]?.getAttribute('aria-label'),\n        'Recently used',\n        'recents is the first tab'\n    )\n    t.equal(\n        tabs[1]?.getAttribute('aria-label'),\n        'People',\n        'people is the first emoji category'\n    )\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid, 'renders an emoji grid')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        grid?.textContent?.includes('🐒'),\n        'category tab filters the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stays open when switching categories', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'picker is open before tab click')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        picker.isOpen,\n        'picker stays open after clicking a category tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid exists when open', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n    t.ok(grid, 'grid exists')\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid has an accessible label', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.equal(\n        grid?.getAttribute('aria-label'),\n        'Emoji',\n        'grid has aria-label'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker search controls the grid', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(\n        search?.getAttribute('aria-controls'),\n        'search has aria-controls'\n    )\n    t.equal(\n        search?.getAttribute('aria-controls'),\n        grid?.id,\n        'search aria-controls references the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker moves focus to search on open', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'search input is focused after open'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker returns focus to trigger on close', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.appendChild(trigger)\n    trigger.focus()\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open(trigger)\n    picker.close()\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returns to the trigger element'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('emoji-picker tabs use roving tabindex', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const selected = tabs[0]\n    const notSelected = tabs[1]\n    t.equal(\n        selected?.getAttribute('tabindex'),\n        '0',\n        'selected tab has tabindex 0'\n    )\n    t.equal(\n        notSelected?.getAttribute('tabindex'),\n        '-1',\n        'non-selected tab has tabindex -1'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker tabs navigate with arrow keys', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const firstTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"]'\n    )\n    firstTab?.focus()\n    keydown(firstTab!, 'ArrowRight')\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(\n        tabs[1]?.getAttribute('aria-selected'),\n        'true',\n        'ArrowRight activates the next tab'\n    )\n    t.equal(\n        document.activeElement,\n        tabs[1],\n        'ArrowRight moves focus to the next tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker search filters visible emoji', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    t.ok(input, 'renders a search input')\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n    t.ok(\n        !grid?.textContent?.includes('😀'),\n        'hides emoji that do not match the query'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker emits emoji-select and closes after selection', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const details:Array<EmojiSelectDetail> = []\n    picker.addEventListener('emoji-select', (event) => {\n        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n    })\n    const emoji = Array.from(\n        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n    ).find(button => button.textContent === '🧈')\n    emoji?.click()\n\n    const detail = details[0]\n    t.ok(detail, 'emits selection detail')\n    if (detail) {\n        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n        t.equal(detail.query, 'butter', 'emits the current search query')\n    }\n    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n    picker.remove()\n})\n\ntest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    const first = buttons[0]\n    first?.focus()\n    if (first) keydown(first, 'ArrowRight')\n    t.equal(\n        document.activeElement,\n        buttons[1],\n        'ArrowRight moves to the next emoji'\n    )\n    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n    t.equal(\n        document.activeElement,\n        buttons[9],\n        'ArrowDown moves by one grid row'\n    )\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n    if (buttons[9]) keydown(buttons[9], 'Enter')\n    t.ok(selected, 'Enter selects the focused emoji')\n    t.ok(!picker.isOpen, 'Enter closes the picker')\n\n    picker.open()\n    keydown(picker, 'Escape')\n    t.ok(!picker.isOpen, 'Escape closes the picker')\n    picker.remove()\n})\n\ntest('Enter on a category tab activates it without emoji-select', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n\n    const peopleTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )\n    peopleTab?.focus()\n    t.equal(\n        document.activeElement,\n        peopleTab,\n        'focus is on the People tab'\n    )\n    if (peopleTab) {\n        keydown(peopleTab, 'Enter')\n        peopleTab.click()\n    }\n\n    t.ok(!selected, 'Enter on tab does not emit emoji-select')\n    const updatedPeopleTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )\n    t.equal(\n        updatedPeopleTab?.getAttribute('aria-selected'),\n        'true',\n        'People tab is now selected'\n    )\n    t.ok(picker.isOpen, 'picker stays open')\n    picker.close()\n    picker.remove()\n})\n\ntest('Enter on a skin tone radio checks it without emoji-select', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n\n    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n    t.ok(radios.length >= 2, 'has skin tone radios')\n    const second = radios[1]\n    second?.focus()\n    if (second) {\n        keydown(second, 'Enter')\n        second.click()\n    }\n\n    t.ok(!selected, 'Enter on radio does not emit emoji-select')\n    const updatedRadios = picker.querySelectorAll<HTMLElement>(\n        '[role=\"radio\"]'\n    )\n    t.equal(\n        updatedRadios[1]?.getAttribute('aria-checked'),\n        'true',\n        'radio is now checked'\n    )\n    t.ok(picker.isOpen, 'picker stays open')\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowLeft in search box stays in search box', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'search is focused after open'\n    )\n    if (search) keydown(search, 'ArrowLeft')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowLeft'\n    )\n    if (search) keydown(search, 'ArrowRight')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowRight'\n    )\n    if (search) keydown(search, 'ArrowUp')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowUp'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowDown in search box moves focus into grid', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    search?.focus()\n    if (search) keydown(search, 'ArrowDown')\n\n    const firstCell = picker.querySelector<HTMLElement>(\n        '[role=\"gridcell\"]'\n    )\n    t.equal(\n        document.activeElement,\n        firstCell,\n        'focus moves to the first gridcell'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('Enter in search with query selects first visible emoji', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const details:Array<EmojiSelectDetail> = []\n    picker.addEventListener('emoji-select', (event) => {\n        details.push(\n            (event as CustomEvent<EmojiSelectDetail>).detail\n        )\n    })\n\n    if (input) keydown(input, 'Enter')\n\n    t.equal(details.length, 1, 'emits emoji-select')\n    t.ok(\n        details[0]?.emoji.name.startsWith('butter'),\n        'selects the first visible emoji matching the query'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowRight on tone radio moves and checks next radio', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n    t.ok(radios.length >= 3, 'has at least 3 radios')\n    radios[0]?.focus()\n    t.equal(\n        document.activeElement,\n        radios[0],\n        'first radio is focused'\n    )\n\n    if (radios[0]) keydown(radios[0], 'ArrowRight')\n\n    const updated = picker.querySelectorAll<HTMLElement>(\n        '[role=\"radio\"]'\n    )\n    t.equal(\n        document.activeElement,\n        updated[1],\n        'focus moved to second radio'\n    )\n    t.equal(\n        updated[1]?.getAttribute('aria-checked'),\n        'true',\n        'second radio is now checked'\n    )\n    t.equal(\n        updated[0]?.getAttribute('aria-checked'),\n        'false',\n        'first radio is unchecked'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker closes when a popover click lands outside', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'opens through the public open method')\n\n    document.body.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n    t.ok(!picker.isOpen, 'outside click closes the popover')\n    picker.remove()\n})\n\ntest('emoji-picker inline mode stays in document flow', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('inline', '')\n    document.body.appendChild(picker)\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    const panel = grid?.parentElement\n    t.ok(grid, 'inline mode still renders the picker grid')\n    t.ok(panel && !panel.hasAttribute('popover'),\n        'inline mode removes popover behavior')\n    t.equal(\n        getComputedStyle(panel as Element).position,\n        'static',\n        'inline mode uses in-flow positioning'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stores and restores capped recently used emoji', t => {\n    const key = 'emoji-picker-test-recents'\n    localStorage.removeItem(key)\n    const emojis:Array<EmojiEntry> = Array.from(\n        { length:25 },\n        (_, index) => ({\n            emoji:String.fromCodePoint(0x1f600 + index),\n            name:`test-${index}`,\n            keywords:[],\n            category:'people',\n        })\n    )\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('recent-key', key)\n    picker.emojis = emojis\n    document.body.appendChild(picker)\n\n    for (const emoji of emojis) {\n        picker.open()\n        picker.querySelector<HTMLElement>(\n            '[role=\"tab\"][aria-label=\"People\"]'\n        )?.click()\n        const button = Array.from(\n            picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n        ).find(item => item.textContent === emoji.emoji)\n        button?.click()\n    }\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n    t.equal(recents.length, 24, 'caps recents at 24 entries')\n    t.equal(\n        recents[0]?.textContent,\n        emojis[24]?.emoji,\n        'most recently selected emoji is first'\n    )\n\n    const duplicate = emojis[10]\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    Array.from(\n        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n    ).find(item => item.textContent === duplicate?.emoji)?.click()\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n        duplicate?.emoji,\n        'duplicate selection moves the emoji to the front'\n    )\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('recent-key', key)\n    restored.emojis = emojis\n    document.body.appendChild(restored)\n    restored.open()\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        restored.querySelectorAll('[role=\"gridcell\"]').length,\n        24,\n        'restores recents from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('emoji-picker applies and restores a selected skin tone', t => {\n    const key = 'emoji-picker-test-skin-tone'\n    localStorage.removeItem(key)\n    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n    t.ok(wave, 'has an emoji with skin tone variants')\n    if (!wave) return\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('skin-tone-key', key)\n    picker.emojis = [wave]\n    document.body.appendChild(picker)\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n    const waveButton = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n\n    let selected = ''\n    picker.addEventListener('emoji-select', (event) => {\n        selected = (event as CustomEvent<EmojiSelectDetail>)\n            .detail.emoji.emoji\n    })\n    waveButton?.click()\n    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('skin-tone-key', key)\n    restored.emojis = [wave]\n    document.body.appendChild(restored)\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    t.equal(\n        restored.querySelector('[role=\"gridcell\"]')?.textContent,\n        '👋🏿',\n        'restores the skin tone from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('emoji-picker updates its preview when an emoji is hovered', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n\n    const button = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    const preview = picker.querySelector('[role=\"status\"]')\n    t.ok(preview, 'renders a preview region')\n    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n    t.ok(\n        preview?.textContent?.includes('🧈'),\n        'preview shows the hovered emoji'\n    )\n    t.ok(\n        preview?.textContent?.includes('butter'),\n        'preview shows the hovered emoji name'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker inserts into the field named by for', t => {\n    const field = document.createElement('textarea')\n    field.id = 'emoji-picker-target'\n    field.value = 'hello world'\n    field.setSelectionRange(6, 6)\n    document.body.appendChild(field)\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('for', field.id)\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLButtonElement>('[role=\"gridcell\"]')?.click()\n\n    t.equal(\n        field.value,\n        'hello 🧈world',\n        'inserts the selected emoji at the field caret'\n    )\n    picker.remove()\n    field.remove()\n})\n\ntest('element has correct defaults', t => {\n    const { el } = setup()\n    t.equal(el.minChars, 2, 'minChars defaults to 2')\n    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n    t.ok(el.emojis.length > 0, 'has default emoji data')\n    el.remove()\n})\n\ntest('auto-attaches to child textarea', t => {\n    const { el, textarea } = setup()\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'textarea gets aria-autocomplete=list'\n    )\n    el.remove()\n})\n\ntest('attaches to child added after connect', async t => {\n    t.plan(1)\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    document.body.appendChild(el)\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    await sleep(50)\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'MutationObserver picks up late child'\n    )\n    el.remove()\n})\n\ntest('attaches via for attribute', t => {\n    const textarea = document.createElement('textarea')\n    textarea.id = 'test-external-field'\n    document.body.appendChild(textarea)\n\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    el.setAttribute('for', 'test-external-field')\n    el.emojis = SMALL_SET\n    document.body.appendChild(el)\n\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'external field gets aria-autocomplete'\n    )\n\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover opens for external field')\n\n    el.remove()\n    textarea.remove()\n})\n\ntest('works with input element', t => {\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    const input = document.createElement('input')\n    input.type = 'text'\n    el.appendChild(input)\n    document.body.appendChild(el)\n    el.emojis = SMALL_SET\n\n    simulateInput(input, ':pizza')\n    t.ok(el.isOpen, 'popover opens for input element')\n\n    keydown(input, 'Enter')\n    t.ok(\n        input.value.includes('🍕'),\n        'emoji inserted into input'\n    )\n\n    el.remove()\n})\n\n// -- Trigger behavior ------------------------------------------\n\ntest('popover opens on valid trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :sm')\n    t.ok(el.isOpen, 'opens for :sm after space')\n    el.remove()\n})\n\ntest('popover opens at start of input', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens when colon at position 0')\n    el.remove()\n})\n\ntest('does not open for short query', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':s')\n    t.ok(\n        !el.isOpen,\n        'stays closed with 1 char (minChars=2)'\n    )\n    el.remove()\n})\n\ntest('does not trigger after word character', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'word:sm')\n    t.ok(\n        !el.isOpen,\n        'no trigger when colon follows letter'\n    )\n    el.remove()\n})\n\ntest('triggers after opening paren', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, '(:sm')\n    t.ok(el.isOpen, 'triggers after (')\n    el.remove()\n})\n\ntest('closes when trigger disappears', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens first')\n    simulateInput(textarea, 'no trigger here')\n    t.ok(!el.isOpen, 'closes when no trigger')\n    el.remove()\n})\n\ntest('search is case-insensitive', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':SM')\n    t.ok(el.isOpen, 'opens for uppercase query')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'finds results')\n    el.remove()\n})\n\n// -- Search results --------------------------------------------\n\ntest('finds results by name prefix', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length >= 2, 'matches name prefixes')\n    el.remove()\n})\n\ntest('finds results by name substring', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':burger')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches name substrings')\n    el.remove()\n})\n\ntest('finds results by keyword', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':lit')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches keywords')\n    el.remove()\n})\n\ntest('respects maxResults', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.maxResults = 2\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length <= 2, 'results capped at maxResults')\n    el.remove()\n})\n\ntest('shows empty state for no matches', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':zzzzzz')\n    t.ok(\n        el.isOpen,\n        'popover opens even with no matches'\n    )\n    const items = listItems(el)\n    t.equal(items.length, 0, 'no result items')\n    const empty = el.querySelector(\n        '.emoji-search-empty'\n    )\n    t.ok(empty, 'empty state element shown')\n    el.remove()\n})\n\n// -- Keyboard navigation --------------------------------------\n\ntest('first item selected by default', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'first item is selected'\n    )\n    el.remove()\n})\n\ntest('ArrowDown moves selection forward', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'false',\n        'first item deselected'\n    )\n    t.equal(\n        items[1]?.getAttribute('aria-selected'),\n        'true',\n        'second item selected'\n    )\n    el.remove()\n})\n\ntest('ArrowUp wraps from first to last', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const lastIdx = items.length - 1\n    keydown(textarea, 'ArrowUp')\n    t.equal(\n        items[lastIdx]?.getAttribute('aria-selected'),\n        'true',\n        'last item selected after wrap'\n    )\n    el.remove()\n})\n\ntest('ArrowDown wraps from last to first', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const count = items.length\n    for (let i = 0; i < count; i++) {\n        keydown(textarea, 'ArrowDown')\n    }\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'wraps back to first'\n    )\n    el.remove()\n})\n\ntest('aria-activedescendant tracks selection', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const first = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.ok(first, 'set when popover opens')\n    keydown(textarea, 'ArrowDown')\n    const second = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.notEqual(\n        first, second,\n        'changes on navigation'\n    )\n    el.remove()\n})\n\n// -- Commit behavior -------------------------------------------\n\ntest('Enter commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted'\n    )\n    t.ok(\n        !textarea.value.includes(':pizza'),\n        'trigger text replaced'\n    )\n    el.remove()\n})\n\ntest('Tab commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Tab')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted via Tab'\n    )\n    el.remove()\n})\n\ntest('Escape closes without inserting', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover open')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes(':pizza'),\n        'original text preserved'\n    )\n    el.remove()\n})\n\ntest('committed emoji has trailing space', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.endsWith(' '),\n        'space after emoji'\n    )\n    el.remove()\n})\n\ntest('preserves text before trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.startsWith('hello '),\n        'preceding text kept'\n    )\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted after prefix'\n    )\n    el.remove()\n})\n\ntest('navigated commit inserts correct emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('😄'),\n        'second result emoji inserted'\n    )\n    el.remove()\n})\n\ntest('click on item commits emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    const items = listItems(el)\n    t.ok(items.length > 0, 'has items to click')\n    items[0]?.click()\n    t.ok(!el.isOpen, 'closes after click')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted on click'\n    )\n    el.remove()\n})\n\n// -- Events ----------------------------------------------------\n\ntest('emoji-select event fires on commit', async t => {\n    t.plan(3)\n    const { el, textarea } = setup(SMALL_SET)\n\n    el.addEventListener('emoji-select', ((\n        ev:CustomEvent<EmojiSelectDetail>\n    ) => {\n        t.ok(ev.detail.emoji, 'has emoji detail')\n        t.equal(\n            ev.detail.emoji.name, 'pizza',\n            'correct emoji name'\n        )\n        t.equal(\n            ev.detail.query, 'pizza',\n            'correct query string'\n        )\n    }) as EventListener)\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\ntest('emoji-select event bubbles', async t => {\n    t.plan(1)\n    const { el, textarea } = setup(SMALL_SET)\n\n    document.body.addEventListener(\n        'emoji-select',\n        function handler () {\n            t.ok(true, 'event bubbles to body')\n            document.body.removeEventListener(\n                'emoji-select', handler\n            )\n        }\n    )\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\n// -- Configuration ---------------------------------------------\n\ntest('minChars can be lowered', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.minChars = 1\n    simulateInput(textarea, ':s')\n    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n    el.remove()\n})\n\ntest('custom emoji data', t => {\n    const custom:EmojiEntry[] = [\n        {\n            emoji:'🧪',\n            name:'test_tube',\n            keywords:['science'],\n        },\n    ]\n    const { el, textarea } = setup(custom)\n    simulateInput(textarea, ':test')\n    const items = listItems(el)\n    t.equal(items.length, 1, 'finds custom emoji')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('🧪'),\n        'custom emoji inserted'\n    )\n    el.remove()\n})\n\n// -- Lifecycle -------------------------------------------------\n\ntest('detach prevents further triggers', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    simulateInput(textarea, ':pizza')\n    t.ok(!el.isOpen, 'no popover after detach')\n    el.remove()\n})\n\ntest('re-attach after detach', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    el.attach(textarea)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'works after re-attach')\n    el.remove()\n})\n\ntest('popover re-opens after close', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens first time')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'closes on Escape')\n    simulateInput(textarea, ':cat')\n    t.ok(el.isOpen, 'opens again with new query')\n    el.remove()\n})\n\ntest('aria-controls set and cleared', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(\n        textarea.hasAttribute('aria-controls'),\n        'set when open'\n    )\n    keydown(textarea, 'Escape')\n    t.ok(\n        !textarea.hasAttribute('aria-controls'),\n        'removed on close'\n    )\n    el.remove()\n})\n\ntest('disconnectedCallback cleans up', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens while connected')\n    el.remove()\n    simulateInput(textarea, ':cat')\n    t.ok(!el.isOpen, 'no trigger after disconnect')\n})\n\nfunction setup (emojis?:EmojiEntry[]):{\n    el:EmojiInput;\n    textarea:HTMLTextAreaElement;\n} {\n    const el = document.createElement('emoji-input') as EmojiInput\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    document.body.appendChild(el)\n    if (emojis) el.emojis = emojis\n    return { el, textarea }\n}\n\nfunction simulateInput (\n    field:HTMLTextAreaElement|HTMLInputElement,\n    value:string,\n):void {\n    field.value = value\n    field.selectionStart = value.length\n    field.selectionEnd = value.length\n    field.dispatchEvent(\n        new InputEvent('input', { bubbles:true })\n    )\n}\n\nfunction keydown (field:HTMLElement, key:string):void {\n    field.dispatchEvent(new KeyboardEvent('keydown', {\n        key,\n        bubbles:true,\n        cancelable:true,\n    }))\n}\n\nfunction listItems (\n    el:EmojiInput,\n):NodeListOf<HTMLElement> {\n    return el.querySelectorAll(\n        '.emoji-search-item'\n    )\n}\n","numLines":1560,"startLine":1,"totalLines":1560}}}
