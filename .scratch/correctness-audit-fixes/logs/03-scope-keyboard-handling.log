dRecents()\n168\t        this.loadSkinTone()\n169\t        this.syncMode()\n170\t        if (!this.panel.isConnected) this.append(this.panel)\n171\t        this.renderTabs()\n172\t        this.renderTones()\n173\t        this.renderGrid()\n174\t        document.addEventListener('click', this.onDocumentClick)\n175\t    }\n176\t\n177\t    disconnectedCallback ():void {\n178\t        document.removeEventListener('click', this.onDocumentClick)\n179\t        this.close()\n180\t    }\n181\t\n182\t    attributeChangedCallback (name:string):void {\n183\t        this.syncMode()\n184\t        if (name === 'recent-key') this.loadRecents()\n185\t        if (name === 'skin-tone-key') this.loadSkinTone()\n186\t        this.renderTones()\n187\t        this.renderGrid()\n188\t    }\n189\t\n190\t    open (anchor?:HTMLElement):void {\n191\t        const el = document.activeElement\n192\t        this.triggerElement =\n193\t            el instanceof HTMLElement ? el : null\n194\t        this.panel.hidden = false\n195\t        if (!this.hasAttribute('inline')\n196\t            && typeof this.panel.showPopover === 'function') {\n197\t            this.panel.showPopover()\n198\t        }\n199\t        if (anchor && !this.hasAttribute('inline')) {\n200\t            const rect = anchor.getBoundingClientRect()\n201\t            this.panel.style.top = `${rect.bottom}px`\n202\t            this.panel.style.left = `${rect.left}px`\n203\t        }\n204\t        this.opened = true\n205\t        this.searchInput.focus({ preventScroll:true })\n206\t    }\n207\t\n208\t    close ():void {\n209\t        if (this.panel.matches(':popover-open')) {\n210\t            this.panel.hidePopover()\n211\t        }\n212\t        this.panel.hidden = true\n213\t        this.opened = false\n214\t        this.triggerElement?.focus()\n215\t        this.triggerElement = null\n216\t    }\n217\t\n218\t    private renderTabs ():void {\n219\t        this.tabs.replaceChildren()\n220\t        const tabs = [RECENTS, ...CATEGORIES]\n221\t        for (const category of tabs) {\n222\t            const tab = document.createElement('button')\n223\t            tab.type = 'button'\n224\t            tab.className = 'emoji-picker-tab'\n225\t            tab.id = `${this.uid}-tab-${category.id}`\n226\t            tab.setAttribute('role', 'tab')\n227\t            tab.setAttribute('aria-label', category.label)\n228\t            tab.setAttribute(\n229\t                'aria-selected',\n230\t                String(category.id === this.category),\n231\t            )\n232\t            tab.tabIndex = category.id === this.category ?\n233\t                0 : -1\n234\t            tab.title = category.label\n235\t            tab.textContent = category.icon\n236\t            tab.addEventListener('click', () => {\n237\t                this.category = category.id\n238\t                this.renderTabs()\n239\t                this.renderGrid()\n240\t            })\n241\t            this.tabs.append(tab)\n242\t        }\n243\t    }\n244\t\n245\t    private syncMode ():void {\n246\t        if (!this.panel) return\n247\t        if (this.hasAttribute('inline')) {\n248\t            this.panel.removeAttribute('popover')\n249\t        } else {\n250\t            this.panel.setAttribute('popover', 'manual')\n251\t        }\n252\t    }\n253\t\n254\t    private renderGrid ():void {\n255\t        if (!this.grid) return\n256\t        this.grid.replaceChildren()\n257\t        this.clearPreview()\n258\t        const emojis = this.query.trim()\n259\t            ? search(this.data, this.query, this.data.length)\n260\t            : this.category === RECENTS.id\n261\t                ? this.recentEntries()\n262\t                : this.data.filter(emoji => (\n263\t                    emoji.category === this.category\n264\t                    || emoji.categories?.includes(this.category) === true\n265\t                ))\n266\t\n267\t        if (!emojis.length) {\n268\t            const empty = document.createElement('div')\n269\t            empty.className = 'emoji-picker-empty'\n270\t            empty.textContent = this.category === RECENTS.id\n271\t                ? 'No recently used emoji'\n272\t                : 'No emoji in this category'\n273\t            this.grid.append(empty)\n274\t            return\n275\t        }\n276\t\n277\t        for (const emoji of emojis) {\n278\t            const displayed = this.withSelectedTone(emoji)\n279\t            const button = document.createElement('button')\n280\t            button.type = 'button'\n281\t            button.className = 'emoji-picker-emoji'\n282\t            button.setAttribute('role', 'gridcell')\n283\t            button.setAttribute(\n284\t                'aria-label', displayed.label ?? displayed.name\n285\t            )\n286\t            button.textContent = displayed.emoji\n287\t            button.addEventListener('mouseenter', () => {\n288\t                this.showPreview(displayed)\n289\t            })\n290\t            button.addEventListener('focus', () => {\n291\t                this.showPreview(displayed)\n292\t            })\n293\t            button.addEventListener('click', () => this.select(displayed))\n294\t            this.grid.append(button)\n295\t        }\n296\t    }\n297\t\n298\t    private select (emoji:EmojiEntry):void {\n299\t        const query = this.query\n300\t        this.addRecent(emoji)\n301\t        const field = this.targetField\n302\t        if (field) {\n303\t            const start = field.selectionStart ?? field.value.length\n304\t            const end = field.selectionEnd ?? start\n305\t            field.setRangeText(emoji.emoji, start, end, 'end')\n306\t            field.dispatchEvent(new InputEvent('input', {\n307\t                bubbles:true,\n308\t                inputType:'insertText',\n309\t                data:emoji.emoji,\n310\t            }))\n311\t        }\n312\t        this.close()\n313\t        this.dispatchEvent(new CustomEvent('emoji-select', {\n314\t            bubbles:true,\n315\t            composed:true,\n316\t            detail:{ emoji, query },\n317\t        }))\n318\t    }\n319\t\n320\t    private get targetField ():PickerField|null {\n321\t        const id = this.getAttribute('for')\n322\t        if (!id) return null\n323\t        const field = document.getElementById(id)\n324\t        return field instanceof HTMLTextAreaElement\n325\t            || field instanceof HTMLInputElement\n326\t            ? field\n327\t            : null\n328\t    }\n329\t\n330\t    private loadRecents ():void {\n331\t        const stored = this.readRecents()\n332\t        this.recentNames = stored\n333\t    }\n334\t\n335\t    private recentEntries ():Array<EmojiEntry> {\n336\t        return this.recentNames\n337\t            .map(name => this.data.find(emoji => emoji.name === name))\n338\t            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n339\t    }\n340\t\n341\t    private addRecent (emoji:EmojiEntry):void {\n342\t        this.recentNames = [\n343\t            emoji.name,\n344\t            ...this.recentNames.filter(name => name !== emoji.name),\n345\t        ].slice(0, MAX_RECENTS)\n346\t        this.writeRecents()\n347\t    }\n348\t\n349\t    private readRecents ():Array<string> {\n350\t        const key = this.recentKey\n351\t        try {\n352\t            const value = window.localStorage.getItem(key)\n353\t            if (value) {\n354\t                const parsed:unknown = JSON.parse(value)\n355\t                if (Array.isArray(parsed)) {\n356\t                    return parsed.filter(\n357\t                        (name):name is string => typeof name === 'string'\n358\t                    ).slice(0, MAX_RECENTS)\n359\t                }\n360\t            }\n361\t        } catch {\n362\t            return [...memoryRecents.get(key) ?? []]\n363\t        }\n364\t        return [...memoryRecents.get(key) ?? []]\n365\t    }\n366\t\n367\t    private writeRecents ():void {\n368\t        const key = this.recentKey\n369\t        memoryRecents.set(key, [...this.recentNames])\n370\t        try {\n371\t            window.localStorage.setItem(\n372\t                key,\n373\t                JSON.stringify(this.recentNames)\n374\t            )\n375\t        } catch {\n376\t            // The in-memory map is the fallback when storage is unavailable.\n377\t        }\n378\t    }\n379\t\n380\t    private renderTones ():void {\n381\t        if (!this.tones) return\n382\t        this.tones.replaceChildren()\n383\t        TONE_SWATCHES.forEach((swatch, tone) => {\n384\t            const button = document.createElement('button')\n385\t            button.type = 'button'\n386\t            button.className = 'emoji-picker-tone'\n387\t            button.setAttribute('role', 'radio')\n388\t            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n389\t            button.setAttribute('aria-checked', String(tone === this.skinTone))\n390\t            button.textContent = swatch\n391\t            button.addEventListener('click', () => {\n392\t                this.skinTone = tone\n393\t                this.writeSkinTone()\n394\t                this.renderTones()\n395\t                this.renderGrid()\n396\t            })\n397\t            this.tones.append(button)\n398\t        })\n399\t    }\n400\t\n401\t    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n402\t        const variants = emoji.skins ?? emoji.variants\n403\t        const variant = variants?.[this.skinTone]\n404\t        return variant ? { ...emoji, emoji:variant.native } : emoji\n405\t    }\n406\t\n407\t    private loadSkinTone ():void {\n408\t        const key = this.skinToneKey\n409\t        try {\n410\t            const value = window.localStorage.getItem(key)\n411\t            const tone = value === null ? undefined : Number(value)\n412\t            if (tone !== undefined && Number.isInteger(tone)\n413\t                && tone >= 0 && tone < TONE_SWATCHES.length) {\n414\t                this.skinTone = tone\n415\t                return\n416\t            }\n417\t        } catch {\n418\t            // The in-memory map is the fallback when storage is unavailable.\n419\t        }\n420\t        this.skinTone = memorySkinTones.get(key) ?? 0\n421\t    }\n422\t\n423\t    private writeSkinTone ():void {\n424\t        const key = this.skinToneKey\n425\t        memorySkinTones.set(key, this.skinTone)\n426\t        try {\n427\t            window.localStorage.setItem(key, String(this.skinTone))\n428\t        } catch {\n429\t            // The in-memory map is the fallback when storage is unavailable.\n430\t        }\n431\t    }\n432\t\n433\t    private clearPreview ():void {\n434\t        this.preview.replaceChildren()\n435\t    }\n436\t\n437\t    private showPreview (emoji:EmojiEntry):void {\n438\t        const glyph = document.createElement('span')\n439\t        glyph.className = 'emoji-picker-preview-glyph'\n440\t        glyph.textContent = emoji.emoji\n441\t\n442\t        const name = document.createElement('span')\n443\t        name.className = 'emoji-picker-preview-name'\n444\t        name.textContent = emoji.name\n445\t\n446\t        this.preview.replaceChildren(glyph, name)\n447\t    }\n448\t\n449\t    private onKeydown = (event:KeyboardEvent):void => {\n450\t        if (!this.opened) return\n451\t        if (event.key === 'Escape') {\n452\t            event.preventDefault()\n453\t            this.close()\n454\t            return\n455\t        }\n456\t\n457\t        const buttons = Array.from(\n458\t            this.grid.querySelectorAll<HTMLButtonElement>(\n459\t                '[role=\"gridcell\"]'\n460\t            )\n461\t        )\n462\t        if (!buttons.length) return\n463\t\n464\t        const active = document.activeElement\n465\t        const current = Math.max(0, buttons.indexOf(\n466\t            active as HTMLButtonElement\n467\t        ))\n468\t        const delta = event.key === 'ArrowRight'\n469\t            ? 1\n470\t            : event.key === 'ArrowLeft'\n471\t                ? -1\n472\t                : event.key === 'ArrowDown'\n473\t                    ? 8\n474\t                    : event.key === 'ArrowUp'\n475\t                        ? -8\n476\t                        : 0\n477\t\n478\t        if (delta) {\n479\t            event.preventDefault()\n480\t            const index = (current + delta + buttons.length)\n481\t                % buttons.length\n482\t            buttons[index]?.focus()\n483\t        } else if (event.key === 'Enter') {\n484\t            event.preventDefault()\n485\t            buttons[current]?.click()\n486\t        }\n487\t    }\n488\t\n489\t    private onTabKeydown = (event:KeyboardEvent):void => {\n490\t        const tabs = Array.from(\n491\t            this.tabs.querySelectorAll<HTMLButtonElement>(\n492\t                '[role=\"tab\"]'\n493\t            )\n494\t        )\n495\t        const current = tabs.indexOf(\n496\t            document.activeElement as HTMLButtonElement\n497\t        )\n498\t        if (current === -1) return\n499\t\n500\t        let next = -1\n501\t        if (event.key === 'ArrowRight') {\n502\t            next = (current + 1) % tabs.length\n503\t        } else if (event.key === 'ArrowLeft') {\n504\t            next = (current - 1 + tabs.length)\n505\t                % tabs.length\n506\t        } else if (event.key === 'Home') {\n507\t            next = 0\n508\t        } else if (event.key === 'End') {\n509\t            next = tabs.length - 1\n510\t        }\n511\t\n512\t        if (next < 0) return\n513\t        event.preventDefault()\n514\t        event.stopPropagation()\n515\t        const allCategories = [RECENTS, ...CATEGORIES]\n516\t        this.category = allCategories[next]!.id\n517\t        this.renderTabs()\n518\t        this.renderGrid()\n519\t        this.tabs.querySelectorAll<HTMLButtonElement>(\n520\t            '[role=\"tab\"]'\n521\t        )[next]?.focus()\n522\t    }\n523\t\n524\t    private onDocumentClick = (event:MouseEvent):void => {\n525\t        if (!this.opened) return\n526\t        if (!event.composedPath().includes(this)) {\n527\t            this.close()\n528\t        }\n529\t    }\n530\t}\n531\t\n532\tEmojiPicker.define()\n533\t\n534\tdeclare global {\n535\t    interface HTMLElementTagNameMap {\n536\t        'emoji-picker':EmojiPicker;\n537\t    }\n538\t}\n539\t"}]},"parent_tool_use_id":null,"session_id":"17b2a073-2dcb-44d7-adf3-864d54401ab0","uuid":"e8945dec-028f-4125-a416-bda20f776bee","timestamp":"2026-09-23T18:38:16.343Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-03-scope-keyboard-handling/src/picker.ts","content":"import { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nimport { search } from './search.js'\n\nexport { EmojiButton } from './button.js'\n\ntype PickerField = HTMLTextAreaElement|HTMLInputElement\ntype PickerCategory = {\n    readonly id:string;\n    readonly label:string;\n    readonly icon:string;\n}\n\nconst CATEGORIES:Array<PickerCategory> = [\n    { id:'people', label:'People', icon:'😀' },\n    { id:'nature', label:'Nature', icon:'🐻' },\n    { id:'foods', label:'Food', icon:'🍔' },\n    { id:'activity', label:'Activity', icon:'⚽' },\n    { id:'places', label:'Places', icon:'🌍' },\n    { id:'objects', label:'Objects', icon:'💡' },\n    { id:'symbols', label:'Symbols', icon:'🔣' },\n    { id:'flags', label:'Flags', icon:'🏳️' },\n]\n\nconst RECENTS:PickerCategory = {\n    id:'recent',\n    label:'Recently used',\n    icon:'🕘',\n}\n\nconst MAX_RECENTS = 24\nconst DEFAULT_RECENT_KEY = 'emoji-picker-recents'\nconst DEFAULT_SKIN_TONE_KEY = 'emoji-picker-skin-tone'\nconst memoryRecents = new Map<string, Array<string>>()\nconst memorySkinTones = new Map<string, number>()\nconst TONE_SWATCHES = ['👋', '👋🏻', '👋🏼', '👋🏽', '👋🏾', '👋🏿']\nconst TONE_LABELS = [\n    'Default skin tone',\n    'Light skin tone',\n    'Medium-light skin tone',\n    'Medium skin tone',\n    'Medium-dark skin tone',\n    'Dark skin tone',\n]\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\nexport class EmojiPicker extends Base {\n    static TAG = 'emoji-picker'\n    static observedAttributes = [\n        'inline',\n        'recent-key',\n        'skin-tone-key',\n    ]\n\n    static define (tag = EmojiPicker.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n        const customElements = window.customElements\n        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n    }\n\n    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n    private panel!:HTMLDivElement\n    private tabs!:HTMLDivElement\n    private searchInput!:HTMLInputElement\n    private grid!:HTMLDivElement\n    private tones!:HTMLDivElement\n    private preview!:HTMLDivElement\n    private category = 'recent'\n    private query = ''\n    private opened = false\n    private recentNames:Array<string> = []\n    private skinTone = 0\n    private uid = `emoji-picker-${\n        Math.random().toString(36).slice(2, 8)\n    }`\n\n    private triggerElement:HTMLElement|null = null\n\n    get recentKey ():string {\n        return this.getAttribute('recent-key')\n            ?? DEFAULT_RECENT_KEY\n    }\n\n    set recentKey (value:string) {\n        this.setAttribute('recent-key', value)\n    }\n\n    get skinToneKey ():string {\n        return this.getAttribute('skin-tone-key')\n            ?? DEFAULT_SKIN_TONE_KEY\n    }\n\n    set skinToneKey (value:string) {\n        this.setAttribute('skin-tone-key', value)\n    }\n\n    static render (el:EmojiPicker):void {\n        el.panel = document.createElement('div')\n        el.panel.className = 'emoji-picker-panel'\n        el.panel.setAttribute('popover', 'manual')\n\n        el.tabs = document.createElement('div')\n        el.tabs.className = 'emoji-picker-tabs'\n        el.tabs.setAttribute('role', 'tablist')\n\n        el.searchInput = document.createElement('input')\n        el.searchInput.className = 'emoji-picker-search'\n        el.searchInput.type = 'search'\n        el.searchInput.placeholder = 'Search emoji'\n        el.searchInput.setAttribute(\n            'aria-label',\n            'Search emoji',\n        )\n        el.searchInput.setAttribute(\n            'aria-controls',\n            `${el.uid}-grid`,\n        )\n        el.searchInput.addEventListener('input', () => {\n            el.query = el.searchInput.value\n            el.renderGrid()\n        })\n\n        el.tones = document.createElement('div')\n        el.tones.className = 'emoji-picker-tones'\n        el.tones.setAttribute('role', 'radiogroup')\n        el.tones.setAttribute('aria-label', 'Skin tone')\n\n        el.grid = document.createElement('div')\n        el.grid.className = 'emoji-picker-grid'\n        el.grid.id = `${el.uid}-grid`\n        el.grid.setAttribute('role', 'grid')\n        el.grid.setAttribute('aria-label', 'Emoji')\n\n        el.preview = document.createElement('div')\n        el.preview.className = 'emoji-picker-preview'\n        el.preview.setAttribute('role', 'status')\n        el.preview.setAttribute('aria-live', 'polite')\n\n        el.panel.append(\n            el.tabs,\n            el.searchInput,\n            el.tones,\n            el.grid,\n            el.preview,\n        )\n        el.addEventListener('keydown', el.onKeydown)\n        el.tabs.addEventListener('keydown', el.onTabKeydown)\n    }\n\n    get emojis ():Array<EmojiEntry> {\n        return this.data\n    }\n\n    set emojis (value:Array<EmojiEntry>) {\n        this.data = value\n        this.renderGrid()\n    }\n\n    get isOpen ():boolean {\n        return this.opened\n    }\n\n    connectedCallback ():void {\n        if (!this.panel) EmojiPicker.render(this)\n        this.loadRecents()\n        this.loadSkinTone()\n        this.syncMode()\n        if (!this.panel.isConnected) this.append(this.panel)\n        this.renderTabs()\n        this.renderTones()\n        this.renderGrid()\n        document.addEventListener('click', this.onDocumentClick)\n    }\n\n    disconnectedCallback ():void {\n        document.removeEventListener('click', this.onDocumentClick)\n        this.close()\n    }\n\n    attributeChangedCallback (name:string):void {\n        this.syncMode()\n        if (name === 'recent-key') this.loadRecents()\n        if (name === 'skin-tone-key') this.loadSkinTone()\n        this.renderTones()\n        this.renderGrid()\n    }\n\n    open (anchor?:HTMLElement):void {\n        const el = document.activeElement\n        this.triggerElement =\n            el instanceof HTMLElement ? el : null\n        this.panel.hidden = false\n        if (!this.hasAttribute('inline')\n            && typeof this.panel.showPopover === 'function') {\n            this.panel.showPopover()\n        }\n        if (anchor && !this.hasAttribute('inline')) {\n            const rect = anchor.getBoundingClientRect()\n            this.panel.style.top = `${rect.bottom}px`\n            this.panel.style.left = `${rect.left}px`\n        }\n        this.opened = true\n        this.searchInput.focus({ preventScroll:true })\n    }\n\n    close ():void {\n        if (this.panel.matches(':popover-open')) {\n            this.panel.hidePopover()\n        }\n        this.panel.hidden = true\n        this.opened = false\n        this.triggerElement?.focus()\n        this.triggerElement = null\n    }\n\n    private renderTabs ():void {\n        this.tabs.replaceChildren()\n        const tabs = [RECENTS, ...CATEGORIES]\n        for (const category of tabs) {\n            const tab = document.createElement('button')\n            tab.type = 'button'\n            tab.className = 'emoji-picker-tab'\n            tab.id = `${this.uid}-tab-${category.id}`\n            tab.setAttribute('role', 'tab')\n            tab.setAttribute('aria-label', category.label)\n            tab.setAttribute(\n                'aria-selected',\n                String(category.id === this.category),\n            )\n            tab.tabIndex = category.id === this.category ?\n                0 : -1\n            tab.title = category.label\n            tab.textContent = category.icon\n            tab.addEventListener('click', () => {\n                this.category = category.id\n                this.renderTabs()\n                this.renderGrid()\n            })\n            this.tabs.append(tab)\n        }\n    }\n\n    private syncMode ():void {\n        if (!this.panel) return\n        if (this.hasAttribute('inline')) {\n            this.panel.removeAttribute('popover')\n        } else {\n            this.panel.setAttribute('popover', 'manual')\n        }\n    }\n\n    private renderGrid ():void {\n        if (!this.grid) return\n        this.grid.replaceChildren()\n        this.clearPreview()\n        const emojis = this.query.trim()\n            ? search(this.data, this.query, this.data.length)\n            : this.category === RECENTS.id\n                ? this.recentEntries()\n                : this.data.filter(emoji => (\n                    emoji.category === this.category\n                    || emoji.categories?.includes(this.category) === true\n                ))\n\n        if (!emojis.length) {\n            const empty = document.createElement('div')\n            empty.className = 'emoji-picker-empty'\n            empty.textContent = this.category === RECENTS.id\n                ? 'No recently used emoji'\n                : 'No emoji in this category'\n            this.grid.append(empty)\n            return\n        }\n\n        for (const emoji of emojis) {\n            const displayed = this.withSelectedTone(emoji)\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-emoji'\n            button.setAttribute('role', 'gridcell')\n            button.setAttribute(\n                'aria-label', displayed.label ?? displayed.name\n            )\n            button.textContent = displayed.emoji\n            button.addEventListener('mouseenter', () => {\n                this.showPreview(displayed)\n            })\n            button.addEventListener('focus', () => {\n                this.showPreview(displayed)\n            })\n            button.addEventListener('click', () => this.select(displayed))\n            this.grid.append(button)\n        }\n    }\n\n    private select (emoji:EmojiEntry):void {\n        const query = this.query\n        this.addRecent(emoji)\n        const field = this.targetField\n        if (field) {\n            const start = field.selectionStart ?? field.value.length\n            const end = field.selectionEnd ?? start\n            field.setRangeText(emoji.emoji, start, end, 'end')\n            field.dispatchEvent(new InputEvent('input', {\n                bubbles:true,\n                inputType:'insertText',\n                data:emoji.emoji,\n            }))\n        }\n        this.close()\n        this.dispatchEvent(new CustomEvent('emoji-select', {\n            bubbles:true,\n            composed:true,\n            detail:{ emoji, query },\n        }))\n    }\n\n    private get targetField ():PickerField|null {\n        const id = this.getAttribute('for')\n        if (!id) return null\n        const field = document.getElementById(id)\n        return field instanceof HTMLTextAreaElement\n            || field instanceof HTMLInputElement\n            ? field\n            : null\n    }\n\n    private loadRecents ():void {\n        const stored = this.readRecents()\n        this.recentNames = stored\n    }\n\n    private recentEntries ():Array<EmojiEntry> {\n        return this.recentNames\n            .map(name => this.data.find(emoji => emoji.name === name))\n            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n    }\n\n    private addRecent (emoji:EmojiEntry):void {\n        this.recentNames = [\n            emoji.name,\n            ...this.recentNames.filter(name => name !== emoji.name),\n        ].slice(0, MAX_RECENTS)\n        this.writeRecents()\n    }\n\n    private readRecents ():Array<string> {\n        const key = this.recentKey\n        try {\n            const value = window.localStorage.getItem(key)\n            if (value) {\n                const parsed:unknown = JSON.parse(value)\n                if (Array.isArray(parsed)) {\n                    return parsed.filter(\n                        (name):name is string => typeof name === 'string'\n                    ).slice(0, MAX_RECENTS)\n                }\n            }\n        } catch {\n            return [...memoryRecents.get(key) ?? []]\n        }\n        return [...memoryRecents.get(key) ?? []]\n    }\n\n    private writeRecents ():void {\n        const key = this.recentKey\n        memoryRecents.set(key, [...this.recentNames])\n        try {\n            window.localStorage.setItem(\n                key,\n                JSON.stringify(this.recentNames)\n            )\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private renderTones ():void {\n        if (!this.tones) return\n        this.tones.replaceChildren()\n        TONE_SWATCHES.forEach((swatch, tone) => {\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-tone'\n            button.setAttribute('role', 'radio')\n            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n            button.setAttribute('aria-checked', String(tone === this.skinTone))\n            button.textContent = swatch\n            button.addEventListener('click', () => {\n                this.skinTone = tone\n                this.writeSkinTone()\n                this.renderTones()\n                this.renderGrid()\n            })\n            this.tones.append(button)\n        })\n    }\n\n    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n        const variants = emoji.skins ?? emoji.variants\n        const variant = variants?.[this.skinTone]\n        return variant ? { ...emoji, emoji:variant.native } : emoji\n    }\n\n    private loadSkinTone ():void {\n        const key = this.skinToneKey\n        try {\n            const value = window.localStorage.getItem(key)\n            const tone = value === null ? undefined : Number(value)\n            if (tone !== undefined && Number.isInteger(tone)\n                && tone >= 0 && tone < TONE_SWATCHES.length) {\n                this.skinTone = tone\n                return\n            }\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n        this.skinTone = memorySkinTones.get(key) ?? 0\n    }\n\n    private writeSkinTone ():void {\n        const key = this.skinToneKey\n        memorySkinTones.set(key, this.skinTone)\n        try {\n            window.localStorage.setItem(key, String(this.skinTone))\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private clearPreview ():void {\n        this.preview.replaceChildren()\n    }\n\n    private showPreview (emoji:EmojiEntry):void {\n        const glyph = document.createElement('span')\n        glyph.className = 'emoji-picker-preview-glyph'\n        glyph.textContent = emoji.emoji\n\n        const name = document.createElement('span')\n        name.className = 'emoji-picker-preview-name'\n        name.textContent = emoji.name\n\n        this.preview.replaceChildren(glyph, name)\n    }\n\n    private onKeydown = (event:KeyboardEvent):void => {\n        if (!this.opened) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            this.close()\n            return\n        }\n\n        const buttons = Array.from(\n            this.grid.querySelectorAll<HTMLButtonElement>(\n                '[role=\"gridcell\"]'\n            )\n        )\n        if (!buttons.length) return\n\n        const active = document.activeElement\n        const current = Math.max(0, buttons.indexOf(\n            active as HTMLButtonElement\n        ))\n        const delta = event.key === 'ArrowRight'\n            ? 1\n            : event.key === 'ArrowLeft'\n                ? -1\n                : event.key === 'ArrowDown'\n                    ? 8\n                    : event.key === 'ArrowUp'\n                        ? -8\n                        : 0\n\n        if (delta) {\n            event.preventDefault()\n            const index = (current + delta + buttons.length)\n                % buttons.length\n            buttons[index]?.focus()\n        } else if (event.key === 'Enter') {\n            event.preventDefault()\n            buttons[current]?.click()\n        }\n    }\n\n    private onTabKeydown = (event:KeyboardEvent):void => {\n        const tabs = Array.from(\n            this.tabs.querySelectorAll<HTMLButtonElement>(\n                '[role=\"tab\"]'\n            )\n        )\n        const current = tabs.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % tabs.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + tabs.length)\n                % tabs.length\n        } else if (event.key === 'Home') {\n            next = 0\n        } else if (event.key === 'End') {\n            next = tabs.length - 1\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        const allCategories = [RECENTS, ...CATEGORIES]\n        this.category = allCategories[next]!.id\n        this.renderTabs()\n        this.renderGrid()\n        this.tabs.querySelectorAll<HTMLButtonElement>(\n            '[role=\"tab\"]'\n        )[next]?.focus()\n    }\n\n    private onDocumentClick = (event:MouseEvent):void => {\n        if (!this.opened) return\n        if (!event.composedPath().includes(this)) {\n            this.close()\n        }\n    }\n}\n\nEmojiPicker.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-picker':EmojiPicker;\n    }\n}\n","numLines":539,"startLine":1,"totalLines":539}}}
