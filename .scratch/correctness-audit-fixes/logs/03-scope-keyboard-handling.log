define (tag = EmojiPicker.TAG):void {\n58\t        if (typeof window === 'undefined' || !window.customElements) return\n59\t        const customElements = window.customElements\n60\t        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n61\t    }\n62\t\n63\t    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n64\t    private panel!:HTMLDivElement\n65\t    private tabs!:HTMLDivElement\n66\t    private searchInput!:HTMLInputElement\n67\t    private grid!:HTMLDivElement\n68\t    private tones!:HTMLDivElement\n69\t    private preview!:HTMLDivElement\n70\t    private category = 'recent'\n71\t    private query = ''\n72\t    private opened = false\n73\t    private recentNames:Array<string> = []\n74\t    private skinTone = 0\n75\t    private uid = `emoji-picker-${\n76\t        Math.random().toString(36).slice(2, 8)\n77\t    }`\n78\t\n79\t    private triggerElement:HTMLElement|null = null\n80\t\n81\t    get recentKey ():string {\n82\t        return this.getAttribute('recent-key')\n83\t            ?? DEFAULT_RECENT_KEY\n84\t    }\n85\t\n86\t    set recentKey (value:string) {\n87\t        this.setAttribute('recent-key', value)\n88\t    }\n89\t\n90\t    get skinToneKey ():string {\n91\t        return this.getAttribute('skin-tone-key')\n92\t            ?? DEFAULT_SKIN_TONE_KEY\n93\t    }\n94\t\n95\t    set skinToneKey (value:string) {\n96\t        this.setAttribute('skin-tone-key', value)\n97\t    }\n98\t\n99\t    static render (el:EmojiPicker):void {\n100\t        el.panel = document.createElement('div')\n101\t        el.panel.className = 'emoji-picker-panel'\n102\t        el.panel.setAttribute('popover', 'manual')\n103\t\n104\t        el.tabs = document.createElement('div')\n105\t        el.tabs.className = 'emoji-picker-tabs'\n106\t        el.tabs.setAttribute('role', 'tablist')\n107\t\n108\t        el.searchInput = document.createElement('input')\n109\t        el.searchInput.className = 'emoji-picker-search'\n110\t        el.searchInput.type = 'search