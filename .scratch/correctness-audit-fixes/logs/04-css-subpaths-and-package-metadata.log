{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013pcGXXqDxNSFBYAZ3mgpES","type":"tool_result","content":"1\timport { strict as assert } from 'node:assert'\n2\timport { existsSync } from 'node:fs'\n3\timport { createRequire } from 'node:module'\n4\timport { fileURLToPath } from 'node:url'\n5\timport { dirname, resolve } from 'node:path'\n6\t\n7\tconst require = createRequire(import.meta.url)\n8\tconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..')\n9\t\n10\tlet passed = 0\n11\tlet failed = 0\n12\t\n13\tasync function test (name, fn) {\n14\t    try {\n15\t        await fn()\n16\t        passed++\n17\t        console.log(`  ok - ${name}`)\n18\t    } catch (err) {\n19\t        failed++\n20\t        console.log(`  not ok - ${name}`)\n21\t        console.log(`    ${err.message}`)\n22\t    }\n23\t}\n24\t\n25\tconsole.log('TAP version 13')\n26\tconsole.log('# Node smoke tests')\n27\t\n28\t// -- ESM imports --\n29\t\n30\tawait test(\n31\t    'ESM import of main entry succeeds',\n32\t    async () => {\n33\t        const mod = await import(\n34\t            resolve(root, 'dist/index.js')\n35\t        )\n36\t        assert.equal(typeof mod.EmojiInput, 'function')\n37\t        assert.equal(typeof mod.EmojiPicker, 'function')\n38\t        assert.equal(typeof mod.EmojiButton, 'function')\n39\t    },\n40\t)\n41\t\n42\tawait test(\n43\t    'ESM import of /picker succeeds',\n44\t    async () => {\n45\t        const mod = await import(\n46\t            resolve(root, 'dist/picker.js')\n47\t        )\n48\t        assert.equal(typeof mod.EmojiPicker, 'function')\n49\t    },\n50\t)\n51\t\n52\tawait test(\n53\t    'ESM import of /button succeeds',\n54\t    async () => {\n55\t        const mod = await import(\n56\t            resolve(root, 'dist/button.js')\n57\t        )\n58\t        assert.equal(typeof mod.EmojiButton, 'function')\n59\t    },\n60\t)\n61\t\n62\t// -- CJS require --\n63\t\n64\tawait test(\n65\t    'CJS require of main entry succeeds',\n66\t    async () => {\n67\t        const mod = require(resolve(root, 'dist/index.cjs'))\n68\t        assert.equal(typeof mod.EmojiInput, 'function')\n69\t        assert.equal(typeof mod.EmojiPicker, 'function')\n70\t        assert.equal(typeof mod.EmojiButton, 'function')\n71\t    },\n72\t)\n73\t\n74\tawait test(\n75\t    'CJS require of /picker succeeds',\n76\t    async () => {\n77\t        const mod = require(resolve(root, 'dist/picker.cjs'))\n78\t        assert.equal(typeof mod.EmojiPicker, 'function')\n79\t    },\n80\t)\n81\t\n82\tawait test(\n83\t    'CJS require of /button succeeds',\n84\t    async () => {\n85\t        const mod = require(resolve(root, 'dist/button.cjs'))\n86\t        assert.equal(typeof mod.EmojiButton, 'function')\n87\t    },\n88\t)\n89\t\n90\t// -- Export shape --\n91\t\n92\tawait test(\n93\t    'main entry exports EmojiInput, EmojiPicker, EmojiButton',\n94\t    async () => {\n95\t        const mod = await import(\n96\t            resolve(root, 'dist/index.js')\n97\t        )\n98\t        assert.ok('EmojiInput' in mod)\n99\t        assert.ok('EmojiPicker' in mod)\n100\t        assert.ok('EmojiButton' in mod)\n101\t    },\n102\t)\n103\t\n104\tawait test(\n105\t    '/button subpath exports only EmojiButton',\n106\t    async () => {\n107\t        const mod = await import(\n108\t            resolve(root, 'dist/button.js')\n109\t        )\n110\t        assert.ok('EmojiButton' in mod)\n111\t        assert.ok(!('EmojiInput' in mod))\n112\t        assert.ok(!('EmojiPicker' in mod))\n113\t    },\n114\t)\n115\t\n116\tconsole.log(`\\n1..${passed + failed}`)\n117\tconsole.log(`# pass ${passed}`)\n118\tconsole.log(`# fail ${failed}`)\n119\t\n120\tif (failed > 0) process.exit(1)\n121\t"}]},"parent_tool_use_id":null,"session_id":"f6bde644-44ab-498a-8659-5687eac90585","uuid":"076834af-2115-48e6-9853-361525d80dca","timestamp":"2026-09-23T18:47:02.315Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-04-css-subpaths-and-package-metadata/test/smoke.mjs","content":"import { strict as assert } from 'node:assert'\nimport { existsSync } from 'node:fs'\nimport { createRequire } from 'node:module'\nimport { fileURLToPath } from 'node:url'\nimport { dirname, resolve } from 'node:path'\n\nconst require = createRequire(import.meta.url)\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..')\n\nlet passed = 0\nlet failed = 0\n\nasync function test (name, fn) {\n    try {\n        await fn()\n        passed++\n        console.log(`  ok - ${name}`)\n    } catch (err) {\n        failed++\n        console.log(`  not ok - ${name}`)\n        console.log(`    ${err.message}`)\n    }\n}\n\nconsole.log('TAP version 13')\nconsole.log('# Node smoke tests')\n\n// -- ESM imports --\n\nawait test(\n    'ESM import of main entry succeeds',\n    async () => {\n        const mod = await import(\n            resolve(root, 'dist/index.js')\n        )\n        assert.equal(typeof mod.EmojiInput, 'function')\n        assert.equal(typeof mod.EmojiPicker, 'function')\n        assert.equal(typeof mod.EmojiButton, 'function')\n    },\n)\n\nawait test(\n    'ESM import of /picker succeeds',\n    async () => {\n        const mod = await import(\n            resolve(root, 'dist/picker.js')\n        )\n        assert.equal(typeof mod.EmojiPicker, 'function')\n    },\n)\n\nawait test(\n    'ESM import of /button succeeds',\n    async () => {\n        const mod = await import(\n            resolve(root, 'dist/button.js')\n        )\n        assert.equal(typeof mod.EmojiButton, 'function')\n    },\n)\n\n// -- CJS require --\n\nawait test(\n    'CJS require of main entry succeeds',\n    async () => {\n        const mod = require(resolve(root, 'dist/index.cjs'))\n        assert.equal(typeof mod.EmojiInput, 'function')\n        assert.equal(typeof mod.EmojiPicker, 'function')\n        assert.equal(typeof mod.EmojiButton, 'function')\n    },\n)\n\nawait test(\n    'CJS require of /picker succeeds',\n    async () => {\n        const mod = require(resolve(root, 'dist/picker.cjs'))\n        assert.equal(typeof mod.EmojiPicker, 'function')\n    },\n)\n\nawait test(\n    'CJS require of /button succeeds',\n    async () => {\n        const mod = require(resolve(root, 'dist/button.cjs'))\n        assert.equal(typeof mod.EmojiButton, 'function')\n    },\n)\n\n// -- Export shape --\n\nawait test(\n    'main entry exports EmojiInput, EmojiPicker, EmojiButton',\n    async () => {\n        const mod = await import(\n            resolve(root, 'dist/index.js')\n        )\n        assert.ok('EmojiInput' in mod)\n        assert.ok('EmojiPicker' in mod)\n        assert.ok('EmojiButton' in mod)\n    },\n)\n\nawait test(\n    '/button subpath exports only EmojiButton',\n    async () => {\n        const mod = await import(\n            resolve(root, 'dist/button.js')\n        )\n        assert.ok('EmojiButton' in mod)\n        assert.ok(!('EmojiInput' in mod))\n        assert.ok(!('EmojiPicker' in mod))\n    },\n)\n\nconsole.log(`\\n1..${passed + failed}`)\nconsole.log(`# pass ${passed}`)\nconsole.log(`# fail ${failed}`)\n\nif (failed > 0) process.exit(1)\n","numLines":121,"startLine":1,"totalLines":121}}}
