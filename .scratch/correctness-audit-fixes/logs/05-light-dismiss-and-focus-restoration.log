{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019B5vworQJQzWH15jzoXYNY","type":"tool_result","content":"1\timport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n2\timport { search } from './search.js'\n3\t\n4\texport { EmojiButton } from './button.js'\n5\t\n6\ttype PickerField = HTMLTextAreaElement|HTMLInputElement\n7\ttype PickerCategory = {\n8\t    readonly id:string;\n9\t    readonly label:string;\n10\t    readonly icon:string;\n11\t}\n12\t\n13\tconst CATEGORIES:Array<PickerCategory> = [\n14\t    { id:'people', label:'People', icon:'😀' },\n15\t    { id:'nature', label:'Nature', icon:'🐻' },\n16\t    { id:'foods', label:'Food', icon:'🍔' },\n17\t    { id:'activity', label:'Activity', icon:'⚽' },\n18\t    { id:'places', label:'Places', icon:'🌍' },\n19\t    { id:'objects', label:'Objects', icon:'💡' },\n20\t    { id:'symbols', label:'Symbols', icon:'🔣' },\n21\t    { id:'flags', label:'Flags', icon:'🏳️' },\n22\t]\n23\t\n24\tconst RECENTS:PickerCategory = {\n25\t    id:'recent',\n26\t    label:'Recently used',\n27\t    icon:'🕘',\n28\t}\n29\t\n30\tconst MAX_RECENTS = 24\n31\tconst DEFAULT_RECENT_KEY = 'emoji-picker-recents'\n32\tconst DEFAULT_SKIN_TONE_KEY = 'emoji-picker-skin-tone'\n33\tconst memoryRecents = new Map<string, Array<string>>()\n34\tconst memorySkinTones = new Map<string, number>()\n35\tconst TONE_SWATCHES = ['👋', '👋🏻', '👋🏼', '👋🏽', '👋🏾', '👋🏿']\n36\tconst TONE_LABELS = [\n37\t    'Default skin tone',\n38\t    'Light skin tone',\n39\t    'Medium-light skin tone',\n40\t    'Medium skin tone',\n41\t    'Medium-dark skin tone',\n42\t    'Dark skin tone',\n43\t]\n44\t\n45\tconst Base = typeof HTMLElement !== 'undefined' ?\n46\t    HTMLElement :\n47\t    class {} as unknown as typeof HTMLElement\n48\t\n49\texport class EmojiPicker extends Base {\n50\t    static TAG = 'emoji-picker'\n51\t    static observedAttributes = [\n52\t        'inline',\n53\t        'recent-key',\n54\t        'skin-tone-key',\n55\t    ]\n56\t\n57\t    static define (tag = EmojiPicker.TAG):void {\n58\t        if (typeof window === 'undefined' || !window.customElements) return\n59\t        const customElements = window.customElements\n60\t        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n61\t    }\n62\t\n63\t    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n64\t    private panel!:HTMLDivElement\n65\t    private tabs!:HTMLDivElement\n66\t    private searchInput!:HTMLInputElement\n67\t    private grid!:HTMLDivElement\n68\t    private tones!:HTMLDivElement\n69\t    private preview!:HTMLDivElement\n70\t    private category = 'recent'\n71\t    private query = ''\n72\t    private opened = false\n73\t    private recentNames:Array<string> = []\n74\t    private skinTone = 0\n75\t    private uid = `emoji-picker-${\n76\t        Math.random().toString(36).slice(2, 8)\n77\t    }`\n78\t\n79\t    private triggerElement:HTMLElement|null = null\n80\t\n81\t    get recentKey ():string {\n82\t        return this.getAttribute('recent-key')\n83\t            ?? DEFAULT_RECENT_KEY\n84\t    }\n85\t\n86\t    set recentKey (value:string) {\n87\t        this.setAttribute('recent-key', value)\n88\t    }\n89\t\n90\t    get skinToneKey ():string {\n91\t        return this.getAttribute('skin-tone-key')\n92\t            ?? DEFAULT_SKIN_TONE_KEY\n93\t    }\n94\t\n95\t    set skinToneKey (value:string) {\n96\t        this.setAttribute('skin-tone-key', value)\n97\t    }\n98\t\n99\t    static render (el:EmojiPicker):void {\n100\t        el.panel = document.createElement('div')\n101\t        el.panel.className = 'emoji-picker-panel'\n102\t        el.panel.setAttribute('popover', 'manual')\n103\t\n104\t        el.tabs = document.createElement('div')\n105\t        el.tabs.className = 'emoji-picker-tabs'\n106\t        el.tabs.setAttribute('role', 'tablist')\n107\t\n108\t        el.searchInput = document.createElement('input')\n109\t        el.searchInput.className = 'emoji-picker-search'\n110\t        el.searchInput.type = 'search