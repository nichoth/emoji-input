     if (!this.panel) EmojiPicker.render(this)\n168\t        this.loadRecents()\n169\t        this.loadSkinTone()\n170\t        this.syncMode()\n171\t        if (!this.panel.isConnected) this.append(this.panel)\n172\t        this.renderTabs()\n173\t        this.renderTones()\n174\t        this.renderGrid()\n175\t        document.addEventListener('click', this.onDocumentClick)\n176\t    }\n177\t\n178\t    disconnectedCallback ():void {\n179\t        document.removeEventListener('click', this.onDocumentClick)\n180\t        this.close()\n181\t    }\n182\t\n183\t    attributeChangedCallback (name:string):void {\n184\t        this.syncMode()\n185\t        if (name === 'recent-key') this.loadRecents()\n186\t        if (name === 'skin-tone-key') this.loadSkinTone()\n187\t        this.renderTones()\n188\t        this.renderGrid()\n189\t    }\n190\t\n191\t    open (anchor?:HTMLElement):void {\n192\t        const el = document.activeElement\n193\t        this.triggerElement =\n194\t            el instanceof HTMLElement ? el : null\n195\t        this.panel.hidden = false\n196\t        if (!this.hasAttribute('inline')\n197\t            && typeof this.panel.showPopover === 'function') {\n198\t            this.panel.showPopover()\n199\t        }\n200\t        if (anchor && !this.hasAttribute('inline')) {\n201\t            const rect = anchor.getBoundingClientRect()\n202\t            this.panel.style.top = `${rect.bottom}px`\n203\t            this.panel.style.left = `${rect.left}px`\n204\t        }\n205\t        this.opened = true\n206\t        this.searchInput.focus({ preventScroll:true })\n207\t    }\n208\t\n209\t    close ():void {\n210\t        if (this.panel.matches(':popover-open')) {\n211\t            this.panel.hidePopover()\n212\t        }\n213\t        this.panel.hidden = true\n214\t        this.opened = false\n215\t        this.triggerElement?.focus()\n216\t        this.triggerElement = null\n217\t    }\n218\t\n219\t    private renderTabs ():void {\n220\t        this.tabs.replaceChildren()\n221\t        const tabs = [RECENTS, ...CATEGORIES]\n222\t        for (const category of tabs) {\n223\t            const tab = document.createElement('button')\n224\t            tab.type = 'button'\n225\t            tab.className = 'emoji-picker-tab'\n226\t            tab.id = `${this.uid}-tab-${category.id}`\n227\t            tab.setAttribute('role', 'tab')\n228\t            tab.setAttribute('aria-label', category.label)\n229\t            tab.setAttribute(\n230\t                'aria-selected',\n231\t                String(category.id === this.category),\n232\t            )\n233\t            tab.tabIndex = category.id === this.category ?\n234\t                0 : -1\n235\t            tab.title = category.label\n236\t            tab.textContent = category.icon\n237\t            tab.addEventListener('click', () => {\n238\t                this.category = category.id\n239\t                this.renderTabs()\n240\t                this.renderGrid()\n241\t            })\n242\t            this.tabs.append(tab)\n243\t        }\n244\t    }\n245\t\n246\t    private syncMode ():void {\n247\t        if (!this.panel) return\n248\t        if (this.hasAttribute('inline')) {\n249\t            this.panel.removeAttribute('popover')\n250\t        } else {\n251\t            this.panel.setAttribute('popover', 'manual')\n252\t        }\n253\t    }\n254\t\n255\t    private renderGrid ():void {\n256\t        if (!this.grid) return\n257\t        this.grid.replaceChildren()\n258\t        this.clearPreview()\n259\t        const emojis = this.query.trim()\n260\t            ? search(this.data, this.query, this.data.length)\n261\t            : this.category === RECENTS.id\n262\t                ? this.recentEntries()\n263\t                : this.data.filter(emoji => (\n264\t                    emoji.category === this.category\n265\t                    || emoji.categories?.includes(this.category) === true\n266\t                ))\n267\t\n268\t        if (!emojis.length) {\n269\t            const empty = document.createElement('div')\n270\t            empty.className = 'emoji-picker-empty'\n271\t            empty.textContent = this.category === RECENTS.id\n272\t                ? 'No recently used emoji'\n273\t                : 'No emoji in this category'\n274\t            this.grid.append(empty)\n275\t            return\n276\t        }\n277\t\n278\t        for (const emoji of emojis) {\n279\t            const displayed = this.withSelectedTone(emoji)\n280\t            const button = document.createElement('button')\n281\t            button.type = 'button'\n282\t            button.className = 'emoji-picker-emoji'\n283\t            button.setAttribute('role', 'gridcell')\n284\t            button.setAttribute(\n285\t                'aria-label', displayed.label ?? displayed.name\n286\t            )\n287\t            button.textContent = displayed.emoji\n288\t            button.addEventListener('mouseenter', () => {\n289\t                this.showPreview(displayed)\n290\t            })\n291\t            button.addEventListener('focus', () => {\n292\t                this.showPreview(displayed)\n293\t            })\n294\t            button.addEventListener('click', () => this.select(displayed))\n295\t            this.grid.append(button)\n296\t        }\n297\t    }\n298\t\n299\t    private select (emoji:EmojiEntry):void {\n300\t        const query = this.query\n301\t        this.addRecent(emoji)\n302\t        const field = this.targetField\n303\t        if (field) {\n304\t            const start = field.selectionStart ?? field.value.length\n305\t            const end = field.selectionEnd ?? start\n306\t            field.setRangeText(emoji.emoji, start, end, 'end')\n307\t            field.dispatchEvent(new InputEvent('input', {\n308\t                bubbles:true,\n309\t                inputType:'insertText',\n310\t                data:emoji.emoji,\n311\t            }))\n312\t        }\n313\t        this.close()\n314\t        this.dispatchEvent(new CustomEvent('emoji-select', {\n315\t            bubbles:true,\n316\t            composed:true,\n317\t            detail:{ emoji, query },\n318\t        }))\n319\t    }\n320\t\n321\t    private get targetField ():PickerField|null {\n322\t        const id = this.getAttribute('for')\n323\t        if (!id) return null\n324\t        const field = document.getElementById(id)\n325\t        return field instanceof HTMLTextAreaElement\n326\t            || field instanceof HTMLInputElement\n327\t            ? field\n328\t            : null\n329\t    }\n330\t\n331\t    private loadRecents ():void {\n332\t        const stored = this.readRecents()\n333\t        this.recentNames = stored\n334\t    }\n335\t\n336\t    private recentEntries ():Array<EmojiEntry> {\n337\t        return this.recentNames\n338\t            .map(name => this.data.find(emoji => emoji.name === name))\n339\t            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n340\t    }\n341\t\n342\t    private addRecent (emoji:EmojiEntry):void {\n343\t        this.recentNames = [\n344\t            emoji.name,\n345\t            ...this.recentNames.filter(name => name !== emoji.name),\n346\t        ].slice(0, MAX_RECENTS)\n347\t        this.writeRecents()\n348\t    }\n349\t\n350\t    private readRecents ():Array<string> {\n351\t        const key = this.recentKey\n352\t        try {\n353\t            const value = window.localStorage.getItem(key)\n354\t            if (value) {\n355\t                const parsed:unknown = JSON.parse(value)\n356\t                if (Array.isArray(parsed)) {\n357\t                    return parsed.filter(\n358\t                        (name):name is string => typeof name === 'string'\n359\t                    ).slice(0, MAX_RECENTS)\n360\t                }\n361\t            }\n362\t        } catch {\n363\t            return [...memoryRecents.get(key) ?? []]\n364\t        }\n365\t        return [...memoryRecents.get(key) ?? []]\n366\t    }\n367\t\n368\t    private writeRecents ():void {\n369\t        const key = this.recentKey\n370\t        memoryRecents.set(key, [...this.recentNames])\n371\t        try {\n372\t            window.localStorage.setItem(\n373\t                key,\n374\t                JSON.stringify(this.recentNames)\n375\t            )\n376\t        } catch {\n377\t            // The in-memory map is the fallback when storage is unavailable.\n378\t        }\n379\t    }\n380\t\n381\t    private renderTones ():void {\n382\t        if (!this.tones) return\n383\t        this.tones.replaceChildren()\n384\t        TONE_SWATCHES.forEach((swatch, tone) => {\n385\t            const button = document.createElement('button')\n386\t            button.type = 'button'\n387\t            button.className = 'emoji-picker-tone'\n388\t            button.setAttribute('role', 'radio')\n389\t            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n390\t            button.setAttribute('aria-checked', String(tone === this.skinTone))\n391\t            button.textContent = swatch\n392\t            button.addEventListener('click', () => {\n393\t                this.skinTone = tone\n394\t                this.writeSkinTone()\n395\t                this.renderTones()\n396\t                this.renderGrid()\n397\t            })\n398\t            this.tones.append(button)\n399\t        })\n400\t    }\n401\t\n402\t    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n403\t        const variants = emoji.skins ?? emoji.variants\n404\t        const variant = variants?.[this.skinTone]\n405\t        return variant ? { ...emoji, emoji:variant.native } : emoji\n406\t    }\n407\t\n408\t    private loadSkinTone ():void {\n409\t        const key = this.skinToneKey\n410\t        try {\n411\t            const value = window.localStorage.getItem(key)\n412\t            const tone = value === null ? undefined : Number(value)\n413\t            if (tone !== undefined && Number.isInteger(tone)\n414\t                && tone >= 0 && tone < TONE_SWATCHES.length) {\n415\t                this.skinTone = tone\n416\t                return\n417\t            }\n418\t        } catch {\n419\t            // The in-memory map is the fallback when storage is unavailable.\n420\t        }\n421\t        this.skinTone = memorySkinTones.get(key) ?? 0\n422\t    }\n423\t\n424\t    private writeSkinTone ():void {\n425\t        const key = this.skinToneKey\n426\t        memorySkinTones.set(key, this.skinTone)\n427\t        try {\n428\t            window.localStorage.setItem(key, String(this.skinTone))\n429\t        } catch {\n430\t            // The in-memory map is the fallback when storage is unavailable.\n431\t        }\n432\t    }\n433\t\n434\t    private clearPreview ():void {\n435\t        this.preview.replaceChildren()\n436\t    }\n437\t\n438\t    private showPreview (emoji:EmojiEntry):void {\n439\t        const glyph = document.createElement('span')\n440\t        glyph.className = 'emoji-picker-preview-glyph'\n441\t        glyph.textContent = emoji.emoji\n442\t\n443\t        const name = document.createElement('span')\n444\t        name.className = 'emoji-picker-preview-name'\n445\t        name.textContent = emoji.name\n446\t\n447\t        this.preview.replaceChildren(glyph, name)\n448\t    }\n449\t\n450\t    private onKeydown = (event:KeyboardEvent):void => {\n451\t        if (!this.opened) return\n452\t        if (event.key === 'Escape') {\n453\t            event.preventDefault()\n454\t            this.close()\n455\t            return\n456\t        }\n457\t\n458\t        const target = event.target as HTMLElement|null\n459\t\n460\t        if (target?.closest('[role=\"tab\"]')) {\n461\t            return\n462\t        }\n463\t\n464\t        if (target?.closest('[role=\"radio\"]')) {\n465\t            return\n466\t        }\n467\t\n468\t        if (target === this.searchInput) {\n469\t            this.onSearchKeydown(event)\n470\t            return\n471\t        }\n472\t\n473\t        if (target?.closest('[role=\"gridcell\"]')) {\n474\t            this.onGridKeydown(event)\n475\t        }\n476\t    }\n477\t\n478\t    private onSearchKeydown (event:KeyboardEvent):void {\n479\t        if (event.key === 'ArrowDown') {\n480\t            event.preventDefault()\n481\t            const first = this.grid.querySelector<HTMLButtonElement>(\n482\t                '[role=\"gridcell\"]'\n483\t            )\n484\t            first?.focus()\n485\t            return\n486\t        }\n487\t\n488\t        if (event.key === 'Enter') {\n489\t            const query = this.searchInput.value.trim()\n490\t            if (!query) return\n491\t            const first = this.grid.querySelector<HTMLButtonElement>(\n492\t                '[role=\"gridcell\"]'\n493\t            )\n494\t            first?.click()\n495\t        }\n496\t    }\n497\t\n498\t    private onGridKeydown (event:KeyboardEvent):void {\n499\t        const buttons = Array.from(\n500\t            this.grid.querySelectorAll<HTMLButtonElement>(\n501\t                '[role=\"gridcell\"]'\n502\t            )\n503\t        )\n504\t        if (!buttons.length) return\n505\t\n506\t        const active = document.activeElement\n507\t        const current = Math.max(0, buttons.indexOf(\n508\t            active as HTMLButtonElement\n509\t        ))\n510\t        const delta = event.key === 'ArrowRight'\n511\t            ? 1\n512\t            : event.key === 'ArrowLeft'\n513\t                ? -1\n514\t                : event.key === 'ArrowDown'\n515\t                    ? 8\n516\t                    : event.key === 'ArrowUp'\n517\t                        ? -8\n518\t                        : 0\n519\t\n520\t        if (delta) {\n521\t            event.preventDefault()\n522\t            const index = (current + delta + buttons.length)\n523\t                % buttons.length\n524\t            buttons[index]?.focus()\n525\t        } else if (\n526\t            event.key === 'Enter' || event.key === ' '\n527\t        ) {\n528\t            buttons[current]?.click()\n529\t        }\n530\t    }\n531\t\n532\t    private onTabKeydown = (event:KeyboardEvent):void => {\n533\t        const tabs = Array.from(\n534\t            this.tabs.querySelectorAll<HTMLButtonElement>(\n535\t                '[role=\"tab\"]'\n536\t            )\n537\t        )\n538\t        const current = tabs.indexOf(\n539\t            document.activeElement as HTMLButtonElement\n540\t        )\n541\t        if (current === -1) return\n542\t\n543\t        let next = -1\n544\t        if (event.key === 'ArrowRight') {\n545\t            next = (current + 1) % tabs.length\n546\t        } else if (event.key === 'ArrowLeft') {\n547\t            next = (current - 1 + tabs.length)\n548\t                % tabs.length\n549\t        } else if (event.key === 'Home') {\n550\t            next = 0\n551\t        } else if (event.key === 'End') {\n552\t            next = tabs.length - 1\n553\t        }\n554\t\n555\t        if (next < 0) return\n556\t        event.preventDefault()\n557\t        event.stopPropagation()\n558\t        const allCategories = [RECENTS, ...CATEGORIES]\n559\t        this.category = allCategories[next]!.id\n560\t        this.renderTabs()\n561\t        this.renderGrid()\n562\t        this.tabs.querySelectorAll<HTMLButtonElement>(\n563\t            '[role=\"tab\"]'\n564\t        )[next]?.focus()\n565\t    }\n566\t\n567\t    private onToneKeydown = (event:KeyboardEvent):void => {\n568\t        const radios = Array.from(\n569\t            this.tones.querySelectorAll<HTMLButtonElement>(\n570\t                '[role=\"radio\"]'\n571\t            )\n572\t        )\n573\t        const current = radios.indexOf(\n574\t            document.activeElement as HTMLButtonElement\n575\t        )\n576\t        if (current === -1) return\n577\t\n578\t        let next = -1\n579\t        if (event.key === 'ArrowRight') {\n580\t            next = (current + 1) % radios.length\n581\t        } else if (event.key === 'ArrowLeft') {\n582\t            next = (current - 1 + radios.length)\n583\t                % radios.length\n584\t        }\n585\t\n586\t        if (next < 0) return\n587\t        event.preventDefault()\n588\t        event.stopPropagation()\n589\t        this.skinTone = next\n590\t        this.writeSkinTone()\n591\t        this.renderTones()\n592\t        this.renderGrid()\n593\t        this.tones.querySelectorAll<HTMLButtonElement>(\n594\t            '[role=\"radio\"]'\n595\t        )[next]?.focus()\n596\t    }\n597\t\n598\t    private onDocumentClick = (event:MouseEvent):void => {\n599\t        if (!this.opened) return\n600\t        if (!event.composedPath().includes(this)) {\n601\t            this.close()\n602\t        }\n603\t    }\n604\t}\n605\t\n606\tEmojiPicker.define()\n607\t\n608\tdeclare global {\n609\t    interface HTMLElementTagNameMap {\n610\t        'emoji-picker':EmojiPicker;\n611\t    }\n612\t}\n613\t"}]},"parent_tool_use_id":null,"session_id":"3b0b9f0b-1dc8-4717-a724-0e8ed0d9f10e","uuid":"991e0ffc-adb1-45c5-bc68-ef5268febb2a","timestamp":"2026-09-23T18:46:47.952Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-05-light-dismiss-and-focus-restoration/src/picker.ts","content":"import { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nimport { search } from './search.js'\n\nexport { EmojiButton } from './button.js'\n\ntype PickerField = HTMLTextAreaElement|HTMLInputElement\ntype PickerCategory = {\n    readonly id:string;\n    readonly label:string;\n    readonly icon:string;\n}\n\nconst CATEGORIES:Array<PickerCategory> = [\n    { id:'people', label:'People', icon:'😀' },\n    { id:'nature', label:'Nature', icon:'🐻' },\n    { id:'foods', label:'Food', icon:'🍔' },\n    { id:'activity', label:'Activity', icon:'⚽' },\n    { id:'places', label:'Places', icon:'🌍' },\n    { id:'objects', label:'Objects', icon:'💡' },\n    { id:'symbols', label:'Symbols', icon:'🔣' },\n    { id:'flags', label:'Flags', icon:'🏳️' },\n]\n\nconst RECENTS:PickerCategory = {\n    id:'recent',\n    label:'Recently used',\n    icon:'🕘',\n}\n\nconst MAX_RECENTS = 24\nconst DEFAULT_RECENT_KEY = 'emoji-picker-recents'\nconst DEFAULT_SKIN_TONE_KEY = 'emoji-picker-skin-tone'\nconst memoryRecents = new Map<string, Array<string>>()\nconst memorySkinTones = new Map<string, number>()\nconst TONE_SWATCHES = ['👋', '👋🏻', '👋🏼', '👋🏽', '👋🏾', '👋🏿']\nconst TONE_LABELS = [\n    'Default skin tone',\n    'Light skin tone',\n    'Medium-light skin tone',\n    'Medium skin tone',\n    'Medium-dark skin tone',\n    'Dark skin tone',\n]\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\nexport class EmojiPicker extends Base {\n    static TAG = 'emoji-picker'\n    static observedAttributes = [\n        'inline',\n        'recent-key',\n        'skin-tone-key',\n    ]\n\n    static define (tag = EmojiPicker.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n        const customElements = window.customElements\n        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n    }\n\n    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n    private panel!:HTMLDivElement\n    private tabs!:HTMLDivElement\n    private searchInput!:HTMLInputElement\n    private grid!:HTMLDivElement\n    private tones!:HTMLDivElement\n    private preview!:HTMLDivElement\n    private category = 'recent'\n    private query = ''\n    private opened = false\n    private recentNames:Array<string> = []\n    private skinTone = 0\n    private uid = `emoji-picker-${\n        Math.random().toString(36).slice(2, 8)\n    }`\n\n    private triggerElement:HTMLElement|null = null\n\n    get recentKey ():string {\n        return this.getAttribute('recent-key')\n            ?? DEFAULT_RECENT_KEY\n    }\n\n    set recentKey (value:string) {\n        this.setAttribute('recent-key', value)\n    }\n\n    get skinToneKey ():string {\n        return this.getAttribute('skin-tone-key')\n            ?? DEFAULT_SKIN_TONE_KEY\n    }\n\n    set skinToneKey (value:string) {\n        this.setAttribute('skin-tone-key', value)\n    }\n\n    static render (el:EmojiPicker):void {\n        el.panel = document.createElement('div')\n        el.panel.className = 'emoji-picker-panel'\n        el.panel.setAttribute('popover', 'manual')\n\n        el.tabs = document.createElement('div')\n        el.tabs.className = 'emoji-picker-tabs'\n        el.tabs.setAttribute('role', 'tablist')\n\n        el.searchInput = document.createElement('input')\n        el.searchInput.className = 'emoji-picker-search'\n        el.searchInput.type = 'search'\n        el.searchInput.placeholder = 'Search emoji'\n        el.searchInput.setAttribute(\n            'aria-label',\n            'Search emoji',\n        )\n        el.searchInput.setAttribute(\n            'aria-controls',\n            `${el.uid}-grid`,\n        )\n        el.searchInput.addEventListener('input', () => {\n            el.query = el.searchInput.value\n            el.renderGrid()\n        })\n\n        el.tones = document.createElement('div')\n        el.tones.className = 'emoji-picker-tones'\n        el.tones.setAttribute('role', 'radiogroup')\n        el.tones.setAttribute('aria-label', 'Skin tone')\n\n        el.grid = document.createElement('div')\n        el.grid.className = 'emoji-picker-grid'\n        el.grid.id = `${el.uid}-grid`\n        el.grid.setAttribute('role', 'grid')\n        el.grid.setAttribute('aria-label', 'Emoji')\n\n        el.preview = document.createElement('div')\n        el.preview.className = 'emoji-picker-preview'\n        el.preview.setAttribute('role', 'status')\n        el.preview.setAttribute('aria-live', 'polite')\n\n        el.panel.append(\n            el.tabs,\n            el.searchInput,\n            el.tones,\n            el.grid,\n            el.preview,\n        )\n        el.addEventListener('keydown', el.onKeydown)\n        el.tabs.addEventListener('keydown', el.onTabKeydown)\n        el.tones.addEventListener('keydown', el.onToneKeydown)\n    }\n\n    get emojis ():Array<EmojiEntry> {\n        return this.data\n    }\n\n    set emojis (value:Array<EmojiEntry>) {\n        this.data = value\n        this.renderGrid()\n    }\n\n    get isOpen ():boolean {\n        return this.opened\n    }\n\n    connectedCallback ():void {\n        if (!this.panel) EmojiPicker.render(this)\n        this.loadRecents()\n        this.loadSkinTone()\n        this.syncMode()\n        if (!this.panel.isConnected) this.append(this.panel)\n        this.renderTabs()\n        this.renderTones()\n        this.renderGrid()\n        document.addEventListener('click', this.onDocumentClick)\n    }\n\n    disconnectedCallback ():void {\n        document.removeEventListener('click', this.onDocumentClick)\n        this.close()\n    }\n\n    attributeChangedCallback (name:string):void {\n        this.syncMode()\n        if (name === 'recent-key') this.loadRecents()\n        if (name === 'skin-tone-key') this.loadSkinTone()\n        this.renderTones()\n        this.renderGrid()\n    }\n\n    open (anchor?:HTMLElement):void {\n        const el = document.activeElement\n        this.triggerElement =\n            el instanceof HTMLElement ? el : null\n        this.panel.hidden = false\n        if (!this.hasAttribute('inline')\n            && typeof this.panel.showPopover === 'function') {\n            this.panel.showPopover()\n        }\n        if (anchor && !this.hasAttribute('inline')) {\n            const rect = anchor.getBoundingClientRect()\n            this.panel.style.top = `${rect.bottom}px`\n            this.panel.style.left = `${rect.left}px`\n        }\n        this.opened = true\n        this.searchInput.focus({ preventScroll:true })\n    }\n\n    close ():void {\n        if (this.panel.matches(':popover-open')) {\n            this.panel.hidePopover()\n        }\n        this.panel.hidden = true\n        this.opened = false\n        this.triggerElement?.focus()\n        this.triggerElement = null\n    }\n\n    private renderTabs ():void {\n        this.tabs.replaceChildren()\n        const tabs = [RECENTS, ...CATEGORIES]\n        for (const category of tabs) {\n            const tab = document.createElement('button')\n            tab.type = 'button'\n            tab.className = 'emoji-picker-tab'\n            tab.id = `${this.uid}-tab-${category.id}`\n            tab.setAttribute('role', 'tab')\n            tab.setAttribute('aria-label', category.label)\n            tab.setAttribute(\n                'aria-selected',\n                String(category.id === this.category),\n            )\n            tab.tabIndex = category.id === this.category ?\n                0 : -1\n            tab.title = category.label\n            tab.textContent = category.icon\n            tab.addEventListener('click', () => {\n                this.category = category.id\n                this.renderTabs()\n                this.renderGrid()\n            })\n            this.tabs.append(tab)\n        }\n    }\n\n    private syncMode ():void {\n        if (!this.panel) return\n        if (this.hasAttribute('inline')) {\n            this.panel.removeAttribute('popover')\n        } else {\n            this.panel.setAttribute('popover', 'manual')\n        }\n    }\n\n    private renderGrid ():void {\n        if (!this.grid) return\n        this.grid.replaceChildren()\n        this.clearPreview()\n        const emojis = this.query.trim()\n            ? search(this.data, this.query, this.data.length)\n            : this.category === RECENTS.id\n                ? this.recentEntries()\n                : this.data.filter(emoji => (\n                    emoji.category === this.category\n                    || emoji.categories?.includes(this.category) === true\n                ))\n\n        if (!emojis.length) {\n            const empty = document.createElement('div')\n            empty.className = 'emoji-picker-empty'\n            empty.textContent = this.category === RECENTS.id\n                ? 'No recently used emoji'\n                : 'No emoji in this category'\n            this.grid.append(empty)\n            return\n        }\n\n        for (const emoji of emojis) {\n            const displayed = this.withSelectedTone(emoji)\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-emoji'\n            button.setAttribute('role', 'gridcell')\n            button.setAttribute(\n                'aria-label', displayed.label ?? displayed.name\n            )\n            button.textContent = displayed.emoji\n            button.addEventListener('mouseenter', () => {\n                this.showPreview(displayed)\n            })\n            button.addEventListener('focus', () => {\n                this.showPreview(displayed)\n            })\n            button.addEventListener('click', () => this.select(displayed))\n            this.grid.append(button)\n        }\n    }\n\n    private select (emoji:EmojiEntry):void {\n        const query = this.query\n        this.addRecent(emoji)\n        const field = this.targetField\n        if (field) {\n            const start = field.selectionStart ?? field.value.length\n            const end = field.selectionEnd ?? start\n            field.setRangeText(emoji.emoji, start, end, 'end')\n            field.dispatchEvent(new InputEvent('input', {\n                bubbles:true,\n                inputType:'insertText',\n                data:emoji.emoji,\n            }))\n        }\n        this.close()\n        this.dispatchEvent(new CustomEvent('emoji-select', {\n            bubbles:true,\n            composed:true,\n            detail:{ emoji, query },\n        }))\n    }\n\n    private get targetField ():PickerField|null {\n        const id = this.getAttribute('for')\n        if (!id) return null\n        const field = document.getElementById(id)\n        return field instanceof HTMLTextAreaElement\n            || field instanceof HTMLInputElement\n            ? field\n            : null\n    }\n\n    private loadRecents ():void {\n        const stored = this.readRecents()\n        this.recentNames = stored\n    }\n\n    private recentEntries ():Array<EmojiEntry> {\n        return this.recentNames\n            .map(name => this.data.find(emoji => emoji.name === name))\n            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n    }\n\n    private addRecent (emoji:EmojiEntry):void {\n        this.recentNames = [\n            emoji.name,\n            ...this.recentNames.filter(name => name !== emoji.name),\n        ].slice(0, MAX_RECENTS)\n        this.writeRecents()\n    }\n\n    private readRecents ():Array<string> {\n        const key = this.recentKey\n        try {\n            const value = window.localStorage.getItem(key)\n            if (value) {\n                const parsed:unknown = JSON.parse(value)\n                if (Array.isArray(parsed)) {\n                    return parsed.filter(\n                        (name):name is string => typeof name === 'string'\n                    ).slice(0, MAX_RECENTS)\n                }\n            }\n        } catch {\n            return [...memoryRecents.get(key) ?? []]\n        }\n        return [...memoryRecents.get(key) ?? []]\n    }\n\n    private writeRecents ():void {\n        const key = this.recentKey\n        memoryRecents.set(key, [...this.recentNames])\n        try {\n            window.localStorage.setItem(\n                key,\n                JSON.stringify(this.recentNames)\n            )\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private renderTones ():void {\n        if (!this.tones) return\n        this.tones.replaceChildren()\n        TONE_SWATCHES.forEach((swatch, tone) => {\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-tone'\n            button.setAttribute('role', 'radio')\n            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n            button.setAttribute('aria-checked', String(tone === this.skinTone))\n            button.textContent = swatch\n            button.addEventListener('click', () => {\n                this.skinTone = tone\n                this.writeSkinTone()\n                this.renderTones()\n                this.renderGrid()\n            })\n            this.tones.append(button)\n        })\n    }\n\n    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n        const variants = emoji.skins ?? emoji.variants\n        const variant = variants?.[this.skinTone]\n        return variant ? { ...emoji, emoji:variant.native } : emoji\n    }\n\n    private loadSkinTone ():void {\n        const key = this.skinToneKey\n        try {\n            const value = window.localStorage.getItem(key)\n            const tone = value === null ? undefined : Number(value)\n            if (tone !== undefined && Number.isInteger(tone)\n                && tone >= 0 && tone < TONE_SWATCHES.length) {\n                this.skinTone = tone\n                return\n            }\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n        this.skinTone = memorySkinTones.get(key) ?? 0\n    }\n\n    private writeSkinTone ():void {\n        const key = this.skinToneKey\n        memorySkinTones.set(key, this.skinTone)\n        try {\n            window.localStorage.setItem(key, String(this.skinTone))\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private clearPreview ():void {\n        this.preview.replaceChildren()\n    }\n\n    private showPreview (emoji:EmojiEntry):void {\n        const glyph = document.createElement('span')\n        glyph.className = 'emoji-picker-preview-glyph'\n        glyph.textContent = emoji.emoji\n\n        const name = document.createElement('span')\n        name.className = 'emoji-picker-preview-name'\n        name.textContent = emoji.name\n\n        this.preview.replaceChildren(glyph, name)\n    }\n\n    private onKeydown = (event:KeyboardEvent):void => {\n        if (!this.opened) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            this.close()\n            return\n        }\n\n        const target = event.target as HTMLElement|null\n\n        if (target?.closest('[role=\"tab\"]')) {\n            return\n        }\n\n        if (target?.closest('[role=\"radio\"]')) {\n            return\n        }\n\n        if (target === this.searchInput) {\n            this.onSearchKeydown(event)\n            return\n        }\n\n        if (target?.closest('[role=\"gridcell\"]')) {\n            this.onGridKeydown(event)\n        }\n    }\n\n    private onSearchKeydown (event:KeyboardEvent):void {\n        if (event.key === 'ArrowDown') {\n            event.preventDefault()\n            const first = this.grid.querySelector<HTMLButtonElement>(\n                '[role=\"gridcell\"]'\n            )\n            first?.focus()\n            return\n        }\n\n        if (event.key === 'Enter') {\n            const query = this.searchInput.value.trim()\n            if (!query) return\n            const first = this.grid.querySelector<HTMLButtonElement>(\n                '[role=\"gridcell\"]'\n            )\n            first?.click()\n        }\n    }\n\n    private onGridKeydown (event:KeyboardEvent):void {\n        const buttons = Array.from(\n            this.grid.querySelectorAll<HTMLButtonElement>(\n                '[role=\"gridcell\"]'\n            )\n        )\n        if (!buttons.length) return\n\n        const active = document.activeElement\n        const current = Math.max(0, buttons.indexOf(\n            active as HTMLButtonElement\n        ))\n        const delta = event.key === 'ArrowRight'\n            ? 1\n            : event.key === 'ArrowLeft'\n                ? -1\n                : event.key === 'ArrowDown'\n                    ? 8\n                    : event.key === 'ArrowUp'\n                        ? -8\n                        : 0\n\n        if (delta) {\n            event.preventDefault()\n            const index = (current + delta + buttons.length)\n                % buttons.length\n            buttons[index]?.focus()\n        } else if (\n            event.key === 'Enter' || event.key === ' '\n        ) {\n            buttons[current]?.click()\n        }\n    }\n\n    private onTabKeydown = (event:KeyboardEvent):void => {\n        const tabs = Array.from(\n            this.tabs.querySelectorAll<HTMLButtonElement>(\n                '[role=\"tab\"]'\n            )\n        )\n        const current = tabs.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % tabs.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + tabs.length)\n                % tabs.length\n        } else if (event.key === 'Home') {\n            next = 0\n        } else if (event.key === 'End') {\n            next = tabs.length - 1\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        const allCategories = [RECENTS, ...CATEGORIES]\n        this.category = allCategories[next]!.id\n        this.renderTabs()\n        this.renderGrid()\n        this.tabs.querySelectorAll<HTMLButtonElement>(\n            '[role=\"tab\"]'\n        )[next]?.focus()\n    }\n\n    private onToneKeydown = (event:KeyboardEvent):void => {\n        const radios = Array.from(\n            this.tones.querySelectorAll<HTMLButtonElement>(\n                '[role=\"radio\"]'\n            )\n        )\n        const current = radios.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % radios.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + radios.length)\n                % radios.length\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        this.skinTone = next\n        this.writeSkinTone()\n        this.renderTones()\n        this.renderGrid()\n        this.tones.querySelectorAll<HTMLButtonElement>(\n            '[role=\"radio\"]'\n        )[next]?.focus()\n    }\n\n    private onDocumentClick = (event:MouseEvent):void => {\n        if (!this.opened) return\n        if (!event.composedPath().includes(this)) {\n            this.close()\n        }\n    }\n}\n\nEmojiPicker.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-picker':EmojiPicker;\n    }\n}\n","numLines":613,"startLine":1,"totalLines":613}}}
