n52\t        ev.stopPropagation()\n53\t        const forId = this.getAttribute('for')\n54\t        if (!forId) return\n55\t\n56\t        const root = this.getRootNode() as Document\n57\t        const target = root.getElementById(forId)\n58\t        if (target?.localName !== 'emoji-picker') return\n59\t\n60\t        const picker = target as EmojiPicker\n61\t        picker.open(this)\n62\t    }\n63\t}\n64\t\n65\tEmojiButton.define()\n66\t\n67\tdeclare global {\n68\t    interface HTMLElementTagNameMap {\n69\t        'emoji-button':EmojiButton;\n70\t    }\n71\t}\n72\t"}]},"parent_tool_use_id":null,"session_id":"3b0b9f0b-1dc8-4717-a724-0e8ed0d9f10e","uuid":"4df1447a-de8f-40ef-98aa-5cff2871dfa6","timestamp":"2026-09-23T18:46:48.624Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-05-light-dismiss-and-focus-restoration/src/button.ts","content":"import { type EmojiPicker } from './picker'\n\nconst ICON_SVG = `<svg class=\"emoji-button\"\n    fill=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"\n        fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n    <circle cx=\"9\" cy=\"10\" r=\"1\"/>\n    <circle cx=\"15\" cy=\"10\" r=\"1\"/>\n    <path d=\"M8 15c2 2 6 2 8 0\"\n        fill=\"none\" stroke=\"currentColor\"\n        stroke-linecap=\"round\" stroke-width=\"2\"/>\n</svg>`\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\nexport class EmojiButton extends Base {\n    static TAG = 'emoji-button'\n    private button:HTMLButtonElement|null = null\n\n    static define (tag = EmojiButton.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n\n        if (!customElements.get(tag)) {\n            customElements.define(tag, EmojiButton)\n        }\n    }\n\n    static render ():string {\n        return `<button class=\"emoji-button\" type=\"button\">\n            ${ICON_SVG}\n            <span class=\"visually-hidden\">\n                Open emoji picker\n            </span>\n        </button>`\n    }\n\n    connectedCallback ():void {\n        const btn = this.querySelector('button.emoji-button') as HTMLButtonElement\n        if (btn) {\n            this.button = btn\n        } else {\n            this.innerHTML = EmojiButton.render()\n            this.button = this.querySelector('button')!\n        }\n\n        this.button!.addEventListener('click', this.onClick)\n    }\n\n    private onClick = (ev:MouseEvent):void => {\n        ev.stopPropagation()\n        const forId = this.getAttribute('for')\n        if (!forId) return\n\n        const root = this.getRootNode() as Document\n        const target = root.getElementById(forId)\n        if (target?.localName !== 'emoji-picker') return\n\n        const picker = target as EmojiPicker\n        picker.open(this)\n    }\n}\n\nEmojiButton.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-button':EmojiButton;\n    }\n}\n","numLines":72,"startLine":1,"totalLines":72}}}
