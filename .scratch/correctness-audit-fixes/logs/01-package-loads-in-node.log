{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DkVTFLPSKnFvNtwXxFzXd2","type":"tool_result","content":"1\timport emojiData from '@emoji-mart/data/sets/15/native.json'\n2\t\n3\ttype EmojiMartSkin = {\n4\t    readonly unified:string;\n5\t    readonly native:string;\n6\t}\n7\t\n8\ttype EmojiMartRecord = {\n9\t    readonly id:string;\n10\t    readonly name:string;\n11\t    readonly keywords:Array<string>;\n12\t    readonly skins:Array<EmojiMartSkin>;\n13\t}\n14\t\n15\ttype EmojiMartCategory = {\n16\t    readonly id:string;\n17\t    readonly emojis:Array<string>;\n18\t}\n19\t\n20\ttype EmojiMartData = {\n21\t    readonly categories:Array<EmojiMartCategory>;\n22\t    readonly emojis:Record<string, EmojiMartRecord>;\n23\t}\n24\t\n25\texport type EmojiSkin = EmojiMartSkin&{\n26\t    readonly tone:number;\n27\t}\n28\t\n29\texport type EmojiEntry = {\n30\t    readonly emoji:string;\n31\t    readonly name:string;\n32\t    readonly keywords?:Array<string>;\n33\t    readonly label?:string;\n34\t    readonly category?:string|null;\n35\t    readonly categories?:Array<string>;\n36\t    readonly skins?:Array<EmojiSkin>;\n37\t    readonly variants?:Array<EmojiSkin>;\n38\t}\n39\t\n40\tconst data = emojiData as unknown as EmojiMartData\n41\t\n42\tfunction categoryMap (\n43\t    categories:ReadonlyArray<EmojiMartCategory>,\n44\t):Map<string, Array<string>> {\n45\t    const result = new Map<string, Array<string>>()\n46\t    for (const category of categories) {\n47\t        for (const id of category.emojis) {\n48\t            const existing = result.get(id) ?? []\n49\t            existing.push(category.id)\n50\t            result.set(id, existing)\n51\t        }\n52\t    }\n53\t    return result\n54\t}\n55\t\n56\tfunction adaptSkin (skin:EmojiMartSkin, index:number):EmojiSkin {\n57\t    return {\n58\t        unified:skin.unified,\n59\t        native:skin.native,\n60\t        tone:index,\n61\t    }\n62\t}\n63\t\n64\tfunction adaptEmoji (\n65\t    record:EmojiMartRecord,\n66\t    categories:ReadonlyMap<string, Array<string>>,\n67\t):EmojiEntry {\n68\t    const categoryNames = categories.get(record.id) ?? []\n69\t    const skins = record.skins.map(adaptSkin)\n70\t    return {\n71\t        emoji:skins[0]?.native ?? '',\n72\t        name:record.id,\n73\t        keywords:[...record.keywords],\n74\t        label:record.name,\n75\t        category:categoryNames[0] ?? null,\n76\t        categories:[...categoryNames],\n77\t        skins,\n78\t        variants:skins,\n79\t    }\n80\t}\n81\t\n82\tconst categories = categoryMap(data.categories)\n83\t\n84\texport const DEFAULT_EMOJIS:Array<EmojiEntry> = Object.values(data.emojis)\n85\t    .map(record => adaptEmoji(record, categories))\n86\t"}]},"parent_tool_use_id":null,"session_id":"3aa3ade1-b996-4ec5-b8dc-a08b3f38702f","uuid":"802db3c1-03ff-4416-94e1-e8155c55795e","timestamp":"2026-09-23T18:38:14.841Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-01-package-loads-in-node/src/data.ts","content":"import emojiData from '@emoji-mart/data/sets/15/native.json'\n\ntype EmojiMartSkin = {\n    readonly unified:string;\n    readonly native:string;\n}\n\ntype EmojiMartRecord = {\n    readonly id:string;\n    readonly name:string;\n    readonly keywords:Array<string>;\n    readonly skins:Array<EmojiMartSkin>;\n}\n\ntype EmojiMartCategory = {\n    readonly id:string;\n    readonly emojis:Array<string>;\n}\n\ntype EmojiMartData = {\n    readonly categories:Array<EmojiMartCategory>;\n    readonly emojis:Record<string, EmojiMartRecord>;\n}\n\nexport type EmojiSkin = EmojiMartSkin&{\n    readonly tone:number;\n}\n\nexport type EmojiEntry = {\n    readonly emoji:string;\n    readonly name:string;\n    readonly keywords?:Array<string>;\n    readonly label?:string;\n    readonly category?:string|null;\n    readonly categories?:Array<string>;\n    readonly skins?:Array<EmojiSkin>;\n    readonly variants?:Array<EmojiSkin>;\n}\n\nconst data = emojiData as unknown as EmojiMartData\n\nfunction categoryMap (\n    categories:ReadonlyArray<EmojiMartCategory>,\n):Map<string, Array<string>> {\n    const result = new Map<string, Array<string>>()\n    for (const category of categories) {\n        for (const id of category.emojis) {\n            const existing = result.get(id) ?? []\n            existing.push(category.id)\n            result.set(id, existing)\n        }\n    }\n    return result\n}\n\nfunction adaptSkin (skin:EmojiMartSkin, index:number):EmojiSkin {\n    return {\n        unified:skin.unified,\n        native:skin.native,\n        tone:index,\n    }\n}\n\nfunction adaptEmoji (\n    record:EmojiMartRecord,\n    categories:ReadonlyMap<string, Array<string>>,\n):EmojiEntry {\n    const categoryNames = categories.get(record.id) ?? []\n    const skins = record.skins.map(adaptSkin)\n    return {\n        emoji:skins[0]?.native ?? '',\n        name:record.id,\n        keywords:[...record.keywords],\n        label:record.name,\n        category:categoryNames[0] ?? null,\n        categories:[...categoryNames],\n        skins,\n        variants:skins,\n    }\n}\n\nconst categories = categoryMap(data.categories)\n\nexport const DEFAULT_EMOJIS:Array<EmojiEntry> = Object.values(data.emojis)\n    .map(record => adaptEmoji(record, categories))\n","numLines":86,"startLine":1,"totalLines":86}}}
