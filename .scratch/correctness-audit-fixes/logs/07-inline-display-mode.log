{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016E5eWt8rua7ukQURpgfwuL","type":"tool_result","content":"1\timport { test } from '@substrate-system/tapzero'\n2\timport { sleep } from '@substrate-system/dom'\n3\timport {\n4\t    EmojiInput,\n5\t    EmojiButton as MainEmojiButton,\n6\t    EmojiPicker as MainEmojiPicker,\n7\t    DEFAULT_EMOJIS,\n8\t    type EmojiEntry,\n9\t    type EmojiSelectDetail,\n10\t} from '../src/index.js'\n11\timport { EmojiPicker } from '../src/picker.js'\n12\timport { EmojiButton } from '../src/button.js'\n13\timport { search } from '../src/search.js'\n14\timport packageJson from '../package.json'\n15\timport buttonCss from '../src/button.css'\n16\timport pickerCss from '../src/picker.css'\n17\t\n18\tconst _style = document.createElement('style')\n19\t_style.textContent = [buttonCss, pickerCss].join('\\n')\n20\tdocument.head.appendChild(_style)\n21\t\n22\t// -- Helpers ---------------------------------------------------\n23\t\n24\tconst SMALL_SET:EmojiEntry[] = [\n25\t    {\n26\t        emoji:'😀',\n27\t        name:'grinning',\n28\t        keywords:['smile', 'happy'],\n29\t    },\n30\t    {\n31\t        emoji:'😃',\n32\t        name:'smiley',\n33\t        keywords:['smile', 'happy'],\n34\t    },\n35\t    {\n36\t        emoji:'😄',\n37\t        name:'smile',\n38\t        keywords:['happy', 'laugh'],\n39\t    },\n40\t    {\n41\t        emoji:'🍕',\n42\t        name:'pizza',\n43\t        keywords:['food'],\n44\t    },\n45\t    {\n46\t        emoji:'🍔',\n47\t        name:'hamburger',\n48\t        keywords:['burger', 'food'],\n49\t    },\n50\t    {\n51\t        emoji:'🔥',\n52\t        name:'fire',\n53\t        keywords:['lit', 'hot'],\n54\t    },\n55\t    {\n56\t        emoji:'🐱',\n57\t        name:'cat',\n58\t        keywords:['kitty'],\n59\t    },\n60\t    {\n61\t        emoji:'🐶',\n62\t        name:'dog',\n63\t        keywords:['puppy'],\n64\t    },\n65\t]\n66\t\n67\t// -- Static render (Node-compatible) ---------------------------\n68\t\n69\ttest('static render returns an HTML string', t => {\n70\t    const html = EmojiInput.render('test-uid')\n71\t    t.equal(typeof html, 'string', 'returns a string')\n72\t    t.ok(\n73\t        html.includes('emoji-search-list'),\n74\t        'contains the list class'\n75\t    )\n76\t    t.ok(\n77\t        html.includes('role=\"listbox\"'),\n78\t        'has listbox role'\n79\t    )\n80\t    t.ok(\n81\t        html.includes('aria-label=\"Emoji suggestions\"'),\n82\t        'listbox has an accessible label'\n83\t    )\n84\t    t.ok(\n85\t        html.includes('id=\"test-uid-list\"'),\n86\t        'uses the uid for the element id'\n87\t    )\n88\t    t.ok(\n89\t        html.includes('popover=\"manual\"'),\n90\t        'has popover attribute'\n91\t    )\n92\t})\n93\t\n94\t// -- Data structure --------------------------------------------\n95\t\n96\ttest('DEFAULT_EMOJIS has expected structure', t => {\n97\t    t.ok(\n98\t        DEFAULT_EMOJIS.length >= 1800,\n99\t        'contains the complete emoji-mart set'\n100\t    )\n101\t\n102\t    const first = DEFAULT_EMOJIS[0]\n103\t    t.equal(\n104\t        typeof first.emoji, 'string',\n105\t        'emoji field is a string'\n106\t    )\n107\t    t.equal(\n108\t        typeof first.name, 'string',\n109\t        'name field is a string'\n110\t    )\n111\t    t.ok(\n112\t        Array.isArray(first.keywords),\n113\t        'keywords is an array'\n114\t    )\n115\t})\n116\t\n117\ttest('DEFAULT_EMOJIS includes category and skin data', t => {\n118\t    const butter = DEFAULT_EMOJIS.find(\n119\t        emoji => emoji.name === 'butter'\n120\t    )\n121\t\n122\t    t.ok(butter, 'includes butter')\n123\t    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n124\t    t.ok(butter?.category, 'includes a category')\n125\t    t.ok(Array.isArray(butter?.categories), 'includes categories')\n126\t\n127\t    const wave = DEFAULT_EMOJIS.find(\n128\t        emoji => emoji.name === 'wave'\n129\t    )\n130\t    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n131\t    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n132\t})\n133\t\n134\ttest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n135\t    const invalid = DEFAULT_EMOJIS.filter(\n136\t        e => !e.emoji || !e.name\n137\t    )\n138\t    t.equal(\n139\t        invalid.length, 0,\n140\t        'no entries missing emoji or name'\n141\t    )\n142\t})\n143\t\n144\ttest('shared search ranks name prefixes before substrings', t => {\n145\t    const emojis:EmojiEntry[] = [\n146\t        { emoji:'1', name:'pineapple', keywords:[] },\n147\t        { emoji:'2', name:'apple', keywords:[] },\n148\t        { emoji:'3', name:'grape', keywords:[] },\n149\t    ]\n150\t\n151\t    const results = search(emojis, 'app', 8)\n152\t    t.equal(\n153\t        JSON.stringify(results.map(emoji => emoji.name)),\n154\t        JSON.stringify(['apple', 'pineapple']),\n155\t        'prefix matches rank before substring matches'\n156\t    )\n157\t})\n158\t\n159\ttest('shared search ranks keyword prefixes after name matches', t => {\n160\t    const emojis:EmojiEntry[] = [\n161\t        { emoji:'1', name:'grape', keywords:['apple'] },\n162\t        { emoji:'2', name:'pineapple', keywords:[] },\n163\t        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n164\t    ]\n165\t\n166\t    const results = search(emojis, 'app', 8)\n167\t    t.equal(\n168\t        JSON.stringify(results.map(emoji => emoji.name)),\n169\t        JSON.stringify(['pineapple', 'grape', 'fruit']),\n170\t        'keyword prefix matches rank after name matches'\n171\t    )\n172\t})\n173\t\n174\t// -- Registration and setup ------------------------------------\n175\t\n176\ttest('custom element is registered', t => {\n177\t    const ctor = customElements.get('emoji-input')\n178\t    t.ok(ctor, 'emoji-input tag is defined')\n179\t    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n180\t})\n181\t\n182\ttest('emoji-picker custom element is registered', t => {\n183\t    const ctor = customElements.get('emoji-picker')\n184\t    t.ok(ctor, 'emoji-picker tag is defined')\n185\t    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n186\t\n187\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n188\t    document.body.appendChild(picker)\n189\t    t.ok(picker.emojis.length > 0, 'has default emoji data')\n190\t    t.ok(!picker.isOpen, 'starts closed')\n191\t    picker.remove()\n192\t})\n193\t\n194\ttest('emoji-button custom element renders an accessible smiley button', t => {\n195\t    const ctor = customElements.get('emoji-button')\n196\t    t.ok(ctor, 'emoji-button tag is defined')\n197\t    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n198\t\n199\t    const button = document.createElement('emoji-button')\n200\t    document.body.appendChild(button)\n201\t    const inner = button.querySelector('button')\n202\t    t.ok(inner, 'renders a native button')\n203\t    t.equal(inner?.type, 'button', 'button does not submit forms')\n204\t    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n205\t    t.ok(\n206\t        inner?.querySelector('.visually-hidden'),\n207\t        'has a visually-hidden label'\n208\t    )\n209\t    button.remove()\n210\t})\n211\t\n212\ttest('emoji-button uses currentColor', t => {\n213\t    const button = document.createElement('emoji-button')\n214\t    document.body.appendChild(button)\n215\t\n216\t    const svg = button.querySelector('svg')\n217\t    t.equal(\n218\t        svg?.getAttribute('fill'),\n219\t        'currentColor',\n220\t        'the SVG inherits its fill from currentColor'\n221\t    )\n222\t    button.remove()\n223\t})\n224\t\n225\ttest('emoji-button opens the picker named by for', t => {\n226\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n227\t    picker.id = 'button-picker-target'\n228\t    let opens = 0\n229\t    picker.open = () => { opens++ }\n230\t\n231\t    const button = document.createElement('emoji-button')\n232\t    button.setAttribute('for', picker.id)\n233\t    document.body.append(picker, button)\n234\t    button.querySelector('button')?.click()\n235\t\n236\t    t.equal(opens, 1, 'click calls the referenced picker open method')\n237\t    button.remove()\n238\t    picker.remove()\n239\t})\n240\t\n241\ttest('emoji-button positions the picker below itself', t => {\n242\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n243\t    picker.id = 'position-test-picker'\n244\t    picker.setAttribute('for', 'position-target')\n245\t\n246\t    const wrapper = document.createElement('div')\n247\t    wrapper.style.position = 'relative'\n248\t    wrapper.style.marginTop = '120px'\n249\t    wrapper.style.marginLeft = '200px'\n250\t\n251\t    const button = document.createElement('emoji-button') as EmojiButton\n252\t    button.setAttribute('for', picker.id)\n253\t\n254\t    wrapper.append(button, picker)\n255\t    document.body.append(wrapper)\n256\t\n257\t    button.querySelector('button')?.click()\n258\t    t.ok(picker.isOpen, 'picker opens')\n259\t\n260\t    picker.querySelector<HTMLElement>(\n261\t        '[role=\"tab\"][aria-label=\"People\"]'\n262\t    )?.click()\n263\t    const panel = picker.querySelector(\n264\t        '.emoji-picker-panel'\n265\t    ) as HTMLElement\n266\t    const btnRect = button.getBoundingClientRect()\n267\t    const panelRect = panel.getBoundingClientRect()\n268\t\n269\t    t.ok(\n270\t        panelRect.top >= btnRect.bottom - 1,\n271\t        'picker top is at or below the button bottom'\n272\t    )\n273\t    t.ok(\n274\t        Math.abs(panelRect.left - btnRect.left) < 2,\n275\t        'picker left aligns with the button left'\n276\t    )\n277\t\n278\t    picker.close()\n279\t    picker.remove()\n280\t    wrapper.remove()\n281\t})\n282\t\n283\ttest('button subpath exports only EmojiButton', t => {\n284\t    const buttonExports = packageJson.exports['./button'] as {\n285\t        import:string;\n286\t        require:string;\n287\t    }|undefined\n288\t    t.ok(buttonExports, 'button subpath is declared')\n289\t    t.equal(\n290\t        buttonExports?.import,\n291\t        './dist/button.js',\n292\t        'button import subpath points to the ESM build'\n293\t    )\n294\t    t.equal(\n295\t        buttonExports?.require,\n296\t        './dist/button.cjs',\n297\t        'button require subpath points to the CommonJS build'\n298\t    )\n299\t})\n300\t\n301\ttest('main entrypoint exports all component classes', t => {\n302\t    t.equal(\n303\t        MainEmojiPicker,\n304\t        EmojiPicker,\n305\t        'main entrypoint exports EmojiPicker'\n306\t    )\n307\t    t.equal(\n308\t        MainEmojiButton,\n309\t        EmojiButton,\n310\t        'main entrypoint exports EmojiButton'\n311\t    )\n312\t    t.equal(\n313\t        EmojiInput,\n314\t        customElements.get('emoji-input'),\n315\t        'main entrypoint exports EmojiInput'\n316\t    )\n317\t})\n318\t\n319\ttest('emoji-picker defaults to the recently used tab', t => {\n320\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n321\t    document.body.appendChild(picker)\n322\t\n323\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n324\t    const recentsTab = tabs[0]\n325\t    t.equal(\n326\t        recentsTab?.getAttribute('aria-selected'),\n327\t        'true',\n328\t        'recently used tab is selected by default'\n329\t    )\n330\t    const peopleTab = tabs[1]\n331\t    t.equal(\n332\t        peopleTab?.getAttribute('aria-selected'),\n333\t        'false',\n334\t        'people tab is not selected by default'\n335\t    )\n336\t    picker.remove()\n337\t})\n338\t\n339\ttest('emoji-picker renders category tabs and an eight-column grid', t => {\n340\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n341\t    document.body.appendChild(picker)\n342\t    picker.open()\n343\t\n344\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n345\t    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n346\t    t.equal(\n347\t        tabs[0]?.getAttribute('aria-label'),\n348\t        'Recently used',\n349\t        'recents is the first tab'\n350\t    )\n351\t    t.equal(\n352\t        tabs[1]?.getAttribute('aria-label'),\n353\t        'People',\n354\t        'people is the first emoji category'\n355\t    )\n356\t\n357\t    const grid = picker.querySelector('[role=\"grid\"]')\n358\t    t.ok(grid, 'renders an emoji grid')\n359\t\n360\t    const natureTab = picker.querySelector<HTMLElement>(\n361\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n362\t    )\n363\t    natureTab?.click()\n364\t    t.ok(\n365\t        grid?.textContent?.includes('🐒'),\n366\t        'category tab filters the grid'\n367\t    )\n368\t    picker.remove()\n369\t})\n370\t\n371\ttest('emoji-picker stays open when switching categories', t => {\n372\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n373\t    document.body.appendChild(picker)\n374\t    picker.open()\n375\t    t.ok(picker.isOpen, 'picker is open before tab click')\n376\t\n377\t    const natureTab = picker.querySelector<HTMLElement>(\n378\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n379\t    )\n380\t    natureTab?.click()\n381\t    t.ok(\n382\t        picker.isOpen,\n383\t        'picker stays open after clicking a category tab'\n384\t    )\n385\t    picker.close()\n386\t    picker.remove()\n387\t})\n388\t\n389\ttest('emoji-picker grid exists when open', t => {\n390\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n391\t    document.body.appendChild(picker)\n392\t    picker.open()\n393\t\n394\t    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n395\t    t.ok(grid, 'grid exists')\n396\t    picker.close()\n397\t    picker.remove()\n398\t})\n399\t\n400\ttest('emoji-picker grid has an accessible label', t => {\n401\t    const picker = document.createElement(\n402\t        'emoji-picker'\n403\t    ) as EmojiPicker\n404\t    document.body.appendChild(picker)\n405\t    const grid = picker.querySelector('[role=\"grid\"]')\n406\t    t.equal(\n407\t        grid?.getAttribute('aria-label'),\n408\t        'Emoji',\n409\t        'grid has aria-label'\n410\t    )\n411\t    picker.remove()\n412\t})\n413\t\n414\ttest('emoji-picker search controls the grid', t => {\n415\t    const picker = document.createElement(\n416\t        'emoji-picker'\n417\t    ) as EmojiPicker\n418\t    document.body.appendChild(picker)\n419\t    const search = picker.querySelector(\n420\t        'input[type=\"search\"]'\n421\t    )\n422\t    const grid = picker.querySelector('[role=\"grid\"]')\n423\t    t.ok(\n424\t        search?.getAttribute('aria-controls'),\n425\t        'search has aria-controls'\n426\t    )\n427\t    t.equal(\n428\t        search?.getAttribute('aria-controls'),\n429\t        grid?.id,\n430\t        'search aria-controls references the grid'\n431\t    )\n432\t    picker.remove()\n433\t})\n434\t\n435\ttest('emoji-picker moves focus to search on open', t => {\n436\t    const picker = document.createElement(\n437\t        'emoji-picker'\n438\t    ) as EmojiPicker\n439\t    document.body.appendChild(picker)\n440\t    picker.open()\n441\t    const search = picker.querySelector(\n442\t        'input[type=\"search\"]'\n443\t    )\n444\t    t.equal(\n445\t        document.activeElement,\n446\t        search,\n447\t        'search input is focused after open'\n448\t    )\n449\t    picker.close()\n450\t    picker.remove()\n451\t})\n452\t\n453\ttest('emoji-picker returns focus to trigger on close', t => {\n454\t    const trigger = document.createElement('button')\n455\t    trigger.textContent = 'trigger'\n456\t    document.body.appendChild(trigger)\n457\t    trigger.focus()\n458\t\n459\t    const picker = document.createElement(\n460\t        'emoji-picker'\n461\t    ) as EmojiPicker\n462\t    document.body.appendChild(picker)\n463\t    picker.open(trigger)\n464\t    picker.close()\n465\t    t.equal(\n466\t        document.activeElement,\n467\t        trigger,\n468\t        'focus returns to the trigger element'\n469\t    )\n470\t    picker.remove()\n471\t    trigger.remove()\n472\t})\n473\t\n474\ttest('open() from bubbling click handler leaves isOpen true', t => {\n475\t    const trigger = document.createElement('button')\n476\t    trigger.textContent = 'open picker'\n477\t    const picker = document.createElement(\n478\t        'emoji-picker'\n479\t    ) as EmojiPicker\n480\t    document.body.append(trigger, picker)\n481\t\n482\t    trigger.addEventListener('click', () => {\n483\t        picker.open(trigger)\n484\t    })\n485\t    trigger.click()\n486\t\n487\t    t.ok(\n488\t        picker.isOpen,\n489\t        'picker stays open after bubbling click'\n490\t    )\n491\t    picker.close()\n492\t    picker.remove()\n493\t    trigger.remove()\n494\t})\n495\t\n496\ttest('Escape with focus inside panel closes and restores focus', t => {\n497\t    const trigger = document.createElement('button')\n498\t    trigger.textContent = 'trigger'\n499\t    document.body.append(trigger)\n500\t    trigger.focus()\n501\t\n502\t    const picker = document.createElement(\n503\t        'emoji-picker'\n504\t    ) as EmojiPicker\n505\t    document.body.append(picker)\n506\t    picker.open(trigger)\n507\t    t.ok(picker.isOpen, 'picker is open')\n508\t\n509\t    const search = picker.querySelector<HTMLElement>(\n510\t        'input[type=\"search\"]'\n511\t    )\n512\t    t.equal(\n513\t        document.activeElement,\n514\t        search,\n515\t        'focus is inside panel'\n516\t    )\n517\t    keydown(picker, 'Escape')\n518\t    t.ok(!picker.isOpen, 'picker closed')\n519\t    t.equal(\n520\t        document.activeElement,\n521\t        trigger,\n522\t        'focus returned to trigger'\n523\t    )\n524\t    picker.remove()\n525\t    trigger.remove()\n526\t})\n527\t\n528\ttest('programmatic close() with focus inside restores trigger', t => {\n529\t    const trigger = document.createElement('button')\n530\t    trigger.textContent = 'trigger'\n531\t    document.body.append(trigger)\n532\t    trigger.focus()\n533\t\n534\t    const picker = document.createElement(\n535\t        'emoji-picker'\n536\t    ) as EmojiPicker\n537\t    document.body.append(picker)\n538\t    picker.open(trigger)\n539\t\n540\t    const search = picker.querySelector<HTMLElement>(\n541\t        'input[type=\"search\"]'\n542\t    )\n543\t    search?.focus()\n544\t    picker.close()\n545\t    t.equal(\n546\t        document.activeElement,\n547\t        trigger,\n548\t        'focus returned to trigger on programmatic close'\n549\t    )\n550\t    picker.remove()\n551\t    trigger.remove()\n552\t})\n553\t\n554\ttest('selection with for field focuses that field', t => {\n555\t    const field = document.createElement('textarea')\n556\t    field.id = 'select-focus-target'\n557\t    const trigger = document.createElement('button')\n558\t    trigger.textContent = 'trigger'\n559\t    document.body.append(field, trigger)\n560\t\n561\t    const picker = document.createElement(\n562\t        'emoji-picker'\n563\t    ) as EmojiPicker\n564\t    picker.setAttribute('for', field.id)\n565\t    picker.emojis = [{\n566\t        emoji:'🧈',\n567\t        name:'butter',\n568\t        keywords:['food'],\n569\t        category:'people',\n570\t    }]\n571\t    document.body.append(picker)\n572\t    trigger.focus()\n573\t    picker.open(trigger)\n574\t    picker.querySelector<HTMLElement>(\n575\t        '[role=\"tab\"][aria-label=\"People\"]'\n576\t    )?.click()\n577\t\n578\t    picker.querySelector<HTMLButtonElement>(\n579\t        '[role=\"gridcell\"] button'\n580\t    )?.click()\n581\t\n582\t    t.equal(\n583\t        document.activeElement,\n584\t        field,\n585\t        'focus moved to the for field after selection'\n586\t    )\n587\t    t.ok(\n588\t        field.value.includes('🧈'),\n589\t        'emoji was inserted'\n590\t    )\n591\t    picker.remove()\n592\t    field.remove()\n593\t    trigger.remove()\n594\t})\n595\t\n596\ttest('selection without for field focuses trigger', t => {\n597\t    const trigger = document.createElement('button')\n598\t    trigger.textContent = 'trigger'\n599\t    document.body.append(trigger)\n600\t\n601\t    const picker = document.createElement(\n602\t        'emoji-picker'\n603\t    ) as EmojiPicker\n604\t    picker.emojis = [{\n605\t        emoji:'🧈',\n606\t        name:'butter',\n607\t        keywords:['food'],\n608\t        category:'people',\n609\t    }]\n610\t    document.body.append(picker)\n611\t    trigger.focus()\n612\t    picker.open(trigger)\n613\t    picker.querySelector<HTMLElement>(\n614\t        '[role=\"tab\"][aria-label=\"People\"]'\n615\t    )?.click()\n616\t\n617\t    picker.querySelector<HTMLButtonElement>(\n618\t        '[role=\"gridcell\"] button'\n619\t    )?.click()\n620\t\n621\t    t.equal(\n622\t        document.activeElement,\n623\t        trigger,\n624\t        'focus returned to trigger after selection'\n625\t    )\n626\t    picker.remove()\n627\t    trigger.remove()\n628\t})\n629\t\n630\ttest('isOpen false after light dismiss', t => {\n631\t    const picker = document.createElement(\n632\t        'emoji-picker'\n633\t    ) as EmojiPicker\n634\t    document.body.append(picker)\n635\t    picker.open()\n636\t    t.ok(picker.isOpen, 'starts open')\n637\t\n638\t    const panel = picker.querySelector<HTMLElement>(\n639\t        '.emoji-picker-panel'\n640\t    )\n641\t    panel?.dispatchEvent(new ToggleEvent('toggle', {\n642\t        newState:'closed',\n643\t        oldState:'open',\n644\t    }))\n645\t\n646\t    t.ok(\n647\t        !picker.isOpen,\n648\t        'isOpen is false after toggle event'\n649\t    )\n650\t    picker.remove()\n651\t})\n652\t\n653\ttest('removing picker while open does not move focus', t => {\n654\t    const trigger = document.createElement('button')\n655\t    trigger.textContent = 'trigger'\n656\t    const other = document.createElement('button')\n657\t    other.textContent = 'other'\n658\t    document.body.append(trigger, other)\n659\t\n660\t    const picker = document.createElement(\n661\t        'emoji-picker'\n662\t    ) as EmojiPicker\n663\t    document.body.append(picker)\n664\t    trigger.focus()\n665\t    picker.open(trigger)\n666\t\n667\t    other.focus()\n668\t    picker.remove()\n669\t\n670\t    t.equal(\n671\t        document.activeElement,\n672\t        other,\n673\t        'focus stays on other after disconnect'\n674\t    )\n675\t    trigger.remove()\n676\t    other.remove()\n677\t})\n678\t\n679\ttest('button opens picker with custom tag name', t => {\n680\t    class CustomPicker extends EmojiPicker {}\n681\t    const tag = 'custom-emoji-picker'\n682\t    if (!customElements.get(tag)) {\n683\t        customElements.define(tag, CustomPicker)\n684\t    }\n685\t\n686\t    const picker = document.createElement(tag) as EmojiPicker\n687\t    picker.id = 'custom-tag-picker'\n688\t    const btn = document.createElement(\n689\t        'emoji-button'\n690\t    ) as EmojiButton\n691\t    btn.setAttribute('for', picker.id)\n692\t    document.body.append(picker, btn)\n693\t\n694\t    btn.querySelector('button')?.click()\n695\t    t.ok(\n696\t        picker.isOpen,\n697\t        'button opened the custom-tagged picker'\n698\t    )\n699\t    picker.close()\n700\t    picker.remove()\n701\t    btn.remove()\n702\t})\n703\t\n704\ttest('emoji-picker tabs use roving tabindex', t => {\n705\t    const picker = document.createElement(\n706\t        'emoji-picker'\n707\t    ) as EmojiPicker\n708\t    document.body.appendChild(picker)\n709\t\n710\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n711\t    const selected = tabs[0]\n712\t    const notSelected = tabs[1]\n713\t    t.equal(\n714\t        selected?.getAttribute('tabindex'),\n715\t        '0',\n716\t        'selected tab has tabindex 0'\n717\t    )\n718\t    t.equal(\n719\t        notSelected?.getAttribute('tabindex'),\n720\t        '-1',\n721\t        'non-selected tab has tabindex -1'\n722\t    )\n723\t    picker.remove()\n724\t})\n725\t\n726\ttest('emoji-picker tabs navigate with arrow keys', t => {\n727\t    const picker = document.createElement(\n728\t        'emoji-picker'\n729\t    ) as EmojiPicker\n730\t    document.body.appendChild(picker)\n731\t    picker.open()\n732\t\n733\t    const firstTab = picker.querySelector<HTMLElement>(\n734\t        '[role=\"tab\"]'\n735\t    )\n736\t    firstTab?.focus()\n737\t    keydown(firstTab!, 'ArrowRight')\n738\t\n739\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n740\t    t.equal(\n741\t        tabs[1]?.getAttribute('aria-selected'),\n742\t        'true',\n743\t        'ArrowRight activates the next tab'\n744\t    )\n745\t    t.equal(\n746\t        document.activeElement,\n747\t        tabs[1],\n748\t        'ArrowRight moves focus to the next tab'\n749\t    )\n750\t    picker.close()\n751\t    picker.remove()\n752\t})\n753\t\n754\ttest('emoji-picker search filters visible emoji', t => {\n755\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n756\t    document.body.appendChild(picker)\n757\t    picker.open()\n758\t\n759\t    const input = picker.querySelector<HTMLInputElement>(\n760\t        'input[type=\"search\"]'\n761\t    )\n762\t    t.ok(input, 'renders a search input')\n763\t    if (input) {\n764\t        input.value = 'butter'\n765\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n766\t    }\n767\t\n768\t    const grid = picker.querySelector('[role=\"grid\"]')\n769\t    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n770\t    t.ok(\n771\t        !grid?.textContent?.includes('😀'),\n772\t        'hides emoji that do not match the query'\n773\t    )\n774\t    picker.remove()\n775\t})\n776\t\n777\ttest('emoji-picker emits emoji-select and closes after selection', t => {\n778\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n779\t    document.body.appendChild(picker)\n780\t    picker.open()\n781\t\n782\t    const input = picker.querySelector<HTMLInputElement>(\n783\t        'input[type=\"search\"]'\n784\t    )\n785\t    if (input) {\n786\t        input.value = 'butter'\n787\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n788\t    }\n789\t\n790\t    const details:Array<EmojiSelectDetail> = []\n791\t    picker.addEventListener('emoji-select', (event) => {\n792\t        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n793\t    })\n794\t    const emoji = Array.from(\n795\t        picker.querySelectorAll<HTMLButtonElement>(\n796\t            '[role=\"gridcell\"] button'\n797\t        )\n798\t    ).find(button => button.textContent === '🧈')\n799\t    emoji?.click()\n800\t\n801\t    const detail = details[0]\n802\t    t.ok(detail, 'emits selection detail')\n803\t    if (detail) {\n804\t        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n805\t        t.equal(detail.query, 'butter', 'emits the current search query')\n806\t    }\n807\t    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n808\t    picker.remove()\n809\t})\n810\t\n811\ttest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n812\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n813\t    document.body.appendChild(picker)\n814\t    picker.open()\n815\t\n816\t    picker.querySelector<HTMLElement>(\n817\t        '[role=\"tab\"][aria-label=\"People\"]'\n818\t    )?.click()\n819\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n820\t        '[role=\"gridcell\"] button'\n821\t    )\n822\t    const first = buttons[0]\n823\t    first?.focus()\n824\t    if (first) keydown(first, 'ArrowRight')\n825\t    t.equal(\n826\t        document.activeElement,\n827\t        buttons[1],\n828\t        'ArrowRight moves to the next emoji'\n829\t    )\n830\t    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n831\t    t.equal(\n832\t        document.activeElement,\n833\t        buttons[9],\n834\t        'ArrowDown moves by one grid row'\n835\t    )\n836\t\n837\t    let selected = false\n838\t    picker.addEventListener('emoji-select', () => { selected = true })\n839\t    if (buttons[9]) keydown(buttons[9], 'Enter')\n840\t    t.ok(selected, 'Enter selects the focused emoji')\n841\t    t.ok(!picker.isOpen, 'Enter closes the picker')\n842\t\n843\t    picker.open()\n844\t    keydown(picker, 'Escape')\n845\t    t.ok(!picker.isOpen, 'Escape closes the picker')\n846\t    picker.remove()\n847\t})\n848\t\n849\ttest('Enter on a category tab activates it without emoji-select', t => {\n850\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n851\t    document.body.appendChild(picker)\n852\t    picker.open()\n853\t\n854\t    let selected = false\n855\t    picker.addEventListener('emoji-select', () => { selected = true })\n856\t\n857\t    const peopleTab = picker.querySelector<HTMLElement>(\n858\t        '[role=\"tab\"][aria-label=\"People\"]'\n859\t    )\n860\t    peopleTab?.focus()\n861\t    t.equal(\n862\t        document.activeElement,\n863\t        peopleTab,\n864\t        'focus is on the People tab'\n865\t    )\n866\t    if (peopleTab) {\n867\t        keydown(peopleTab, 'Enter')\n868\t        peopleTab.click()\n869\t    }\n870\t\n871\t    t.ok(!selected, 'Enter on tab does not emit emoji-select')\n872\t    const updatedPeopleTab = picker.querySelector<HTMLElement>(\n873\t        '[role=\"tab\"][aria-label=\"People\"]'\n874\t    )\n875\t    t.equal(\n876\t        updatedPeopleTab?.getAttribute('aria-selected'),\n877\t        'true',\n878\t        'People tab is now selected'\n879\t    )\n880\t    t.ok(picker.isOpen, 'picker stays open')\n881\t    picker.close()\n882\t    picker.remove()\n883\t})\n884\t\n885\ttest('Enter on a skin tone radio checks it without emoji-select', t => {\n886\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n887\t    document.body.appendChild(picker)\n888\t    picker.open()\n889\t\n890\t    let selected = false\n891\t    picker.addEventListener('emoji-select', () => { selected = true })\n892\t\n893\t    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n894\t    t.ok(radios.length >= 2, 'has skin tone radios')\n895\t    const second = radios[1]\n896\t    second?.focus()\n897\t    if (second) {\n898\t        keydown(second, 'Enter')\n899\t        second.click()\n900\t    }\n901\t\n902\t    t.ok(!selected, 'Enter on radio does not emit emoji-select')\n903\t    const updatedRadios = picker.querySelectorAll<HTMLElement>(\n904\t        '[role=\"radio\"]'\n905\t    )\n906\t    t.equal(\n907\t        updatedRadios[1]?.getAttribute('aria-checked'),\n908\t        'true',\n909\t        'radio is now checked'\n910\t    )\n911\t    t.ok(picker.isOpen, 'picker stays open')\n912\t    picker.close()\n913\t    picker.remove()\n914\t})\n915\t\n916\ttest('ArrowLeft in search box stays in search box', t => {\n917\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n918\t    document.body.appendChild(picker)\n919\t    picker.open()\n920\t\n921\t    const search = picker.querySelector<HTMLElement>(\n922\t        'input[type=\"search\"]'\n923\t    )\n924\t    t.equal(\n925\t        document.activeElement,\n926\t        search,\n927\t        'search is focused after open'\n928\t    )\n929\t    if (search) keydown(search, 'ArrowLeft')\n930\t    t.equal(\n931\t        document.activeElement,\n932\t        search,\n933\t        'focus stays in search after ArrowLeft'\n934\t    )\n935\t    if (search) keydown(search, 'ArrowRight')\n936\t    t.equal(\n937\t        document.activeElement,\n938\t        search,\n939\t        'focus stays in search after ArrowRight'\n940\t    )\n941\t    if (search) keydown(search, 'ArrowUp')\n942\t    t.equal(\n943\t        document.activeElement,\n944\t        search,\n945\t        'focus stays in search after ArrowUp'\n946\t    )\n947\t    picker.close()\n948\t    picker.remove()\n949\t})\n950\t\n951\ttest('ArrowDown in search box moves focus into grid', t => {\n952\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n953\t    document.body.appendChild(picker)\n954\t    picker.open()\n955\t\n956\t    picker.querySelector<HTMLElement>(\n957\t        '[role=\"tab\"][aria-label=\"People\"]'\n958\t    )?.click()\n959\t\n960\t    const search = picker.querySelector<HTMLElement>(\n961\t        'input[type=\"search\"]'\n962\t    )\n963\t    search?.focus()\n964\t    if (search) keydown(search, 'ArrowDown')\n965\t\n966\t    const firstBtn = picker.querySelector<HTMLElement>(\n967\t        '[role=\"gridcell\"] button'\n968\t    )\n969\t    t.equal(\n970\t        document.activeElement,\n971\t        firstBtn,\n972\t        'focus moves to the first gridcell button'\n973\t    )\n974\t    picker.close()\n975\t    picker.remove()\n976\t})\n977\t\n978\ttest('Enter in search with query selects first visible emoji', t => {\n979\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n980\t    document.body.appendChild(picker)\n981\t    picker.open()\n982\t\n983\t    const input = picker.querySelector<HTMLInputElement>(\n984\t        'input[type=\"search\"]'\n985\t    )\n986\t    if (input) {\n987\t        input.value = 'butter'\n988\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n989\t    }\n990\t\n991\t    const details:Array<EmojiSelectDetail> = []\n992\t    picker.addEventListener('emoji-select', (event) => {\n993\t        details.push(\n994\t            (event as CustomEvent<EmojiSelectDetail>).detail\n995\t        )\n996\t    })\n997\t\n998\t    if (input) keydown(input, 'Enter')\n999\t\n1000\t    t.equal(details.length, 1, 'emits emoji-select')\n1001\t    t.ok(\n1002\t        details[0]?.emoji.name.startsWith('butter'),\n1003\t        'selects the first visible emoji matching the query'\n1004\t    )\n1005\t    picker.close()\n1006\t    picker.remove()\n1007\t})\n1008\t\n1009\ttest('ArrowRight on tone radio moves and checks next radio', t => {\n1010\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1011\t    document.body.appendChild(picker)\n1012\t    picker.open()\n1013\t\n1014\t    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n1015\t    t.ok(radios.length >= 3, 'has at least 3 radios')\n1016\t    radios[0]?.focus()\n1017\t    t.equal(\n1018\t        document.activeElement,\n1019\t        radios[0],\n1020\t        'first radio is focused'\n1021\t    )\n1022\t\n1023\t    if (radios[0]) keydown(radios[0], 'ArrowRight')\n1024\t\n1025\t    const updated = picker.querySelectorAll<HTMLElement>(\n1026\t        '[role=\"radio\"]'\n1027\t    )\n1028\t    t.equal(\n1029\t        document.activeElement,\n1030\t        updated[1],\n1031\t        'focus moved to second radio'\n1032\t    )\n1033\t    t.equal(\n1034\t        updated[1]?.getAttribute('aria-checked'),\n1035\t        'true',\n1036\t        'second radio is now checked'\n1037\t    )\n1038\t    t.equal(\n1039\t        updated[0]?.getAttribute('aria-checked'),\n1040\t        'false',\n1041\t        'first radio is unchecked'\n1042\t    )\n1043\t    picker.close()\n1044\t    picker.remove()\n1045\t})\n1046\t\n1047\ttest('after outside click, focus stays on clicked element', t => {\n1048\t    const picker = document.createElement(\n1049\t        'emoji-picker'\n1050\t    ) as EmojiPicker\n1051\t    const other = document.createElement('button')\n1052\t    other.textContent = 'other'\n1053\t    document.body.append(picker, other)\n1054\t    picker.open()\n1055\t    t.ok(picker.isOpen, 'picker is open')\n1056\t\n1057\t    other.focus()\n1058\t    picker.querySelector<HTMLElement>(\n1059\t        '.emoji-picker-panel'\n1060\t    )?.dispatchEvent(new ToggleEvent('toggle', {\n1061\t        newState:'closed',\n1062\t        oldState:'open',\n1063\t    }))\n1064\t\n1065\t    t.ok(\n1066\t        !picker.isOpen,\n1067\t        'picker reports closed after light dismiss'\n1068\t    )\n1069\t    t.equal(\n1070\t        document.activeElement,\n1071\t        other,\n1072\t        'focus stays on the clicked element'\n1073\t    )\n1074\t    picker.remove()\n1075\t    other.remove()\n1076\t})\n1077\t\n1078\ttest('emoji-picker inline mode stays in document flow', t => {\n1079\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1080\t    picker.setAttribute('inline', '')\n1081\t    document.body.appendChild(picker)\n1082\t\n1083\t    const grid = picker.querySelector('[role=\"grid\"]')\n1084\t    const panel = grid?.parentElement\n1085\t    t.ok(grid, 'inline mode still renders the picker grid')\n1086\t    t.ok(panel && !panel.hasAttribute('popover'),\n1087\t        'inline mode removes popover behavior')\n1088\t    t.equal(\n1089\t        getComputedStyle(panel as Element).position,\n1090\t        'static',\n1091\t        'inline mode uses in-flow positioning'\n1092\t    )\n1093\t    picker.remove()\n1094\t})\n1095\t\n1096\ttest('emoji-picker stores and restores capped recently used emoji', t => {\n1097\t    const key = 'emoji-picker-test-recents'\n1098\t    localStorage.removeItem(key)\n1099\t    const emojis:Array<EmojiEntry> = Array.from(\n1100\t        { length:25 },\n1101\t        (_, index) => ({\n1102\t            emoji:String.fromCodePoint(0x1f600 + index),\n1103\t            name:`test-${index}`,\n1104\t            keywords:[],\n1105\t            category:'people',\n1106\t        })\n1107\t    )\n1108\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1109\t    picker.setAttribute('recent-key', key)\n1110\t    picker.emojis = emojis\n1111\t    document.body.appendChild(picker)\n1112\t\n1113\t    for (const emoji of emojis) {\n1114\t        picker.open()\n1115\t        picker.querySelector<HTMLElement>(\n1116\t            '[role=\"tab\"][aria-label=\"People\"]'\n1117\t        )?.click()\n1118\t        const button = Array.from(\n1119\t            picker.querySelectorAll<HTMLButtonElement>(\n1120\t                '[role=\"gridcell\"] button'\n1121\t            )\n1122\t        ).find(item => item.textContent === emoji.emoji)\n1123\t        button?.click()\n1124\t    }\n1125\t\n1126\t    picker.open()\n1127\t    picker.querySelector<HTMLElement>(\n1128\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n1129\t    )?.click()\n1130\t    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n1131\t    t.equal(recents.length, 24, 'caps recents at 24 entries')\n1132\t    t.equal(\n1133\t        recents[0]?.textContent,\n1134\t        emojis[24]?.emoji,\n1135\t        'most recently selected emoji is first'\n1136\t    )\n1137\t\n1138\t    const duplicate = emojis[10]\n1139\t    picker.open()\n1140\t    picker.querySelector<HTMLElement>(\n1141\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n1142\t    )?.click()\n1143\t    Array.from(\n1144\t        picker.querySelectorAll<HTMLButtonElement>(\n1145\t            '[role=\"gridcell\"] button'\n1146\t        )\n1147\t    ).find(item => item.textContent === duplicate?.emoji)?.click()\n1148\t\n1149\t    picker.open()\n1150\t    picker.querySelector<HTMLElement>(\n1151\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n1152\t    )?.click()\n1153\t    t.equal(\n1154\t        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n1155\t        duplicate?.emoji,\n1156\t        'duplicate selection moves the emoji to the front'\n1157\t    )\n1158\t    picker.remove()\n1159\t\n1160\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n1161\t    restored.setAttribute('recent-key', key)\n1162\t    restored.emojis = emojis\n1163\t    document.body.appendChild(restored)\n1164\t    restored.open()\n1165\t    restored.querySelector<HTMLElement>(\n1166\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n1167\t    )?.click()\n1168\t    t.equal(\n1169\t        restored.querySelectorAll('[role=\"gridcell\"]').length,\n1170\t        24,\n1171\t        'restores recents from localStorage'\n1172\t    )\n1173\t    restored.remove()\n1174\t    localStorage.removeItem(key)\n1175\t})\n1176\t\n1177\ttest('emoji-picker applies and restores a selected skin tone', t => {\n1178\t    const key = 'emoji-picker-test-skin-tone'\n1179\t    localStorage.removeItem(key)\n1180\t    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n1181\t    t.ok(wave, 'has an emoji with skin tone variants')\n1182\t    if (!wave) return\n1183\t\n1184\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1185\t    picker.setAttribute('skin-tone-key', key)\n1186\t    picker.emojis = [wave]\n1187\t    document.body.appendChild(picker)\n1188\t\n1189\t    picker.querySelector<HTMLElement>(\n1190\t        '[role=\"tab\"][aria-label=\"People\"]'\n1191\t    )?.click()\n1192\t    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n1193\t    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n1194\t    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n1195\t    const waveButton = picker.querySelector<HTMLButtonElement>(\n1196\t        '[role=\"gridcell\"] button'\n1197\t    )\n1198\t    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n1199\t\n1200\t    let selected = ''\n1201\t    picker.addEventListener('emoji-select', (event) => {\n1202\t        selected = (event as CustomEvent<EmojiSelectDetail>)\n1203\t            .detail.emoji.emoji\n1204\t    })\n1205\t    waveButton?.click()\n1206\t    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n1207\t    picker.remove()\n1208\t\n1209\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n1210\t    restored.setAttribute('skin-tone-key', key)\n1211\t    restored.emojis = [wave]\n1212\t    document.body.appendChild(restored)\n1213\t    restored.querySelector<HTMLElement>(\n1214\t        '[role=\"tab\"][aria-label=\"People\"]'\n1215\t    )?.click()\n1216\t    t.equal(\n1217\t        restored.querySelector(\n1218\t            '[role=\"gridcell\"] button'\n1219\t        )?.textContent,\n1220\t        '👋🏿',\n1221\t        'restores the skin tone from localStorage'\n1222\t    )\n1223\t    restored.remove()\n1224\t    localStorage.removeItem(key)\n1225\t})\n1226\t\n1227\ttest('every gridcell sits inside a row and contains a button', t => {\n1228\t    const picker = document.createElement(\n1229\t        'emoji-picker'\n1230\t    ) as EmojiPicker\n1231\t    document.body.appendChild(picker)\n1232\t    picker.open()\n1233\t    picker.querySelector<HTMLElement>(\n1234\t        '[role=\"tab\"][aria-label=\"People\"]'\n1235\t    )?.click()\n1236\t\n1237\t    const rows = picker.querySelectorAll('[role=\"row\"]')\n1238\t    t.ok(rows.length > 0, 'grid has rows')\n1239\t\n1240\t    const cells = picker.querySelectorAll('[role=\"gridcell\"]')\n1241\t    t.ok(cells.length > 0, 'grid has gridcells')\n1242\t\n1243\t    for (const cell of Array.from(cells)) {\n1244\t        t.equal(\n1245\t            cell.closest('[role=\"row\"]')?.getAttribute('role'),\n1246\t            'row',\n1247\t            'gridcell is inside a row'\n1248\t        )\n1249\t        const buttons = cell.querySelectorAll('button')\n1250\t        t.equal(\n1251\t            buttons.length,\n1252\t            1,\n1253\t            'gridcell contains exactly one button'\n1254\t        )\n1255\t    }\n1256\t    picker.close()\n1257\t    picker.remove()\n1258\t})\n1259\t\n1260\ttest('exactly one gridcell button has tabindex 0', t => {\n1261\t    const picker = document.createElement(\n1262\t        'emoji-picker'\n1263\t    ) as EmojiPicker\n1264\t    document.body.appendChild(picker)\n1265\t    picker.open()\n1266\t    picker.querySelector<HTMLElement>(\n1267\t        '[role=\"tab\"][aria-label=\"People\"]'\n1268\t    )?.click()\n1269\t\n1270\t    const tabbable = () => picker.querySelectorAll(\n1271\t        '[role=\"gridcell\"] button[tabindex=\"0\"]'\n1272\t    )\n1273\t    t.equal(\n1274\t        tabbable().length, 1,\n1275\t        'one tabbable button after render'\n1276\t    )\n1277\t\n1278\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n1279\t        '[role=\"gridcell\"] button'\n1280\t    )\n1281\t    buttons[0]?.focus()\n1282\t    keydown(buttons[0]!, 'ArrowRight')\n1283\t    t.equal(\n1284\t        tabbable().length, 1,\n1285\t        'one tabbable button after arrow navigation'\n1286\t    )\n1287\t    t.equal(\n1288\t        tabbable()[0],\n1289\t        buttons[1],\n1290\t        'tabbable button is the focused one'\n1291\t    )\n1292\t\n1293\t    buttons[3]?.click()\n1294\t    picker.open()\n1295\t    picker.querySelector<HTMLElement>(\n1296\t        '[role=\"tab\"][aria-label=\"People\"]'\n1297\t    )?.click()\n1298\t    t.equal(\n1299\t        tabbable().length, 1,\n1300\t        'one tabbable button after click and re-render'\n1301\t    )\n1302\t    picker.close()\n1303\t    picker.remove()\n1304\t})\n1305\t\n1306\ttest('grid renders eight columns per row', t => {\n1307\t    const picker = document.createElement(\n1308\t        'emoji-picker'\n1309\t    ) as EmojiPicker\n1310\t    document.body.appendChild(picker)\n1311\t    picker.open()\n1312\t    picker.querySelector<HTMLElement>(\n1313\t        '[role=\"tab\"][aria-label=\"People\"]'\n1314\t    )?.click()\n1315\t\n1316\t    const rows = picker.querySelectorAll('[role=\"row\"]')\n1317\t    t.ok(rows.length > 1, 'has multiple rows')\n1318\t    const firstRowCells = rows[0]!\n1319\t        .querySelectorAll('[role=\"gridcell\"]')\n1320\t    t.equal(\n1321\t        firstRowCells.length, 8,\n1322\t        'first row has eight cells'\n1323\t    )\n1324\t    picker.close()\n1325\t    picker.remove()\n1326\t})\n1327\t\n1328\ttest('Enter on a focused grid cell emits emoji-select', t => {\n1329\t    const picker = document.createElement(\n1330\t        'emoji-picker'\n1331\t    ) as EmojiPicker\n1332\t    document.body.appendChild(picker)\n1333\t    picker.open()\n1334\t    picker.querySelector<HTMLElement>(\n1335\t        '[role=\"tab\"][aria-label=\"People\"]'\n1336\t    )?.click()\n1337\t\n1338\t    let detail:EmojiSelectDetail|null = null\n1339\t    picker.addEventListener('emoji-select', (ev) => {\n1340\t        detail = (ev as CustomEvent<EmojiSelectDetail>).detail\n1341\t    })\n1342\t\n1343\t    const btn = picker.querySelector<HTMLButtonElement>(\n1344\t        '[role=\"gridcell\"] button'\n1345\t    )\n1346\t    btn?.focus()\n1347\t    keydown(btn!, 'Enter')\n1348\t    t.ok(detail, 'Enter emits emoji-select')\n1349\t    t.ok(\n1350\t        detail!.emoji.emoji.length > 0,\n1351\t        'detail contains the emoji'\n1352\t    )\n1353\t    picker.close()\n1354\t    picker.remove()\n1355\t})\n1356\t\n1357\ttest('Home and End move to row start and end', t => {\n1358\t    const picker = document.createElement(\n1359\t        'emoji-picker'\n1360\t    ) as EmojiPicker\n1361\t    document.body.appendChild(picker)\n1362\t    picker.open()\n1363\t    picker.querySelector<HTMLElement>(\n1364\t        '[role=\"tab\"][aria-label=\"People\"]'\n1365\t    )?.click()\n1366\t\n1367\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n1368\t        '[role=\"gridcell\"] button'\n1369\t    )\n1370\t    const firstRow = picker.querySelector('[role=\"row\"]')\n1371\t    const rowLen = firstRow ?\n1372\t        firstRow.querySelectorAll('[role=\"gridcell\"]').length :\n1373\t        8\n1374\t\n1375\t    buttons[3]?.focus()\n1376\t    keydown(buttons[3]!, 'Home')\n1377\t    t.equal(\n1378\t        document.activeElement,\n1379\t        buttons[0],\n1380\t        'Home moves to the first cell in the row'\n1381\t    )\n1382\t\n1383\t    keydown(buttons[0]!, 'End')\n1384\t    t.equal(\n1385\t        document.activeElement,\n1386\t        buttons[rowLen - 1],\n1387\t        'End moves to the last cell in the row'\n1388\t    )\n1389\t    picker.close()\n1390\t    picker.remove()\n1391\t})\n1392\t\n1393\ttest('ArrowDown moves to the cell below using row length', t => {\n1394\t    const picker = document.createElement(\n1395\t        'emoji-picker'\n1396\t    ) as EmojiPicker\n1397\t    document.body.appendChild(picker)\n1398\t    picker.open()\n1399\t    picker.querySelector<HTMLElement>(\n1400\t        '[role=\"tab\"][aria-label=\"People\"]'\n1401\t    )?.click()\n1402\t\n1403\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n1404\t        '[role=\"gridcell\"] button'\n1405\t    )\n1406\t    const firstRow = picker.querySelector('[role=\"row\"]')\n1407\t    const rowLen = firstRow ?\n1408\t        firstRow.querySelectorAll('[role=\"gridcell\"]').length :\n1409\t        8\n1410\t\n1411\t    buttons[2]?.focus()\n1412\t    keydown(buttons[2]!, 'ArrowDown')\n1413\t    t.equal(\n1414\t        document.activeElement,\n1415\t        buttons[2 + rowLen],\n1416\t        'ArrowDown moves by the rendered row length'\n1417\t    )\n1418\t\n1419\t    keydown(buttons[2 + rowLen]!, 'ArrowUp')\n1420\t    t.equal(\n1421\t        document.activeElement,\n1422\t        buttons[2],\n1423\t        'ArrowUp moves back by the rendered row length'\n1424\t    )\n1425\t    picker.close()\n1426\t    picker.remove()\n1427\t})\n1428\t\n1429\ttest('Tab from search lands on tabbable cell', t => {\n1430\t    const picker = document.createElement(\n1431\t        'emoji-picker'\n1432\t    ) as EmojiPicker\n1433\t    document.body.appendChild(picker)\n1434\t    picker.open()\n1435\t    picker.querySelector<HTMLElement>(\n1436\t        '[role=\"tab\"][aria-label=\"People\"]'\n1437\t    )?.click()\n1438\t\n1439\t    const search = picker.querySelector<HTMLElement>(\n1440\t        'input[type=\"search\"]'\n1441\t    )\n1442\t    search?.focus()\n1443\t\n1444\t    const tabbable = picker.querySelector<HTMLButtonElement>(\n1445\t        '[role=\"gridcell\"] button[tabindex=\"0\"]'\n1446\t    )\n1447\t    t.ok(tabbable, 'a tabbable cell exists')\n1448\t\n1449\t    const nonTabbable = picker.querySelectorAll(\n1450\t        '[role=\"gridcell\"] button[tabindex=\"-1\"]'\n1451\t    )\n1452\t    t.ok(\n1453\t        nonTabbable.length > 0,\n1454\t        'other cells are not tabbable'\n1455\t    )\n1456\t    picker.close()\n1457\t    picker.remove()\n1458\t})\n1459\t\n1460\ttest('emoji-picker updates its preview when an emoji is hovered', t => {\n1461\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1462\t    picker.emojis = [{\n1463\t        emoji:'🧈',\n1464\t        name:'butter',\n1465\t        keywords:['food'],\n1466\t        category:'people',\n1467\t    }]\n1468\t    document.body.appendChild(picker)\n1469\t\n1470\t    const button = picker.querySelector<HTMLButtonElement>(\n1471\t        '[role=\"gridcell\"] button'\n1472\t    )\n1473\t    const preview = picker.querySelector('[role=\"status\"]')\n1474\t    t.ok(preview, 'renders a preview region')\n1475\t    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n1476\t    t.ok(\n1477\t        preview?.textContent?.includes('🧈'),\n1478\t        'preview shows the hovered emoji'\n1479\t    )\n1480\t    t.ok(\n1481\t        preview?.textContent?.includes('butter'),\n1482\t        'preview shows the hovered emoji name'\n1483\t    )\n1484\t    picker.remove()\n1485\t})\n1486\t\n1487\ttest('emoji-picker inserts into the field named by for', t => {\n1488\t    const field = document.createElement('textarea')\n1489\t    field.id = 'emoji-picker-target'\n1490\t    field.value = 'hello world'\n1491\t    field.setSelectionRange(6, 6)\n1492\t    document.body.appendChild(field)\n1493\t\n1494\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n1495\t    picker.setAttribute('for', field.id)\n1496\t    picker.emojis = [{\n1497\t        emoji:'🧈',\n1498\t        name:'butter',\n1499\t        keywords:['food'],\n1500\t        category:'people',\n1501\t    }]\n1502\t    document.body.appendChild(picker)\n1503\t    picker.open()\n1504\t    picker.querySelector<HTMLButtonElement>(\n1505\t        '[role=\"gridcell\"] button'\n1506\t    )?.click()\n1507\t\n1508\t    t.equal(\n1509\t        field.value,\n1510\t        'hello 🧈world',\n1511\t        'inserts the selected emoji at the field caret'\n1512\t    )\n1513\t    picker.remove()\n1514\t    field.remove()\n1515\t})\n1516\t\n1517\ttest('element has correct defaults', t => {\n1518\t    const { el } = setup()\n1519\t    t.equal(el.minChars, 2, 'minChars defaults to 2')\n1520\t    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n1521\t    t.ok(el.emojis.length > 0, 'has default emoji data')\n1522\t    el.remove()\n1523\t})\n1524\t\n1525\ttest('auto-attaches to child textarea', t => {\n1526\t    const { el, textarea } = setup()\n1527\t    t.equal(\n1528\t        textarea.getAttribute('aria-autocomplete'),\n1529\t        'list',\n1530\t        'textarea gets aria-autocomplete=list'\n1531\t    )\n1532\t    el.remove()\n1533\t})\n1534\t\n1535\ttest('attaches to child added after connect', async t => {\n1536\t    t.plan(1)\n1537\t    const el = document.createElement(\n1538\t        'emoji-input'\n1539\t    ) as EmojiInput\n1540\t    document.body.appendChild(el)\n1541\t    const textarea = document.createElement('textarea')\n1542\t    el.appendChild(textarea)\n1543\t    await sleep(50)\n1544\t    t.equal(\n1545\t        textarea.getAttribute('aria-autocomplete'),\n1546\t        'list',\n1547\t        'MutationObserver picks up late child'\n1548\t    )\n1549\t    el.remove()\n1550\t})\n1551\t\n1552\ttest('attaches via for attribute', t => {\n1553\t    const textarea = document.createElement('textarea')\n1554\t    textarea.id = 'test-external-field'\n1555\t    document.body.appendChild(textarea)\n1556\t\n1557\t    const el = document.createElement(\n1558\t        'emoji-input'\n1559\t    ) as EmojiInput\n1560\t    el.setAttribute('for', 'test-external-field')\n1561\t    el.emojis = SMALL_SET\n1562\t    document.body.appendChild(el)\n1563\t\n1564\t    t.equal(\n1565\t        textarea.getAttribute('aria-autocomplete'),\n1566\t        'list',\n1567\t        'external field gets aria-autocomplete'\n1568\t    )\n1569\t\n1570\t    simulateInput(textarea, ':pizza')\n1571\t    t.ok(el.isOpen, 'popover opens for external field')\n1572\t\n1573\t    el.remove()\n1574\t    textarea.remove()\n1575\t})\n1576\t\n1577\ttest('works with input element', t => {\n1578\t    const el = document.createElement(\n1579\t        'emoji-input'\n1580\t    ) as EmojiInput\n1581\t    const input = document.createElement('input')\n1582\t    input.type = 'text'\n1583\t    el.appendChild(input)\n1584\t    document.body.appendChild(el)\n1585\t    el.emojis = SMALL_SET\n1586\t\n1587\t    simulateInput(input, ':pizza')\n1588\t    t.ok(el.isOpen, 'popover opens for input element')\n1589\t\n1590\t    keydown(input, 'Enter')\n1591\t    t.ok(\n1592\t        input.value.includes('🍕'),\n1593\t        'emoji inserted into input'\n1594\t    )\n1595\t\n1596\t    el.remove()\n1597\t})\n1598\t\n1599\t// -- Trigger behavior ------------------------------------------\n1600\t\n1601\ttest('popover opens on valid trigger', t => {\n1602\t    const { el, textarea } = setup(SMALL_SET)\n1603\t    simulateInput(textarea, 'hello :sm')\n1604\t    t.ok(el.isOpen, 'opens for :sm after space')\n1605\t    el.remove()\n1606\t})\n1607\t\n1608\ttest('popover opens at start of input', t => {\n1609\t    const { el, textarea } = setup(SMALL_SET)\n1610\t    simulateInput(textarea, ':sm')\n1611\t    t.ok(el.isOpen, 'opens when colon at position 0')\n1612\t    el.remove()\n1613\t})\n1614\t\n1615\ttest('does not open for short query', t => {\n1616\t    const { el, textarea } = setup(SMALL_SET)\n1617\t    simulateInput(textarea, ':s')\n1618\t    t.ok(\n1619\t        !el.isOpen,\n1620\t        'stays closed with 1 char (minChars=2)'\n1621\t    )\n1622\t    el.remove()\n1623\t})\n1624\t\n1625\ttest('does not trigger after word character', t => {\n1626\t    const { el, textarea } = setup(SMALL_SET)\n1627\t    simulateInput(textarea, 'word:sm')\n1628\t    t.ok(\n1629\t        !el.isOpen,\n1630\t        'no trigger when colon follows letter'\n1631\t    )\n1632\t    el.remove()\n1633\t})\n1634\t\n1635\ttest('triggers after opening paren', t => {\n1636\t    const { el, textarea } = setup(SMALL_SET)\n1637\t    simulateInput(textarea, '(:sm')\n1638\t    t.ok(el.isOpen, 'triggers after (')\n1639\t    el.remove()\n1640\t})\n1641\t\n1642\ttest('closes when trigger disappears', t => {\n1643\t    const { el, textarea } = setup(SMALL_SET)\n1644\t    simulateInput(textarea, ':sm')\n1645\t    t.ok(el.isOpen, 'opens first')\n1646\t    simulateInput(textarea, 'no trigger here')\n1647\t    t.ok(!el.isOpen, 'closes when no trigger')\n1648\t    el.remove()\n1649\t})\n1650\t\n1651\ttest('search is case-insensitive', t => {\n1652\t    const { el, textarea } = setup(SMALL_SET)\n1653\t    simulateInput(textarea, ':SM')\n1654\t    t.ok(el.isOpen, 'opens for uppercase query')\n1655\t    const items = listItems(el)\n1656\t    t.ok(items.length >= 1, 'finds results')\n1657\t    el.remove()\n1658\t})\n1659\t\n1660\t// -- Search results --------------------------------------------\n1661\t\n1662\ttest('finds results by name prefix', t => {\n1663\t    const { el, textarea } = setup(SMALL_SET)\n1664\t    simulateInput(textarea, ':sm')\n1665\t    const items = listItems(el)\n1666\t    t.ok(items.length >= 2, 'matches name prefixes')\n1667\t    el.remove()\n1668\t})\n1669\t\n1670\ttest('finds results by name substring', t => {\n1671\t    const { el, textarea } = setup(SMALL_SET)\n1672\t    simulateInput(textarea, ':burger')\n1673\t    const items = listItems(el)\n1674\t    t.ok(items.length >= 1, 'matches name substrings')\n1675\t    el.remove()\n1676\t})\n1677\t\n1678\ttest('finds results by keyword', t => {\n1679\t    const { el, textarea } = setup(SMALL_SET)\n1680\t    simulateInput(textarea, ':lit')\n1681\t    const items = listItems(el)\n1682\t    t.ok(items.length >= 1, 'matches keywords')\n1683\t    el.remove()\n1684\t})\n1685\t\n1686\ttest('respects maxResults', t => {\n1687\t    const { el, textarea } = setup(SMALL_SET)\n1688\t    el.maxResults = 2\n1689\t    simulateInput(textarea, ':sm')\n1690\t    const items = listItems(el)\n1691\t    t.ok(items.length <= 2, 'results capped at maxResults')\n1692\t    el.remove()\n1693\t})\n1694\t\n1695\ttest('shows empty state for no matches', t => {\n1696\t    const { el, textarea } = setup(SMALL_SET)\n1697\t    simulateInput(textarea, ':zzzzzz')\n1698\t    t.ok(\n1699\t        el.isOpen,\n1700\t        'popover opens even with no matches'\n1701\t    )\n1702\t    const items = listItems(el)\n1703\t    t.equal(items.length, 0, 'no result items')\n1704\t    const empty = el.querySelector(\n1705\t        '.emoji-search-empty'\n1706\t    )\n1707\t    t.ok(empty, 'empty state element shown')\n1708\t    el.remove()\n1709\t})\n1710\t\n1711\t// -- Keyboard navigation --------------------------------------\n1712\t\n1713\ttest('first item selected by default', t => {\n1714\t    const { el, textarea } = setup(SMALL_SET)\n1715\t    simulateInput(textarea, ':sm')\n1716\t    const items = listItems(el)\n1717\t    t.equal(\n1718\t        items[0]?.getAttribute('aria-selected'),\n1719\t        'true',\n1720\t        'first item is selected'\n1721\t    )\n1722\t    el.remove()\n1723\t})\n1724\t\n1725\ttest('ArrowDown moves selection forward', t => {\n1726\t    const { el, textarea } = setup(SMALL_SET)\n1727\t    simulateInput(textarea, ':sm')\n1728\t    keydown(textarea, 'ArrowDown')\n1729\t    const items = listItems(el)\n1730\t    t.equal(\n1731\t        items[0]?.getAttribute('aria-selected'),\n1732\t        'false',\n1733\t        'first item deselected'\n1734\t    )\n1735\t    t.equal(\n1736\t        items[1]?.getAttribute('aria-selected'),\n1737\t        'true',\n1738\t        'second item selected'\n1739\t    )\n1740\t    el.remove()\n1741\t})\n1742\t\n1743\ttest('ArrowUp wraps from first to last', t => {\n1744\t    const { el, textarea } = setup(SMALL_SET)\n1745\t    simulateInput(textarea, ':sm')\n1746\t    const items = listItems(el)\n1747\t    const lastIdx = items.length - 1\n1748\t    keydown(textarea, 'ArrowUp')\n1749\t    t.equal(\n1750\t        items[lastIdx]?.getAttribute('aria-selected'),\n1751\t        'true',\n1752\t        'last item selected after wrap'\n1753\t    )\n1754\t    el.remove()\n1755\t})\n1756\t\n1757\ttest('ArrowDown wraps from last to first', t => {\n1758\t    const { el, textarea } = setup(SMALL_SET)\n1759\t    simulateInput(textarea, ':sm')\n1760\t    const items = listItems(el)\n1761\t    const count = items.length\n1762\t    for (let i = 0; i < count; i++) {\n1763\t        keydown(textarea, 'ArrowDown')\n1764\t    }\n1765\t    t.equal(\n1766\t        items[0]?.getAttribute('aria-selected'),\n1767\t        'true',\n1768\t        'wraps back to first'\n1769\t    )\n1770\t    el.remove()\n1771\t})\n1772\t\n1773\ttest('aria-activedescendant tracks selection', t => {\n1774\t    const { el, textarea } = setup(SMALL_SET)\n1775\t    simulateInput(textarea, ':sm')\n1776\t    const first = textarea.getAttribute(\n1777\t        'aria-activedescendant'\n1778\t    )\n1779\t    t.ok(first, 'set when popover opens')\n1780\t    keydown(textarea, 'ArrowDown')\n1781\t    const second = textarea.getAttribute(\n1782\t        'aria-activedescendant'\n1783\t    )\n1784\t    t.notEqual(\n1785\t        first, second,\n1786\t        'changes on navigation'\n1787\t    )\n1788\t    el.remove()\n1789\t})\n1790\t\n1791\t// -- Commit behavior -------------------------------------------\n1792\t\n1793\ttest('Enter commits the selected emoji', t => {\n1794\t    const { el, textarea } = setup(SMALL_SET)\n1795\t    simulateInput(textarea, ':pizza')\n1796\t    keydown(textarea, 'Enter')\n1797\t    t.ok(!el.isOpen, 'popover closes')\n1798\t    t.ok(\n1799\t        textarea.value.includes('🍕'),\n1800\t        'emoji inserted'\n1801\t    )\n1802\t    t.ok(\n1803\t        !textarea.value.includes(':pizza'),\n1804\t        'trigger text replaced'\n1805\t    )\n1806\t    el.remove()\n1807\t})\n1808\t\n1809\ttest('Tab commits the selected emoji', t => {\n1810\t    const { el, textarea } = setup(SMALL_SET)\n1811\t    simulateInput(textarea, ':pizza')\n1812\t    keydown(textarea, 'Tab')\n1813\t    t.ok(!el.isOpen, 'popover closes')\n1814\t    t.ok(\n1815\t        textarea.value.includes('🍕'),\n1816\t        'emoji inserted via Tab'\n1817\t    )\n1818\t    el.remove()\n1819\t})\n1820\t\n1821\ttest('Escape closes without inserting', t => {\n1822\t    const { el, textarea } = setup(SMALL_SET)\n1823\t    simulateInput(textarea, ':pizza')\n1824\t    t.ok(el.isOpen, 'popover open')\n1825\t    keydown(textarea, 'Escape')\n1826\t    t.ok(!el.isOpen, 'popover closes')\n1827\t    t.ok(\n1828\t        textarea.value.includes(':pizza'),\n1829\t        'original text preserved'\n1830\t    )\n1831\t    el.remove()\n1832\t})\n1833\t\n1834\ttest('committed emoji has trailing space', t => {\n1835\t    const { el, textarea } = setup(SMALL_SET)\n1836\t    simulateInput(textarea, ':pizza')\n1837\t    keydown(textarea, 'Enter')\n1838\t    t.ok(\n1839\t        textarea.value.endsWith(' '),\n1840\t        'space after emoji'\n1841\t    )\n1842\t    el.remove()\n1843\t})\n1844\t\n1845\ttest('preserves text before trigger', t => {\n1846\t    const { el, textarea } = setup(SMALL_SET)\n1847\t    simulateInput(textarea, 'hello :pizza')\n1848\t    keydown(textarea, 'Enter')\n1849\t    t.ok(\n1850\t        textarea.value.startsWith('hello '),\n1851\t        'preceding text kept'\n1852\t    )\n1853\t    t.ok(\n1854\t        textarea.value.includes('🍕'),\n1855\t        'emoji inserted after prefix'\n1856\t    )\n1857\t    el.remove()\n1858\t})\n1859\t\n1860\ttest('navigated commit inserts correct emoji', t => {\n1861\t    const { el, textarea } = setup(SMALL_SET)\n1862\t    simulateInput(textarea, ':sm')\n1863\t    keydown(textarea, 'ArrowDown')\n1864\t    keydown(textarea, 'Enter')\n1865\t    t.ok(\n1866\t        textarea.value.includes('😄'),\n1867\t        'second result emoji inserted'\n1868\t    )\n1869\t    el.remove()\n1870\t})\n1871\t\n1872\ttest('click on item commits emoji', t => {\n1873\t    const { el, textarea } = setup(SMALL_SET)\n1874\t    simulateInput(textarea, ':pizza')\n1875\t    const items = listItems(el)\n1876\t    t.ok(items.length > 0, 'has items to click')\n1877\t    items[0]?.click()\n1878\t    t.ok(!el.isOpen, 'closes after click')\n1879\t    t.ok(\n1880\t        textarea.value.includes('🍕'),\n1881\t        'emoji inserted on click'\n1882\t    )\n1883\t    el.remove()\n1884\t})\n1885\t\n1886\t// -- Events ----------------------------------------------------\n1887\t\n1888\ttest('emoji-select event fires on commit', async t => {\n1889\t    t.plan(3)\n1890\t    const { el, textarea } = setup(SMALL_SET)\n1891\t\n1892\t    el.addEventListener('emoji-select', ((\n1893\t        ev:CustomEvent<EmojiSelectDetail>\n1894\t    ) => {\n1895\t        t.ok(ev.detail.emoji, 'has emoji detail')\n1896\t        t.equal(\n1897\t            ev.detail.emoji.name, 'pizza',\n1898\t            'correct emoji name'\n1899\t        )\n1900\t        t.equal(\n1901\t            ev.detail.query, 'pizza',\n1902\t            'correct query string'\n1903\t        )\n1904\t    }) as EventListener)\n1905\t\n1906\t    simulateInput(textarea, ':pizza')\n1907\t    keydown(textarea, 'Enter')\n1908\t    el.remove()\n1909\t})\n1910\t\n1911\ttest('emoji-select event bubbles', async t => {\n1912\t    t.plan(1)\n1913\t    const { el, textarea } = setup(SMALL_SET)\n1914\t\n1915\t    document.body.addEventListener(\n1916\t        'emoji-select',\n1917\t        function handler () {\n1918\t            t.ok(true, 'event bubbles to body')\n1919\t            document.body.removeEventListener(\n1920\t                'emoji-select', handler\n1921\t            )\n1922\t        }\n1923\t    )\n1924\t\n1925\t    simulateInput(textarea, ':pizza')\n1926\t    keydown(textarea, 'Enter')\n1927\t    el.remove()\n1928\t})\n1929\t\n1930\t// -- Configuration ---------------------------------------------\n1931\t\n1932\ttest('minChars can be lowered', t => {\n1933\t    const { el, textarea } = setup(SMALL_SET)\n1934\t    el.minChars = 1\n1935\t    simulateInput(textarea, ':s')\n1936\t    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n1937\t    el.remove()\n1938\t})\n1939\t\n1940\ttest('custom emoji data', t => {\n1941\t    const custom:EmojiEntry[] = [\n1942\t        {\n1943\t            emoji:'🧪',\n1944\t            name:'test_tube',\n1945\t            keywords:['science'],\n1946\t        },\n1947\t    ]\n1948\t    const { el, textarea } = setup(custom)\n1949\t    simulateInput(textarea, ':test')\n1950\t    const items = listItems(el)\n1951\t    t.equal(items.length, 1, 'finds custom emoji')\n1952\t    keydown(textarea, 'Enter')\n1953\t    t.ok(\n1954\t        textarea.value.includes('🧪'),\n1955\t        'custom emoji inserted'\n1956\t    )\n1957\t    el.remove()\n1958\t})\n1959\t\n1960\t// -- Lifecycle -------------------------------------------------\n1961\t\n1962\ttest('detach prevents further triggers', t => {\n1963\t    const { el, textarea } = setup(SMALL_SET)\n1964\t    el.detach()\n1965\t    simulateInput(textarea, ':pizza')\n1966\t    t.ok(!el.isOpen, 'no popover after detach')\n1967\t    el.remove()\n1968\t})\n1969\t\n1970\ttest('re-attach after detach', t => {\n1971\t    const { el, textarea } = setup(SMALL_SET)\n1972\t    el.detach()\n1973\t    el.attach(textarea)\n1974\t    simulateInput(textarea, ':pizza')\n1975\t    t.ok(el.isOpen, 'works after re-attach')\n1976\t    el.remove()\n1977\t})\n1978\t\n1979\ttest('popover re-opens after close', t => {\n1980\t    const { el, textarea } = setup(SMALL_SET)\n1981\t    simulateInput(textarea, ':pizza')\n1982\t    t.ok(el.isOpen, 'opens first time')\n1983\t    keydown(textarea, 'Escape')\n1984\t    t.ok(!el.isOpen, 'closes on Escape')\n1985\t    simulateInput(textarea, ':cat')\n1986\t    t.ok(el.isOpen, 'opens again with new query')\n1987\t    el.remove()\n1988\t})\n1989\t\n1990\ttest('aria-controls set and cleared', t => {\n1991\t    const { el, textarea } = setup(SMALL_SET)\n1992\t    simulateInput(textarea, ':sm')\n1993\t    t.ok(\n1994\t        textarea.hasAttribute('aria-controls'),\n1995\t        'set when open'\n1996\t    )\n1997\t    keydown(textarea, 'Escape')\n1998\t    t.ok(\n1999\t        !textarea.hasAttribute('aria-controls'),\n2000\t        'removed on close'\n2001\t    )\n2002\t    el.remove()\n2003\t})\n2004\t\n2005\ttest('Enter with isComposing true does not commit', t => {\n2006\t    const { el, textarea } = setup(SMALL_SET)\n2007\t    simulateInput(textarea, ':pizza')\n2008\t    t.ok(el.isOpen, 'popover is open')\n2009\t    keydown(textarea, 'Enter', { isComposing:true })\n2010\t    t.ok(el.isOpen, 'popover stays open during IME')\n2011\t    t.ok(\n2012\t        textarea.value.includes(':pizza'),\n2013\t        'trigger text not replaced during IME'\n2014\t    )\n2015\t    t.ok(\n2016\t        !textarea.value.includes('🍕'),\n2017\t        'no emoji inserted during IME'\n2018\t    )\n2019\t    el.remove()\n2020\t})\n2021\t\n2022\ttest('keyCode 229 does not commit', t => {\n2023\t    const { el, textarea } = setup(SMALL_SET)\n2024\t    simulateInput(textarea, ':pizza')\n2025\t    t.ok(el.isOpen, 'popover is open')\n2026\t    keydown(textarea, 'Enter', { keyCode:229 })\n2027\t    t.ok(el.isOpen, 'popover stays open for keyCode 229')\n2028\t    el.remove()\n2029\t})\n2030\t\n2031\ttest('detach removes all aria attributes from field', t => {\n2032\t    const { el, textarea } = setup(SMALL_SET)\n2033\t    simulateInput(textarea, ':pizza')\n2034\t    t.ok(el.isOpen, 'popover opened')\n2035\t    el.detach()\n2036\t    t.ok(\n2037\t        !textarea.hasAttribute('aria-autocomplete'),\n2038\t        'aria-autocomplete removed'\n2039\t    )\n2040\t    t.ok(\n2041\t        !textarea.hasAttribute('aria-controls'),\n2042\t        'aria-controls removed'\n2043\t    )\n2044\t    t.ok(\n2045\t        !textarea.hasAttribute('aria-activedescendant'),\n2046\t        'aria-activedescendant removed'\n2047\t    )\n2048\t    el.remove()\n2049\t})\n2050\t\n2051\ttest('minChars assigned before upgrade is honored', t => {\n2052\t    const tag = `emoji-input-pre-${Math.random().toString(36).slice(2, 8)}`\n2053\t    const el = document.createElement(tag) as EmojiInput\n2054\t    const textarea = document.createElement('textarea')\n2055\t    el.appendChild(textarea)\n2056\t    ;(el as any).minChars = 1\n2057\t    document.body.appendChild(el)\n2058\t    customElements.define(tag, class extends EmojiInput {\n2059\t        static TAG = tag\n2060\t    })\n2061\t    customElements.upgrade(el)\n2062\t    t.equal(el.minChars, 1, 'minChars survived upgrade')\n2063\t    simulateInput(textarea, ':s')\n2064\t    t.ok(el.isOpen, 'opens with 1 char after pre-upgrade minChars=1')\n2065\t    el.remove()\n2066\t})\n2067\t\n2068\ttest('emojis assigned before upgrade is used for search', t => {\n2069\t    const tag = `emoji-input-pre2-${Math.random().toString(36).slice(2, 8)}`\n2070\t    const el = document.createElement(tag) as EmojiInput\n2071\t    const textarea = document.createElement('textarea')\n2072\t    el.appendChild(textarea)\n2073\t    const custom:EmojiEntry[] = [\n2074\t        { emoji:'🧪', name:'test_tube', keywords:['science'] },\n2075\t    ]\n2076\t    ;(el as any).emojis = custom\n2077\t    document.body.appendChild(el)\n2078\t    customElements.define(tag, class extends EmojiInput {\n2079\t        static TAG = tag\n2080\t    })\n2081\t    customElements.upgrade(el)\n2082\t    t.equal(el.emojis, custom, 'emojis survived upgrade')\n2083\t    simulateInput(textarea, ':test')\n2084\t    const items = listItems(el)\n2085\t    t.ok(items.length >= 1, 'finds pre-upgrade custom emoji')\n2086\t    el.remove()\n2087\t})\n2088\t\n2089\ttest('adopts existing rendered list child', t => {\n2090\t    const el = document.createElement('emoji-input') as EmojiInput\n2091\t    const textarea = document.createElement('textarea')\n2092\t    const uid = 'ssr-test'\n2093\t    const wrapper = document.createElement('div')\n2094\t    wrapper.innerHTML = EmojiInput.render(uid)\n2095\t    const list = wrapper.firstElementChild as HTMLElement\n2096\t    el.appendChild(textarea)\n2097\t    el.appendChild(list)\n2098\t    document.body.appendChild(el)\n2099\t    const lists = el.querySelectorAll('[role=\"listbox\"]')\n2100\t    t.equal(lists.length, 1, 'exactly one listbox exists')\n2101\t    el.emojis = SMALL_SET\n2102\t    simulateInput(textarea, ':pizza')\n2103\t    t.ok(el.isOpen, 'popover works with adopted list')\n2104\t    el.remove()\n2105\t})\n2106\t\n2107\ttest('disconnectedCallback cleans up', t => {\n2108\t    const { el, textarea } = setup(SMALL_SET)\n2109\t    simulateInput(textarea, ':pizza')\n2110\t    t.ok(el.isOpen, 'opens while connected')\n2111\t    el.remove()\n2112\t    simulateInput(textarea, ':cat')\n2113\t    t.ok(!el.isOpen, 'no trigger after disconnect')\n2114\t})\n2115\t\n2116\tfunction setup (emojis?:EmojiEntry[]):{\n2117\t    el:EmojiInput;\n2118\t    textarea:HTMLTextAreaElement;\n2119\t} {\n2120\t    const el = document.createElement('emoji-input') as EmojiInput\n2121\t    const textarea = document.createElement('textarea')\n2122\t    el.appendChild(textarea)\n2123\t    document.body.appendChild(el)\n2124\t    if (emojis) el.emojis = emojis\n2125\t    return { el, textarea }\n2126\t}\n2127\t\n2128\tfunction simulateInput (\n2129\t    field:HTMLTextAreaElement|HTMLInputElement,\n2130\t    value:string,\n2131\t):void {\n2132\t    field.value = value\n2133\t    field.selectionStart = value.length\n2134\t    field.selectionEnd = value.length\n2135\t    field.dispatchEvent(\n2136\t        new InputEvent('input', { bubbles:true })\n2137\t    )\n2138\t}\n2139\t\n2140\tfunction keydown (\n2141\t    field:HTMLElement,\n2142\t    key:string,\n2143\t    opts?:KeyboardEventInit,\n2144\t):void {\n2145\t    field.dispatchEvent(new KeyboardEvent('keydown', {\n2146\t        key,\n2147\t        bubbles:true,\n2148\t        cancelable:true,\n2149\t        ...opts,\n2150\t    }))\n2151\t}\n2152\t\n2153\tfunction listItems (\n2154\t    el:EmojiInput,\n2155\t):NodeListOf<HTMLElement> {\n2156\t    return el.querySelectorAll(\n2157\t        '.emoji-search-item'\n2158\t    )\n2159\t}\n2160\t"}]},"parent_tool_use_id":null,"session_id":"6da8e044-980b-454b-b3d1-29ae769542a1","uuid":"ba920f23-e636-4f78-b38e-1847b4b85260","timestamp":"2026-09-23T18:59:22.460Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-07-inline-display-mode/test/index.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { sleep } from '@substrate-system/dom'\nimport {\n    EmojiInput,\n    EmojiButton as MainEmojiButton,\n    EmojiPicker as MainEmojiPicker,\n    DEFAULT_EMOJIS,\n    type EmojiEntry,\n    type EmojiSelectDetail,\n} from '../src/index.js'\nimport { EmojiPicker } from '../src/picker.js'\nimport { EmojiButton } from '../src/button.js'\nimport { search } from '../src/search.js'\nimport packageJson from '../package.json'\nimport buttonCss from '../src/button.css'\nimport pickerCss from '../src/picker.css'\n\nconst _style = document.createElement('style')\n_style.textContent = [buttonCss, pickerCss].join('\\n')\ndocument.head.appendChild(_style)\n\n// -- Helpers ---------------------------------------------------\n\nconst SMALL_SET:EmojiEntry[] = [\n    {\n        emoji:'😀',\n        name:'grinning',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😃',\n        name:'smiley',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😄',\n        name:'smile',\n        keywords:['happy', 'laugh'],\n    },\n    {\n        emoji:'🍕',\n        name:'pizza',\n        keywords:['food'],\n    },\n    {\n        emoji:'🍔',\n        name:'hamburger',\n        keywords:['burger', 'food'],\n    },\n    {\n        emoji:'🔥',\n        name:'fire',\n        keywords:['lit', 'hot'],\n    },\n    {\n        emoji:'🐱',\n        name:'cat',\n        keywords:['kitty'],\n    },\n    {\n        emoji:'🐶',\n        name:'dog',\n        keywords:['puppy'],\n    },\n]\n\n// -- Static render (Node-compatible) ---------------------------\n\ntest('static render returns an HTML string', t => {\n    const html = EmojiInput.render('test-uid')\n    t.equal(typeof html, 'string', 'returns a string')\n    t.ok(\n        html.includes('emoji-search-list'),\n        'contains the list class'\n    )\n    t.ok(\n        html.includes('role=\"listbox\"'),\n        'has listbox role'\n    )\n    t.ok(\n        html.includes('aria-label=\"Emoji suggestions\"'),\n        'listbox has an accessible label'\n    )\n    t.ok(\n        html.includes('id=\"test-uid-list\"'),\n        'uses the uid for the element id'\n    )\n    t.ok(\n        html.includes('popover=\"manual\"'),\n        'has popover attribute'\n    )\n})\n\n// -- Data structure --------------------------------------------\n\ntest('DEFAULT_EMOJIS has expected structure', t => {\n    t.ok(\n        DEFAULT_EMOJIS.length >= 1800,\n        'contains the complete emoji-mart set'\n    )\n\n    const first = DEFAULT_EMOJIS[0]\n    t.equal(\n        typeof first.emoji, 'string',\n        'emoji field is a string'\n    )\n    t.equal(\n        typeof first.name, 'string',\n        'name field is a string'\n    )\n    t.ok(\n        Array.isArray(first.keywords),\n        'keywords is an array'\n    )\n})\n\ntest('DEFAULT_EMOJIS includes category and skin data', t => {\n    const butter = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'butter'\n    )\n\n    t.ok(butter, 'includes butter')\n    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n    t.ok(butter?.category, 'includes a category')\n    t.ok(Array.isArray(butter?.categories), 'includes categories')\n\n    const wave = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'wave'\n    )\n    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n})\n\ntest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n    const invalid = DEFAULT_EMOJIS.filter(\n        e => !e.emoji || !e.name\n    )\n    t.equal(\n        invalid.length, 0,\n        'no entries missing emoji or name'\n    )\n})\n\ntest('shared search ranks name prefixes before substrings', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'pineapple', keywords:[] },\n        { emoji:'2', name:'apple', keywords:[] },\n        { emoji:'3', name:'grape', keywords:[] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['apple', 'pineapple']),\n        'prefix matches rank before substring matches'\n    )\n})\n\ntest('shared search ranks keyword prefixes after name matches', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'grape', keywords:['apple'] },\n        { emoji:'2', name:'pineapple', keywords:[] },\n        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['pineapple', 'grape', 'fruit']),\n        'keyword prefix matches rank after name matches'\n    )\n})\n\n// -- Registration and setup ------------------------------------\n\ntest('custom element is registered', t => {\n    const ctor = customElements.get('emoji-input')\n    t.ok(ctor, 'emoji-input tag is defined')\n    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n})\n\ntest('emoji-picker custom element is registered', t => {\n    const ctor = customElements.get('emoji-picker')\n    t.ok(ctor, 'emoji-picker tag is defined')\n    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    t.ok(picker.emojis.length > 0, 'has default emoji data')\n    t.ok(!picker.isOpen, 'starts closed')\n    picker.remove()\n})\n\ntest('emoji-button custom element renders an accessible smiley button', t => {\n    const ctor = customElements.get('emoji-button')\n    t.ok(ctor, 'emoji-button tag is defined')\n    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n    const inner = button.querySelector('button')\n    t.ok(inner, 'renders a native button')\n    t.equal(inner?.type, 'button', 'button does not submit forms')\n    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n    t.ok(\n        inner?.querySelector('.visually-hidden'),\n        'has a visually-hidden label'\n    )\n    button.remove()\n})\n\ntest('emoji-button uses currentColor', t => {\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n\n    const svg = button.querySelector('svg')\n    t.equal(\n        svg?.getAttribute('fill'),\n        'currentColor',\n        'the SVG inherits its fill from currentColor'\n    )\n    button.remove()\n})\n\ntest('emoji-button opens the picker named by for', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'button-picker-target'\n    let opens = 0\n    picker.open = () => { opens++ }\n\n    const button = document.createElement('emoji-button')\n    button.setAttribute('for', picker.id)\n    document.body.append(picker, button)\n    button.querySelector('button')?.click()\n\n    t.equal(opens, 1, 'click calls the referenced picker open method')\n    button.remove()\n    picker.remove()\n})\n\ntest('emoji-button positions the picker below itself', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'position-test-picker'\n    picker.setAttribute('for', 'position-target')\n\n    const wrapper = document.createElement('div')\n    wrapper.style.position = 'relative'\n    wrapper.style.marginTop = '120px'\n    wrapper.style.marginLeft = '200px'\n\n    const button = document.createElement('emoji-button') as EmojiButton\n    button.setAttribute('for', picker.id)\n\n    wrapper.append(button, picker)\n    document.body.append(wrapper)\n\n    button.querySelector('button')?.click()\n    t.ok(picker.isOpen, 'picker opens')\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const panel = picker.querySelector(\n        '.emoji-picker-panel'\n    ) as HTMLElement\n    const btnRect = button.getBoundingClientRect()\n    const panelRect = panel.getBoundingClientRect()\n\n    t.ok(\n        panelRect.top >= btnRect.bottom - 1,\n        'picker top is at or below the button bottom'\n    )\n    t.ok(\n        Math.abs(panelRect.left - btnRect.left) < 2,\n        'picker left aligns with the button left'\n    )\n\n    picker.close()\n    picker.remove()\n    wrapper.remove()\n})\n\ntest('button subpath exports only EmojiButton', t => {\n    const buttonExports = packageJson.exports['./button'] as {\n        import:string;\n        require:string;\n    }|undefined\n    t.ok(buttonExports, 'button subpath is declared')\n    t.equal(\n        buttonExports?.import,\n        './dist/button.js',\n        'button import subpath points to the ESM build'\n    )\n    t.equal(\n        buttonExports?.require,\n        './dist/button.cjs',\n        'button require subpath points to the CommonJS build'\n    )\n})\n\ntest('main entrypoint exports all component classes', t => {\n    t.equal(\n        MainEmojiPicker,\n        EmojiPicker,\n        'main entrypoint exports EmojiPicker'\n    )\n    t.equal(\n        MainEmojiButton,\n        EmojiButton,\n        'main entrypoint exports EmojiButton'\n    )\n    t.equal(\n        EmojiInput,\n        customElements.get('emoji-input'),\n        'main entrypoint exports EmojiInput'\n    )\n})\n\ntest('emoji-picker defaults to the recently used tab', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const recentsTab = tabs[0]\n    t.equal(\n        recentsTab?.getAttribute('aria-selected'),\n        'true',\n        'recently used tab is selected by default'\n    )\n    const peopleTab = tabs[1]\n    t.equal(\n        peopleTab?.getAttribute('aria-selected'),\n        'false',\n        'people tab is not selected by default'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker renders category tabs and an eight-column grid', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n    t.equal(\n        tabs[0]?.getAttribute('aria-label'),\n        'Recently used',\n        'recents is the first tab'\n    )\n    t.equal(\n        tabs[1]?.getAttribute('aria-label'),\n        'People',\n        'people is the first emoji category'\n    )\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid, 'renders an emoji grid')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        grid?.textContent?.includes('🐒'),\n        'category tab filters the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stays open when switching categories', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'picker is open before tab click')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        picker.isOpen,\n        'picker stays open after clicking a category tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid exists when open', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n    t.ok(grid, 'grid exists')\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid has an accessible label', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.equal(\n        grid?.getAttribute('aria-label'),\n        'Emoji',\n        'grid has aria-label'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker search controls the grid', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(\n        search?.getAttribute('aria-controls'),\n        'search has aria-controls'\n    )\n    t.equal(\n        search?.getAttribute('aria-controls'),\n        grid?.id,\n        'search aria-controls references the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker moves focus to search on open', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'search input is focused after open'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker returns focus to trigger on close', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.appendChild(trigger)\n    trigger.focus()\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open(trigger)\n    picker.close()\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returns to the trigger element'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('open() from bubbling click handler leaves isOpen true', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'open picker'\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.append(trigger, picker)\n\n    trigger.addEventListener('click', () => {\n        picker.open(trigger)\n    })\n    trigger.click()\n\n    t.ok(\n        picker.isOpen,\n        'picker stays open after bubbling click'\n    )\n    picker.close()\n    picker.remove()\n    trigger.remove()\n})\n\ntest('Escape with focus inside panel closes and restores focus', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.append(trigger)\n    trigger.focus()\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.append(picker)\n    picker.open(trigger)\n    t.ok(picker.isOpen, 'picker is open')\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'focus is inside panel'\n    )\n    keydown(picker, 'Escape')\n    t.ok(!picker.isOpen, 'picker closed')\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returned to trigger'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('programmatic close() with focus inside restores trigger', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.append(trigger)\n    trigger.focus()\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.append(picker)\n    picker.open(trigger)\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    search?.focus()\n    picker.close()\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returned to trigger on programmatic close'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('selection with for field focuses that field', t => {\n    const field = document.createElement('textarea')\n    field.id = 'select-focus-target'\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.append(field, trigger)\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    picker.setAttribute('for', field.id)\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.append(picker)\n    trigger.focus()\n    picker.open(trigger)\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )?.click()\n\n    t.equal(\n        document.activeElement,\n        field,\n        'focus moved to the for field after selection'\n    )\n    t.ok(\n        field.value.includes('🧈'),\n        'emoji was inserted'\n    )\n    picker.remove()\n    field.remove()\n    trigger.remove()\n})\n\ntest('selection without for field focuses trigger', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.append(trigger)\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.append(picker)\n    trigger.focus()\n    picker.open(trigger)\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )?.click()\n\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returned to trigger after selection'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('isOpen false after light dismiss', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.append(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'starts open')\n\n    const panel = picker.querySelector<HTMLElement>(\n        '.emoji-picker-panel'\n    )\n    panel?.dispatchEvent(new ToggleEvent('toggle', {\n        newState:'closed',\n        oldState:'open',\n    }))\n\n    t.ok(\n        !picker.isOpen,\n        'isOpen is false after toggle event'\n    )\n    picker.remove()\n})\n\ntest('removing picker while open does not move focus', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    const other = document.createElement('button')\n    other.textContent = 'other'\n    document.body.append(trigger, other)\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.append(picker)\n    trigger.focus()\n    picker.open(trigger)\n\n    other.focus()\n    picker.remove()\n\n    t.equal(\n        document.activeElement,\n        other,\n        'focus stays on other after disconnect'\n    )\n    trigger.remove()\n    other.remove()\n})\n\ntest('button opens picker with custom tag name', t => {\n    class CustomPicker extends EmojiPicker {}\n    const tag = 'custom-emoji-picker'\n    if (!customElements.get(tag)) {\n        customElements.define(tag, CustomPicker)\n    }\n\n    const picker = document.createElement(tag) as EmojiPicker\n    picker.id = 'custom-tag-picker'\n    const btn = document.createElement(\n        'emoji-button'\n    ) as EmojiButton\n    btn.setAttribute('for', picker.id)\n    document.body.append(picker, btn)\n\n    btn.querySelector('button')?.click()\n    t.ok(\n        picker.isOpen,\n        'button opened the custom-tagged picker'\n    )\n    picker.close()\n    picker.remove()\n    btn.remove()\n})\n\ntest('emoji-picker tabs use roving tabindex', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const selected = tabs[0]\n    const notSelected = tabs[1]\n    t.equal(\n        selected?.getAttribute('tabindex'),\n        '0',\n        'selected tab has tabindex 0'\n    )\n    t.equal(\n        notSelected?.getAttribute('tabindex'),\n        '-1',\n        'non-selected tab has tabindex -1'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker tabs navigate with arrow keys', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const firstTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"]'\n    )\n    firstTab?.focus()\n    keydown(firstTab!, 'ArrowRight')\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(\n        tabs[1]?.getAttribute('aria-selected'),\n        'true',\n        'ArrowRight activates the next tab'\n    )\n    t.equal(\n        document.activeElement,\n        tabs[1],\n        'ArrowRight moves focus to the next tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker search filters visible emoji', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    t.ok(input, 'renders a search input')\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n    t.ok(\n        !grid?.textContent?.includes('😀'),\n        'hides emoji that do not match the query'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker emits emoji-select and closes after selection', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const details:Array<EmojiSelectDetail> = []\n    picker.addEventListener('emoji-select', (event) => {\n        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n    })\n    const emoji = Array.from(\n        picker.querySelectorAll<HTMLButtonElement>(\n            '[role=\"gridcell\"] button'\n        )\n    ).find(button => button.textContent === '🧈')\n    emoji?.click()\n\n    const detail = details[0]\n    t.ok(detail, 'emits selection detail')\n    if (detail) {\n        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n        t.equal(detail.query, 'butter', 'emits the current search query')\n    }\n    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n    picker.remove()\n})\n\ntest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    const first = buttons[0]\n    first?.focus()\n    if (first) keydown(first, 'ArrowRight')\n    t.equal(\n        document.activeElement,\n        buttons[1],\n        'ArrowRight moves to the next emoji'\n    )\n    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n    t.equal(\n        document.activeElement,\n        buttons[9],\n        'ArrowDown moves by one grid row'\n    )\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n    if (buttons[9]) keydown(buttons[9], 'Enter')\n    t.ok(selected, 'Enter selects the focused emoji')\n    t.ok(!picker.isOpen, 'Enter closes the picker')\n\n    picker.open()\n    keydown(picker, 'Escape')\n    t.ok(!picker.isOpen, 'Escape closes the picker')\n    picker.remove()\n})\n\ntest('Enter on a category tab activates it without emoji-select', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n\n    const peopleTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )\n    peopleTab?.focus()\n    t.equal(\n        document.activeElement,\n        peopleTab,\n        'focus is on the People tab'\n    )\n    if (peopleTab) {\n        keydown(peopleTab, 'Enter')\n        peopleTab.click()\n    }\n\n    t.ok(!selected, 'Enter on tab does not emit emoji-select')\n    const updatedPeopleTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )\n    t.equal(\n        updatedPeopleTab?.getAttribute('aria-selected'),\n        'true',\n        'People tab is now selected'\n    )\n    t.ok(picker.isOpen, 'picker stays open')\n    picker.close()\n    picker.remove()\n})\n\ntest('Enter on a skin tone radio checks it without emoji-select', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n\n    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n    t.ok(radios.length >= 2, 'has skin tone radios')\n    const second = radios[1]\n    second?.focus()\n    if (second) {\n        keydown(second, 'Enter')\n        second.click()\n    }\n\n    t.ok(!selected, 'Enter on radio does not emit emoji-select')\n    const updatedRadios = picker.querySelectorAll<HTMLElement>(\n        '[role=\"radio\"]'\n    )\n    t.equal(\n        updatedRadios[1]?.getAttribute('aria-checked'),\n        'true',\n        'radio is now checked'\n    )\n    t.ok(picker.isOpen, 'picker stays open')\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowLeft in search box stays in search box', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'search is focused after open'\n    )\n    if (search) keydown(search, 'ArrowLeft')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowLeft'\n    )\n    if (search) keydown(search, 'ArrowRight')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowRight'\n    )\n    if (search) keydown(search, 'ArrowUp')\n    t.equal(\n        document.activeElement,\n        search,\n        'focus stays in search after ArrowUp'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowDown in search box moves focus into grid', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    search?.focus()\n    if (search) keydown(search, 'ArrowDown')\n\n    const firstBtn = picker.querySelector<HTMLElement>(\n        '[role=\"gridcell\"] button'\n    )\n    t.equal(\n        document.activeElement,\n        firstBtn,\n        'focus moves to the first gridcell button'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('Enter in search with query selects first visible emoji', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const details:Array<EmojiSelectDetail> = []\n    picker.addEventListener('emoji-select', (event) => {\n        details.push(\n            (event as CustomEvent<EmojiSelectDetail>).detail\n        )\n    })\n\n    if (input) keydown(input, 'Enter')\n\n    t.equal(details.length, 1, 'emits emoji-select')\n    t.ok(\n        details[0]?.emoji.name.startsWith('butter'),\n        'selects the first visible emoji matching the query'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowRight on tone radio moves and checks next radio', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const radios = picker.querySelectorAll<HTMLElement>('[role=\"radio\"]')\n    t.ok(radios.length >= 3, 'has at least 3 radios')\n    radios[0]?.focus()\n    t.equal(\n        document.activeElement,\n        radios[0],\n        'first radio is focused'\n    )\n\n    if (radios[0]) keydown(radios[0], 'ArrowRight')\n\n    const updated = picker.querySelectorAll<HTMLElement>(\n        '[role=\"radio\"]'\n    )\n    t.equal(\n        document.activeElement,\n        updated[1],\n        'focus moved to second radio'\n    )\n    t.equal(\n        updated[1]?.getAttribute('aria-checked'),\n        'true',\n        'second radio is now checked'\n    )\n    t.equal(\n        updated[0]?.getAttribute('aria-checked'),\n        'false',\n        'first radio is unchecked'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('after outside click, focus stays on clicked element', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    const other = document.createElement('button')\n    other.textContent = 'other'\n    document.body.append(picker, other)\n    picker.open()\n    t.ok(picker.isOpen, 'picker is open')\n\n    other.focus()\n    picker.querySelector<HTMLElement>(\n        '.emoji-picker-panel'\n    )?.dispatchEvent(new ToggleEvent('toggle', {\n        newState:'closed',\n        oldState:'open',\n    }))\n\n    t.ok(\n        !picker.isOpen,\n        'picker reports closed after light dismiss'\n    )\n    t.equal(\n        document.activeElement,\n        other,\n        'focus stays on the clicked element'\n    )\n    picker.remove()\n    other.remove()\n})\n\ntest('emoji-picker inline mode stays in document flow', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('inline', '')\n    document.body.appendChild(picker)\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    const panel = grid?.parentElement\n    t.ok(grid, 'inline mode still renders the picker grid')\n    t.ok(panel && !panel.hasAttribute('popover'),\n        'inline mode removes popover behavior')\n    t.equal(\n        getComputedStyle(panel as Element).position,\n        'static',\n        'inline mode uses in-flow positioning'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stores and restores capped recently used emoji', t => {\n    const key = 'emoji-picker-test-recents'\n    localStorage.removeItem(key)\n    const emojis:Array<EmojiEntry> = Array.from(\n        { length:25 },\n        (_, index) => ({\n            emoji:String.fromCodePoint(0x1f600 + index),\n            name:`test-${index}`,\n            keywords:[],\n            category:'people',\n        })\n    )\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('recent-key', key)\n    picker.emojis = emojis\n    document.body.appendChild(picker)\n\n    for (const emoji of emojis) {\n        picker.open()\n        picker.querySelector<HTMLElement>(\n            '[role=\"tab\"][aria-label=\"People\"]'\n        )?.click()\n        const button = Array.from(\n            picker.querySelectorAll<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )\n        ).find(item => item.textContent === emoji.emoji)\n        button?.click()\n    }\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n    t.equal(recents.length, 24, 'caps recents at 24 entries')\n    t.equal(\n        recents[0]?.textContent,\n        emojis[24]?.emoji,\n        'most recently selected emoji is first'\n    )\n\n    const duplicate = emojis[10]\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    Array.from(\n        picker.querySelectorAll<HTMLButtonElement>(\n            '[role=\"gridcell\"] button'\n        )\n    ).find(item => item.textContent === duplicate?.emoji)?.click()\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n        duplicate?.emoji,\n        'duplicate selection moves the emoji to the front'\n    )\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('recent-key', key)\n    restored.emojis = emojis\n    document.body.appendChild(restored)\n    restored.open()\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        restored.querySelectorAll('[role=\"gridcell\"]').length,\n        24,\n        'restores recents from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('emoji-picker applies and restores a selected skin tone', t => {\n    const key = 'emoji-picker-test-skin-tone'\n    localStorage.removeItem(key)\n    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n    t.ok(wave, 'has an emoji with skin tone variants')\n    if (!wave) return\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('skin-tone-key', key)\n    picker.emojis = [wave]\n    document.body.appendChild(picker)\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n    const waveButton = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n\n    let selected = ''\n    picker.addEventListener('emoji-select', (event) => {\n        selected = (event as CustomEvent<EmojiSelectDetail>)\n            .detail.emoji.emoji\n    })\n    waveButton?.click()\n    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('skin-tone-key', key)\n    restored.emojis = [wave]\n    document.body.appendChild(restored)\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    t.equal(\n        restored.querySelector(\n            '[role=\"gridcell\"] button'\n        )?.textContent,\n        '👋🏿',\n        'restores the skin tone from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('every gridcell sits inside a row and contains a button', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const rows = picker.querySelectorAll('[role=\"row\"]')\n    t.ok(rows.length > 0, 'grid has rows')\n\n    const cells = picker.querySelectorAll('[role=\"gridcell\"]')\n    t.ok(cells.length > 0, 'grid has gridcells')\n\n    for (const cell of Array.from(cells)) {\n        t.equal(\n            cell.closest('[role=\"row\"]')?.getAttribute('role'),\n            'row',\n            'gridcell is inside a row'\n        )\n        const buttons = cell.querySelectorAll('button')\n        t.equal(\n            buttons.length,\n            1,\n            'gridcell contains exactly one button'\n        )\n    }\n    picker.close()\n    picker.remove()\n})\n\ntest('exactly one gridcell button has tabindex 0', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const tabbable = () => picker.querySelectorAll(\n        '[role=\"gridcell\"] button[tabindex=\"0\"]'\n    )\n    t.equal(\n        tabbable().length, 1,\n        'one tabbable button after render'\n    )\n\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    buttons[0]?.focus()\n    keydown(buttons[0]!, 'ArrowRight')\n    t.equal(\n        tabbable().length, 1,\n        'one tabbable button after arrow navigation'\n    )\n    t.equal(\n        tabbable()[0],\n        buttons[1],\n        'tabbable button is the focused one'\n    )\n\n    buttons[3]?.click()\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    t.equal(\n        tabbable().length, 1,\n        'one tabbable button after click and re-render'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('grid renders eight columns per row', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const rows = picker.querySelectorAll('[role=\"row\"]')\n    t.ok(rows.length > 1, 'has multiple rows')\n    const firstRowCells = rows[0]!\n        .querySelectorAll('[role=\"gridcell\"]')\n    t.equal(\n        firstRowCells.length, 8,\n        'first row has eight cells'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('Enter on a focused grid cell emits emoji-select', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    let detail:EmojiSelectDetail|null = null\n    picker.addEventListener('emoji-select', (ev) => {\n        detail = (ev as CustomEvent<EmojiSelectDetail>).detail\n    })\n\n    const btn = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    btn?.focus()\n    keydown(btn!, 'Enter')\n    t.ok(detail, 'Enter emits emoji-select')\n    t.ok(\n        detail!.emoji.emoji.length > 0,\n        'detail contains the emoji'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('Home and End move to row start and end', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    const firstRow = picker.querySelector('[role=\"row\"]')\n    const rowLen = firstRow ?\n        firstRow.querySelectorAll('[role=\"gridcell\"]').length :\n        8\n\n    buttons[3]?.focus()\n    keydown(buttons[3]!, 'Home')\n    t.equal(\n        document.activeElement,\n        buttons[0],\n        'Home moves to the first cell in the row'\n    )\n\n    keydown(buttons[0]!, 'End')\n    t.equal(\n        document.activeElement,\n        buttons[rowLen - 1],\n        'End moves to the last cell in the row'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('ArrowDown moves to the cell below using row length', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    const firstRow = picker.querySelector('[role=\"row\"]')\n    const rowLen = firstRow ?\n        firstRow.querySelectorAll('[role=\"gridcell\"]').length :\n        8\n\n    buttons[2]?.focus()\n    keydown(buttons[2]!, 'ArrowDown')\n    t.equal(\n        document.activeElement,\n        buttons[2 + rowLen],\n        'ArrowDown moves by the rendered row length'\n    )\n\n    keydown(buttons[2 + rowLen]!, 'ArrowUp')\n    t.equal(\n        document.activeElement,\n        buttons[2],\n        'ArrowUp moves back by the rendered row length'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('Tab from search lands on tabbable cell', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n\n    const search = picker.querySelector<HTMLElement>(\n        'input[type=\"search\"]'\n    )\n    search?.focus()\n\n    const tabbable = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button[tabindex=\"0\"]'\n    )\n    t.ok(tabbable, 'a tabbable cell exists')\n\n    const nonTabbable = picker.querySelectorAll(\n        '[role=\"gridcell\"] button[tabindex=\"-1\"]'\n    )\n    t.ok(\n        nonTabbable.length > 0,\n        'other cells are not tabbable'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker updates its preview when an emoji is hovered', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n\n    const button = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )\n    const preview = picker.querySelector('[role=\"status\"]')\n    t.ok(preview, 'renders a preview region')\n    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n    t.ok(\n        preview?.textContent?.includes('🧈'),\n        'preview shows the hovered emoji'\n    )\n    t.ok(\n        preview?.textContent?.includes('butter'),\n        'preview shows the hovered emoji name'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker inserts into the field named by for', t => {\n    const field = document.createElement('textarea')\n    field.id = 'emoji-picker-target'\n    field.value = 'hello world'\n    field.setSelectionRange(6, 6)\n    document.body.appendChild(field)\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('for', field.id)\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"] button'\n    )?.click()\n\n    t.equal(\n        field.value,\n        'hello 🧈world',\n        'inserts the selected emoji at the field caret'\n    )\n    picker.remove()\n    field.remove()\n})\n\ntest('element has correct defaults', t => {\n    const { el } = setup()\n    t.equal(el.minChars, 2, 'minChars defaults to 2')\n    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n    t.ok(el.emojis.length > 0, 'has default emoji data')\n    el.remove()\n})\n\ntest('auto-attaches to child textarea', t => {\n    const { el, textarea } = setup()\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'textarea gets aria-autocomplete=list'\n    )\n    el.remove()\n})\n\ntest('attaches to child added after connect', async t => {\n    t.plan(1)\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    document.body.appendChild(el)\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    await sleep(50)\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'MutationObserver picks up late child'\n    )\n    el.remove()\n})\n\ntest('attaches via for attribute', t => {\n    const textarea = document.createElement('textarea')\n    textarea.id = 'test-external-field'\n    document.body.appendChild(textarea)\n\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    el.setAttribute('for', 'test-external-field')\n    el.emojis = SMALL_SET\n    document.body.appendChild(el)\n\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'external field gets aria-autocomplete'\n    )\n\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover opens for external field')\n\n    el.remove()\n    textarea.remove()\n})\n\ntest('works with input element', t => {\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    const input = document.createElement('input')\n    input.type = 'text'\n    el.appendChild(input)\n    document.body.appendChild(el)\n    el.emojis = SMALL_SET\n\n    simulateInput(input, ':pizza')\n    t.ok(el.isOpen, 'popover opens for input element')\n\n    keydown(input, 'Enter')\n    t.ok(\n        input.value.includes('🍕'),\n        'emoji inserted into input'\n    )\n\n    el.remove()\n})\n\n// -- Trigger behavior ------------------------------------------\n\ntest('popover opens on valid trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :sm')\n    t.ok(el.isOpen, 'opens for :sm after space')\n    el.remove()\n})\n\ntest('popover opens at start of input', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens when colon at position 0')\n    el.remove()\n})\n\ntest('does not open for short query', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':s')\n    t.ok(\n        !el.isOpen,\n        'stays closed with 1 char (minChars=2)'\n    )\n    el.remove()\n})\n\ntest('does not trigger after word character', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'word:sm')\n    t.ok(\n        !el.isOpen,\n        'no trigger when colon follows letter'\n    )\n    el.remove()\n})\n\ntest('triggers after opening paren', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, '(:sm')\n    t.ok(el.isOpen, 'triggers after (')\n    el.remove()\n})\n\ntest('closes when trigger disappears', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens first')\n    simulateInput(textarea, 'no trigger here')\n    t.ok(!el.isOpen, 'closes when no trigger')\n    el.remove()\n})\n\ntest('search is case-insensitive', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':SM')\n    t.ok(el.isOpen, 'opens for uppercase query')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'finds results')\n    el.remove()\n})\n\n// -- Search results --------------------------------------------\n\ntest('finds results by name prefix', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length >= 2, 'matches name prefixes')\n    el.remove()\n})\n\ntest('finds results by name substring', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':burger')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches name substrings')\n    el.remove()\n})\n\ntest('finds results by keyword', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':lit')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches keywords')\n    el.remove()\n})\n\ntest('respects maxResults', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.maxResults = 2\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length <= 2, 'results capped at maxResults')\n    el.remove()\n})\n\ntest('shows empty state for no matches', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':zzzzzz')\n    t.ok(\n        el.isOpen,\n        'popover opens even with no matches'\n    )\n    const items = listItems(el)\n    t.equal(items.length, 0, 'no result items')\n    const empty = el.querySelector(\n        '.emoji-search-empty'\n    )\n    t.ok(empty, 'empty state element shown')\n    el.remove()\n})\n\n// -- Keyboard navigation --------------------------------------\n\ntest('first item selected by default', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'first item is selected'\n    )\n    el.remove()\n})\n\ntest('ArrowDown moves selection forward', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'false',\n        'first item deselected'\n    )\n    t.equal(\n        items[1]?.getAttribute('aria-selected'),\n        'true',\n        'second item selected'\n    )\n    el.remove()\n})\n\ntest('ArrowUp wraps from first to last', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const lastIdx = items.length - 1\n    keydown(textarea, 'ArrowUp')\n    t.equal(\n        items[lastIdx]?.getAttribute('aria-selected'),\n        'true',\n        'last item selected after wrap'\n    )\n    el.remove()\n})\n\ntest('ArrowDown wraps from last to first', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const count = items.length\n    for (let i = 0; i < count; i++) {\n        keydown(textarea, 'ArrowDown')\n    }\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'wraps back to first'\n    )\n    el.remove()\n})\n\ntest('aria-activedescendant tracks selection', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const first = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.ok(first, 'set when popover opens')\n    keydown(textarea, 'ArrowDown')\n    const second = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.notEqual(\n        first, second,\n        'changes on navigation'\n    )\n    el.remove()\n})\n\n// -- Commit behavior -------------------------------------------\n\ntest('Enter commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted'\n    )\n    t.ok(\n        !textarea.value.includes(':pizza'),\n        'trigger text replaced'\n    )\n    el.remove()\n})\n\ntest('Tab commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Tab')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted via Tab'\n    )\n    el.remove()\n})\n\ntest('Escape closes without inserting', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover open')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes(':pizza'),\n        'original text preserved'\n    )\n    el.remove()\n})\n\ntest('committed emoji has trailing space', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.endsWith(' '),\n        'space after emoji'\n    )\n    el.remove()\n})\n\ntest('preserves text before trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.startsWith('hello '),\n        'preceding text kept'\n    )\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted after prefix'\n    )\n    el.remove()\n})\n\ntest('navigated commit inserts correct emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('😄'),\n        'second result emoji inserted'\n    )\n    el.remove()\n})\n\ntest('click on item commits emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    const items = listItems(el)\n    t.ok(items.length > 0, 'has items to click')\n    items[0]?.click()\n    t.ok(!el.isOpen, 'closes after click')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted on click'\n    )\n    el.remove()\n})\n\n// -- Events ----------------------------------------------------\n\ntest('emoji-select event fires on commit', async t => {\n    t.plan(3)\n    const { el, textarea } = setup(SMALL_SET)\n\n    el.addEventListener('emoji-select', ((\n        ev:CustomEvent<EmojiSelectDetail>\n    ) => {\n        t.ok(ev.detail.emoji, 'has emoji detail')\n        t.equal(\n            ev.detail.emoji.name, 'pizza',\n            'correct emoji name'\n        )\n        t.equal(\n            ev.detail.query, 'pizza',\n            'correct query string'\n        )\n    }) as EventListener)\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\ntest('emoji-select event bubbles', async t => {\n    t.plan(1)\n    const { el, textarea } = setup(SMALL_SET)\n\n    document.body.addEventListener(\n        'emoji-select',\n        function handler () {\n            t.ok(true, 'event bubbles to body')\n            document.body.removeEventListener(\n                'emoji-select', handler\n            )\n        }\n    )\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\n// -- Configuration ---------------------------------------------\n\ntest('minChars can be lowered', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.minChars = 1\n    simulateInput(textarea, ':s')\n    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n    el.remove()\n})\n\ntest('custom emoji data', t => {\n    const custom:EmojiEntry[] = [\n        {\n            emoji:'🧪',\n            name:'test_tube',\n            keywords:['science'],\n        },\n    ]\n    const { el, textarea } = setup(custom)\n    simulateInput(textarea, ':test')\n    const items = listItems(el)\n    t.equal(items.length, 1, 'finds custom emoji')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('🧪'),\n        'custom emoji inserted'\n    )\n    el.remove()\n})\n\n// -- Lifecycle -------------------------------------------------\n\ntest('detach prevents further triggers', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    simulateInput(textarea, ':pizza')\n    t.ok(!el.isOpen, 'no popover after detach')\n    el.remove()\n})\n\ntest('re-attach after detach', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    el.attach(textarea)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'works after re-attach')\n    el.remove()\n})\n\ntest('popover re-opens after close', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens first time')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'closes on Escape')\n    simulateInput(textarea, ':cat')\n    t.ok(el.isOpen, 'opens again with new query')\n    el.remove()\n})\n\ntest('aria-controls set and cleared', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(\n        textarea.hasAttribute('aria-controls'),\n        'set when open'\n    )\n    keydown(textarea, 'Escape')\n    t.ok(\n        !textarea.hasAttribute('aria-controls'),\n        'removed on close'\n    )\n    el.remove()\n})\n\ntest('Enter with isComposing true does not commit', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover is open')\n    keydown(textarea, 'Enter', { isComposing:true })\n    t.ok(el.isOpen, 'popover stays open during IME')\n    t.ok(\n        textarea.value.includes(':pizza'),\n        'trigger text not replaced during IME'\n    )\n    t.ok(\n        !textarea.value.includes('🍕'),\n        'no emoji inserted during IME'\n    )\n    el.remove()\n})\n\ntest('keyCode 229 does not commit', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover is open')\n    keydown(textarea, 'Enter', { keyCode:229 })\n    t.ok(el.isOpen, 'popover stays open for keyCode 229')\n    el.remove()\n})\n\ntest('detach removes all aria attributes from field', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover opened')\n    el.detach()\n    t.ok(\n        !textarea.hasAttribute('aria-autocomplete'),\n        'aria-autocomplete removed'\n    )\n    t.ok(\n        !textarea.hasAttribute('aria-controls'),\n        'aria-controls removed'\n    )\n    t.ok(\n        !textarea.hasAttribute('aria-activedescendant'),\n        'aria-activedescendant removed'\n    )\n    el.remove()\n})\n\ntest('minChars assigned before upgrade is honored', t => {\n    const tag = `emoji-input-pre-${Math.random().toString(36).slice(2, 8)}`\n    const el = document.createElement(tag) as EmojiInput\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    ;(el as any).minChars = 1\n    document.body.appendChild(el)\n    customElements.define(tag, class extends EmojiInput {\n        static TAG = tag\n    })\n    customElements.upgrade(el)\n    t.equal(el.minChars, 1, 'minChars survived upgrade')\n    simulateInput(textarea, ':s')\n    t.ok(el.isOpen, 'opens with 1 char after pre-upgrade minChars=1')\n    el.remove()\n})\n\ntest('emojis assigned before upgrade is used for search', t => {\n    const tag = `emoji-input-pre2-${Math.random().toString(36).slice(2, 8)}`\n    const el = document.createElement(tag) as EmojiInput\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    const custom:EmojiEntry[] = [\n        { emoji:'🧪', name:'test_tube', keywords:['science'] },\n    ]\n    ;(el as any).emojis = custom\n    document.body.appendChild(el)\n    customElements.define(tag, class extends EmojiInput {\n        static TAG = tag\n    })\n    customElements.upgrade(el)\n    t.equal(el.emojis, custom, 'emojis survived upgrade')\n    simulateInput(textarea, ':test')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'finds pre-upgrade custom emoji')\n    el.remove()\n})\n\ntest('adopts existing rendered list child', t => {\n    const el = document.createElement('emoji-input') as EmojiInput\n    const textarea = document.createElement('textarea')\n    const uid = 'ssr-test'\n    const wrapper = document.createElement('div')\n    wrapper.innerHTML = EmojiInput.render(uid)\n    const list = wrapper.firstElementChild as HTMLElement\n    el.appendChild(textarea)\n    el.appendChild(list)\n    document.body.appendChild(el)\n    const lists = el.querySelectorAll('[role=\"listbox\"]')\n    t.equal(lists.length, 1, 'exactly one listbox exists')\n    el.emojis = SMALL_SET\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover works with adopted list')\n    el.remove()\n})\n\ntest('disconnectedCallback cleans up', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens while connected')\n    el.remove()\n    simulateInput(textarea, ':cat')\n    t.ok(!el.isOpen, 'no trigger after disconnect')\n})\n\nfunction setup (emojis?:EmojiEntry[]):{\n    el:EmojiInput;\n    textarea:HTMLTextAreaElement;\n} {\n    const el = document.createElement('emoji-input') as EmojiInput\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    document.body.appendChild(el)\n    if (emojis) el.emojis = emojis\n    return { el, textarea }\n}\n\nfunction simulateInput (\n    field:HTMLTextAreaElement|HTMLInputElement,\n    value:string,\n):void {\n    field.value = value\n    field.selectionStart = value.length\n    field.selectionEnd = value.length\n    field.dispatchEvent(\n        new InputEvent('input', { bubbles:true })\n    )\n}\n\nfunction keydown (\n    field:HTMLElement,\n    key:string,\n    opts?:KeyboardEventInit,\n):void {\n    field.dispatchEvent(new KeyboardEvent('keydown', {\n        key,\n        bubbles:true,\n        cancelable:true,\n        ...opts,\n    }))\n}\n\nfunction listItems (\n    el:EmojiInput,\n):NodeListOf<HTMLElement> {\n    return el.querySelectorAll(\n        '.emoji-search-item'\n    )\n}\n","numLines":2160,"startLine":1,"totalLines":2160}}}
