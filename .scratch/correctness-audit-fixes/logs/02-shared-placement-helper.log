{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NDTEPoTb1oMmiQiAEKd74g","type":"tool_result","content":"1\timport { test } from '@substrate-system/tapzero'\n2\timport { sleep } from '@substrate-system/dom'\n3\timport {\n4\t    EmojiInput,\n5\t    EmojiButton as MainEmojiButton,\n6\t    EmojiPicker as MainEmojiPicker,\n7\t    DEFAULT_EMOJIS,\n8\t    type EmojiEntry,\n9\t    type EmojiSelectDetail,\n10\t} from '../src/index.js'\n11\timport { EmojiPicker } from '../src/picker.js'\n12\timport { EmojiButton } from '../src/button.js'\n13\timport { search } from '../src/search.js'\n14\timport packageJson from '../package.json'\n15\timport buttonCss from '../src/button.css'\n16\timport pickerCss from '../src/picker.css'\n17\t\n18\tconst _style = document.createElement('style')\n19\t_style.textContent = [buttonCss, pickerCss].join('\\n')\n20\tdocument.head.appendChild(_style)\n21\t\n22\t// -- Helpers ---------------------------------------------------\n23\t\n24\tconst SMALL_SET:EmojiEntry[] = [\n25\t    {\n26\t        emoji:'😀',\n27\t        name:'grinning',\n28\t        keywords:['smile', 'happy'],\n29\t    },\n30\t    {\n31\t        emoji:'😃',\n32\t        name:'smiley',\n33\t        keywords:['smile', 'happy'],\n34\t    },\n35\t    {\n36\t        emoji:'😄',\n37\t        name:'smile',\n38\t        keywords:['happy', 'laugh'],\n39\t    },\n40\t    {\n41\t        emoji:'🍕',\n42\t        name:'pizza',\n43\t        keywords:['food'],\n44\t    },\n45\t    {\n46\t        emoji:'🍔',\n47\t        name:'hamburger',\n48\t        keywords:['burger', 'food'],\n49\t    },\n50\t    {\n51\t        emoji:'🔥',\n52\t        name:'fire',\n53\t        keywords:['lit', 'hot'],\n54\t    },\n55\t    {\n56\t        emoji:'🐱',\n57\t        name:'cat',\n58\t        keywords:['kitty'],\n59\t    },\n60\t    {\n61\t        emoji:'🐶',\n62\t        name:'dog',\n63\t        keywords:['puppy'],\n64\t    },\n65\t]\n66\t\n67\t// -- Static render (Node-compatible) ---------------------------\n68\t\n69\ttest('static render returns an HTML string', t => {\n70\t    const html = EmojiInput.render('test-uid')\n71\t    t.equal(typeof html, 'string', 'returns a string')\n72\t    t.ok(\n73\t        html.includes('emoji-search-list'),\n74\t        'contains the list class'\n75\t    )\n76\t    t.ok(\n77\t        html.includes('role=\"listbox\"'),\n78\t        'has listbox role'\n79\t    )\n80\t    t.ok(\n81\t        html.includes('aria-label=\"Emoji suggestions\"'),\n82\t        'listbox has an accessible label'\n83\t    )\n84\t    t.ok(\n85\t        html.includes('id=\"test-uid-list\"'),\n86\t        'uses the uid for the element id'\n87\t    )\n88\t    t.ok(\n89\t        html.includes('popover=\"manual\"'),\n90\t        'has popover attribute'\n91\t    )\n92\t})\n93\t\n94\t// -- Data structure --------------------------------------------\n95\t\n96\ttest('DEFAULT_EMOJIS has expected structure', t => {\n97\t    t.ok(\n98\t        DEFAULT_EMOJIS.length >= 1800,\n99\t        'contains the complete emoji-mart set'\n100\t    )\n101\t\n102\t    const first = DEFAULT_EMOJIS[0]\n103\t    t.equal(\n104\t        typeof first.emoji, 'string',\n105\t        'emoji field is a string'\n106\t    )\n107\t    t.equal(\n108\t        typeof first.name, 'string',\n109\t        'name field is a string'\n110\t    )\n111\t    t.ok(\n112\t        Array.isArray(first.keywords),\n113\t        'keywords is an array'\n114\t    )\n115\t})\n116\t\n117\ttest('DEFAULT_EMOJIS includes category and skin data', t => {\n118\t    const butter = DEFAULT_EMOJIS.find(\n119\t        emoji => emoji.name === 'butter'\n120\t    )\n121\t\n122\t    t.ok(butter, 'includes butter')\n123\t    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n124\t    t.ok(butter?.category, 'includes a category')\n125\t    t.ok(Array.isArray(butter?.categories), 'includes categories')\n126\t\n127\t    const wave = DEFAULT_EMOJIS.find(\n128\t        emoji => emoji.name === 'wave'\n129\t    )\n130\t    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n131\t    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n132\t})\n133\t\n134\ttest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n135\t    const invalid = DEFAULT_EMOJIS.filter(\n136\t        e => !e.emoji || !e.name\n137\t    )\n138\t    t.equal(\n139\t        invalid.length, 0,\n140\t        'no entries missing emoji or name'\n141\t    )\n142\t})\n143\t\n144\ttest('shared search ranks name prefixes before substrings', t => {\n145\t    const emojis:EmojiEntry[] = [\n146\t        { emoji:'1', name:'pineapple', keywords:[] },\n147\t        { emoji:'2', name:'apple', keywords:[] },\n148\t        { emoji:'3', name:'grape', keywords:[] },\n149\t    ]\n150\t\n151\t    const results = search(emojis, 'app', 8)\n152\t    t.equal(\n153\t        JSON.stringify(results.map(emoji => emoji.name)),\n154\t        JSON.stringify(['apple', 'pineapple']),\n155\t        'prefix matches rank before substring matches'\n156\t    )\n157\t})\n158\t\n159\ttest('shared search ranks keyword prefixes after name matches', t => {\n160\t    const emojis:EmojiEntry[] = [\n161\t        { emoji:'1', name:'grape', keywords:['apple'] },\n162\t        { emoji:'2', name:'pineapple', keywords:[] },\n163\t        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n164\t    ]\n165\t\n166\t    const results = search(emojis, 'app', 8)\n167\t    t.equal(\n168\t        JSON.stringify(results.map(emoji => emoji.name)),\n169\t        JSON.stringify(['pineapple', 'grape', 'fruit']),\n170\t        'keyword prefix matches rank after name matches'\n171\t    )\n172\t})\n173\t\n174\t// -- Registration and setup ------------------------------------\n175\t\n176\ttest('custom element is registered', t => {\n177\t    const ctor = customElements.get('emoji-input')\n178\t    t.ok(ctor, 'emoji-input tag is defined')\n179\t    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n180\t})\n181\t\n182\ttest('emoji-picker custom element is registered', t => {\n183\t    const ctor = customElements.get('emoji-picker')\n184\t    t.ok(ctor, 'emoji-picker tag is defined')\n185\t    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n186\t\n187\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n188\t    document.body.appendChild(picker)\n189\t    t.ok(picker.emojis.length > 0, 'has default emoji data')\n190\t    t.ok(!picker.isOpen, 'starts closed')\n191\t    picker.remove()\n192\t})\n193\t\n194\ttest('emoji-button custom element renders an accessible smiley button', t => {\n195\t    const ctor = customElements.get('emoji-button')\n196\t    t.ok(ctor, 'emoji-button tag is defined')\n197\t    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n198\t\n199\t    const button = document.createElement('emoji-button')\n200\t    document.body.appendChild(button)\n201\t    const inner = button.querySelector('button')\n202\t    t.ok(inner, 'renders a native button')\n203\t    t.equal(inner?.type, 'button', 'button does not submit forms')\n204\t    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n205\t    t.ok(\n206\t        inner?.querySelector('.visually-hidden'),\n207\t        'has a visually-hidden label'\n208\t    )\n209\t    button.remove()\n210\t})\n211\t\n212\ttest('emoji-button uses currentColor', t => {\n213\t    const button = document.createElement('emoji-button')\n214\t    document.body.appendChild(button)\n215\t\n216\t    const svg = button.querySelector('svg')\n217\t    t.equal(\n218\t        svg?.getAttribute('fill'),\n219\t        'currentColor',\n220\t        'the SVG inherits its fill from currentColor'\n221\t    )\n222\t    button.remove()\n223\t})\n224\t\n225\ttest('emoji-button opens the picker named by for', t => {\n226\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n227\t    picker.id = 'button-picker-target'\n228\t    let opens = 0\n229\t    picker.open = () => { opens++ }\n230\t\n231\t    const button = document.createElement('emoji-button')\n232\t    button.setAttribute('for', picker.id)\n233\t    document.body.append(picker, button)\n234\t    button.querySelector('button')?.click()\n235\t\n236\t    t.equal(opens, 1, 'click calls the referenced picker open method')\n237\t    button.remove()\n238\t    picker.remove()\n239\t})\n240\t\n241\ttest('emoji-button positions the picker below itself', t => {\n242\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n243\t    picker.id = 'position-test-picker'\n244\t    picker.setAttribute('for', 'position-target')\n245\t\n246\t    const wrapper = document.createElement('div')\n247\t    wrapper.style.position = 'relative'\n248\t    wrapper.style.marginTop = '120px'\n249\t    wrapper.style.marginLeft = '200px'\n250\t\n251\t    const button = document.createElement('emoji-button') as EmojiButton\n252\t    button.setAttribute('for', picker.id)\n253\t\n254\t    wrapper.append(button, picker)\n255\t    document.body.append(wrapper)\n256\t\n257\t    button.querySelector('button')?.click()\n258\t    t.ok(picker.isOpen, 'picker opens')\n259\t\n260\t    picker.querySelector<HTMLElement>(\n261\t        '[role=\"tab\"][aria-label=\"People\"]'\n262\t    )?.click()\n263\t    const panel = picker.querySelector(\n264\t        '.emoji-picker-panel'\n265\t    ) as HTMLElement\n266\t    const btnRect = button.getBoundingClientRect()\n267\t    const panelRect = panel.getBoundingClientRect()\n268\t\n269\t    t.ok(\n270\t        panelRect.top >= btnRect.bottom - 1,\n271\t        'picker top is at or below the button bottom'\n272\t    )\n273\t    t.ok(\n274\t        Math.abs(panelRect.left - btnRect.left) < 2,\n275\t        'picker left aligns with the button left'\n276\t    )\n277\t\n278\t    picker.close()\n279\t    picker.remove()\n280\t    wrapper.remove()\n281\t})\n282\t\n283\ttest('button subpath exports only EmojiButton', t => {\n284\t    const buttonExports = packageJson.exports['./button'] as {\n285\t        import:string;\n286\t        require:string;\n287\t    }|undefined\n288\t    t.ok(buttonExports, 'button subpath is declared')\n289\t    t.equal(\n290\t        buttonExports?.import,\n291\t        './dist/button.js',\n292\t        'button import subpath points to the ESM build'\n293\t    )\n294\t    t.equal(\n295\t        buttonExports?.require,\n296\t        './dist/button.cjs',\n297\t        'button require subpath points to the CommonJS build'\n298\t    )\n299\t})\n300\t\n301\ttest('main entrypoint exports all component classes', t => {\n302\t    t.equal(\n303\t        MainEmojiPicker,\n304\t        EmojiPicker,\n305\t        'main entrypoint exports EmojiPicker'\n306\t    )\n307\t    t.equal(\n308\t        MainEmojiButton,\n309\t        EmojiButton,\n310\t        'main entrypoint exports EmojiButton'\n311\t    )\n312\t    t.equal(\n313\t        EmojiInput,\n314\t        customElements.get('emoji-input'),\n315\t        'main entrypoint exports EmojiInput'\n316\t    )\n317\t})\n318\t\n319\ttest('emoji-picker defaults to the recently used tab', t => {\n320\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n321\t    document.body.appendChild(picker)\n322\t\n323\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n324\t    const recentsTab = tabs[0]\n325\t    t.equal(\n326\t        recentsTab?.getAttribute('aria-selected'),\n327\t        'true',\n328\t        'recently used tab is selected by default'\n329\t    )\n330\t    const peopleTab = tabs[1]\n331\t    t.equal(\n332\t        peopleTab?.getAttribute('aria-selected'),\n333\t        'false',\n334\t        'people tab is not selected by default'\n335\t    )\n336\t    picker.remove()\n337\t})\n338\t\n339\ttest('emoji-picker renders category tabs and an eight-column grid', t => {\n340\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n341\t    document.body.appendChild(picker)\n342\t    picker.open()\n343\t\n344\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n345\t    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n346\t    t.equal(\n347\t        tabs[0]?.getAttribute('aria-label'),\n348\t        'Recently used',\n349\t        'recents is the first tab'\n350\t    )\n351\t    t.equal(\n352\t        tabs[1]?.getAttribute('aria-label'),\n353\t        'People',\n354\t        'people is the first emoji category'\n355\t    )\n356\t\n357\t    const grid = picker.querySelector('[role=\"grid\"]')\n358\t    t.ok(grid, 'renders an emoji grid')\n359\t\n360\t    const natureTab = picker.querySelector<HTMLElement>(\n361\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n362\t    )\n363\t    natureTab?.click()\n364\t    t.ok(\n365\t        grid?.textContent?.includes('🐒'),\n366\t        'category tab filters the grid'\n367\t    )\n368\t    picker.remove()\n369\t})\n370\t\n371\ttest('emoji-picker stays open when switching categories', t => {\n372\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n373\t    document.body.appendChild(picker)\n374\t    picker.open()\n375\t    t.ok(picker.isOpen, 'picker is open before tab click')\n376\t\n377\t    const natureTab = picker.querySelector<HTMLElement>(\n378\t        '[role=\"tab\"][aria-label=\"Nature\"]'\n379\t    )\n380\t    natureTab?.click()\n381\t    t.ok(\n382\t        picker.isOpen,\n383\t        'picker stays open after clicking a category tab'\n384\t    )\n385\t    picker.close()\n386\t    picker.remove()\n387\t})\n388\t\n389\ttest('emoji-picker grid exists when open', t => {\n390\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n391\t    document.body.appendChild(picker)\n392\t    picker.open()\n393\t\n394\t    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n395\t    t.ok(grid, 'grid exists')\n396\t    picker.close()\n397\t    picker.remove()\n398\t})\n399\t\n400\ttest('emoji-picker grid has an accessible label', t => {\n401\t    const picker = document.createElement(\n402\t        'emoji-picker'\n403\t    ) as EmojiPicker\n404\t    document.body.appendChild(picker)\n405\t    const grid = picker.querySelector('[role=\"grid\"]')\n406\t    t.equal(\n407\t        grid?.getAttribute('aria-label'),\n408\t        'Emoji',\n409\t        'grid has aria-label'\n410\t    )\n411\t    picker.remove()\n412\t})\n413\t\n414\ttest('emoji-picker search controls the grid', t => {\n415\t    const picker = document.createElement(\n416\t        'emoji-picker'\n417\t    ) as EmojiPicker\n418\t    document.body.appendChild(picker)\n419\t    const search = picker.querySelector(\n420\t        'input[type=\"search\"]'\n421\t    )\n422\t    const grid = picker.querySelector('[role=\"grid\"]')\n423\t    t.ok(\n424\t        search?.getAttribute('aria-controls'),\n425\t        'search has aria-controls'\n426\t    )\n427\t    t.equal(\n428\t        search?.getAttribute('aria-controls'),\n429\t        grid?.id,\n430\t        'search aria-controls references the grid'\n431\t    )\n432\t    picker.remove()\n433\t})\n434\t\n435\ttest('emoji-picker moves focus to search on open', t => {\n436\t    const picker = document.createElement(\n437\t        'emoji-picker'\n438\t    ) as EmojiPicker\n439\t    document.body.appendChild(picker)\n440\t    picker.open()\n441\t    const search = picker.querySelector(\n442\t        'input[type=\"search\"]'\n443\t    )\n444\t    t.equal(\n445\t        document.activeElement,\n446\t        search,\n447\t        'search input is focused after open'\n448\t    )\n449\t    picker.close()\n450\t    picker.remove()\n451\t})\n452\t\n453\ttest('emoji-picker returns focus to trigger on close', t => {\n454\t    const trigger = document.createElement('button')\n455\t    trigger.textContent = 'trigger'\n456\t    document.body.appendChild(trigger)\n457\t    trigger.focus()\n458\t\n459\t    const picker = document.createElement(\n460\t        'emoji-picker'\n461\t    ) as EmojiPicker\n462\t    document.body.appendChild(picker)\n463\t    picker.open(trigger)\n464\t    picker.close()\n465\t    t.equal(\n466\t        document.activeElement,\n467\t        trigger,\n468\t        'focus returns to the trigger element'\n469\t    )\n470\t    picker.remove()\n471\t    trigger.remove()\n472\t})\n473\t\n474\ttest('emoji-picker tabs use roving tabindex', t => {\n475\t    const picker = document.createElement(\n476\t        'emoji-picker'\n477\t    ) as EmojiPicker\n478\t    document.body.appendChild(picker)\n479\t\n480\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n481\t    const selected = tabs[0]\n482\t    const notSelected = tabs[1]\n483\t    t.equal(\n484\t        selected?.getAttribute('tabindex'),\n485\t        '0',\n486\t        'selected tab has tabindex 0'\n487\t    )\n488\t    t.equal(\n489\t        notSelected?.getAttribute('tabindex'),\n490\t        '-1',\n491\t        'non-selected tab has tabindex -1'\n492\t    )\n493\t    picker.remove()\n494\t})\n495\t\n496\ttest('emoji-picker tabs navigate with arrow keys', t => {\n497\t    const picker = document.createElement(\n498\t        'emoji-picker'\n499\t    ) as EmojiPicker\n500\t    document.body.appendChild(picker)\n501\t    picker.open()\n502\t\n503\t    const firstTab = picker.querySelector<HTMLElement>(\n504\t        '[role=\"tab\"]'\n505\t    )\n506\t    firstTab?.focus()\n507\t    keydown(firstTab!, 'ArrowRight')\n508\t\n509\t    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n510\t    t.equal(\n511\t        tabs[1]?.getAttribute('aria-selected'),\n512\t        'true',\n513\t        'ArrowRight activates the next tab'\n514\t    )\n515\t    t.equal(\n516\t        document.activeElement,\n517\t        tabs[1],\n518\t        'ArrowRight moves focus to the next tab'\n519\t    )\n520\t    picker.close()\n521\t    picker.remove()\n522\t})\n523\t\n524\ttest('emoji-picker search filters visible emoji', t => {\n525\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n526\t    document.body.appendChild(picker)\n527\t    picker.open()\n528\t\n529\t    const input = picker.querySelector<HTMLInputElement>(\n530\t        'input[type=\"search\"]'\n531\t    )\n532\t    t.ok(input, 'renders a search input')\n533\t    if (input) {\n534\t        input.value = 'butter'\n535\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n536\t    }\n537\t\n538\t    const grid = picker.querySelector('[role=\"grid\"]')\n539\t    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n540\t    t.ok(\n541\t        !grid?.textContent?.includes('😀'),\n542\t        'hides emoji that do not match the query'\n543\t    )\n544\t    picker.remove()\n545\t})\n546\t\n547\ttest('emoji-picker emits emoji-select and closes after selection', t => {\n548\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n549\t    document.body.appendChild(picker)\n550\t    picker.open()\n551\t\n552\t    const input = picker.querySelector<HTMLInputElement>(\n553\t        'input[type=\"search\"]'\n554\t    )\n555\t    if (input) {\n556\t        input.value = 'butter'\n557\t        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n558\t    }\n559\t\n560\t    const details:Array<EmojiSelectDetail> = []\n561\t    picker.addEventListener('emoji-select', (event) => {\n562\t        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n563\t    })\n564\t    const emoji = Array.from(\n565\t        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n566\t    ).find(button => button.textContent === '🧈')\n567\t    emoji?.click()\n568\t\n569\t    const detail = details[0]\n570\t    t.ok(detail, 'emits selection detail')\n571\t    if (detail) {\n572\t        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n573\t        t.equal(detail.query, 'butter', 'emits the current search query')\n574\t    }\n575\t    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n576\t    picker.remove()\n577\t})\n578\t\n579\ttest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n580\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n581\t    document.body.appendChild(picker)\n582\t    picker.open()\n583\t\n584\t    picker.querySelector<HTMLElement>(\n585\t        '[role=\"tab\"][aria-label=\"People\"]'\n586\t    )?.click()\n587\t    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n588\t        '[role=\"gridcell\"]'\n589\t    )\n590\t    const first = buttons[0]\n591\t    first?.focus()\n592\t    if (first) keydown(first, 'ArrowRight')\n593\t    t.equal(\n594\t        document.activeElement,\n595\t        buttons[1],\n596\t        'ArrowRight moves to the next emoji'\n597\t    )\n598\t    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n599\t    t.equal(\n600\t        document.activeElement,\n601\t        buttons[9],\n602\t        'ArrowDown moves by one grid row'\n603\t    )\n604\t\n605\t    let selected = false\n606\t    picker.addEventListener('emoji-select', () => { selected = true })\n607\t    if (buttons[9]) keydown(buttons[9], 'Enter')\n608\t    t.ok(selected, 'Enter selects the focused emoji')\n609\t    t.ok(!picker.isOpen, 'Enter closes the picker')\n610\t\n611\t    picker.open()\n612\t    keydown(picker, 'Escape')\n613\t    t.ok(!picker.isOpen, 'Escape closes the picker')\n614\t    picker.remove()\n615\t})\n616\t\n617\ttest('emoji-picker closes when a popover click lands outside', t => {\n618\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n619\t    document.body.appendChild(picker)\n620\t    picker.open()\n621\t    t.ok(picker.isOpen, 'opens through the public open method')\n622\t\n623\t    document.body.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n624\t    t.ok(!picker.isOpen, 'outside click closes the popover')\n625\t    picker.remove()\n626\t})\n627\t\n628\ttest('emoji-picker inline mode stays in document flow', t => {\n629\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n630\t    picker.setAttribute('inline', '')\n631\t    document.body.appendChild(picker)\n632\t\n633\t    const grid = picker.querySelector('[role=\"grid\"]')\n634\t    const panel = grid?.parentElement\n635\t    t.ok(grid, 'inline mode still renders the picker grid')\n636\t    t.ok(panel && !panel.hasAttribute('popover'),\n637\t        'inline mode removes popover behavior')\n638\t    t.equal(\n639\t        getComputedStyle(panel as Element).position,\n640\t        'static',\n641\t        'inline mode uses in-flow positioning'\n642\t    )\n643\t    picker.remove()\n644\t})\n645\t\n646\ttest('emoji-picker stores and restores capped recently used emoji', t => {\n647\t    const key = 'emoji-picker-test-recents'\n648\t    localStorage.removeItem(key)\n649\t    const emojis:Array<EmojiEntry> = Array.from(\n650\t        { length:25 },\n651\t        (_, index) => ({\n652\t            emoji:String.fromCodePoint(0x1f600 + index),\n653\t            name:`test-${index}`,\n654\t            keywords:[],\n655\t            category:'people',\n656\t        })\n657\t    )\n658\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n659\t    picker.setAttribute('recent-key', key)\n660\t    picker.emojis = emojis\n661\t    document.body.appendChild(picker)\n662\t\n663\t    for (const emoji of emojis) {\n664\t        picker.open()\n665\t        picker.querySelector<HTMLElement>(\n666\t            '[role=\"tab\"][aria-label=\"People\"]'\n667\t        )?.click()\n668\t        const button = Array.from(\n669\t            picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n670\t        ).find(item => item.textContent === emoji.emoji)\n671\t        button?.click()\n672\t    }\n673\t\n674\t    picker.open()\n675\t    picker.querySelector<HTMLElement>(\n676\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n677\t    )?.click()\n678\t    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n679\t    t.equal(recents.length, 24, 'caps recents at 24 entries')\n680\t    t.equal(\n681\t        recents[0]?.textContent,\n682\t        emojis[24]?.emoji,\n683\t        'most recently selected emoji is first'\n684\t    )\n685\t\n686\t    const duplicate = emojis[10]\n687\t    picker.open()\n688\t    picker.querySelector<HTMLElement>(\n689\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n690\t    )?.click()\n691\t    Array.from(\n692\t        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n693\t    ).find(item => item.textContent === duplicate?.emoji)?.click()\n694\t\n695\t    picker.open()\n696\t    picker.querySelector<HTMLElement>(\n697\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n698\t    )?.click()\n699\t    t.equal(\n700\t        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n701\t        duplicate?.emoji,\n702\t        'duplicate selection moves the emoji to the front'\n703\t    )\n704\t    picker.remove()\n705\t\n706\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n707\t    restored.setAttribute('recent-key', key)\n708\t    restored.emojis = emojis\n709\t    document.body.appendChild(restored)\n710\t    restored.open()\n711\t    restored.querySelector<HTMLElement>(\n712\t        '[role=\"tab\"][aria-label=\"Recently used\"]'\n713\t    )?.click()\n714\t    t.equal(\n715\t        restored.querySelectorAll('[role=\"gridcell\"]').length,\n716\t        24,\n717\t        'restores recents from localStorage'\n718\t    )\n719\t    restored.remove()\n720\t    localStorage.removeItem(key)\n721\t})\n722\t\n723\ttest('emoji-picker applies and restores a selected skin tone', t => {\n724\t    const key = 'emoji-picker-test-skin-tone'\n725\t    localStorage.removeItem(key)\n726\t    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n727\t    t.ok(wave, 'has an emoji with skin tone variants')\n728\t    if (!wave) return\n729\t\n730\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n731\t    picker.setAttribute('skin-tone-key', key)\n732\t    picker.emojis = [wave]\n733\t    document.body.appendChild(picker)\n734\t\n735\t    picker.querySelector<HTMLElement>(\n736\t        '[role=\"tab\"][aria-label=\"People\"]'\n737\t    )?.click()\n738\t    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n739\t    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n740\t    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n741\t    const waveButton = picker.querySelector<HTMLButtonElement>(\n742\t        '[role=\"gridcell\"]'\n743\t    )\n744\t    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n745\t\n746\t    let selected = ''\n747\t    picker.addEventListener('emoji-select', (event) => {\n748\t        selected = (event as CustomEvent<EmojiSelectDetail>)\n749\t            .detail.emoji.emoji\n750\t    })\n751\t    waveButton?.click()\n752\t    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n753\t    picker.remove()\n754\t\n755\t    const restored = document.createElement('emoji-picker') as EmojiPicker\n756\t    restored.setAttribute('skin-tone-key', key)\n757\t    restored.emojis = [wave]\n758\t    document.body.appendChild(restored)\n759\t    restored.querySelector<HTMLElement>(\n760\t        '[role=\"tab\"][aria-label=\"People\"]'\n761\t    )?.click()\n762\t    t.equal(\n763\t        restored.querySelector('[role=\"gridcell\"]')?.textContent,\n764\t        '👋🏿',\n765\t        'restores the skin tone from localStorage'\n766\t    )\n767\t    restored.remove()\n768\t    localStorage.removeItem(key)\n769\t})\n770\t\n771\ttest('emoji-picker updates its preview when an emoji is hovered', t => {\n772\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n773\t    picker.emojis = [{\n774\t        emoji:'🧈',\n775\t        name:'butter',\n776\t        keywords:['food'],\n777\t        category:'people',\n778\t    }]\n779\t    document.body.appendChild(picker)\n780\t\n781\t    const button = picker.querySelector<HTMLButtonElement>(\n782\t        '[role=\"gridcell\"]'\n783\t    )\n784\t    const preview = picker.querySelector('[role=\"status\"]')\n785\t    t.ok(preview, 'renders a preview region')\n786\t    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n787\t    t.ok(\n788\t        preview?.textContent?.includes('🧈'),\n789\t        'preview shows the hovered emoji'\n790\t    )\n791\t    t.ok(\n792\t        preview?.textContent?.includes('butter'),\n793\t        'preview shows the hovered emoji name'\n794\t    )\n795\t    picker.remove()\n796\t})\n797\t\n798\ttest('emoji-picker inserts into the field named by for', t => {\n799\t    const field = document.createElement('textarea')\n800\t    field.id = 'emoji-picker-target'\n801\t    field.value = 'hello world'\n802\t    field.setSelectionRange(6, 6)\n803\t    document.body.appendChild(field)\n804\t\n805\t    const picker = document.createElement('emoji-picker') as EmojiPicker\n806\t    picker.setAttribute('for', field.id)\n807\t    picker.emojis = [{\n808\t        emoji:'🧈',\n809\t        name:'butter',\n810\t        keywords:['food'],\n811\t        category:'people',\n812\t    }]\n813\t    document.body.appendChild(picker)\n814\t    picker.open()\n815\t    picker.querySelector<HTMLButtonElement>('[role=\"gridcell\"]')?.click()\n816\t\n817\t    t.equal(\n818\t        field.value,\n819\t        'hello 🧈world',\n820\t        'inserts the selected emoji at the field caret'\n821\t    )\n822\t    picker.remove()\n823\t    field.remove()\n824\t})\n825\t\n826\ttest('element has correct defaults', t => {\n827\t    const { el } = setup()\n828\t    t.equal(el.minChars, 2, 'minChars defaults to 2')\n829\t    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n830\t    t.ok(el.emojis.length > 0, 'has default emoji data')\n831\t    el.remove()\n832\t})\n833\t\n834\ttest('auto-attaches to child textarea', t => {\n835\t    const { el, textarea } = setup()\n836\t    t.equal(\n837\t        textarea.getAttribute('aria-autocomplete'),\n838\t        'list',\n839\t        'textarea gets aria-autocomplete=list'\n840\t    )\n841\t    el.remove()\n842\t})\n843\t\n844\ttest('attaches to child added after connect', async t => {\n845\t    t.plan(1)\n846\t    const el = document.createElement(\n847\t        'emoji-input'\n848\t    ) as EmojiInput\n849\t    document.body.appendChild(el)\n850\t    const textarea = document.createElement('textarea')\n851\t    el.appendChild(textarea)\n852\t    await sleep(50)\n853\t    t.equal(\n854\t        textarea.getAttribute('aria-autocomplete'),\n855\t        'list',\n856\t        'MutationObserver picks up late child'\n857\t    )\n858\t    el.remove()\n859\t})\n860\t\n861\ttest('attaches via for attribute', t => {\n862\t    const textarea = document.createElement('textarea')\n863\t    textarea.id = 'test-external-field'\n864\t    document.body.appendChild(textarea)\n865\t\n866\t    const el = document.createElement(\n867\t        'emoji-input'\n868\t    ) as EmojiInput\n869\t    el.setAttribute('for', 'test-external-field')\n870\t    el.emojis = SMALL_SET\n871\t    document.body.appendChild(el)\n872\t\n873\t    t.equal(\n874\t        textarea.getAttribute('aria-autocomplete'),\n875\t        'list',\n876\t        'external field gets aria-autocomplete'\n877\t    )\n878\t\n879\t    simulateInput(textarea, ':pizza')\n880\t    t.ok(el.isOpen, 'popover opens for external field')\n881\t\n882\t    el.remove()\n883\t    textarea.remove()\n884\t})\n885\t\n886\ttest('works with input element', t => {\n887\t    const el = document.createElement(\n888\t        'emoji-input'\n889\t    ) as EmojiInput\n890\t    const input = document.createElement('input')\n891\t    input.type = 'text'\n892\t    el.appendChild(input)\n893\t    document.body.appendChild(el)\n894\t    el.emojis = SMALL_SET\n895\t\n896\t    simulateInput(input, ':pizza')\n897\t    t.ok(el.isOpen, 'popover opens for input element')\n898\t\n899\t    keydown(input, 'Enter')\n900\t    t.ok(\n901\t        input.value.includes('🍕'),\n902\t        'emoji inserted into input'\n903\t    )\n904\t\n905\t    el.remove()\n906\t})\n907\t\n908\t// -- Trigger behavior ------------------------------------------\n909\t\n910\ttest('popover opens on valid trigger', t => {\n911\t    const { el, textarea } = setup(SMALL_SET)\n912\t    simulateInput(textarea, 'hello :sm')\n913\t    t.ok(el.isOpen, 'opens for :sm after space')\n914\t    el.remove()\n915\t})\n916\t\n917\ttest('popover opens at start of input', t => {\n918\t    const { el, textarea } = setup(SMALL_SET)\n919\t    simulateInput(textarea, ':sm')\n920\t    t.ok(el.isOpen, 'opens when colon at position 0')\n921\t    el.remove()\n922\t})\n923\t\n924\ttest('does not open for short query', t => {\n925\t    const { el, textarea } = setup(SMALL_SET)\n926\t    simulateInput(textarea, ':s')\n927\t    t.ok(\n928\t        !el.isOpen,\n929\t        'stays closed with 1 char (minChars=2)'\n930\t    )\n931\t    el.remove()\n932\t})\n933\t\n934\ttest('does not trigger after word character', t => {\n935\t    const { el, textarea } = setup(SMALL_SET)\n936\t    simulateInput(textarea, 'word:sm')\n937\t    t.ok(\n938\t        !el.isOpen,\n939\t        'no trigger when colon follows letter'\n940\t    )\n941\t    el.remove()\n942\t})\n943\t\n944\ttest('triggers after opening paren', t => {\n945\t    const { el, textarea } = setup(SMALL_SET)\n946\t    simulateInput(textarea, '(:sm')\n947\t    t.ok(el.isOpen, 'triggers after (')\n948\t    el.remove()\n949\t})\n950\t\n951\ttest('closes when trigger disappears', t => {\n952\t    const { el, textarea } = setup(SMALL_SET)\n953\t    simulateInput(textarea, ':sm')\n954\t    t.ok(el.isOpen, 'opens first')\n955\t    simulateInput(textarea, 'no trigger here')\n956\t    t.ok(!el.isOpen, 'closes when no trigger')\n957\t    el.remove()\n958\t})\n959\t\n960\ttest('search is case-insensitive', t => {\n961\t    const { el, textarea } = setup(SMALL_SET)\n962\t    simulateInput(textarea, ':SM')\n963\t    t.ok(el.isOpen, 'opens for uppercase query')\n964\t    const items = listItems(el)\n965\t    t.ok(items.length >= 1, 'finds results')\n966\t    el.remove()\n967\t})\n968\t\n969\t// -- Search results --------------------------------------------\n970\t\n971\ttest('finds results by name prefix', t => {\n972\t    const { el, textarea } = setup(SMALL_SET)\n973\t    simulateInput(textarea, ':sm')\n974\t    const items = listItems(el)\n975\t    t.ok(items.length >= 2, 'matches name prefixes')\n976\t    el.remove()\n977\t})\n978\t\n979\ttest('finds results by name substring', t => {\n980\t    const { el, textarea } = setup(SMALL_SET)\n981\t    simulateInput(textarea, ':burger')\n982\t    const items = listItems(el)\n983\t    t.ok(items.length >= 1, 'matches name substrings')\n984\t    el.remove()\n985\t})\n986\t\n987\ttest('finds results by keyword', t => {\n988\t    const { el, textarea } = setup(SMALL_SET)\n989\t    simulateInput(textarea, ':lit')\n990\t    const items = listItems(el)\n991\t    t.ok(items.length >= 1, 'matches keywords')\n992\t    el.remove()\n993\t})\n994\t\n995\ttest('respects maxResults', t => {\n996\t    const { el, textarea } = setup(SMALL_SET)\n997\t    el.maxResults = 2\n998\t    simulateInput(textarea, ':sm')\n999\t    const items = listItems(el)\n1000\t    t.ok(items.length <= 2, 'results capped at maxResults')\n1001\t    el.remove()\n1002\t})\n1003\t\n1004\ttest('shows empty state for no matches', t => {\n1005\t    const { el, textarea } = setup(SMALL_SET)\n1006\t    simulateInput(textarea, ':zzzzzz')\n1007\t    t.ok(\n1008\t        el.isOpen,\n1009\t        'popover opens even with no matches'\n1010\t    )\n1011\t    const items = listItems(el)\n1012\t    t.equal(items.length, 0, 'no result items')\n1013\t    const empty = el.querySelector(\n1014\t        '.emoji-search-empty'\n1015\t    )\n1016\t    t.ok(empty, 'empty state element shown')\n1017\t    el.remove()\n1018\t})\n1019\t\n1020\t// -- Keyboard navigation --------------------------------------\n1021\t\n1022\ttest('first item selected by default', t => {\n1023\t    const { el, textarea } = setup(SMALL_SET)\n1024\t    simulateInput(textarea, ':sm')\n1025\t    const items = listItems(el)\n1026\t    t.equal(\n1027\t        items[0]?.getAttribute('aria-selected'),\n1028\t        'true',\n1029\t        'first item is selected'\n1030\t    )\n1031\t    el.remove()\n1032\t})\n1033\t\n1034\ttest('ArrowDown moves selection forward', t => {\n1035\t    const { el, textarea } = setup(SMALL_SET)\n1036\t    simulateInput(textarea, ':sm')\n1037\t    keydown(textarea, 'ArrowDown')\n1038\t    const items = listItems(el)\n1039\t    t.equal(\n1040\t        items[0]?.getAttribute('aria-selected'),\n1041\t        'false',\n1042\t        'first item deselected'\n1043\t    )\n1044\t    t.equal(\n1045\t        items[1]?.getAttribute('aria-selected'),\n1046\t        'true',\n1047\t        'second item selected'\n1048\t    )\n1049\t    el.remove()\n1050\t})\n1051\t\n1052\ttest('ArrowUp wraps from first to last', t => {\n1053\t    const { el, textarea } = setup(SMALL_SET)\n1054\t    simulateInput(textarea, ':sm')\n1055\t    const items = listItems(el)\n1056\t    const lastIdx = items.length - 1\n1057\t    keydown(textarea, 'ArrowUp')\n1058\t    t.equal(\n1059\t        items[lastIdx]?.getAttribute('aria-selected'),\n1060\t        'true',\n1061\t        'last item selected after wrap'\n1062\t    )\n1063\t    el.remove()\n1064\t})\n1065\t\n1066\ttest('ArrowDown wraps from last to first', t => {\n1067\t    const { el, textarea } = setup(SMALL_SET)\n1068\t    simulateInput(textarea, ':sm')\n1069\t    const items = listItems(el)\n1070\t    const count = items.length\n1071\t    for (let i = 0; i < count; i++) {\n1072\t        keydown(textarea, 'ArrowDown')\n1073\t    }\n1074\t    t.equal(\n1075\t        items[0]?.getAttribute('aria-selected'),\n1076\t        'true',\n1077\t        'wraps back to first'\n1078\t    )\n1079\t    el.remove()\n1080\t})\n1081\t\n1082\ttest('aria-activedescendant tracks selection', t => {\n1083\t    const { el, textarea } = setup(SMALL_SET)\n1084\t    simulateInput(textarea, ':sm')\n1085\t    const first = textarea.getAttribute(\n1086\t        'aria-activedescendant'\n1087\t    )\n1088\t    t.ok(first, 'set when popover opens')\n1089\t    keydown(textarea, 'ArrowDown')\n1090\t    const second = textarea.getAttribute(\n1091\t        'aria-activedescendant'\n1092\t    )\n1093\t    t.notEqual(\n1094\t        first, second,\n1095\t        'changes on navigation'\n1096\t    )\n1097\t    el.remove()\n1098\t})\n1099\t\n1100\t// -- Commit behavior -------------------------------------------\n1101\t\n1102\ttest('Enter commits the selected emoji', t => {\n1103\t    const { el, textarea } = setup(SMALL_SET)\n1104\t    simulateInput(textarea, ':pizza')\n1105\t    keydown(textarea, 'Enter')\n1106\t    t.ok(!el.isOpen, 'popover closes')\n1107\t    t.ok(\n1108\t        textarea.value.includes('🍕'),\n1109\t        'emoji inserted'\n1110\t    )\n1111\t    t.ok(\n1112\t        !textarea.value.includes(':pizza'),\n1113\t        'trigger text replaced'\n1114\t    )\n1115\t    el.remove()\n1116\t})\n1117\t\n1118\ttest('Tab commits the selected emoji', t => {\n1119\t    const { el, textarea } = setup(SMALL_SET)\n1120\t    simulateInput(textarea, ':pizza')\n1121\t    keydown(textarea, 'Tab')\n1122\t    t.ok(!el.isOpen, 'popover closes')\n1123\t    t.ok(\n1124\t        textarea.value.includes('🍕'),\n1125\t        'emoji inserted via Tab'\n1126\t    )\n1127\t    el.remove()\n1128\t})\n1129\t\n1130\ttest('Escape closes without inserting', t => {\n1131\t    const { el, textarea } = setup(SMALL_SET)\n1132\t    simulateInput(textarea, ':pizza')\n1133\t    t.ok(el.isOpen, 'popover open')\n1134\t    keydown(textarea, 'Escape')\n1135\t    t.ok(!el.isOpen, 'popover closes')\n1136\t    t.ok(\n1137\t        textarea.value.includes(':pizza'),\n1138\t        'original text preserved'\n1139\t    )\n1140\t    el.remove()\n1141\t})\n1142\t\n1143\ttest('committed emoji has trailing space', t => {\n1144\t    const { el, textarea } = setup(SMALL_SET)\n1145\t    simulateInput(textarea, ':pizza')\n1146\t    keydown(textarea, 'Enter')\n1147\t    t.ok(\n1148\t        textarea.value.endsWith(' '),\n1149\t        'space after emoji'\n1150\t    )\n1151\t    el.remove()\n1152\t})\n1153\t\n1154\ttest('preserves text before trigger', t => {\n1155\t    const { el, textarea } = setup(SMALL_SET)\n1156\t    simulateInput(textarea, 'hello :pizza')\n1157\t    keydown(textarea, 'Enter')\n1158\t    t.ok(\n1159\t        textarea.value.startsWith('hello '),\n1160\t        'preceding text kept'\n1161\t    )\n1162\t    t.ok(\n1163\t        textarea.value.includes('🍕'),\n1164\t        'emoji inserted after prefix'\n1165\t    )\n1166\t    el.remove()\n1167\t})\n1168\t\n1169\ttest('navigated commit inserts correct emoji', t => {\n1170\t    const { el, textarea } = setup(SMALL_SET)\n1171\t    simulateInput(textarea, ':sm')\n1172\t    keydown(textarea, 'ArrowDown')\n1173\t    keydown(textarea, 'Enter')\n1174\t    t.ok(\n1175\t        textarea.value.includes('😄'),\n1176\t        'second result emoji inserted'\n1177\t    )\n1178\t    el.remove()\n1179\t})\n1180\t\n1181\ttest('click on item commits emoji', t => {\n1182\t    const { el, textarea } = setup(SMALL_SET)\n1183\t    simulateInput(textarea, ':pizza')\n1184\t    const items = listItems(el)\n1185\t    t.ok(items.length > 0, 'has items to click')\n1186\t    items[0]?.click()\n1187\t    t.ok(!el.isOpen, 'closes after click')\n1188\t    t.ok(\n1189\t        textarea.value.includes('🍕'),\n1190\t        'emoji inserted on click'\n1191\t    )\n1192\t    el.remove()\n1193\t})\n1194\t\n1195\t// -- Events ----------------------------------------------------\n1196\t\n1197\ttest('emoji-select event fires on commit', async t => {\n1198\t    t.plan(3)\n1199\t    const { el, textarea } = setup(SMALL_SET)\n1200\t\n1201\t    el.addEventListener('emoji-select', ((\n1202\t        ev:CustomEvent<EmojiSelectDetail>\n1203\t    ) => {\n1204\t        t.ok(ev.detail.emoji, 'has emoji detail')\n1205\t        t.equal(\n1206\t            ev.detail.emoji.name, 'pizza',\n1207\t            'correct emoji name'\n1208\t        )\n1209\t        t.equal(\n1210\t            ev.detail.query, 'pizza',\n1211\t            'correct query string'\n1212\t        )\n1213\t    }) as EventListener)\n1214\t\n1215\t    simulateInput(textarea, ':pizza')\n1216\t    keydown(textarea, 'Enter')\n1217\t    el.remove()\n1218\t})\n1219\t\n1220\ttest('emoji-select event bubbles', async t => {\n1221\t    t.plan(1)\n1222\t    const { el, textarea } = setup(SMALL_SET)\n1223\t\n1224\t    document.body.addEventListener(\n1225\t        'emoji-select',\n1226\t        function handler () {\n1227\t            t.ok(true, 'event bubbles to body')\n1228\t            document.body.removeEventListener(\n1229\t                'emoji-select', handler\n1230\t            )\n1231\t        }\n1232\t    )\n1233\t\n1234\t    simulateInput(textarea, ':pizza')\n1235\t    keydown(textarea, 'Enter')\n1236\t    el.remove()\n1237\t})\n1238\t\n1239\t// -- Configuration ---------------------------------------------\n1240\t\n1241\ttest('minChars can be lowered', t => {\n1242\t    const { el, textarea } = setup(SMALL_SET)\n1243\t    el.minChars = 1\n1244\t    simulateInput(textarea, ':s')\n1245\t    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n1246\t    el.remove()\n1247\t})\n1248\t\n1249\ttest('custom emoji data', t => {\n1250\t    const custom:EmojiEntry[] = [\n1251\t        {\n1252\t            emoji:'🧪',\n1253\t            name:'test_tube',\n1254\t            keywords:['science'],\n1255\t        },\n1256\t    ]\n1257\t    const { el, textarea } = setup(custom)\n1258\t    simulateInput(textarea, ':test')\n1259\t    const items = listItems(el)\n1260\t    t.equal(items.length, 1, 'finds custom emoji')\n1261\t    keydown(textarea, 'Enter')\n1262\t    t.ok(\n1263\t        textarea.value.includes('🧪'),\n1264\t        'custom emoji inserted'\n1265\t    )\n1266\t    el.remove()\n1267\t})\n1268\t\n1269\t// -- Lifecycle -------------------------------------------------\n1270\t\n1271\ttest('detach prevents further triggers', t => {\n1272\t    const { el, textarea } = setup(SMALL_SET)\n1273\t    el.detach()\n1274\t    simulateInput(textarea, ':pizza')\n1275\t    t.ok(!el.isOpen, 'no popover after detach')\n1276\t    el.remove()\n1277\t})\n1278\t\n1279\ttest('re-attach after detach', t => {\n1280\t    const { el, textarea } = setup(SMALL_SET)\n1281\t    el.detach()\n1282\t    el.attach(textarea)\n1283\t    simulateInput(textarea, ':pizza')\n1284\t    t.ok(el.isOpen, 'works after re-attach')\n1285\t    el.remove()\n1286\t})\n1287\t\n1288\ttest('popover re-opens after close', t => {\n1289\t    const { el, textarea } = setup(SMALL_SET)\n1290\t    simulateInput(textarea, ':pizza')\n1291\t    t.ok(el.isOpen, 'opens first time')\n1292\t    keydown(textarea, 'Escape')\n1293\t    t.ok(!el.isOpen, 'closes on Escape')\n1294\t    simulateInput(textarea, ':cat')\n1295\t    t.ok(el.isOpen, 'opens again with new query')\n1296\t    el.remove()\n1297\t})\n1298\t\n1299\ttest('aria-controls set and cleared', t => {\n1300\t    const { el, textarea } = setup(SMALL_SET)\n1301\t    simulateInput(textarea, ':sm')\n1302\t    t.ok(\n1303\t        textarea.hasAttribute('aria-controls'),\n1304\t        'set when open'\n1305\t    )\n1306\t    keydown(textarea, 'Escape')\n1307\t    t.ok(\n1308\t        !textarea.hasAttribute('aria-controls'),\n1309\t        'removed on close'\n1310\t    )\n1311\t    el.remove()\n1312\t})\n1313\t\n1314\ttest('disconnectedCallback cleans up', t => {\n1315\t    const { el, textarea } = setup(SMALL_SET)\n1316\t    simulateInput(textarea, ':pizza')\n1317\t    t.ok(el.isOpen, 'opens while connected')\n1318\t    el.remove()\n1319\t    simulateInput(textarea, ':cat')\n1320\t    t.ok(!el.isOpen, 'no trigger after disconnect')\n1321\t})\n1322\t\n1323\tfunction setup (emojis?:EmojiEntry[]):{\n1324\t    el:EmojiInput;\n1325\t    textarea:HTMLTextAreaElement;\n1326\t} {\n1327\t    const el = document.createElement('emoji-input') as EmojiInput\n1328\t    const textarea = document.createElement('textarea')\n1329\t    el.appendChild(textarea)\n1330\t    document.body.appendChild(el)\n1331\t    if (emojis) el.emojis = emojis\n1332\t    return { el, textarea }\n1333\t}\n1334\t\n1335\tfunction simulateInput (\n1336\t    field:HTMLTextAreaElement|HTMLInputElement,\n1337\t    value:string,\n1338\t):void {\n1339\t    field.value = value\n1340\t    field.selectionStart = value.length\n1341\t    field.selectionEnd = value.length\n1342\t    field.dispatchEvent(\n1343\t        new InputEvent('input', { bubbles:true })\n1344\t    )\n1345\t}\n1346\t\n1347\tfunction keydown (field:HTMLElement, key:string):void {\n1348\t    field.dispatchEvent(new KeyboardEvent('keydown', {\n1349\t        key,\n1350\t        bubbles:true,\n1351\t        cancelable:true,\n1352\t    }))\n1353\t}\n1354\t\n1355\tfunction listItems (\n1356\t    el:EmojiInput,\n1357\t):NodeListOf<HTMLElement> {\n1358\t    return el.querySelectorAll(\n1359\t        '.emoji-search-item'\n1360\t    )\n1361\t}\n1362\t"}]},"parent_tool_use_id":null,"session_id":"16829455-2d54-4b61-851e-96b311024956","uuid":"a3d5e294-5c45-4db5-9896-f0d2a5a4a750","timestamp":"2026-09-23T18:38:17.900Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-02-shared-placement-helper/test/index.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { sleep } from '@substrate-system/dom'\nimport {\n    EmojiInput,\n    EmojiButton as MainEmojiButton,\n    EmojiPicker as MainEmojiPicker,\n    DEFAULT_EMOJIS,\n    type EmojiEntry,\n    type EmojiSelectDetail,\n} from '../src/index.js'\nimport { EmojiPicker } from '../src/picker.js'\nimport { EmojiButton } from '../src/button.js'\nimport { search } from '../src/search.js'\nimport packageJson from '../package.json'\nimport buttonCss from '../src/button.css'\nimport pickerCss from '../src/picker.css'\n\nconst _style = document.createElement('style')\n_style.textContent = [buttonCss, pickerCss].join('\\n')\ndocument.head.appendChild(_style)\n\n// -- Helpers ---------------------------------------------------\n\nconst SMALL_SET:EmojiEntry[] = [\n    {\n        emoji:'😀',\n        name:'grinning',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😃',\n        name:'smiley',\n        keywords:['smile', 'happy'],\n    },\n    {\n        emoji:'😄',\n        name:'smile',\n        keywords:['happy', 'laugh'],\n    },\n    {\n        emoji:'🍕',\n        name:'pizza',\n        keywords:['food'],\n    },\n    {\n        emoji:'🍔',\n        name:'hamburger',\n        keywords:['burger', 'food'],\n    },\n    {\n        emoji:'🔥',\n        name:'fire',\n        keywords:['lit', 'hot'],\n    },\n    {\n        emoji:'🐱',\n        name:'cat',\n        keywords:['kitty'],\n    },\n    {\n        emoji:'🐶',\n        name:'dog',\n        keywords:['puppy'],\n    },\n]\n\n// -- Static render (Node-compatible) ---------------------------\n\ntest('static render returns an HTML string', t => {\n    const html = EmojiInput.render('test-uid')\n    t.equal(typeof html, 'string', 'returns a string')\n    t.ok(\n        html.includes('emoji-search-list'),\n        'contains the list class'\n    )\n    t.ok(\n        html.includes('role=\"listbox\"'),\n        'has listbox role'\n    )\n    t.ok(\n        html.includes('aria-label=\"Emoji suggestions\"'),\n        'listbox has an accessible label'\n    )\n    t.ok(\n        html.includes('id=\"test-uid-list\"'),\n        'uses the uid for the element id'\n    )\n    t.ok(\n        html.includes('popover=\"manual\"'),\n        'has popover attribute'\n    )\n})\n\n// -- Data structure --------------------------------------------\n\ntest('DEFAULT_EMOJIS has expected structure', t => {\n    t.ok(\n        DEFAULT_EMOJIS.length >= 1800,\n        'contains the complete emoji-mart set'\n    )\n\n    const first = DEFAULT_EMOJIS[0]\n    t.equal(\n        typeof first.emoji, 'string',\n        'emoji field is a string'\n    )\n    t.equal(\n        typeof first.name, 'string',\n        'name field is a string'\n    )\n    t.ok(\n        Array.isArray(first.keywords),\n        'keywords is an array'\n    )\n})\n\ntest('DEFAULT_EMOJIS includes category and skin data', t => {\n    const butter = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'butter'\n    )\n\n    t.ok(butter, 'includes butter')\n    t.equal(butter?.emoji, '🧈', 'uses the native butter glyph')\n    t.ok(butter?.category, 'includes a category')\n    t.ok(Array.isArray(butter?.categories), 'includes categories')\n\n    const wave = DEFAULT_EMOJIS.find(\n        emoji => emoji.name === 'wave'\n    )\n    t.equal(wave?.skins?.length, 6, 'includes skin tone variants')\n    t.equal(wave?.skins?.[5]?.native, '👋🏿', 'keeps variant glyphs')\n})\n\ntest('DEFAULT_EMOJIS entries all have emoji and name', t => {\n    const invalid = DEFAULT_EMOJIS.filter(\n        e => !e.emoji || !e.name\n    )\n    t.equal(\n        invalid.length, 0,\n        'no entries missing emoji or name'\n    )\n})\n\ntest('shared search ranks name prefixes before substrings', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'pineapple', keywords:[] },\n        { emoji:'2', name:'apple', keywords:[] },\n        { emoji:'3', name:'grape', keywords:[] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['apple', 'pineapple']),\n        'prefix matches rank before substring matches'\n    )\n})\n\ntest('shared search ranks keyword prefixes after name matches', t => {\n    const emojis:EmojiEntry[] = [\n        { emoji:'1', name:'grape', keywords:['apple'] },\n        { emoji:'2', name:'pineapple', keywords:[] },\n        { emoji:'3', name:'fruit', keywords:['appetizer'] },\n    ]\n\n    const results = search(emojis, 'app', 8)\n    t.equal(\n        JSON.stringify(results.map(emoji => emoji.name)),\n        JSON.stringify(['pineapple', 'grape', 'fruit']),\n        'keyword prefix matches rank after name matches'\n    )\n})\n\n// -- Registration and setup ------------------------------------\n\ntest('custom element is registered', t => {\n    const ctor = customElements.get('emoji-input')\n    t.ok(ctor, 'emoji-input tag is defined')\n    t.equal(ctor, EmojiInput, 'maps to EmojiInput class')\n})\n\ntest('emoji-picker custom element is registered', t => {\n    const ctor = customElements.get('emoji-picker')\n    t.ok(ctor, 'emoji-picker tag is defined')\n    t.equal(ctor, EmojiPicker, 'maps to EmojiPicker class')\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    t.ok(picker.emojis.length > 0, 'has default emoji data')\n    t.ok(!picker.isOpen, 'starts closed')\n    picker.remove()\n})\n\ntest('emoji-button custom element renders an accessible smiley button', t => {\n    const ctor = customElements.get('emoji-button')\n    t.ok(ctor, 'emoji-button tag is defined')\n    t.equal(ctor, EmojiButton, 'maps to EmojiButton class')\n\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n    const inner = button.querySelector('button')\n    t.ok(inner, 'renders a native button')\n    t.equal(inner?.type, 'button', 'button does not submit forms')\n    t.ok(inner?.querySelector('svg'), 'renders the smiley SVG inline')\n    t.ok(\n        inner?.querySelector('.visually-hidden'),\n        'has a visually-hidden label'\n    )\n    button.remove()\n})\n\ntest('emoji-button uses currentColor', t => {\n    const button = document.createElement('emoji-button')\n    document.body.appendChild(button)\n\n    const svg = button.querySelector('svg')\n    t.equal(\n        svg?.getAttribute('fill'),\n        'currentColor',\n        'the SVG inherits its fill from currentColor'\n    )\n    button.remove()\n})\n\ntest('emoji-button opens the picker named by for', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'button-picker-target'\n    let opens = 0\n    picker.open = () => { opens++ }\n\n    const button = document.createElement('emoji-button')\n    button.setAttribute('for', picker.id)\n    document.body.append(picker, button)\n    button.querySelector('button')?.click()\n\n    t.equal(opens, 1, 'click calls the referenced picker open method')\n    button.remove()\n    picker.remove()\n})\n\ntest('emoji-button positions the picker below itself', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.id = 'position-test-picker'\n    picker.setAttribute('for', 'position-target')\n\n    const wrapper = document.createElement('div')\n    wrapper.style.position = 'relative'\n    wrapper.style.marginTop = '120px'\n    wrapper.style.marginLeft = '200px'\n\n    const button = document.createElement('emoji-button') as EmojiButton\n    button.setAttribute('for', picker.id)\n\n    wrapper.append(button, picker)\n    document.body.append(wrapper)\n\n    button.querySelector('button')?.click()\n    t.ok(picker.isOpen, 'picker opens')\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const panel = picker.querySelector(\n        '.emoji-picker-panel'\n    ) as HTMLElement\n    const btnRect = button.getBoundingClientRect()\n    const panelRect = panel.getBoundingClientRect()\n\n    t.ok(\n        panelRect.top >= btnRect.bottom - 1,\n        'picker top is at or below the button bottom'\n    )\n    t.ok(\n        Math.abs(panelRect.left - btnRect.left) < 2,\n        'picker left aligns with the button left'\n    )\n\n    picker.close()\n    picker.remove()\n    wrapper.remove()\n})\n\ntest('button subpath exports only EmojiButton', t => {\n    const buttonExports = packageJson.exports['./button'] as {\n        import:string;\n        require:string;\n    }|undefined\n    t.ok(buttonExports, 'button subpath is declared')\n    t.equal(\n        buttonExports?.import,\n        './dist/button.js',\n        'button import subpath points to the ESM build'\n    )\n    t.equal(\n        buttonExports?.require,\n        './dist/button.cjs',\n        'button require subpath points to the CommonJS build'\n    )\n})\n\ntest('main entrypoint exports all component classes', t => {\n    t.equal(\n        MainEmojiPicker,\n        EmojiPicker,\n        'main entrypoint exports EmojiPicker'\n    )\n    t.equal(\n        MainEmojiButton,\n        EmojiButton,\n        'main entrypoint exports EmojiButton'\n    )\n    t.equal(\n        EmojiInput,\n        customElements.get('emoji-input'),\n        'main entrypoint exports EmojiInput'\n    )\n})\n\ntest('emoji-picker defaults to the recently used tab', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const recentsTab = tabs[0]\n    t.equal(\n        recentsTab?.getAttribute('aria-selected'),\n        'true',\n        'recently used tab is selected by default'\n    )\n    const peopleTab = tabs[1]\n    t.equal(\n        peopleTab?.getAttribute('aria-selected'),\n        'false',\n        'people tab is not selected by default'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker renders category tabs and an eight-column grid', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(tabs.length, 9, 'has recents and eight category tabs')\n    t.equal(\n        tabs[0]?.getAttribute('aria-label'),\n        'Recently used',\n        'recents is the first tab'\n    )\n    t.equal(\n        tabs[1]?.getAttribute('aria-label'),\n        'People',\n        'people is the first emoji category'\n    )\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid, 'renders an emoji grid')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        grid?.textContent?.includes('🐒'),\n        'category tab filters the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stays open when switching categories', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'picker is open before tab click')\n\n    const natureTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Nature\"]'\n    )\n    natureTab?.click()\n    t.ok(\n        picker.isOpen,\n        'picker stays open after clicking a category tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid exists when open', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const grid = picker.querySelector<HTMLElement>('[role=\"grid\"]')\n    t.ok(grid, 'grid exists')\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker grid has an accessible label', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.equal(\n        grid?.getAttribute('aria-label'),\n        'Emoji',\n        'grid has aria-label'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker search controls the grid', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(\n        search?.getAttribute('aria-controls'),\n        'search has aria-controls'\n    )\n    t.equal(\n        search?.getAttribute('aria-controls'),\n        grid?.id,\n        'search aria-controls references the grid'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker moves focus to search on open', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    const search = picker.querySelector(\n        'input[type=\"search\"]'\n    )\n    t.equal(\n        document.activeElement,\n        search,\n        'search input is focused after open'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker returns focus to trigger on close', t => {\n    const trigger = document.createElement('button')\n    trigger.textContent = 'trigger'\n    document.body.appendChild(trigger)\n    trigger.focus()\n\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open(trigger)\n    picker.close()\n    t.equal(\n        document.activeElement,\n        trigger,\n        'focus returns to the trigger element'\n    )\n    picker.remove()\n    trigger.remove()\n})\n\ntest('emoji-picker tabs use roving tabindex', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    const selected = tabs[0]\n    const notSelected = tabs[1]\n    t.equal(\n        selected?.getAttribute('tabindex'),\n        '0',\n        'selected tab has tabindex 0'\n    )\n    t.equal(\n        notSelected?.getAttribute('tabindex'),\n        '-1',\n        'non-selected tab has tabindex -1'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker tabs navigate with arrow keys', t => {\n    const picker = document.createElement(\n        'emoji-picker'\n    ) as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const firstTab = picker.querySelector<HTMLElement>(\n        '[role=\"tab\"]'\n    )\n    firstTab?.focus()\n    keydown(firstTab!, 'ArrowRight')\n\n    const tabs = picker.querySelectorAll('[role=\"tab\"]')\n    t.equal(\n        tabs[1]?.getAttribute('aria-selected'),\n        'true',\n        'ArrowRight activates the next tab'\n    )\n    t.equal(\n        document.activeElement,\n        tabs[1],\n        'ArrowRight moves focus to the next tab'\n    )\n    picker.close()\n    picker.remove()\n})\n\ntest('emoji-picker search filters visible emoji', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    t.ok(input, 'renders a search input')\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    t.ok(grid?.textContent?.includes('🧈'), 'shows the matching emoji')\n    t.ok(\n        !grid?.textContent?.includes('😀'),\n        'hides emoji that do not match the query'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker emits emoji-select and closes after selection', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    const input = picker.querySelector<HTMLInputElement>(\n        'input[type=\"search\"]'\n    )\n    if (input) {\n        input.value = 'butter'\n        input.dispatchEvent(new InputEvent('input', { bubbles:true }))\n    }\n\n    const details:Array<EmojiSelectDetail> = []\n    picker.addEventListener('emoji-select', (event) => {\n        details.push((event as CustomEvent<EmojiSelectDetail>).detail)\n    })\n    const emoji = Array.from(\n        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n    ).find(button => button.textContent === '🧈')\n    emoji?.click()\n\n    const detail = details[0]\n    t.ok(detail, 'emits selection detail')\n    if (detail) {\n        t.equal(detail.emoji.name, 'butter', 'emits the selected emoji')\n        t.equal(detail.query, 'butter', 'emits the current search query')\n    }\n    t.ok(!picker.isOpen, 'closes after selecting an emoji')\n    picker.remove()\n})\n\ntest('emoji-picker supports keyboard grid navigation and dismissal', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const buttons = picker.querySelectorAll<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    const first = buttons[0]\n    first?.focus()\n    if (first) keydown(first, 'ArrowRight')\n    t.equal(\n        document.activeElement,\n        buttons[1],\n        'ArrowRight moves to the next emoji'\n    )\n    if (buttons[1]) keydown(buttons[1], 'ArrowDown')\n    t.equal(\n        document.activeElement,\n        buttons[9],\n        'ArrowDown moves by one grid row'\n    )\n\n    let selected = false\n    picker.addEventListener('emoji-select', () => { selected = true })\n    if (buttons[9]) keydown(buttons[9], 'Enter')\n    t.ok(selected, 'Enter selects the focused emoji')\n    t.ok(!picker.isOpen, 'Enter closes the picker')\n\n    picker.open()\n    keydown(picker, 'Escape')\n    t.ok(!picker.isOpen, 'Escape closes the picker')\n    picker.remove()\n})\n\ntest('emoji-picker closes when a popover click lands outside', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    document.body.appendChild(picker)\n    picker.open()\n    t.ok(picker.isOpen, 'opens through the public open method')\n\n    document.body.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n    t.ok(!picker.isOpen, 'outside click closes the popover')\n    picker.remove()\n})\n\ntest('emoji-picker inline mode stays in document flow', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('inline', '')\n    document.body.appendChild(picker)\n\n    const grid = picker.querySelector('[role=\"grid\"]')\n    const panel = grid?.parentElement\n    t.ok(grid, 'inline mode still renders the picker grid')\n    t.ok(panel && !panel.hasAttribute('popover'),\n        'inline mode removes popover behavior')\n    t.equal(\n        getComputedStyle(panel as Element).position,\n        'static',\n        'inline mode uses in-flow positioning'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker stores and restores capped recently used emoji', t => {\n    const key = 'emoji-picker-test-recents'\n    localStorage.removeItem(key)\n    const emojis:Array<EmojiEntry> = Array.from(\n        { length:25 },\n        (_, index) => ({\n            emoji:String.fromCodePoint(0x1f600 + index),\n            name:`test-${index}`,\n            keywords:[],\n            category:'people',\n        })\n    )\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('recent-key', key)\n    picker.emojis = emojis\n    document.body.appendChild(picker)\n\n    for (const emoji of emojis) {\n        picker.open()\n        picker.querySelector<HTMLElement>(\n            '[role=\"tab\"][aria-label=\"People\"]'\n        )?.click()\n        const button = Array.from(\n            picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n        ).find(item => item.textContent === emoji.emoji)\n        button?.click()\n    }\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    const recents = picker.querySelectorAll('[role=\"gridcell\"]')\n    t.equal(recents.length, 24, 'caps recents at 24 entries')\n    t.equal(\n        recents[0]?.textContent,\n        emojis[24]?.emoji,\n        'most recently selected emoji is first'\n    )\n\n    const duplicate = emojis[10]\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    Array.from(\n        picker.querySelectorAll<HTMLButtonElement>('[role=\"gridcell\"]')\n    ).find(item => item.textContent === duplicate?.emoji)?.click()\n\n    picker.open()\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        picker.querySelector('[role=\"gridcell\"]')?.textContent,\n        duplicate?.emoji,\n        'duplicate selection moves the emoji to the front'\n    )\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('recent-key', key)\n    restored.emojis = emojis\n    document.body.appendChild(restored)\n    restored.open()\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"Recently used\"]'\n    )?.click()\n    t.equal(\n        restored.querySelectorAll('[role=\"gridcell\"]').length,\n        24,\n        'restores recents from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('emoji-picker applies and restores a selected skin tone', t => {\n    const key = 'emoji-picker-test-skin-tone'\n    localStorage.removeItem(key)\n    const wave = DEFAULT_EMOJIS.find(emoji => emoji.name === 'wave')\n    t.ok(wave, 'has an emoji with skin tone variants')\n    if (!wave) return\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('skin-tone-key', key)\n    picker.emojis = [wave]\n    document.body.appendChild(picker)\n\n    picker.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    const swatches = picker.querySelectorAll('[role=\"radio\"]')\n    t.equal(swatches.length, 6, 'renders six skin tone swatches')\n    swatches[5]?.dispatchEvent(new MouseEvent('click', { bubbles:true }))\n    const waveButton = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    t.equal(waveButton?.textContent, '👋🏿', 'uses the selected skin tone')\n\n    let selected = ''\n    picker.addEventListener('emoji-select', (event) => {\n        selected = (event as CustomEvent<EmojiSelectDetail>)\n            .detail.emoji.emoji\n    })\n    waveButton?.click()\n    t.equal(selected, '👋🏿', 'emits the selected skin tone variant')\n    picker.remove()\n\n    const restored = document.createElement('emoji-picker') as EmojiPicker\n    restored.setAttribute('skin-tone-key', key)\n    restored.emojis = [wave]\n    document.body.appendChild(restored)\n    restored.querySelector<HTMLElement>(\n        '[role=\"tab\"][aria-label=\"People\"]'\n    )?.click()\n    t.equal(\n        restored.querySelector('[role=\"gridcell\"]')?.textContent,\n        '👋🏿',\n        'restores the skin tone from localStorage'\n    )\n    restored.remove()\n    localStorage.removeItem(key)\n})\n\ntest('emoji-picker updates its preview when an emoji is hovered', t => {\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n\n    const button = picker.querySelector<HTMLButtonElement>(\n        '[role=\"gridcell\"]'\n    )\n    const preview = picker.querySelector('[role=\"status\"]')\n    t.ok(preview, 'renders a preview region')\n    button?.dispatchEvent(new MouseEvent('mouseenter', { bubbles:true }))\n    t.ok(\n        preview?.textContent?.includes('🧈'),\n        'preview shows the hovered emoji'\n    )\n    t.ok(\n        preview?.textContent?.includes('butter'),\n        'preview shows the hovered emoji name'\n    )\n    picker.remove()\n})\n\ntest('emoji-picker inserts into the field named by for', t => {\n    const field = document.createElement('textarea')\n    field.id = 'emoji-picker-target'\n    field.value = 'hello world'\n    field.setSelectionRange(6, 6)\n    document.body.appendChild(field)\n\n    const picker = document.createElement('emoji-picker') as EmojiPicker\n    picker.setAttribute('for', field.id)\n    picker.emojis = [{\n        emoji:'🧈',\n        name:'butter',\n        keywords:['food'],\n        category:'people',\n    }]\n    document.body.appendChild(picker)\n    picker.open()\n    picker.querySelector<HTMLButtonElement>('[role=\"gridcell\"]')?.click()\n\n    t.equal(\n        field.value,\n        'hello 🧈world',\n        'inserts the selected emoji at the field caret'\n    )\n    picker.remove()\n    field.remove()\n})\n\ntest('element has correct defaults', t => {\n    const { el } = setup()\n    t.equal(el.minChars, 2, 'minChars defaults to 2')\n    t.equal(el.maxResults, 8, 'maxResults defaults to 8')\n    t.ok(el.emojis.length > 0, 'has default emoji data')\n    el.remove()\n})\n\ntest('auto-attaches to child textarea', t => {\n    const { el, textarea } = setup()\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'textarea gets aria-autocomplete=list'\n    )\n    el.remove()\n})\n\ntest('attaches to child added after connect', async t => {\n    t.plan(1)\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    document.body.appendChild(el)\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    await sleep(50)\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'MutationObserver picks up late child'\n    )\n    el.remove()\n})\n\ntest('attaches via for attribute', t => {\n    const textarea = document.createElement('textarea')\n    textarea.id = 'test-external-field'\n    document.body.appendChild(textarea)\n\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    el.setAttribute('for', 'test-external-field')\n    el.emojis = SMALL_SET\n    document.body.appendChild(el)\n\n    t.equal(\n        textarea.getAttribute('aria-autocomplete'),\n        'list',\n        'external field gets aria-autocomplete'\n    )\n\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover opens for external field')\n\n    el.remove()\n    textarea.remove()\n})\n\ntest('works with input element', t => {\n    const el = document.createElement(\n        'emoji-input'\n    ) as EmojiInput\n    const input = document.createElement('input')\n    input.type = 'text'\n    el.appendChild(input)\n    document.body.appendChild(el)\n    el.emojis = SMALL_SET\n\n    simulateInput(input, ':pizza')\n    t.ok(el.isOpen, 'popover opens for input element')\n\n    keydown(input, 'Enter')\n    t.ok(\n        input.value.includes('🍕'),\n        'emoji inserted into input'\n    )\n\n    el.remove()\n})\n\n// -- Trigger behavior ------------------------------------------\n\ntest('popover opens on valid trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :sm')\n    t.ok(el.isOpen, 'opens for :sm after space')\n    el.remove()\n})\n\ntest('popover opens at start of input', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens when colon at position 0')\n    el.remove()\n})\n\ntest('does not open for short query', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':s')\n    t.ok(\n        !el.isOpen,\n        'stays closed with 1 char (minChars=2)'\n    )\n    el.remove()\n})\n\ntest('does not trigger after word character', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'word:sm')\n    t.ok(\n        !el.isOpen,\n        'no trigger when colon follows letter'\n    )\n    el.remove()\n})\n\ntest('triggers after opening paren', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, '(:sm')\n    t.ok(el.isOpen, 'triggers after (')\n    el.remove()\n})\n\ntest('closes when trigger disappears', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(el.isOpen, 'opens first')\n    simulateInput(textarea, 'no trigger here')\n    t.ok(!el.isOpen, 'closes when no trigger')\n    el.remove()\n})\n\ntest('search is case-insensitive', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':SM')\n    t.ok(el.isOpen, 'opens for uppercase query')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'finds results')\n    el.remove()\n})\n\n// -- Search results --------------------------------------------\n\ntest('finds results by name prefix', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length >= 2, 'matches name prefixes')\n    el.remove()\n})\n\ntest('finds results by name substring', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':burger')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches name substrings')\n    el.remove()\n})\n\ntest('finds results by keyword', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':lit')\n    const items = listItems(el)\n    t.ok(items.length >= 1, 'matches keywords')\n    el.remove()\n})\n\ntest('respects maxResults', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.maxResults = 2\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.ok(items.length <= 2, 'results capped at maxResults')\n    el.remove()\n})\n\ntest('shows empty state for no matches', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':zzzzzz')\n    t.ok(\n        el.isOpen,\n        'popover opens even with no matches'\n    )\n    const items = listItems(el)\n    t.equal(items.length, 0, 'no result items')\n    const empty = el.querySelector(\n        '.emoji-search-empty'\n    )\n    t.ok(empty, 'empty state element shown')\n    el.remove()\n})\n\n// -- Keyboard navigation --------------------------------------\n\ntest('first item selected by default', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'first item is selected'\n    )\n    el.remove()\n})\n\ntest('ArrowDown moves selection forward', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    const items = listItems(el)\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'false',\n        'first item deselected'\n    )\n    t.equal(\n        items[1]?.getAttribute('aria-selected'),\n        'true',\n        'second item selected'\n    )\n    el.remove()\n})\n\ntest('ArrowUp wraps from first to last', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const lastIdx = items.length - 1\n    keydown(textarea, 'ArrowUp')\n    t.equal(\n        items[lastIdx]?.getAttribute('aria-selected'),\n        'true',\n        'last item selected after wrap'\n    )\n    el.remove()\n})\n\ntest('ArrowDown wraps from last to first', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const items = listItems(el)\n    const count = items.length\n    for (let i = 0; i < count; i++) {\n        keydown(textarea, 'ArrowDown')\n    }\n    t.equal(\n        items[0]?.getAttribute('aria-selected'),\n        'true',\n        'wraps back to first'\n    )\n    el.remove()\n})\n\ntest('aria-activedescendant tracks selection', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    const first = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.ok(first, 'set when popover opens')\n    keydown(textarea, 'ArrowDown')\n    const second = textarea.getAttribute(\n        'aria-activedescendant'\n    )\n    t.notEqual(\n        first, second,\n        'changes on navigation'\n    )\n    el.remove()\n})\n\n// -- Commit behavior -------------------------------------------\n\ntest('Enter commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted'\n    )\n    t.ok(\n        !textarea.value.includes(':pizza'),\n        'trigger text replaced'\n    )\n    el.remove()\n})\n\ntest('Tab commits the selected emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Tab')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted via Tab'\n    )\n    el.remove()\n})\n\ntest('Escape closes without inserting', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'popover open')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'popover closes')\n    t.ok(\n        textarea.value.includes(':pizza'),\n        'original text preserved'\n    )\n    el.remove()\n})\n\ntest('committed emoji has trailing space', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.endsWith(' '),\n        'space after emoji'\n    )\n    el.remove()\n})\n\ntest('preserves text before trigger', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, 'hello :pizza')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.startsWith('hello '),\n        'preceding text kept'\n    )\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted after prefix'\n    )\n    el.remove()\n})\n\ntest('navigated commit inserts correct emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    keydown(textarea, 'ArrowDown')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('😄'),\n        'second result emoji inserted'\n    )\n    el.remove()\n})\n\ntest('click on item commits emoji', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    const items = listItems(el)\n    t.ok(items.length > 0, 'has items to click')\n    items[0]?.click()\n    t.ok(!el.isOpen, 'closes after click')\n    t.ok(\n        textarea.value.includes('🍕'),\n        'emoji inserted on click'\n    )\n    el.remove()\n})\n\n// -- Events ----------------------------------------------------\n\ntest('emoji-select event fires on commit', async t => {\n    t.plan(3)\n    const { el, textarea } = setup(SMALL_SET)\n\n    el.addEventListener('emoji-select', ((\n        ev:CustomEvent<EmojiSelectDetail>\n    ) => {\n        t.ok(ev.detail.emoji, 'has emoji detail')\n        t.equal(\n            ev.detail.emoji.name, 'pizza',\n            'correct emoji name'\n        )\n        t.equal(\n            ev.detail.query, 'pizza',\n            'correct query string'\n        )\n    }) as EventListener)\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\ntest('emoji-select event bubbles', async t => {\n    t.plan(1)\n    const { el, textarea } = setup(SMALL_SET)\n\n    document.body.addEventListener(\n        'emoji-select',\n        function handler () {\n            t.ok(true, 'event bubbles to body')\n            document.body.removeEventListener(\n                'emoji-select', handler\n            )\n        }\n    )\n\n    simulateInput(textarea, ':pizza')\n    keydown(textarea, 'Enter')\n    el.remove()\n})\n\n// -- Configuration ---------------------------------------------\n\ntest('minChars can be lowered', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.minChars = 1\n    simulateInput(textarea, ':s')\n    t.ok(el.isOpen, 'opens with 1 char when minChars=1')\n    el.remove()\n})\n\ntest('custom emoji data', t => {\n    const custom:EmojiEntry[] = [\n        {\n            emoji:'🧪',\n            name:'test_tube',\n            keywords:['science'],\n        },\n    ]\n    const { el, textarea } = setup(custom)\n    simulateInput(textarea, ':test')\n    const items = listItems(el)\n    t.equal(items.length, 1, 'finds custom emoji')\n    keydown(textarea, 'Enter')\n    t.ok(\n        textarea.value.includes('🧪'),\n        'custom emoji inserted'\n    )\n    el.remove()\n})\n\n// -- Lifecycle -------------------------------------------------\n\ntest('detach prevents further triggers', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    simulateInput(textarea, ':pizza')\n    t.ok(!el.isOpen, 'no popover after detach')\n    el.remove()\n})\n\ntest('re-attach after detach', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    el.detach()\n    el.attach(textarea)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'works after re-attach')\n    el.remove()\n})\n\ntest('popover re-opens after close', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens first time')\n    keydown(textarea, 'Escape')\n    t.ok(!el.isOpen, 'closes on Escape')\n    simulateInput(textarea, ':cat')\n    t.ok(el.isOpen, 'opens again with new query')\n    el.remove()\n})\n\ntest('aria-controls set and cleared', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':sm')\n    t.ok(\n        textarea.hasAttribute('aria-controls'),\n        'set when open'\n    )\n    keydown(textarea, 'Escape')\n    t.ok(\n        !textarea.hasAttribute('aria-controls'),\n        'removed on close'\n    )\n    el.remove()\n})\n\ntest('disconnectedCallback cleans up', t => {\n    const { el, textarea } = setup(SMALL_SET)\n    simulateInput(textarea, ':pizza')\n    t.ok(el.isOpen, 'opens while connected')\n    el.remove()\n    simulateInput(textarea, ':cat')\n    t.ok(!el.isOpen, 'no trigger after disconnect')\n})\n\nfunction setup (emojis?:EmojiEntry[]):{\n    el:EmojiInput;\n    textarea:HTMLTextAreaElement;\n} {\n    const el = document.createElement('emoji-input') as EmojiInput\n    const textarea = document.createElement('textarea')\n    el.appendChild(textarea)\n    document.body.appendChild(el)\n    if (emojis) el.emojis = emojis\n    return { el, textarea }\n}\n\nfunction simulateInput (\n    field:HTMLTextAreaElement|HTMLInputElement,\n    value:string,\n):void {\n    field.value = value\n    field.selectionStart = value.length\n    field.selectionEnd = value.length\n    field.dispatchEvent(\n        new InputEvent('input', { bubbles:true })\n    )\n}\n\nfunction keydown (field:HTMLElement, key:string):void {\n    field.dispatchEvent(new KeyboardEvent('keydown', {\n        key,\n        bubbles:true,\n        cancelable:true,\n    }))\n}\n\nfunction listItems (\n    el:EmojiInput,\n):NodeListOf<HTMLElement> {\n    return el.querySelectorAll(\n        '.emoji-search-item'\n    )\n}\n","numLines":1362,"startLine":1,"totalLines":1362}}}
