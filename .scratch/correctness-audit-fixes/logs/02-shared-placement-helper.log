{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2M9ozvoe6WdYYxS2pMGuc","type":"tool_result","content":"1\t/**\n2\t * <emoji-input>\n3\t *\n4\t * Wrap a <textarea> or <input>. When the user types `:` followed by\n5\t * two or more characters, a popover opens at the caret with matching\n6\t * emoji. Arrow keys move, Enter/Tab insert, Escape closes.\n7\t *\n8\t * No shadow DOM. The list is a plain child element with class\n9\t * `emoji-search-list`; import `index.css` alongside the component\n10\t * and use `--emoji-search-*` custom properties for theming.\n11\t *\n12\t *   <emoji-input>\n13\t *     <textarea></textarea>\n14\t *   </emoji-input>\n15\t *\n16\t * Or attach to a field that lives elsewhere:\n17\t *\n18\t *   const el = document.querySelector('emoji-input')\n19\t *   el.attach(document.querySelector('#chat'))\n20\t *\n21\t * Pass your own data (e.g. from `unicode-emoji-json` or `emojibase-data`)\n22\t * via `el.emojis = [{ emoji: '🍕', name: 'pizza', keywords: ['food'] }]`.\n23\t */\n24\t\n25\timport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n26\timport { search } from './search.js'\n27\texport { EmojiPicker } from './picker.js'\n28\texport { EmojiButton } from './button.js'\n29\texport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n30\texport type EmojiSelectDetail = {\n31\t    emoji:EmojiEntry;\n32\t    query:string;\n33\t}\n34\t\n35\ttype Field = HTMLTextAreaElement|HTMLInputElement\n36\tconst TRIGGER = /:([a-z0-9_+-]*)$/i\n37\t\n38\t// ---------------------------------------------------------------------\n39\t// Caret position (mirror-div technique)\n40\t// ---------------------------------------------------------------------\n41\t\n42\tconst MIRROR_PROPS = [\n43\t    'boxSizing', 'width', 'height',\n44\t    'overflowX', 'overflowY',\n45\t    'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',\n46\t    'borderStyle',\n47\t    'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',\n48\t    'fontStyle', 'fontVariant', 'fontWeight', 'fontStretch', 'fontSize',\n49\t    'fontSizeAdjust', 'lineHeight', 'fontFamily',\n50\t    'textAlign', 'textTransform', 'textIndent', 'textDecoration',\n51\t    'letterSpacing', 'wordSpacing', 'tabSize', 'whiteSpace',\n52\t    'wordWrap', 'wordBreak',\n53\t] as const\n54\t\n55\tinterface CaretRect { top:number; left:number; height:number }\n56\t\n57\tconst Base = typeof HTMLElement !== 'undefined' ?\n58\t    HTMLElement :\n59\t    class {} as unknown as typeof HTMLElement\n60\t\n61\t// ---------------------------------------------------------------------\n62\t// Element\n63\t// ---------------------------------------------------------------------\n64\t\n65\texport class EmojiInput extends Base {\n66\t    static TAG = 'emoji-input'\n67\t\n68\t    static define (tag = EmojiInput.TAG):void {\n69\t        if (typeof window === 'undefined' || !window.customElements) return\n70\t        if (!customElements.get(tag)) {\n71\t            customElements.define(tag, EmojiInput)\n72\t        }\n73\t    }\n74\t\n75\t    static render (uid:string):string {\n76\t        return `<div class=\"emoji-search-list\"\n77\t            popover=\"manual\"\n78\t            role=\"listbox\"\n79\t            aria-label=\"Emoji suggestions\"\n80\t            id=\"${uid}-list\"\n81\t        ></div>`\n82\t    }\n83\t\n84\t    private hydrate ():void {\n85\t        this.list.addEventListener('pointerdown', ev => ev.preventDefault())\n86\t        this.list.addEventListener('click', ev => {\n87\t            const row = (ev.target as HTMLElement)\n88\t                .closest<HTMLElement>('.emoji-search-item')\n89\t            if (!row) return\n90\t            this.index = Number(row.dataset.index)\n91\t            this.commit()\n92\t        })\n93\t        this.list.addEventListener('pointermove', ev => {\n94\t            const row = (ev.target as HTMLElement)\n95\t                .closest<HTMLElement>(\n96\t                    '.emoji-search-item'\n97\t                )\n98\t            if (!row) return\n99\t            const i = Number(row.dataset.index)\n100\t            if (i !== this.index) {\n101\t                this.index = i\n102\t                this.paintSelection()\n103\t            }\n104\t        })\n105\t    }\n106\t\n107\t    /** Emoji dataset. Replace with a full list if you like. */\n108\t    emojis:EmojiEntry[] = DEFAULT_EMOJIS\n109\t    /** Characters after `:` before the popover opens. */\n110\t    minChars = 2\n111\t    /** Max rows to show. */\n112\t    maxResults = 8\n113\t\n114\t    private field:Field|null = null\n115\t    private list!:HTMLElement\n116\t    private results:EmojiEntry[] = []\n117\t    private index = 0\n118\t    private query = ''\n119\t    private range:{ start:number; end:number }|null = null\n120\t    private observer:MutationObserver|null = null\n121\t\n122\t    private uid = `emoji-search-${Math.random().toString(36).slice(2, 8)}`\n123\t\n124\t    connectedCallback ():void {\n125\t        const root = this.getRootNode() as Document|ShadowRoot\n126\t        if (!this.list) {\n127\t            const wrapper = document.createElement('div')\n128\t            wrapper.innerHTML = EmojiInput.render(this.uid)\n129\t            this.list = wrapper.firstElementChild as HTMLElement\n130\t            this.hydrate()\n131\t        }\n132\t        if (!this.list.isConnected) this.append(this.list)\n133\t\n134\t        const forId = this.getAttribute('for')\n135\t        if (forId) {\n136\t            const target = root.getElementById(forId)\n137\t            if (target) this.attach(target as Field)\n138\t        } else {\n139\t            this.attachSlotted()\n140\t            this.observer = new MutationObserver(() => {\n141\t                if (!this.field) this.attachSlotted()\n142\t            })\n143\t            this.observer.observe(this, { childList:true, subtree:true })\n144\t        }\n145\t    }\n146\t\n147\t    disconnectedCallback ():void {\n148\t        this.detach()\n149\t        this.observer?.disconnect()\n150\t    }\n151\t\n152\t    /** Hook up a textarea or text input. */\n153\t    attach (field:Field):void {\n154\t        this.detach()\n155\t        this.field = field\n156\t        field.addEventListener('input', this.onInput);\n157\t        (field as HTMLElement).addEventListener('keydown', this.onKeydown)\n158\t        field.addEventListener('blur', this.close)\n159\t        field.addEventListener('scroll', this.reposition)\n160\t        field.setAttribute('aria-autocomplete', 'list')\n161\t        window.addEventListener('resize', this.reposition)\n162\t        window.addEventListener('scroll', this.reposition, true)\n163\t    }\n164\t\n165\t    detach ():void {\n166\t        if (!this.field) return\n167\t        this.close()\n168\t        const f = this.field\n169\t        f.removeEventListener('input', this.onInput);\n170\t        (f as HTMLElement).removeEventListener('keydown', this.onKeydown)\n171\t        f.removeEventListener('blur', this.close)\n172\t        f.removeEventListener('scroll', this.reposition)\n173\t        window.removeEventListener('resize', this.reposition)\n174\t        window.removeEventListener('scroll', this.reposition, true)\n175\t        this.field = null\n176\t    }\n177\t\n178\t    get isOpen ():boolean {\n179\t        return this.list.matches(':popover-open')\n180\t    }\n181\t\n182\t    close = ():void => {\n183\t        if (this.isOpen) this.list.hidePopover()\n184\t        this.results = []\n185\t        this.range = null\n186\t        this.field?.removeAttribute('aria-activedescendant')\n187\t        this.field?.removeAttribute('aria-controls')\n188\t    }\n189\t\n190\t    // -- private -------------------------------------------------------\n191\t\n192\t    private attachSlotted ():void {\n193\t        const f = this.querySelector<Field>(\n194\t            ':scope > textarea, :scope > input, textarea, input',\n195\t        )\n196\t        if (f) this.attach(f)\n197\t    }\n198\t\n199\t    private onInput = ():void => {\n200\t        const f = this.field\n201\t        if (!f) return\n202\t        const pos = f.selectionStart ?? f.value.length\n203\t        const before = f.value.slice(0, pos)\n204\t        const m = TRIGGER.exec(before)\n205\t\n206\t        if (!m || m[1].length < this.minChars) {\n207\t            this.close()\n208\t            return\n209\t        }\n210\t\n211\t        // don't trigger inside a word like \"http://foo\"\n212\t        const prev = before[m.index - 1]\n213\t        if (prev && /[^\\s([{]/.test(prev)) {\n214\t            this.close()\n215\t            return\n216\t        }\n217\t\n218\t        this.query = m[1]\n219\t        this.range = { start:m.index, end:pos }\n220\t        this.results = search(this.emojis, this.query, this.maxResults)\n221\t        this.index = 0\n222\t        this.render()\n223\t        this.open()\n224\t    }\n225\t\n226\t    private onKeydown = (ev:KeyboardEvent):void => {\n227\t        if (!this.isOpen) return\n228\t        switch (ev.key) {\n229\t            case 'ArrowDown':\n230\t                ev.preventDefault()\n231\t                this.move(1)\n232\t                break\n233\t            case 'ArrowUp':\n234\t                ev.preventDefault()\n235\t                this.move(-1)\n236\t                break\n237\t            case 'Enter':\n238\t            case 'Tab':\n239\t                if (this.results.length) {\n240\t                    ev.preventDefault()\n241\t                    this.commit()\n242\t                }\n243\t                break\n244\t            case 'Escape':\n245\t                ev.preventDefault()\n246\t                this.close()\n247\t                break\n248\t        }\n249\t    }\n250\t\n251\t    private move (delta:number):void {\n252\t        const n = this.results.length\n253\t        if (!n) return\n254\t        this.index = (this.index + delta + n) % n\n255\t        this.paintSelection()\n256\t    }\n257\t\n258\t    private commit ():void {\n259\t        const f = this.field\n260\t        const chosen = this.results[this.index]\n261\t        const r = this.range\n262\t        if (!f || !chosen || !r) return\n263\t\n264\t        const insert = `${chosen.emoji} `\n265\t        f.setRangeText(insert, r.start, r.end, 'end')\n266\t        const query = this.query\n267\t        this.close()\n268\t        f.dispatchEvent(new InputEvent('input', {\n269\t            bubbles:true,\n270\t            inputType:'insertText',\n271\t            data:insert,\n272\t        }))\n273\t        this.dispatchEvent(new CustomEvent<EmojiSelectDetail>('emoji-select', {\n274\t            bubbles:true,\n275\t            composed:true,\n276\t            detail:{ emoji:chosen, query },\n277\t        }))\n278\t    }\n279\t\n280\t    private render ():void {\n281\t        const list = this.list\n282\t        list.replaceChildren()\n283\t        if (!this.results.length) {\n284\t            const empty = document.createElement('div')\n285\t            empty.className = 'emoji-search-empty'\n286\t            empty.textContent = `No emoji matching :${this.query}`\n287\t            list.append(empty)\n288\t            return\n289\t        }\n290\t        const q = this.query.toLowerCase()\n291\t        this.results.forEach((e, i) => {\n292\t            const row = document.createElement('div')\n293\t            row.className = 'emoji-search-item'\n294\t            row.setAttribute('role', 'option')\n295\t            row.id = `${this.uid}-opt-${i}`\n296\t            row.dataset.index = String(i)\n297\t\n298\t            const glyph = document.createElement('span')\n299\t            glyph.className = 'emoji-search-glyph'\n300\t            glyph.textContent = e.emoji\n301\t\n302\t            const name = document.createElement('span')\n303\t            name.className = 'emoji-search-name'\n304\t            const at = e.name.toLowerCase().indexOf(q)\n305\t            if (at >= 0) {\n306\t                name.append(\n307\t                    `:${e.name.slice(0, at)}`,\n308\t                    Object.assign(document.createElement('b'), {\n309\t                        textContent:e.name.slice(at, at + q.length),\n310\t                    }),\n311\t                    `${e.name.slice(at + q.length)}:`,\n312\t                )\n313\t            } else {\n314\t                name.textContent = `:${e.name}:`\n315\t            }\n316\t\n317\t            row.append(glyph, name)\n318\t            list.append(row)\n319\t        })\n320\t        this.paintSelection()\n321\t    }\n322\t\n323\t    private paintSelection ():void {\n324\t        const rows = this.list.querySelectorAll<HTMLElement>('.emoji-search-item')\n325\t        rows.forEach((row, i) => {\n326\t            row.setAttribute('aria-selected', String(i === this.index))\n327\t        })\n328\t        rows[this.index]?.scrollIntoView({ block:'nearest' })\n329\t        this.field?.setAttribute(\n330\t            'aria-activedescendant',\n331\t            `${this.uid}-opt-${this.index}`,\n332\t        )\n333\t    }\n334\t\n335\t    private open ():void {\n336\t        if (!this.isOpen) this.list.showPopover()\n337\t        this.field?.setAttribute('aria-controls', this.list.id)\n338\t        this.reposition()\n339\t    }\n340\t\n341\t    private reposition = ():void => {\n342\t        const f = this.field\n343\t        if (!f || !this.isOpen || !this.range) return\n344\t        const caret = caretRect(f, this.range.start)\n345\t        const box = this.list.getBoundingClientRect()\n346\t        const gap = 4\n347\t        const vw = document.documentElement.clientWidth\n348\t        const vh = document.documentElement.clientHeight\n349\t\n350\t        let left = caret.left\n351\t        let top = caret.top + caret.height + gap\n352\t        if (left + box.width > vw - gap) left = Math.max(gap, vw - box.width - gap)\n353\t        if (top + box.height > vh - gap) {\n354\t            top = Math.max(gap, caret.top - box.height - gap)\n355\t        }\n356\t        this.list.style.left = `${Math.round(left)}px`\n357\t        this.list.style.top = `${Math.round(top)}px`\n358\t    }\n359\t}\n360\t\n361\tEmojiInput.define()\n362\t\n363\tdeclare global {\n364\t    interface HTMLElementTagNameMap {\n365\t        'emoji-input':EmojiInput;\n366\t    }\n367\t    interface HTMLElementEventMap {\n368\t        'emoji-select':CustomEvent<EmojiSelectDetail>;\n369\t    }\n370\t}\n371\t\n372\tfunction caretRect (field:Field, pos:number):CaretRect {\n373\t    const isTextarea = field instanceof HTMLTextAreaElement\n374\t    const cs = getComputedStyle(field)\n375\t    const mirror = document.createElement('div')\n376\t    const s = mirror.style\n377\t\n378\t    for (const p of MIRROR_PROPS) {\n379\t        s[p] = cs[p]\n380\t    }\n381\t    s.position = 'absolute'\n382\t    s.visibility = 'hidden'\n383\t    s.top = '0'\n384\t    s.left = '-9999px'\n385\t    s.overflow = 'hidden'\n386\t    s.whiteSpace = isTextarea ? 'pre-wrap' : 'pre'\n387\t    if (isTextarea) s.wordWrap = 'break-word'\n388\t\n389\t    const before = field.value.slice(0, pos)\n390\t    mirror.textContent = isTextarea ? before : before.replace(/\\s/g, '\\u00a0')\n391\t\n392\t    const marker = document.createElement('span')\n393\t    marker.textContent = field.value.slice(pos) || '.'\n394\t    mirror.appendChild(marker)\n395\t    document.body.appendChild(mirror)\n396\t\n397\t    const rect = field.getBoundingClientRect()\n398\t    const borderTop = parseFloat(cs.borderTopWidth) || 0\n399\t    const borderLeft = parseFloat(cs.borderLeftWidth) || 0\n400\t    const lineHeight = parseFloat(cs.lineHeight) || marker.offsetHeight\n401\t\n402\t    const out = {\n403\t        top:rect.top + borderTop + marker.offsetTop - field.scrollTop,\n404\t        left:rect.left + borderLeft + marker.offsetLeft - field.scrollLeft,\n405\t        height:lineHeight,\n406\t    }\n407\t    mirror.remove()\n408\t    return out\n409\t}\n410\t"}]},"parent_tool_use_id":null,"session_id":"16829455-2d54-4b61-851e-96b311024956","uuid":"7479c6dc-c727-4a95-ae03-b31bd1ff9261","timestamp":"2026-09-23T18:38:10.432Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-02-shared-placement-helper/src/index.ts","content":"/**\n * <emoji-input>\n *\n * Wrap a <textarea> or <input>. When the user types `:` followed by\n * two or more characters, a popover opens at the caret with matching\n * emoji. Arrow keys move, Enter/Tab insert, Escape closes.\n *\n * No shadow DOM. The list is a plain child element with class\n * `emoji-search-list`; import `index.css` alongside the component\n * and use `--emoji-search-*` custom properties for theming.\n *\n *   <emoji-input>\n *     <textarea></textarea>\n *   </emoji-input>\n *\n * Or attach to a field that lives elsewhere:\n *\n *   const el = document.querySelector('emoji-input')\n *   el.attach(document.querySelector('#chat'))\n *\n * Pass your own data (e.g. from `unicode-emoji-json` or `emojibase-data`)\n * via `el.emojis = [{ emoji: '🍕', name: 'pizza', keywords: ['food'] }]`.\n */\n\nimport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nimport { search } from './search.js'\nexport { EmojiPicker } from './picker.js'\nexport { EmojiButton } from './button.js'\nexport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nexport type EmojiSelectDetail = {\n    emoji:EmojiEntry;\n    query:string;\n}\n\ntype Field = HTMLTextAreaElement|HTMLInputElement\nconst TRIGGER = /:([a-z0-9_+-]*)$/i\n\n// ---------------------------------------------------------------------\n// Caret position (mirror-div technique)\n// ---------------------------------------------------------------------\n\nconst MIRROR_PROPS = [\n    'boxSizing', 'width', 'height',\n    'overflowX', 'overflowY',\n    'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',\n    'borderStyle',\n    'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',\n    'fontStyle', 'fontVariant', 'fontWeight', 'fontStretch', 'fontSize',\n    'fontSizeAdjust', 'lineHeight', 'fontFamily',\n    'textAlign', 'textTransform', 'textIndent', 'textDecoration',\n    'letterSpacing', 'wordSpacing', 'tabSize', 'whiteSpace',\n    'wordWrap', 'wordBreak',\n] as const\n\ninterface CaretRect { top:number; left:number; height:number }\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\n// ---------------------------------------------------------------------\n// Element\n// ---------------------------------------------------------------------\n\nexport class EmojiInput extends Base {\n    static TAG = 'emoji-input'\n\n    static define (tag = EmojiInput.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n        if (!customElements.get(tag)) {\n            customElements.define(tag, EmojiInput)\n        }\n    }\n\n    static render (uid:string):string {\n        return `<div class=\"emoji-search-list\"\n            popover=\"manual\"\n            role=\"listbox\"\n            aria-label=\"Emoji suggestions\"\n            id=\"${uid}-list\"\n        ></div>`\n    }\n\n    private hydrate ():void {\n        this.list.addEventListener('pointerdown', ev => ev.preventDefault())\n        this.list.addEventListener('click', ev => {\n            const row = (ev.target as HTMLElement)\n                .closest<HTMLElement>('.emoji-search-item')\n            if (!row) return\n            this.index = Number(row.dataset.index)\n            this.commit()\n        })\n        this.list.addEventListener('pointermove', ev => {\n            const row = (ev.target as HTMLElement)\n                .closest<HTMLElement>(\n                    '.emoji-search-item'\n                )\n            if (!row) return\n            const i = Number(row.dataset.index)\n            if (i !== this.index) {\n                this.index = i\n                this.paintSelection()\n            }\n        })\n    }\n\n    /** Emoji dataset. Replace with a full list if you like. */\n    emojis:EmojiEntry[] = DEFAULT_EMOJIS\n    /** Characters after `:` before the popover opens. */\n    minChars = 2\n    /** Max rows to show. */\n    maxResults = 8\n\n    private field:Field|null = null\n    private list!:HTMLElement\n    private results:EmojiEntry[] = []\n    private index = 0\n    private query = ''\n    private range:{ start:number; end:number }|null = null\n    private observer:MutationObserver|null = null\n\n    private uid = `emoji-search-${Math.random().toString(36).slice(2, 8)}`\n\n    connectedCallback ():void {\n        const root = this.getRootNode() as Document|ShadowRoot\n        if (!this.list) {\n            const wrapper = document.createElement('div')\n            wrapper.innerHTML = EmojiInput.render(this.uid)\n            this.list = wrapper.firstElementChild as HTMLElement\n            this.hydrate()\n        }\n        if (!this.list.isConnected) this.append(this.list)\n\n        const forId = this.getAttribute('for')\n        if (forId) {\n            const target = root.getElementById(forId)\n            if (target) this.attach(target as Field)\n        } else {\n            this.attachSlotted()\n            this.observer = new MutationObserver(() => {\n                if (!this.field) this.attachSlotted()\n            })\n            this.observer.observe(this, { childList:true, subtree:true })\n        }\n    }\n\n    disconnectedCallback ():void {\n        this.detach()\n        this.observer?.disconnect()\n    }\n\n    /** Hook up a textarea or text input. */\n    attach (field:Field):void {\n        this.detach()\n        this.field = field\n        field.addEventListener('input', this.onInput);\n        (field as HTMLElement).addEventListener('keydown', this.onKeydown)\n        field.addEventListener('blur', this.close)\n        field.addEventListener('scroll', this.reposition)\n        field.setAttribute('aria-autocomplete', 'list')\n        window.addEventListener('resize', this.reposition)\n        window.addEventListener('scroll', this.reposition, true)\n    }\n\n    detach ():void {\n        if (!this.field) return\n        this.close()\n        const f = this.field\n        f.removeEventListener('input', this.onInput);\n        (f as HTMLElement).removeEventListener('keydown', this.onKeydown)\n        f.removeEventListener('blur', this.close)\n        f.removeEventListener('scroll', this.reposition)\n        window.removeEventListener('resize', this.reposition)\n        window.removeEventListener('scroll', this.reposition, true)\n        this.field = null\n    }\n\n    get isOpen ():boolean {\n        return this.list.matches(':popover-open')\n    }\n\n    close = ():void => {\n        if (this.isOpen) this.list.hidePopover()\n        this.results = []\n        this.range = null\n        this.field?.removeAttribute('aria-activedescendant')\n        this.field?.removeAttribute('aria-controls')\n    }\n\n    // -- private -------------------------------------------------------\n\n    private attachSlotted ():void {\n        const f = this.querySelector<Field>(\n            ':scope > textarea, :scope > input, textarea, input',\n        )\n        if (f) this.attach(f)\n    }\n\n    private onInput = ():void => {\n        const f = this.field\n        if (!f) return\n        const pos = f.selectionStart ?? f.value.length\n        const before = f.value.slice(0, pos)\n        const m = TRIGGER.exec(before)\n\n        if (!m || m[1].length < this.minChars) {\n            this.close()\n            return\n        }\n\n        // don't trigger inside a word like \"http://foo\"\n        const prev = before[m.index - 1]\n        if (prev && /[^\\s([{]/.test(prev)) {\n            this.close()\n            return\n        }\n\n        this.query = m[1]\n        this.range = { start:m.index, end:pos }\n        this.results = search(this.emojis, this.query, this.maxResults)\n        this.index = 0\n        this.render()\n        this.open()\n    }\n\n    private onKeydown = (ev:KeyboardEvent):void => {\n        if (!this.isOpen) return\n        switch (ev.key) {\n            case 'ArrowDown':\n                ev.preventDefault()\n                this.move(1)\n                break\n            case 'ArrowUp':\n                ev.preventDefault()\n                this.move(-1)\n                break\n            case 'Enter':\n            case 'Tab':\n                if (this.results.length) {\n                    ev.preventDefault()\n                    this.commit()\n                }\n                break\n            case 'Escape':\n                ev.preventDefault()\n                this.close()\n                break\n        }\n    }\n\n    private move (delta:number):void {\n        const n = this.results.length\n        if (!n) return\n        this.index = (this.index + delta + n) % n\n        this.paintSelection()\n    }\n\n    private commit ():void {\n        const f = this.field\n        const chosen = this.results[this.index]\n        const r = this.range\n        if (!f || !chosen || !r) return\n\n        const insert = `${chosen.emoji} `\n        f.setRangeText(insert, r.start, r.end, 'end')\n        const query = this.query\n        this.close()\n        f.dispatchEvent(new InputEvent('input', {\n            bubbles:true,\n            inputType:'insertText',\n            data:insert,\n        }))\n        this.dispatchEvent(new CustomEvent<EmojiSelectDetail>('emoji-select', {\n            bubbles:true,\n            composed:true,\n            detail:{ emoji:chosen, query },\n        }))\n    }\n\n    private render ():void {\n        const list = this.list\n        list.replaceChildren()\n        if (!this.results.length) {\n            const empty = document.createElement('div')\n            empty.className = 'emoji-search-empty'\n            empty.textContent = `No emoji matching :${this.query}`\n            list.append(empty)\n            return\n        }\n        const q = this.query.toLowerCase()\n        this.results.forEach((e, i) => {\n            const row = document.createElement('div')\n            row.className = 'emoji-search-item'\n            row.setAttribute('role', 'option')\n            row.id = `${this.uid}-opt-${i}`\n            row.dataset.index = String(i)\n\n            const glyph = document.createElement('span')\n            glyph.className = 'emoji-search-glyph'\n            glyph.textContent = e.emoji\n\n            const name = document.createElement('span')\n            name.className = 'emoji-search-name'\n            const at = e.name.toLowerCase().indexOf(q)\n            if (at >= 0) {\n                name.append(\n                    `:${e.name.slice(0, at)}`,\n                    Object.assign(document.createElement('b'), {\n                        textContent:e.name.slice(at, at + q.length),\n                    }),\n                    `${e.name.slice(at + q.length)}:`,\n                )\n            } else {\n                name.textContent = `:${e.name}:`\n            }\n\n            row.append(glyph, name)\n            list.append(row)\n        })\n        this.paintSelection()\n    }\n\n    private paintSelection ():void {\n        const rows = this.list.querySelectorAll<HTMLElement>('.emoji-search-item')\n        rows.forEach((row, i) => {\n            row.setAttribute('aria-selected', String(i === this.index))\n        })\n        rows[this.index]?.scrollIntoView({ block:'nearest' })\n        this.field?.setAttribute(\n            'aria-activedescendant',\n            `${this.uid}-opt-${this.index}`,\n        )\n    }\n\n    private open ():void {\n        if (!this.isOpen) this.list.showPopover()\n        this.field?.setAttribute('aria-controls', this.list.id)\n        this.reposition()\n    }\n\n    private reposition = ():void => {\n        const f = this.field\n        if (!f || !this.isOpen || !this.range) return\n        const caret = caretRect(f, this.range.start)\n        const box = this.list.getBoundingClientRect()\n        const gap = 4\n        const vw = document.documentElement.clientWidth\n        const vh = document.documentElement.clientHeight\n\n        let left = caret.left\n        let top = caret.top + caret.height + gap\n        if (left + box.width > vw - gap) left = Math.max(gap, vw - box.width - gap)\n        if (top + box.height > vh - gap) {\n            top = Math.max(gap, caret.top - box.height - gap)\n        }\n        this.list.style.left = `${Math.round(left)}px`\n        this.list.style.top = `${Math.round(top)}px`\n    }\n}\n\nEmojiInput.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-input':EmojiInput;\n    }\n    interface HTMLElementEventMap {\n        'emoji-select':CustomEvent<EmojiSelectDetail>;\n    }\n}\n\nfunction caretRect (field:Field, pos:number):CaretRect {\n    const isTextarea = field instanceof HTMLTextAreaElement\n    const cs = getComputedStyle(field)\n    const mirror = document.createElement('div')\n    const s = mirror.style\n\n    for (const p of MIRROR_PROPS) {\n        s[p] = cs[p]\n    }\n    s.position = 'absolute'\n    s.visibility = 'hidden'\n    s.top = '0'\n    s.left = '-9999px'\n    s.overflow = 'hidden'\n    s.whiteSpace = isTextarea ? 'pre-wrap' : 'pre'\n    if (isTextarea) s.wordWrap = 'break-word'\n\n    const before = field.value.slice(0, pos)\n    mirror.textContent = isTextarea ? before : before.replace(/\\s/g, '\\u00a0')\n\n    const marker = document.createElement('span')\n    marker.textContent = field.value.slice(pos) || '.'\n    mirror.appendChild(marker)\n    document.body.appendChild(mirror)\n\n    const rect = field.getBoundingClientRect()\n    const borderTop = parseFloat(cs.borderTopWidth) || 0\n    const borderLeft = parseFloat(cs.borderLeftWidth) || 0\n    const lineHeight = parseFloat(cs.lineHeight) || marker.offsetHeight\n\n    const out = {\n        top:rect.top + borderTop + marker.offsetTop - field.scrollTop,\n        left:rect.left + borderLeft + marker.offsetLeft - field.scrollLeft,\n        height:lineHeight,\n    }\n    mirror.remove()\n    return out\n}\n","numLines":410,"startLine":1,"totalLines":410}}}
