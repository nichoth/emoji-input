{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lkhe68ZUiaiXs5Vd8Ee12Y","type":"tool_result","content":"1\timport { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\n2\timport { search } from './search.js'\n3\t\n4\texport { EmojiButton } from './button.js'\n5\t\n6\ttype PickerField = HTMLTextAreaElement|HTMLInputElement\n7\ttype PickerCategory = {\n8\t    readonly id:string;\n9\t    readonly label:string;\n10\t    readonly icon:string;\n11\t}\n12\t\n13\tconst CATEGORIES:Array<PickerCategory> = [\n14\t    { id:'people', label:'People', icon:'😀' },\n15\t    { id:'nature', label:'Nature', icon:'🐻' },\n16\t    { id:'foods', label:'Food', icon:'🍔' },\n17\t    { id:'activity', label:'Activity', icon:'⚽' },\n18\t    { id:'places', label:'Places', icon:'🌍' },\n19\t    { id:'objects', label:'Objects', icon:'💡' },\n20\t    { id:'symbols', label:'Symbols', icon:'🔣' },\n21\t    { id:'flags', label:'Flags', icon:'🏳️' },\n22\t]\n23\t\n24\tconst RECENTS:PickerCategory = {\n25\t    id:'recent',\n26\t    label:'Recently used',\n27\t    icon:'🕘',\n28\t}\n29\t\n30\tconst MAX_RECENTS = 24\n31\tconst DEFAULT_RECENT_KEY = 'emoji-picker-recents'\n32\tconst DEFAULT_SKIN_TONE_KEY = 'emoji-picker-skin-tone'\n33\tconst memoryRecents = new Map<string, Array<string>>()\n34\tconst memorySkinTones = new Map<string, number>()\n35\tconst TONE_SWATCHES = ['👋', '👋🏻', '👋🏼', '👋🏽', '👋🏾', '👋🏿']\n36\tconst TONE_LABELS = [\n37\t    'Default skin tone',\n38\t    'Light skin tone',\n39\t    'Medium-light skin tone',\n40\t    'Medium skin tone',\n41\t    'Medium-dark skin tone',\n42\t    'Dark skin tone',\n43\t]\n44\t\n45\tconst Base = typeof HTMLElement !== 'undefined' ?\n46\t    HTMLElement :\n47\t    class {} as unknown as typeof HTMLElement\n48\t\n49\texport class EmojiPicker extends Base {\n50\t    static TAG = 'emoji-picker'\n51\t    static observedAttributes = [\n52\t        'inline',\n53\t        'recent-key',\n54\t        'skin-tone-key',\n55\t    ]\n56\t\n57\t    static define (tag = EmojiPicker.TAG):void {\n58\t        if (typeof window === 'undefined' || !window.customElements) return\n59\t        const customElements = window.customElements\n60\t        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n61\t    }\n62\t\n63\t    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n64\t    private panel!:HTMLDivElement\n65\t    private tabs!:HTMLDivElement\n66\t    private searchInput!:HTMLInputElement\n67\t    private grid!:HTMLDivElement\n68\t    private tones!:HTMLDivElement\n69\t    private preview!:HTMLDivElement\n70\t    private category = 'recent'\n71\t    private query = ''\n72\t    private opened = false\n73\t    private recentNames:Array<string> = []\n74\t    private skinTone = 0\n75\t    private uid = `emoji-picker-${\n76\t        Math.random().toString(36).slice(2, 8)\n77\t    }`\n78\t\n79\t    private triggerElement:HTMLElement|null = null\n80\t\n81\t    get recentKey ():string {\n82\t        return this.getAttribute('recent-key')\n83\t            ?? DEFAULT_RECENT_KEY\n84\t    }\n85\t\n86\t    set recentKey (value:string) {\n87\t        this.setAttribute('recent-key', value)\n88\t    }\n89\t\n90\t    get skinToneKey ():string {\n91\t        return this.getAttribute('skin-tone-key')\n92\t            ?? DEFAULT_SKIN_TONE_KEY\n93\t    }\n94\t\n95\t    set skinToneKey (value:string) {\n96\t        this.setAttribute('skin-tone-key', value)\n97\t    }\n98\t\n99\t    static render (el:EmojiPicker):void {\n100\t        el.panel = document.createElement('div')\n101\t        el.panel.className = 'emoji-picker-panel'\n102\t        el.panel.setAttribute('popover', 'auto')\n103\t\n104\t        el.tabs = document.createElement('div')\n105\t        el.tabs.className = 'emoji-picker-tabs'\n106\t        el.tabs.setAttribute('role', 'tablist')\n107\t\n108\t        el.searchInput = document.createElement('input')\n109\t        el.searchInput.className = 'emoji-picker-search'\n110\t        el.searchInput.type = 'search'\n111\t        el.searchInput.placeholder = 'Search emoji'\n112\t        el.searchInput.setAttribute(\n113\t            'aria-label',\n114\t            'Search emoji',\n115\t        )\n116\t        el.searchInput.setAttribute(\n117\t            'aria-controls',\n118\t            `${el.uid}-grid`,\n119\t        )\n120\t        el.searchInput.addEventListener('input', () => {\n121\t            el.query = el.searchInput.value\n122\t            el.renderGrid()\n123\t        })\n124\t\n125\t        el.tones = document.createElement('div')\n126\t        el.tones.className = 'emoji-picker-tones'\n127\t        el.tones.setAttribute('role', 'radiogroup')\n128\t        el.tones.setAttribute('aria-label', 'Skin tone')\n129\t\n130\t        el.grid = document.createElement('div')\n131\t        el.grid.className = 'emoji-picker-grid'\n132\t        el.grid.id = `${el.uid}-grid`\n133\t        el.grid.setAttribute('role', 'grid')\n134\t        el.grid.setAttribute('aria-label', 'Emoji')\n135\t\n136\t        el.preview = document.createElement('div')\n137\t        el.preview.className = 'emoji-picker-preview'\n138\t        el.preview.setAttribute('role', 'status')\n139\t        el.preview.setAttribute('aria-live', 'polite')\n140\t\n141\t        el.panel.append(\n142\t            el.tabs,\n143\t            el.searchInput,\n144\t            el.tones,\n145\t            el.grid,\n146\t            el.preview,\n147\t        )\n148\t        el.addEventListener('keydown', el.onKeydown)\n149\t        el.tabs.addEventListener('keydown', el.onTabKeydown)\n150\t        el.tones.addEventListener('keydown', el.onToneKeydown)\n151\t        el.grid.addEventListener('mouseenter', (ev) => {\n152\t            el.onGridHoverOrFocus(ev)\n153\t        }, true)\n154\t        el.grid.addEventListener('focusin', (ev) => {\n155\t            el.onGridHoverOrFocus(ev)\n156\t        })\n157\t        el.grid.addEventListener('click', (ev) => {\n158\t            const btn = (ev.target as HTMLElement)\n159\t                .closest<HTMLButtonElement>(\n160\t                    '[role=\"gridcell\"] button'\n161\t                )\n162\t            if (btn) el.focusCell(btn)\n163\t        })\n164\t        el.panel.addEventListener('toggle', el.onPanelToggle)\n165\t    }\n166\t\n167\t    get emojis ():Array<EmojiEntry> {\n168\t        return this.data\n169\t    }\n170\t\n171\t    set emojis (value:Array<EmojiEntry>) {\n172\t        this.data = value\n173\t        this.renderGrid()\n174\t    }\n175\t\n176\t    get isOpen ():boolean {\n177\t        return this.opened\n178\t    }\n179\t\n180\t    connectedCallback ():void {\n181\t        if (!this.panel) EmojiPicker.render(this)\n182\t        this.loadRecents()\n183\t        this.loadSkinTone()\n184\t        this.syncMode()\n185\t        if (!this.panel.isConnected) this.append(this.panel)\n186\t        this.renderTabs()\n187\t        this.renderTones()\n188\t        this.renderGrid()\n189\t    }\n190\t\n191\t    disconnectedCallback ():void {\n192\t        if (this.panel.matches(':popover-open')) {\n193\t            this.panel.hidePopover()\n194\t        }\n195\t        this.panel.hidden = true\n196\t        this.opened = false\n197\t        this.triggerElement = null\n198\t    }\n199\t\n200\t    attributeChangedCallback (name:string):void {\n201\t        this.syncMode()\n202\t        if (name === 'recent-key') this.loadRecents()\n203\t        if (name === 'skin-tone-key') this.loadSkinTone()\n204\t        this.renderTones()\n205\t        this.renderGrid()\n206\t    }\n207\t\n208\t    open (anchor?:HTMLElement):void {\n209\t        const el = document.activeElement\n210\t        this.triggerElement =\n211\t            el instanceof HTMLElement ? el : null\n212\t        this.panel.hidden = false\n213\t        if (!this.hasAttribute('inline')\n214\t            && typeof this.panel.showPopover === 'function') {\n215\t            this.panel.showPopover()\n216\t        }\n217\t        if (anchor && !this.hasAttribute('inline')) {\n218\t            const rect = anchor.getBoundingClientRect()\n219\t            this.panel.style.top = `${rect.bottom}px`\n220\t            this.panel.style.left = `${rect.left}px`\n221\t        }\n222\t        this.opened = true\n223\t        this.searchInput.focus({ preventScroll:true })\n224\t    }\n225\t\n226\t    close ():void {\n227\t        const restoreFocus = this.triggerElement\n228\t            && this.panel.contains(document.activeElement)\n229\t        if (this.panel.matches(':popover-open')) {\n230\t            this.panel.hidePopover()\n231\t        }\n232\t        this.panel.hidden = true\n233\t        this.opened = false\n234\t        if (restoreFocus) {\n235\t            this.triggerElement!.focus()\n236\t        }\n237\t        this.triggerElement = null\n238\t    }\n239\t\n240\t    private renderTabs ():void {\n241\t        this.tabs.replaceChildren()\n242\t        const tabs = [RECENTS, ...CATEGORIES]\n243\t        for (const category of tabs) {\n244\t            const tab = document.createElement('button')\n245\t            tab.type = 'button'\n246\t            tab.className = 'emoji-picker-tab'\n247\t            tab.id = `${this.uid}-tab-${category.id}`\n248\t            tab.setAttribute('role', 'tab')\n249\t            tab.setAttribute('aria-label', category.label)\n250\t            tab.setAttribute(\n251\t                'aria-selected',\n252\t                String(category.id === this.category),\n253\t            )\n254\t            tab.tabIndex = category.id === this.category ?\n255\t                0 : -1\n256\t            tab.title = category.label\n257\t            tab.textContent = category.icon\n258\t            tab.addEventListener('click', () => {\n259\t                this.category = category.id\n260\t                this.renderTabs()\n261\t                this.renderGrid()\n262\t            })\n263\t            this.tabs.append(tab)\n264\t        }\n265\t    }\n266\t\n267\t    private syncMode ():void {\n268\t        if (!this.panel) return\n269\t        if (this.hasAttribute('inline')) {\n270\t            this.panel.removeAttribute('popover')\n271\t        } else {\n272\t            this.panel.setAttribute('popover', 'auto')\n273\t        }\n274\t    }\n275\t\n276\t    private renderGrid ():void {\n277\t        if (!this.grid) return\n278\t        this.grid.replaceChildren()\n279\t        this.clearPreview()\n280\t        const emojis = this.query.trim()\n281\t            ? search(this.data, this.query, this.data.length)\n282\t            : this.category === RECENTS.id\n283\t                ? this.recentEntries()\n284\t                : this.data.filter(emoji => (\n285\t                    emoji.category === this.category\n286\t                    || emoji.categories?.includes(this.category) === true\n287\t                ))\n288\t\n289\t        if (!emojis.length) {\n290\t            const empty = document.createElement('div')\n291\t            empty.className = 'emoji-picker-empty'\n292\t            empty.textContent = this.category === RECENTS.id\n293\t                ? 'No recently used emoji'\n294\t                : 'No emoji in this category'\n295\t            this.grid.append(empty)\n296\t            return\n297\t        }\n298\t\n299\t        const cols = 8\n300\t        let row:HTMLDivElement|null = null\n301\t        for (let i = 0; i < emojis.length; i++) {\n302\t            if (i % cols === 0) {\n303\t                row = document.createElement('div')\n304\t                row.setAttribute('role', 'row')\n305\t                row.className = 'emoji-picker-row'\n306\t                this.grid.append(row)\n307\t            }\n308\t            const emoji = emojis[i]!\n309\t            const displayed = this.withSelectedTone(emoji)\n310\t            const cell = document.createElement('div')\n311\t            cell.setAttribute('role', 'gridcell')\n312\t            const button = document.createElement('button')\n313\t            button.type = 'button'\n314\t            button.className = 'emoji-picker-emoji'\n315\t            button.setAttribute(\n316\t                'aria-label', displayed.label ?? displayed.name\n317\t            )\n318\t            button.textContent = displayed.emoji\n319\t            button.tabIndex = i === 0 ? 0 : -1\n320\t            button.dataset.emojiName = emoji.name\n321\t            button.addEventListener(\n322\t                'click', () => this.select(displayed)\n323\t            )\n324\t            cell.append(button)\n325\t            row!.append(cell)\n326\t        }\n327\t    }\n328\t\n329\t    private onGridHoverOrFocus (ev:Event):void {\n330\t        const btn = (ev.target as HTMLElement)\n331\t            .closest<HTMLButtonElement>(\n332\t                '[role=\"gridcell\"] button'\n333\t            )\n334\t        if (!btn) return\n335\t        const name = btn.dataset.emojiName\n336\t        const entry = this.data.find(\n337\t            e => e.name === name\n338\t        )\n339\t        if (entry) {\n340\t            this.showPreview(\n341\t                this.withSelectedTone(entry)\n342\t            )\n343\t        }\n344\t    }\n345\t\n346\t    private select (emoji:EmojiEntry):void {\n347\t        const query = this.query\n348\t        this.addRecent(emoji)\n349\t        const field = this.targetField\n350\t        const trigger = this.triggerElement\n351\t        if (field) {\n352\t            const start = field.selectionStart\n353\t                ?? field.value.length\n354\t            const end = field.selectionEnd ?? start\n355\t            field.setRangeText(\n356\t                emoji.emoji, start, end, 'end'\n357\t            )\n358\t            field.dispatchEvent(new InputEvent('input', {\n359\t                bubbles:true,\n360\t                inputType:'insertText',\n361\t                data:emoji.emoji,\n362\t            }))\n363\t        }\n364\t        if (this.panel.matches(':popover-open')) {\n365\t            this.panel.hidePopover()\n366\t        }\n367\t        this.panel.hidden = true\n368\t        this.opened = false\n369\t        this.triggerElement = null\n370\t        if (field) {\n371\t            field.focus()\n372\t        } else if (trigger) {\n373\t            trigger.focus()\n374\t        }\n375\t        this.dispatchEvent(new CustomEvent('emoji-select', {\n376\t            bubbles:true,\n377\t            composed:true,\n378\t            detail:{ emoji, query },\n379\t        }))\n380\t    }\n381\t\n382\t    private get targetField ():PickerField|null {\n383\t        const id = this.getAttribute('for')\n384\t        if (!id) return null\n385\t        const field = document.getElementById(id)\n386\t        return field instanceof HTMLTextAreaElement\n387\t            || field instanceof HTMLInputElement\n388\t            ? field\n389\t            : null\n390\t    }\n391\t\n392\t    private loadRecents ():void {\n393\t        const stored = this.readRecents()\n394\t        this.recentNames = stored\n395\t    }\n396\t\n397\t    private recentEntries ():Array<EmojiEntry> {\n398\t        return this.recentNames\n399\t            .map(name => this.data.find(emoji => emoji.name === name))\n400\t            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n401\t    }\n402\t\n403\t    private addRecent (emoji:EmojiEntry):void {\n404\t        this.recentNames = [\n405\t            emoji.name,\n406\t            ...this.recentNames.filter(name => name !== emoji.name),\n407\t        ].slice(0, MAX_RECENTS)\n408\t        this.writeRecents()\n409\t    }\n410\t\n411\t    private readRecents ():Array<string> {\n412\t        const key = this.recentKey\n413\t        try {\n414\t            const value = window.localStorage.getItem(key)\n415\t            if (value) {\n416\t                const parsed:unknown = JSON.parse(value)\n417\t                if (Array.isArray(parsed)) {\n418\t                    return parsed.filter(\n419\t                        (name):name is string => typeof name === 'string'\n420\t                    ).slice(0, MAX_RECENTS)\n421\t                }\n422\t            }\n423\t        } catch {\n424\t            return [...memoryRecents.get(key) ?? []]\n425\t        }\n426\t        return [...memoryRecents.get(key) ?? []]\n427\t    }\n428\t\n429\t    private writeRecents ():void {\n430\t        const key = this.recentKey\n431\t        memoryRecents.set(key, [...this.recentNames])\n432\t        try {\n433\t            window.localStorage.setItem(\n434\t                key,\n435\t                JSON.stringify(this.recentNames)\n436\t            )\n437\t        } catch {\n438\t            // The in-memory map is the fallback when storage is unavailable.\n439\t        }\n440\t    }\n441\t\n442\t    private renderTones ():void {\n443\t        if (!this.tones) return\n444\t        this.tones.replaceChildren()\n445\t        TONE_SWATCHES.forEach((swatch, tone) => {\n446\t            const button = document.createElement('button')\n447\t            button.type = 'button'\n448\t            button.className = 'emoji-picker-tone'\n449\t            button.setAttribute('role', 'radio')\n450\t            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n451\t            button.setAttribute('aria-checked', String(tone === this.skinTone))\n452\t            button.textContent = swatch\n453\t            button.addEventListener('click', () => {\n454\t                this.skinTone = tone\n455\t                this.writeSkinTone()\n456\t                this.renderTones()\n457\t                this.renderGrid()\n458\t            })\n459\t            this.tones.append(button)\n460\t        })\n461\t    }\n462\t\n463\t    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n464\t        const variants = emoji.skins ?? emoji.variants\n465\t        const variant = variants?.[this.skinTone]\n466\t        return variant ? { ...emoji, emoji:variant.native } : emoji\n467\t    }\n468\t\n469\t    private loadSkinTone ():void {\n470\t        const key = this.skinToneKey\n471\t        try {\n472\t            const value = window.localStorage.getItem(key)\n473\t            const tone = value === null ? undefined : Number(value)\n474\t            if (tone !== undefined && Number.isInteger(tone)\n475\t                && tone >= 0 && tone < TONE_SWATCHES.length) {\n476\t                this.skinTone = tone\n477\t                return\n478\t            }\n479\t        } catch {\n480\t            // The in-memory map is the fallback when storage is unavailable.\n481\t        }\n482\t        this.skinTone = memorySkinTones.get(key) ?? 0\n483\t    }\n484\t\n485\t    private writeSkinTone ():void {\n486\t        const key = this.skinToneKey\n487\t        memorySkinTones.set(key, this.skinTone)\n488\t        try {\n489\t            window.localStorage.setItem(key, String(this.skinTone))\n490\t        } catch {\n491\t            // The in-memory map is the fallback when storage is unavailable.\n492\t        }\n493\t    }\n494\t\n495\t    private clearPreview ():void {\n496\t        this.preview.replaceChildren()\n497\t    }\n498\t\n499\t    private showPreview (emoji:EmojiEntry):void {\n500\t        const glyph = document.createElement('span')\n501\t        glyph.className = 'emoji-picker-preview-glyph'\n502\t        glyph.textContent = emoji.emoji\n503\t\n504\t        const name = document.createElement('span')\n505\t        name.className = 'emoji-picker-preview-name'\n506\t        name.textContent = emoji.name\n507\t\n508\t        this.preview.replaceChildren(glyph, name)\n509\t    }\n510\t\n511\t    private onKeydown = (event:KeyboardEvent):void => {\n512\t        if (!this.opened) return\n513\t        if (event.key === 'Escape') {\n514\t            event.preventDefault()\n515\t            this.close()\n516\t            return\n517\t        }\n518\t\n519\t        const target = event.target as HTMLElement|null\n520\t\n521\t        if (target?.closest('[role=\"tab\"]')) {\n522\t            return\n523\t        }\n524\t\n525\t        if (target?.closest('[role=\"radio\"]')) {\n526\t            return\n527\t        }\n528\t\n529\t        if (target === this.searchInput) {\n530\t            this.onSearchKeydown(event)\n531\t            return\n532\t        }\n533\t\n534\t        if (target?.closest('[role=\"gridcell\"]')\n535\t            || target?.closest('[role=\"grid\"]')) {\n536\t            this.onGridKeydown(event)\n537\t        }\n538\t    }\n539\t\n540\t    private onSearchKeydown (event:KeyboardEvent):void {\n541\t        if (event.key === 'ArrowDown') {\n542\t            event.preventDefault()\n543\t            const btn = this.grid.querySelector<HTMLButtonElement>(\n544\t                '[role=\"gridcell\"] button'\n545\t            )\n546\t            if (btn) this.focusCell(btn)\n547\t            return\n548\t        }\n549\t\n550\t        if (event.key === 'Enter') {\n551\t            const query = this.searchInput.value.trim()\n552\t            if (!query) return\n553\t            const btn = this.grid.querySelector<HTMLButtonElement>(\n554\t                '[role=\"gridcell\"] button'\n555\t            )\n556\t            btn?.click()\n557\t        }\n558\t    }\n559\t\n560\t    private onGridKeydown (event:KeyboardEvent):void {\n561\t        const buttons = Array.from(\n562\t            this.grid.querySelectorAll<HTMLButtonElement>(\n563\t                '[role=\"gridcell\"] button'\n564\t            )\n565\t        )\n566\t        if (!buttons.length) return\n567\t\n568\t        const active = document.activeElement\n569\t        const current = Math.max(0, buttons.indexOf(\n570\t            active as HTMLButtonElement\n571\t        ))\n572\t\n573\t        const currentBtn = buttons[current]!\n574\t        const row = currentBtn.closest('[role=\"row\"]')\n575\t        const rowCells = row ?\n576\t            Array.from(row.querySelectorAll<HTMLButtonElement>(\n577\t                '[role=\"gridcell\"] button'\n578\t            )) :\n579\t            buttons\n580\t        const colIndex = rowCells.indexOf(currentBtn)\n581\t        const cols = rowCells.length\n582\t\n583\t        let next = -1\n584\t        if (event.key === 'ArrowRight') {\n585\t            next = current + 1 < buttons.length ?\n586\t                current + 1 : current\n587\t        } else if (event.key === 'ArrowLeft') {\n588\t            next = current - 1 >= 0 ?\n589\t                current - 1 : current\n590\t        } else if (event.key === 'ArrowDown') {\n591\t            const target = current + cols\n592\t            next = target < buttons.length ?\n593\t                target : current\n594\t        } else if (event.key === 'ArrowUp') {\n595\t            const target = current - cols\n596\t            next = target >= 0 ?\n597\t                target : current\n598\t        } else if (event.key === 'Home') {\n599\t            next = current - colIndex\n600\t        } else if (event.key === 'End') {\n601\t            next = current - colIndex + rowCells.length - 1\n602\t        } else if (\n603\t            event.key === 'Enter' || event.key === ' '\n604\t        ) {\n605\t            currentBtn.click()\n606\t            return\n607\t        }\n608\t\n609\t        if (next >= 0 && next !== current) {\n610\t            event.preventDefault()\n611\t            this.focusCell(buttons[next]!)\n612\t        }\n613\t    }\n614\t\n615\t    private focusCell (button:HTMLButtonElement):void {\n616\t        const prev = this.grid.querySelector<HTMLButtonElement>(\n617\t            '[role=\"gridcell\"] button[tabindex=\"0\"]'\n618\t        )\n619\t        if (prev) prev.tabIndex = -1\n620\t        button.tabIndex = 0\n621\t        button.focus()\n622\t    }\n623\t\n624\t    private onTabKeydown = (event:KeyboardEvent):void => {\n625\t        const tabs = Array.from(\n626\t            this.tabs.querySelectorAll<HTMLButtonElement>(\n627\t                '[role=\"tab\"]'\n628\t            )\n629\t        )\n630\t        const current = tabs.indexOf(\n631\t            document.activeElement as HTMLButtonElement\n632\t        )\n633\t        if (current === -1) return\n634\t\n635\t        let next = -1\n636\t        if (event.key === 'ArrowRight') {\n637\t            next = (current + 1) % tabs.length\n638\t        } else if (event.key === 'ArrowLeft') {\n639\t            next = (current - 1 + tabs.length)\n640\t                % tabs.length\n641\t        } else if (event.key === 'Home') {\n642\t            next = 0\n643\t        } else if (event.key === 'End') {\n644\t            next = tabs.length - 1\n645\t        }\n646\t\n647\t        if (next < 0) return\n648\t        event.preventDefault()\n649\t        event.stopPropagation()\n650\t        const allCategories = [RECENTS, ...CATEGORIES]\n651\t        this.category = allCategories[next]!.id\n652\t        this.renderTabs()\n653\t        this.renderGrid()\n654\t        this.tabs.querySelectorAll<HTMLButtonElement>(\n655\t            '[role=\"tab\"]'\n656\t        )[next]?.focus()\n657\t    }\n658\t\n659\t    private onToneKeydown = (event:KeyboardEvent):void => {\n660\t        const radios = Array.from(\n661\t            this.tones.querySelectorAll<HTMLButtonElement>(\n662\t                '[role=\"radio\"]'\n663\t            )\n664\t        )\n665\t        const current = radios.indexOf(\n666\t            document.activeElement as HTMLButtonElement\n667\t        )\n668\t        if (current === -1) return\n669\t\n670\t        let next = -1\n671\t        if (event.key === 'ArrowRight') {\n672\t            next = (current + 1) % radios.length\n673\t        } else if (event.key === 'ArrowLeft') {\n674\t            next = (current - 1 + radios.length)\n675\t                % radios.length\n676\t        }\n677\t\n678\t        if (next < 0) return\n679\t        event.preventDefault()\n680\t        event.stopPropagation()\n681\t        this.skinTone = next\n682\t        this.writeSkinTone()\n683\t        this.renderTones()\n684\t        this.renderGrid()\n685\t        this.tones.querySelectorAll<HTMLButtonElement>(\n686\t            '[role=\"radio\"]'\n687\t        )[next]?.focus()\n688\t    }\n689\t\n690\t    private onPanelToggle = (event:Event):void => {\n691\t        const te = event as ToggleEvent\n692\t        if (te.newState === 'closed') {\n693\t            this.panel.hidden = true\n694\t            this.opened = false\n695\t            this.triggerElement = null\n696\t        }\n697\t    }\n698\t}\n699\t\n700\tEmojiPicker.define()\n701\t\n702\tdeclare global {\n703\t    interface HTMLElementTagNameMap {\n704\t        'emoji-picker':EmojiPicker;\n705\t    }\n706\t}\n707\t"}]},"parent_tool_use_id":null,"session_id":"5d8ca47e-2453-481d-b700-e6152825210e","uuid":"c8c30f58-187c-4a3a-ae03-fccd052c915c","timestamp":"2026-09-23T18:59:11.785Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/emoji-input.correctness-audit-fixes-09-picker-positioning/src/picker.ts","content":"import { DEFAULT_EMOJIS, type EmojiEntry } from './data.js'\nimport { search } from './search.js'\n\nexport { EmojiButton } from './button.js'\n\ntype PickerField = HTMLTextAreaElement|HTMLInputElement\ntype PickerCategory = {\n    readonly id:string;\n    readonly label:string;\n    readonly icon:string;\n}\n\nconst CATEGORIES:Array<PickerCategory> = [\n    { id:'people', label:'People', icon:'😀' },\n    { id:'nature', label:'Nature', icon:'🐻' },\n    { id:'foods', label:'Food', icon:'🍔' },\n    { id:'activity', label:'Activity', icon:'⚽' },\n    { id:'places', label:'Places', icon:'🌍' },\n    { id:'objects', label:'Objects', icon:'💡' },\n    { id:'symbols', label:'Symbols', icon:'🔣' },\n    { id:'flags', label:'Flags', icon:'🏳️' },\n]\n\nconst RECENTS:PickerCategory = {\n    id:'recent',\n    label:'Recently used',\n    icon:'🕘',\n}\n\nconst MAX_RECENTS = 24\nconst DEFAULT_RECENT_KEY = 'emoji-picker-recents'\nconst DEFAULT_SKIN_TONE_KEY = 'emoji-picker-skin-tone'\nconst memoryRecents = new Map<string, Array<string>>()\nconst memorySkinTones = new Map<string, number>()\nconst TONE_SWATCHES = ['👋', '👋🏻', '👋🏼', '👋🏽', '👋🏾', '👋🏿']\nconst TONE_LABELS = [\n    'Default skin tone',\n    'Light skin tone',\n    'Medium-light skin tone',\n    'Medium skin tone',\n    'Medium-dark skin tone',\n    'Dark skin tone',\n]\n\nconst Base = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    class {} as unknown as typeof HTMLElement\n\nexport class EmojiPicker extends Base {\n    static TAG = 'emoji-picker'\n    static observedAttributes = [\n        'inline',\n        'recent-key',\n        'skin-tone-key',\n    ]\n\n    static define (tag = EmojiPicker.TAG):void {\n        if (typeof window === 'undefined' || !window.customElements) return\n        const customElements = window.customElements\n        if (!customElements.get(tag)) customElements.define(tag, EmojiPicker)\n    }\n\n    private data:Array<EmojiEntry> = DEFAULT_EMOJIS\n    private panel!:HTMLDivElement\n    private tabs!:HTMLDivElement\n    private searchInput!:HTMLInputElement\n    private grid!:HTMLDivElement\n    private tones!:HTMLDivElement\n    private preview!:HTMLDivElement\n    private category = 'recent'\n    private query = ''\n    private opened = false\n    private recentNames:Array<string> = []\n    private skinTone = 0\n    private uid = `emoji-picker-${\n        Math.random().toString(36).slice(2, 8)\n    }`\n\n    private triggerElement:HTMLElement|null = null\n\n    get recentKey ():string {\n        return this.getAttribute('recent-key')\n            ?? DEFAULT_RECENT_KEY\n    }\n\n    set recentKey (value:string) {\n        this.setAttribute('recent-key', value)\n    }\n\n    get skinToneKey ():string {\n        return this.getAttribute('skin-tone-key')\n            ?? DEFAULT_SKIN_TONE_KEY\n    }\n\n    set skinToneKey (value:string) {\n        this.setAttribute('skin-tone-key', value)\n    }\n\n    static render (el:EmojiPicker):void {\n        el.panel = document.createElement('div')\n        el.panel.className = 'emoji-picker-panel'\n        el.panel.setAttribute('popover', 'auto')\n\n        el.tabs = document.createElement('div')\n        el.tabs.className = 'emoji-picker-tabs'\n        el.tabs.setAttribute('role', 'tablist')\n\n        el.searchInput = document.createElement('input')\n        el.searchInput.className = 'emoji-picker-search'\n        el.searchInput.type = 'search'\n        el.searchInput.placeholder = 'Search emoji'\n        el.searchInput.setAttribute(\n            'aria-label',\n            'Search emoji',\n        )\n        el.searchInput.setAttribute(\n            'aria-controls',\n            `${el.uid}-grid`,\n        )\n        el.searchInput.addEventListener('input', () => {\n            el.query = el.searchInput.value\n            el.renderGrid()\n        })\n\n        el.tones = document.createElement('div')\n        el.tones.className = 'emoji-picker-tones'\n        el.tones.setAttribute('role', 'radiogroup')\n        el.tones.setAttribute('aria-label', 'Skin tone')\n\n        el.grid = document.createElement('div')\n        el.grid.className = 'emoji-picker-grid'\n        el.grid.id = `${el.uid}-grid`\n        el.grid.setAttribute('role', 'grid')\n        el.grid.setAttribute('aria-label', 'Emoji')\n\n        el.preview = document.createElement('div')\n        el.preview.className = 'emoji-picker-preview'\n        el.preview.setAttribute('role', 'status')\n        el.preview.setAttribute('aria-live', 'polite')\n\n        el.panel.append(\n            el.tabs,\n            el.searchInput,\n            el.tones,\n            el.grid,\n            el.preview,\n        )\n        el.addEventListener('keydown', el.onKeydown)\n        el.tabs.addEventListener('keydown', el.onTabKeydown)\n        el.tones.addEventListener('keydown', el.onToneKeydown)\n        el.grid.addEventListener('mouseenter', (ev) => {\n            el.onGridHoverOrFocus(ev)\n        }, true)\n        el.grid.addEventListener('focusin', (ev) => {\n            el.onGridHoverOrFocus(ev)\n        })\n        el.grid.addEventListener('click', (ev) => {\n            const btn = (ev.target as HTMLElement)\n                .closest<HTMLButtonElement>(\n                    '[role=\"gridcell\"] button'\n                )\n            if (btn) el.focusCell(btn)\n        })\n        el.panel.addEventListener('toggle', el.onPanelToggle)\n    }\n\n    get emojis ():Array<EmojiEntry> {\n        return this.data\n    }\n\n    set emojis (value:Array<EmojiEntry>) {\n        this.data = value\n        this.renderGrid()\n    }\n\n    get isOpen ():boolean {\n        return this.opened\n    }\n\n    connectedCallback ():void {\n        if (!this.panel) EmojiPicker.render(this)\n        this.loadRecents()\n        this.loadSkinTone()\n        this.syncMode()\n        if (!this.panel.isConnected) this.append(this.panel)\n        this.renderTabs()\n        this.renderTones()\n        this.renderGrid()\n    }\n\n    disconnectedCallback ():void {\n        if (this.panel.matches(':popover-open')) {\n            this.panel.hidePopover()\n        }\n        this.panel.hidden = true\n        this.opened = false\n        this.triggerElement = null\n    }\n\n    attributeChangedCallback (name:string):void {\n        this.syncMode()\n        if (name === 'recent-key') this.loadRecents()\n        if (name === 'skin-tone-key') this.loadSkinTone()\n        this.renderTones()\n        this.renderGrid()\n    }\n\n    open (anchor?:HTMLElement):void {\n        const el = document.activeElement\n        this.triggerElement =\n            el instanceof HTMLElement ? el : null\n        this.panel.hidden = false\n        if (!this.hasAttribute('inline')\n            && typeof this.panel.showPopover === 'function') {\n            this.panel.showPopover()\n        }\n        if (anchor && !this.hasAttribute('inline')) {\n            const rect = anchor.getBoundingClientRect()\n            this.panel.style.top = `${rect.bottom}px`\n            this.panel.style.left = `${rect.left}px`\n        }\n        this.opened = true\n        this.searchInput.focus({ preventScroll:true })\n    }\n\n    close ():void {\n        const restoreFocus = this.triggerElement\n            && this.panel.contains(document.activeElement)\n        if (this.panel.matches(':popover-open')) {\n            this.panel.hidePopover()\n        }\n        this.panel.hidden = true\n        this.opened = false\n        if (restoreFocus) {\n            this.triggerElement!.focus()\n        }\n        this.triggerElement = null\n    }\n\n    private renderTabs ():void {\n        this.tabs.replaceChildren()\n        const tabs = [RECENTS, ...CATEGORIES]\n        for (const category of tabs) {\n            const tab = document.createElement('button')\n            tab.type = 'button'\n            tab.className = 'emoji-picker-tab'\n            tab.id = `${this.uid}-tab-${category.id}`\n            tab.setAttribute('role', 'tab')\n            tab.setAttribute('aria-label', category.label)\n            tab.setAttribute(\n                'aria-selected',\n                String(category.id === this.category),\n            )\n            tab.tabIndex = category.id === this.category ?\n                0 : -1\n            tab.title = category.label\n            tab.textContent = category.icon\n            tab.addEventListener('click', () => {\n                this.category = category.id\n                this.renderTabs()\n                this.renderGrid()\n            })\n            this.tabs.append(tab)\n        }\n    }\n\n    private syncMode ():void {\n        if (!this.panel) return\n        if (this.hasAttribute('inline')) {\n            this.panel.removeAttribute('popover')\n        } else {\n            this.panel.setAttribute('popover', 'auto')\n        }\n    }\n\n    private renderGrid ():void {\n        if (!this.grid) return\n        this.grid.replaceChildren()\n        this.clearPreview()\n        const emojis = this.query.trim()\n            ? search(this.data, this.query, this.data.length)\n            : this.category === RECENTS.id\n                ? this.recentEntries()\n                : this.data.filter(emoji => (\n                    emoji.category === this.category\n                    || emoji.categories?.includes(this.category) === true\n                ))\n\n        if (!emojis.length) {\n            const empty = document.createElement('div')\n            empty.className = 'emoji-picker-empty'\n            empty.textContent = this.category === RECENTS.id\n                ? 'No recently used emoji'\n                : 'No emoji in this category'\n            this.grid.append(empty)\n            return\n        }\n\n        const cols = 8\n        let row:HTMLDivElement|null = null\n        for (let i = 0; i < emojis.length; i++) {\n            if (i % cols === 0) {\n                row = document.createElement('div')\n                row.setAttribute('role', 'row')\n                row.className = 'emoji-picker-row'\n                this.grid.append(row)\n            }\n            const emoji = emojis[i]!\n            const displayed = this.withSelectedTone(emoji)\n            const cell = document.createElement('div')\n            cell.setAttribute('role', 'gridcell')\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-emoji'\n            button.setAttribute(\n                'aria-label', displayed.label ?? displayed.name\n            )\n            button.textContent = displayed.emoji\n            button.tabIndex = i === 0 ? 0 : -1\n            button.dataset.emojiName = emoji.name\n            button.addEventListener(\n                'click', () => this.select(displayed)\n            )\n            cell.append(button)\n            row!.append(cell)\n        }\n    }\n\n    private onGridHoverOrFocus (ev:Event):void {\n        const btn = (ev.target as HTMLElement)\n            .closest<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )\n        if (!btn) return\n        const name = btn.dataset.emojiName\n        const entry = this.data.find(\n            e => e.name === name\n        )\n        if (entry) {\n            this.showPreview(\n                this.withSelectedTone(entry)\n            )\n        }\n    }\n\n    private select (emoji:EmojiEntry):void {\n        const query = this.query\n        this.addRecent(emoji)\n        const field = this.targetField\n        const trigger = this.triggerElement\n        if (field) {\n            const start = field.selectionStart\n                ?? field.value.length\n            const end = field.selectionEnd ?? start\n            field.setRangeText(\n                emoji.emoji, start, end, 'end'\n            )\n            field.dispatchEvent(new InputEvent('input', {\n                bubbles:true,\n                inputType:'insertText',\n                data:emoji.emoji,\n            }))\n        }\n        if (this.panel.matches(':popover-open')) {\n            this.panel.hidePopover()\n        }\n        this.panel.hidden = true\n        this.opened = false\n        this.triggerElement = null\n        if (field) {\n            field.focus()\n        } else if (trigger) {\n            trigger.focus()\n        }\n        this.dispatchEvent(new CustomEvent('emoji-select', {\n            bubbles:true,\n            composed:true,\n            detail:{ emoji, query },\n        }))\n    }\n\n    private get targetField ():PickerField|null {\n        const id = this.getAttribute('for')\n        if (!id) return null\n        const field = document.getElementById(id)\n        return field instanceof HTMLTextAreaElement\n            || field instanceof HTMLInputElement\n            ? field\n            : null\n    }\n\n    private loadRecents ():void {\n        const stored = this.readRecents()\n        this.recentNames = stored\n    }\n\n    private recentEntries ():Array<EmojiEntry> {\n        return this.recentNames\n            .map(name => this.data.find(emoji => emoji.name === name))\n            .filter((emoji):emoji is EmojiEntry => emoji !== undefined)\n    }\n\n    private addRecent (emoji:EmojiEntry):void {\n        this.recentNames = [\n            emoji.name,\n            ...this.recentNames.filter(name => name !== emoji.name),\n        ].slice(0, MAX_RECENTS)\n        this.writeRecents()\n    }\n\n    private readRecents ():Array<string> {\n        const key = this.recentKey\n        try {\n            const value = window.localStorage.getItem(key)\n            if (value) {\n                const parsed:unknown = JSON.parse(value)\n                if (Array.isArray(parsed)) {\n                    return parsed.filter(\n                        (name):name is string => typeof name === 'string'\n                    ).slice(0, MAX_RECENTS)\n                }\n            }\n        } catch {\n            return [...memoryRecents.get(key) ?? []]\n        }\n        return [...memoryRecents.get(key) ?? []]\n    }\n\n    private writeRecents ():void {\n        const key = this.recentKey\n        memoryRecents.set(key, [...this.recentNames])\n        try {\n            window.localStorage.setItem(\n                key,\n                JSON.stringify(this.recentNames)\n            )\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private renderTones ():void {\n        if (!this.tones) return\n        this.tones.replaceChildren()\n        TONE_SWATCHES.forEach((swatch, tone) => {\n            const button = document.createElement('button')\n            button.type = 'button'\n            button.className = 'emoji-picker-tone'\n            button.setAttribute('role', 'radio')\n            button.setAttribute('aria-label', TONE_LABELS[tone] ?? swatch)\n            button.setAttribute('aria-checked', String(tone === this.skinTone))\n            button.textContent = swatch\n            button.addEventListener('click', () => {\n                this.skinTone = tone\n                this.writeSkinTone()\n                this.renderTones()\n                this.renderGrid()\n            })\n            this.tones.append(button)\n        })\n    }\n\n    private withSelectedTone (emoji:EmojiEntry):EmojiEntry {\n        const variants = emoji.skins ?? emoji.variants\n        const variant = variants?.[this.skinTone]\n        return variant ? { ...emoji, emoji:variant.native } : emoji\n    }\n\n    private loadSkinTone ():void {\n        const key = this.skinToneKey\n        try {\n            const value = window.localStorage.getItem(key)\n            const tone = value === null ? undefined : Number(value)\n            if (tone !== undefined && Number.isInteger(tone)\n                && tone >= 0 && tone < TONE_SWATCHES.length) {\n                this.skinTone = tone\n                return\n            }\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n        this.skinTone = memorySkinTones.get(key) ?? 0\n    }\n\n    private writeSkinTone ():void {\n        const key = this.skinToneKey\n        memorySkinTones.set(key, this.skinTone)\n        try {\n            window.localStorage.setItem(key, String(this.skinTone))\n        } catch {\n            // The in-memory map is the fallback when storage is unavailable.\n        }\n    }\n\n    private clearPreview ():void {\n        this.preview.replaceChildren()\n    }\n\n    private showPreview (emoji:EmojiEntry):void {\n        const glyph = document.createElement('span')\n        glyph.className = 'emoji-picker-preview-glyph'\n        glyph.textContent = emoji.emoji\n\n        const name = document.createElement('span')\n        name.className = 'emoji-picker-preview-name'\n        name.textContent = emoji.name\n\n        this.preview.replaceChildren(glyph, name)\n    }\n\n    private onKeydown = (event:KeyboardEvent):void => {\n        if (!this.opened) return\n        if (event.key === 'Escape') {\n            event.preventDefault()\n            this.close()\n            return\n        }\n\n        const target = event.target as HTMLElement|null\n\n        if (target?.closest('[role=\"tab\"]')) {\n            return\n        }\n\n        if (target?.closest('[role=\"radio\"]')) {\n            return\n        }\n\n        if (target === this.searchInput) {\n            this.onSearchKeydown(event)\n            return\n        }\n\n        if (target?.closest('[role=\"gridcell\"]')\n            || target?.closest('[role=\"grid\"]')) {\n            this.onGridKeydown(event)\n        }\n    }\n\n    private onSearchKeydown (event:KeyboardEvent):void {\n        if (event.key === 'ArrowDown') {\n            event.preventDefault()\n            const btn = this.grid.querySelector<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )\n            if (btn) this.focusCell(btn)\n            return\n        }\n\n        if (event.key === 'Enter') {\n            const query = this.searchInput.value.trim()\n            if (!query) return\n            const btn = this.grid.querySelector<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )\n            btn?.click()\n        }\n    }\n\n    private onGridKeydown (event:KeyboardEvent):void {\n        const buttons = Array.from(\n            this.grid.querySelectorAll<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )\n        )\n        if (!buttons.length) return\n\n        const active = document.activeElement\n        const current = Math.max(0, buttons.indexOf(\n            active as HTMLButtonElement\n        ))\n\n        const currentBtn = buttons[current]!\n        const row = currentBtn.closest('[role=\"row\"]')\n        const rowCells = row ?\n            Array.from(row.querySelectorAll<HTMLButtonElement>(\n                '[role=\"gridcell\"] button'\n            )) :\n            buttons\n        const colIndex = rowCells.indexOf(currentBtn)\n        const cols = rowCells.length\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = current + 1 < buttons.length ?\n                current + 1 : current\n        } else if (event.key === 'ArrowLeft') {\n            next = current - 1 >= 0 ?\n                current - 1 : current\n        } else if (event.key === 'ArrowDown') {\n            const target = current + cols\n            next = target < buttons.length ?\n                target : current\n        } else if (event.key === 'ArrowUp') {\n            const target = current - cols\n            next = target >= 0 ?\n                target : current\n        } else if (event.key === 'Home') {\n            next = current - colIndex\n        } else if (event.key === 'End') {\n            next = current - colIndex + rowCells.length - 1\n        } else if (\n            event.key === 'Enter' || event.key === ' '\n        ) {\n            currentBtn.click()\n            return\n        }\n\n        if (next >= 0 && next !== current) {\n            event.preventDefault()\n            this.focusCell(buttons[next]!)\n        }\n    }\n\n    private focusCell (button:HTMLButtonElement):void {\n        const prev = this.grid.querySelector<HTMLButtonElement>(\n            '[role=\"gridcell\"] button[tabindex=\"0\"]'\n        )\n        if (prev) prev.tabIndex = -1\n        button.tabIndex = 0\n        button.focus()\n    }\n\n    private onTabKeydown = (event:KeyboardEvent):void => {\n        const tabs = Array.from(\n            this.tabs.querySelectorAll<HTMLButtonElement>(\n                '[role=\"tab\"]'\n            )\n        )\n        const current = tabs.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % tabs.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + tabs.length)\n                % tabs.length\n        } else if (event.key === 'Home') {\n            next = 0\n        } else if (event.key === 'End') {\n            next = tabs.length - 1\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        const allCategories = [RECENTS, ...CATEGORIES]\n        this.category = allCategories[next]!.id\n        this.renderTabs()\n        this.renderGrid()\n        this.tabs.querySelectorAll<HTMLButtonElement>(\n            '[role=\"tab\"]'\n        )[next]?.focus()\n    }\n\n    private onToneKeydown = (event:KeyboardEvent):void => {\n        const radios = Array.from(\n            this.tones.querySelectorAll<HTMLButtonElement>(\n                '[role=\"radio\"]'\n            )\n        )\n        const current = radios.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % radios.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + radios.length)\n                % radios.length\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        this.skinTone = next\n        this.writeSkinTone()\n        this.renderTones()\n        this.renderGrid()\n        this.tones.querySelectorAll<HTMLButtonElement>(\n            '[role=\"radio\"]'\n        )[next]?.focus()\n    }\n\n    private onPanelToggle = (event:Event):void => {\n        const te = event as ToggleEvent\n        if (te.newState === 'closed') {\n            this.panel.hidden = true\n            this.opened = false\n            this.triggerElement = null\n        }\n    }\n}\n\nEmojiPicker.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-picker':EmojiPicker;\n    }\n}\n","numLines":707,"startLine":1,"totalLines":707}}}
