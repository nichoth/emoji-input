 this.grid.querySelector<HTMLButtonElement>(\n            '[role=\"gridcell\"] button[tabindex=\"0\"]'\n        )\n        if (prev) prev.tabIndex = -1\n        button.tabIndex = 0\n        button.focus()\n    }\n\n    private onTabKeydown = (event:KeyboardEvent):void => {\n        const tabs = Array.from(\n            this.tabs.querySelectorAll<HTMLButtonElement>(\n                '[role=\"tab\"]'\n            )\n        )\n        const current = tabs.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % tabs.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + tabs.length)\n                % tabs.length\n        } else if (event.key === 'Home') {\n            next = 0\n        } else if (event.key === 'End') {\n            next = tabs.length - 1\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        const allCategories = [RECENTS, ...CATEGORIES]\n        this.category = allCategories[next]!.id\n        this.renderTabs()\n        this.renderGrid()\n        this.tabs.querySelectorAll<HTMLButtonElement>(\n            '[role=\"tab\"]'\n        )[next]?.focus()\n    }\n\n    private onToneKeydown = (event:KeyboardEvent):void => {\n        const radios = Array.from(\n            this.tones.querySelectorAll<HTMLButtonElement>(\n                '[role=\"radio\"]'\n            )\n        )\n        const current = radios.indexOf(\n            document.activeElement as HTMLButtonElement\n        )\n        if (current === -1) return\n\n        let next = -1\n        if (event.key === 'ArrowRight') {\n            next = (current + 1) % radios.length\n        } else if (event.key === 'ArrowLeft') {\n            next = (current - 1 + radios.length)\n                % radios.length\n        }\n\n        if (next < 0) return\n        event.preventDefault()\n        event.stopPropagation()\n        this.skinTone = next\n        this.writeSkinTone()\n        this.renderTones()\n        this.renderGrid()\n        this.tones.querySelectorAll<HTMLButtonElement>(\n            '[role=\"radio\"]'\n        )[next]?.focus()\n    }\n\n    private onPanelToggle = (event:Event):void => {\n        const te = event as ToggleEvent\n        if (te.newState === 'closed') {\n            this.panel.hidden = true\n            this.opened = false\n            this.triggerElement = null\n        }\n    }\n}\n\nEmojiPicker.define()\n\ndeclare global {\n    interface HTMLElementTagNameMap {\n        'emoji-picker':EmojiPicker;\n    }\n}\n","structuredPatch":[{"oldStart":228,"oldLines":6,"newStart":228,"newLines":7,"lines":["     }"," ","     close ():void {","+        this.detachPositionListeners()","         const restoreFocus = this.triggerElement","             && this.panel.contains(document.activeElement)","         if (this.panel.matches(':popover-open')) {"]},{"oldStart":235,"oldLines":6,"newStart":236,"newLines":7,"lines":["         }","         this.panel.hidden = true","         this.opened = false","+        this.anchorElement = null","         if (restoreFocus) {","             this.triggerElement!.focus()","         }"]}],"userModified":false,"replaceAll":false}}
